import { Button, ComboBox, LineEdit, ListView, ScrollView, VerticalBox, HorizontalBox, Palette } from "std-widgets.slint";

export global Theme {
    in-out property <bool> dark: true;

    out property <color> bg: dark ? #111b21 : #f0f2f5;
    out property <color> panel: dark ? #202c33 : #ffffff;
    out property <color> header: dark ? #202c33 : #f0f2f5;
    out property <color> sidebar: dark ? #111b21 : #ffffff;
    out property <color> text: dark ? #e9edef : #111b21;
    out property <color> text-dim: dark ? #8696a0 : #667781;
    out property <color> border: dark ? #222d34 : #e0e4e7;
    out property <color> hover: dark ? #202c33 : #f5f6f6;
    out property <color> selected: dark ? #2a3942 : #f0f2f5;
    out property <color> conv-bg: dark ? #0b141a : #efeae2;
    out property <color> bubble-in: dark ? #202c33 : #ffffff;
    out property <color> bubble-out: dark ? #005c4b : #d9fdd3;
    out property <color> bubble-text: dark ? #e9edef : #111b21;
    out property <color> time-out: dark ? #99beb5 : #587a68;
    out property <color> accent: dark ? #00a884 : #008069;
    out property <color> chip-bg: dark ? #202c33 : #f0f2f5;
    out property <color> chip-active-bg: dark ? #0a332c : #d9fdd3;
    out property <color> icon: dark ? #aebac1 : #54656f;
    out property <color> pill: dark ? #233138 : #ffffff;
    out property <color> sender: dark ? #53bdeb : #027eb5;
}

export struct ChatItem {
    jid: string,
    name: string,
    preview: string,
    time: string,
    avatar: image,
    hasAvatar: bool,
    initial: string,
    colorIdx: int,
    unread: int,
    mentioned: bool,
    pinned: bool,
}

export struct ReactionItem {
    jid: string,
    name: string,
    emoji: string,
    avatar: image,
    hasAvatar: bool,
    initial: string,
    colorIdx: int,
}

export struct CallItem {
    id: string,
    from: string,
    name: string,
    detail: string,
    time: string,
    avatar: image,
    hasAvatar: bool,
    initial: string,
    colorIdx: int,
    video: bool,
    group: bool,
}

export struct StickerCell {
    id: string,
    pic: image,
    ready: bool,
}

export struct MessageItem {
    id: string,
    kind: string,          // "text" | "image" | "audio" | "doc"
    text: string,          // body, caption, filename or audio duration
    fromMe: bool,
    sender: string,
    senderJid: string,
    showSender: bool,
    firstOfRun: bool,
    forwarded: bool,
    deleted: bool,
    starred: bool,
    hasQuote: bool,
    quoteName: string,
    quoteText: string,
    quoteId: string,
    time: string,
    picture: image,
    picW: int,
    picH: int,
    mediaPath: string,
    mediaReady: bool,
    reactions: string,
    dayLabel: string,
    ticks: string,
    ticksBlue: bool,
    senderAvatar: image,
    senderHasAvatar: bool,
    senderInitial: string,
    senderColorIdx: int,
    voiceJid: string,
    voiceAvatar: image,
    voiceHasAvatar: bool,
    voiceInitial: string,
    voiceColorIdx: int,
    groupIndent: bool,
    showAvatar: bool,
    senderNumber: string,
    senderLabel: string,
    sticker: bool,
    gif: bool,
    styled: styled-text,
    hasStyled: bool,
    linkTitle: string,
    linkDesc: string,
    linkHost: string,
    linkUrl: string,
    hasLink: bool,
    linkThumb: image,
    hasLinkThumb: bool,
    linkThumbW: int,
    linkThumbH: int,
    wave: image,
    hasWave: bool,
    playing: bool,
    progress: float,
    posLabel: string,
}

component Avatar inherits Rectangle {
    in property <image> src;
    in property <bool> has-image;
    in property <string> initial;
    in property <int> color-idx;
    property <[color]> avatar-colors: [#6bcbef, #e17ab0, #91ab01, #f05d4d, #ffbc38, #8b7add, #02a698, #ee6e51];

    border-radius: self.width / 2;
    clip: true;
    background: self.has-image ? transparent : self.avatar-colors[self.color-idx];

    if self.has-image: Image {
        source: root.src;
        width: parent.width;
        height: parent.height;
        image-fit: cover;
    }
    if !self.has-image: Text {
        text: root.initial;
        color: white;
        font-size: root.width * 0.4;
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component GreenLink inherits TouchArea {
    in property <string> label;
    mouse-cursor: pointer;
    height: t.preferred-height;
    width: t.preferred-width;
    t := Text {
        text: root.label;
        color: Theme.accent;
        font-size: 14px;
        font-weight: 700;
    }
}

component IconButton inherits TouchArea {
    in property <image> icon;
    in property <bool> active: false;
    in property <length> icon-size: 22px;
    width: 40px;
    height: 40px;
    mouse-cursor: pointer;
    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 8px;
        background: root.active ? Theme.selected : root.has-hover ? Theme.hover : transparent;
        Image {
            source: root.icon;
            colorize: Theme.icon;
            width: root.icon-size;
            height: root.icon-size;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }
}

component FilterChip inherits TouchArea {
    in property <string> label;
    in property <bool> active: false;
    mouse-cursor: pointer;
    width: chip.preferred-width;
    height: 30px;
    chip := Rectangle {
        height: parent.height;
        border-radius: 15px;
        background: root.active ? Theme.chip-active-bg : Theme.chip-bg;
        HorizontalLayout {
            padding-left: 13px;
            padding-right: 13px;
            Text {
                text: root.label;
                color: root.active ? Theme.accent : Theme.text-dim;
                font-size: 13px;
                vertical-alignment: center;
            }
        }
    }
}

component MenuRow inherits TouchArea {
    in property <image> icon;
    in property <string> label;
    mouse-cursor: pointer;
    height: 40px;
    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 6px;
        background: root.has-hover ? Theme.hover : transparent;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 16px;
            spacing: 10px;
            Image {
                source: root.icon;
                colorize: Theme.icon;
                width: 18px;
                height: 18px;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: root.label;
                color: Theme.text;
                font-size: 14px;
                vertical-alignment: center;
            }
        }
    }
}

// Self-update banner: lives in the sidebar, and on the lock and login
// screens so a new release is never missed behind the PIN.
component UpdateBanner inherits Rectangle {
    in property <int> state;
    in property <string> version;
    callback apply-update();
    callback restart();
    height: root.state > 0 ? 42px : 0;
    visible: root.state > 0;
    background: Theme.accent.with-alpha(0.15);
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 8px;
        Text {
            text: root.state == 1
                ? @tr("Version {} is available", root.version)
                : root.state == 2 ? @tr("Downloading update…")
                : @tr("Update installed");
            color: Theme.text;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.state == 1 || root.state == 3: Rectangle {
            width: update-btn-text.preferred-width + 22px;
            height: 28px;
            y: (parent.height - self.height) / 2;
            border-radius: 14px;
            background: Theme.accent;
            update-btn-text := Text {
                text: root.state == 1 ? @tr("Update") : @tr("Restart");
                color: white;
                font-size: 13px;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if (root.state == 1) { root.apply-update(); }
                    else { root.restart(); }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Zapive";
    icon: @image-url("zapive.png");
    preferred-width: 1100px;
    preferred-height: 700px;
    background: Theme.bg;
    init => {
        Palette.color-scheme = root.dark-theme ? ColorScheme.dark : ColorScheme.light;
        Theme.dark = root.dark-theme;
    }

    // Theme + language (resolved by the host)
    in-out property <bool> dark-theme: true;
    in-out property <string> theme-mode: "dark";      // "dark" | "light" | "system"
    in-out property <string> language-mode: "system"; // "pt" | "en" | "system"
    callback theme-changed(string);
    callback language-changed(string);
    changed dark-theme => {
        Theme.dark = self.dark-theme;
        Palette.color-scheme = self.dark-theme ? ColorScheme.dark : ColorScheme.light;
    }

    // "locked" | "login" | "main"
    in-out property <string> screen: "login";
    in-out property <string> status-text: @tr("Connecting...");

    // Lock screen
    in-out property <string> lock-error: "";
    callback unlock(string);

    // Login
    in-out property <image> qr-image;
    in-out property <bool> pairing-mode: false;
    in-out property <string> pairing-code: "";
    callback request-pairing-code(string);
    // Blocking error the user has to answer (session taken over, offline).
    in-out property <bool> alert-open;
    in-out property <string> alert-title;
    in-out property <string> alert-text;
    in-out property <string> alert-action;
    callback alert-retry();
    callback alert-dismiss();

    // Chats
    in-out property <[ChatItem]> chats;
    in-out property <[ChatItem]> statuses;
    in-out property <string> sidebar-view: "chats";
    callback status-open(string);
    callback view-changed(string);
    // Calls (the ringing/in-call UI lives in CallWindow)
    in-out property <[CallItem]> calls;
    // Voice calls only make sense one-to-one, so groups, channels and
    // status hide the button.
    in-out property <bool> current-callable: false;
    callback start-call(string);
    callback start-video-call(string);
    // Audio and camera pickers in Settings. The first entry of each list
    // is the "system default" label.
    in-out property <[string]> mic-devices;
    in-out property <[string]> speaker-devices;
    in-out property <[string]> camera-devices;
    in-out property <string> mic-device;
    in-out property <string> speaker-device;
    in-out property <string> camera-device;
    callback device-changed(string, string);
    callback settings-opened();
    // Status viewer
    in-out property <bool> sv-open: false;
    in-out property <string> sv-name: "";
    in-out property <string> sv-time: "";
    in-out property <string> sv-text: "";
    in-out property <bool> sv-has-image: false;
    in-out property <image> sv-image;
    in-out property <int> sv-index: 0;
    in-out property <int> sv-count: 0;
    callback status-next();
    callback status-prev();
    callback status-close();
    in-out property <string> selected-jid: "";
    in-out property <string> chat-tab: "all";
    callback open-chat(string);
    // Fired when the pointer settles on a chat row: the backend preloads
    // that chat's messages so a likely click opens instantly.
    callback chat-hover(string);
    // Self-update: 0 = idle, 1 = update available, 2 = downloading,
    // 3 = installed (restart pending).
    in-out property <int> update-state: 0;
    in-out property <string> update-version;
    callback update-apply();
    callback update-restart();
    callback search-changed(string);
    callback tab-changed(string);

    // Conversation
    in-out property <bool> chat-open: false;
    in-out property <string> sync-banner: "";
    in-out property <string> current-chat-name;
    in-out property <string> current-jid: "";
    in-out property <string> current-status: "";
    in-out property <image> current-avatar;
    in-out property <bool> current-avatar-has: false;
    in-out property <string> current-initial: "";
    in-out property <int> current-color-idx: 0;
    in-out property <[MessageItem]> messages;
    in-out property <bool> attach-open: false;
    in-out property <bool> stick-bottom: true;
    // Kept invisible until the host anchors it, so opening a chat never
    // shows the list scrolling into place.
    in-out property <bool> conv-ready: false;
    in-out property <bool> picker-open: false;
    in-out property <string> picker-tab: "emoji";
    in-out property <[[string]]> emoji-rows;
    in-out property <[[StickerCell]]> sticker-rows;
    in-out property <[[StickerCell]]> gif-rows;
    in-out property <[[StickerCell]]> fav-rows;
    callback gif-send(string);
    in-out property <length> conv-scroll: 0;
    in-out property <length> conv-viewport-h: 0;
    // Cleared when a chat is opened anchored on a message, so landing at
    // the top does not immediately pull the older rows back in.
    in-out property <bool> scroll-armed: true;
    in-out property <bool> rec-active: false;
    in-out property <string> rec-elapsed: "0:00";
    in-out property <bool> rec-view-once: false;
    callback jump-latest();
    // Contact / group info
    in-out property <bool> info-open: false;
    in-out property <string> info-name: "";
    in-out property <string> info-id: "";
    in-out property <string> info-about: "";
    in-out property <string> info-desc: "";
    in-out property <bool> info-is-group: false;
    in-out property <string> info-members: "";
    in-out property <bool> info-archived: false;
    in-out property <image> info-avatar;
    in-out property <bool> info-has-avatar: false;
    in-out property <string> info-initial: "";
    in-out property <int> info-color-idx: 0;
    in-out property <[[StickerCell]]> info-media;
    callback open-info();
    callback close-info();
    callback toggle-archive();
    callback clear-chat();
    callback rec-start();
    callback rec-stop();
    callback rec-cancel();
    callback emoji-pick(string);
    callback sticker-send(string);
    callback picker-opened();
    callback picker-closed();
    changed picker-open => {
        if (!self.picker-open) { root.picker-closed(); }
    }
    callback gif-search(string);
    in-out property <string> gif-hint: "";
    in-out property <string> fav-hint: "";
    callback attach-sticker();
    callback send-message(string);
    callback attach-image();
    callback attach-audio();
    callback attach-doc();
    callback play-audio(string);
    callback copy-text(string);
    callback audio-toggle(string);
    callback audio-seek(string, float);
    callback audio-cycle-rate();
    // Who reacted to a message, opened from the reaction chip.
    in-out property <[ReactionItem]> reaction-rows;
    in-out property <string> reactions-title;
    in-out property <bool> reactions-open;
    callback show-reactions(string);
    callback request-reply(string);
    callback open-quote(string);
    callback toggle-star(string);
    callback delete-message(string);
    callback react-to(string, string);
    callback react-pick(string);
    // Quick reaction bar: the message it belongs to, empty when hidden.
    in-out property <string> react-bar-id;
    // Reply being composed.
    in-out property <bool> reply-open;
    in-out property <string> reply-name;
    in-out property <string> reply-text;
    callback cancel-reply();
    in-out property <string> audio-rate-label: "1x";
    // Mini player shown while a voice note plays in another chat.
    in-out property <bool> mini-audio;
    in-out property <string> mini-audio-name;
    in-out property <image> mini-audio-avatar;
    in-out property <bool> mini-audio-avatar-has;
    in-out property <string> mini-audio-initial;
    in-out property <int> mini-audio-color-idx;
    in-out property <bool> mini-audio-playing;
    in-out property <float> mini-audio-progress;
    callback mini-audio-toggle();
    callback mini-audio-open();
    callback mini-audio-close();
    callback load-older();
    callback paste-clipboard();
    callback open-dm(string);
    callback request-forward(string);

    // Forward picker
    in-out property <bool> forward-open: false;
    in-out property <[ChatItem]> forward-rows;
    in-out property <string> forward-preview-text;
    in-out property <image> forward-preview-image;
    in-out property <bool> forward-preview-has-image;
    callback forward-search(string);
    callback forward-to(string);

    public function append-composer(t: string) {
        message-input.text = message-input.text + t;
    }
    public function scroll-conversation-end() {
        msg-list.viewport-y = min(0px, msg-list.height - msg-list.viewport-height);
    }
    public function scroll-conversation-top() {
        msg-list.viewport-y = 0;
    }
    public function set-conversation-scroll(y: length) {
        msg-list.viewport-y = y;
    }

    // Settings
    in-out property <bool> settings-open: false;
    in-out property <bool> pin-set: false;
    in-out property <bool> autostart: false;
    in-out property <string> settings-status: "";
    callback autostart-changed(bool);
    callback save-pin(string, string);
    callback remove-pin(string);
    callback logout();

    // Lightbox
    in-out property <bool> lightbox-open: false;
    in-out property <image> lightbox-image;
    // In-app video player
    in-out property <bool> video-open: false;
    in-out property <image> video-frame;
    in-out property <int> video-w: 0;
    in-out property <int> video-h: 0;
    callback open-video(string);
    callback close-video();

    // Send-image preview (paste / attach confirmation)
    in-out property <bool> preview-open: false;
    in-out property <image> preview-image;
    callback confirm-send-image(string);
    callback cancel-send-image();

    // ---------- Lock screen ----------
    if root.screen == "locked": VerticalBox {
        alignment: center;
        spacing: 14px;
        HorizontalBox {
            alignment: center;
            UpdateBanner {
                width: 360px;
                border-radius: 8px;
                state: root.update-state;
                version: root.update-version;
                apply-update => { root.update-apply(); }
                restart => { root.update-restart(); }
            }
        }
        HorizontalBox {
            alignment: center;
            spacing: 10px;
            Image {
                source: @image-url("icons/lock.svg");
                colorize: Theme.text;
                width: 26px;
                height: 26px;
                y: 2px;
            }
            Text {
                text: "Zapive";
                color: Theme.text;
                font-size: 26px;
                font-weight: 700;
            }
        }
        Text {
            text: @tr("Enter your PIN to unlock");
            color: Theme.text-dim;
            font-size: 14px;
            horizontal-alignment: center;
        }
        HorizontalBox {
            alignment: center;
            pin-input := LineEdit {
                width: 220px;
                input-type: password;
                placeholder-text: @tr("PIN");
                accepted => { root.unlock(self.text); self.text = ""; }
            }
            Button {
                text: @tr("Unlock");
                primary: true;
                clicked => { root.unlock(pin-input.text); pin-input.text = ""; }
            }
        }
        Text {
            text: root.lock-error;
            color: #f05d4d;
            font-size: 13px;
            horizontal-alignment: center;
        }
    }

    // ---------- Login ----------
    if root.screen == "login": VerticalBox {
        alignment: center;
        HorizontalBox {
            alignment: center;
            UpdateBanner {
                width: 820px;
                border-radius: 8px;
                state: root.update-state;
                version: root.update-version;
                apply-update => { root.update-apply(); }
                restart => { root.update-restart(); }
            }
        }
        HorizontalBox {
            alignment: center;
            Rectangle {
                width: 820px;
                height: 420px;
                background: Theme.panel;
                border-radius: 12px;

                if !root.pairing-mode: HorizontalLayout {
                    padding: 48px;
                    spacing: 40px;
                    VerticalLayout {
                        alignment: start;
                        spacing: 22px;
                        horizontal-stretch: 1;
                        Text {
                            text: @tr("Log in to WhatsApp");
                            color: Theme.text;
                            font-size: 24px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.status-text;
                            color: Theme.text-dim;
                            font-size: 13px;
                        }
                        Text { text: @tr("1.  Open WhatsApp on your phone"); color: Theme.text; font-size: 15px; }
                        Text { text: @tr("2.  Tap Menu and then Linked devices"); color: Theme.text; font-size: 15px; }
                        Text { text: @tr("3.  Tap Link a device"); color: Theme.text; font-size: 15px; }
                        Text { text: @tr("4.  Point your camera at this code"); color: Theme.text; font-size: 15px; }
                        Rectangle { height: 8px; }
                        GreenLink {
                            label: @tr("Log in with phone number  ›");
                            clicked => { root.pairing-mode = true; }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 264px;
                            height: 264px;
                            background: white;
                            border-radius: 8px;
                            Image {
                                source: root.qr-image;
                                width: 240px;
                                height: 240px;
                                image-rendering: pixelated;
                            }
                        }
                    }
                }

                if root.pairing-mode: VerticalLayout {
                    padding: 48px;
                    spacing: 20px;
                    alignment: start;
                    Text {
                        text: @tr("Log in with phone number");
                        color: Theme.text;
                        font-size: 24px;
                        font-weight: 700;
                    }
                    Text {
                        text: @tr("Enter your number with the country code to receive a code to type on your phone.");
                        color: Theme.text-dim;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        phone-input := LineEdit {
                            width: 300px;
                            placeholder-text: @tr("E.g.: 5511999998888");
                        }
                        Button {
                            text: @tr("Get code");
                            primary: true;
                            clicked => { root.request-pairing-code(phone-input.text); }
                        }
                    }
                    Text {
                        text: root.pairing-code;
                        color: Theme.accent;
                        font-size: 36px;
                        font-weight: 700;
                        letter-spacing: 4px;
                    }
                    Rectangle { vertical-stretch: 1; }
                    GreenLink {
                        label: @tr("‹  Back to QR code");
                        clicked => { root.pairing-mode = false; }
                    }
                }
            }
        }
    }

    // ---------- Main ----------
    // capture-key-pressed sees Ctrl+V even while the composer LineEdit is
    // focused; rejecting keeps normal text paste working while the app
    // checks the clipboard for an image (WhatsApp-style paste-to-send).
    capture-scope := FocusScope {
        visible: root.screen == "main";
        capture-key-pressed(event) => {
            if (event.text == "v" && event.modifiers.control && root.chat-open) {
                root.paste-clipboard();
            }
            reject
        }

    main-pane := HorizontalLayout {
        padding: 0;
        spacing: 0;

        // Icon rail
        Rectangle {
            width: 60px;
            background: Theme.header;
            VerticalLayout {
                padding: 10px;
                spacing: 8px;
                alignment: start;
                IconButton {
                    icon: @image-url("icons/message-circle.svg");
                    active: root.sidebar-view == "chats";
                    clicked => {
                        root.sidebar-view = "chats";
                        root.view-changed("chats");
                    }
                }
                IconButton {
                    icon: @image-url("icons/circle-dot.svg");
                    active: root.sidebar-view == "status";
                    clicked => { root.sidebar-view = "status"; }
                }
                IconButton {
                    icon: @image-url("icons/phone.svg");
                    active: root.sidebar-view == "calls";
                    clicked => { root.sidebar-view = "calls"; }
                }
                IconButton {
                    icon: @image-url("icons/speakerphone.svg");
                    active: root.sidebar-view == "channels";
                    clicked => {
                        root.sidebar-view = "channels";
                        root.view-changed("channels");
                    }
                }
                IconButton {
                    icon: @image-url("icons/users-group.svg");
                    active: root.sidebar-view == "communities";
                    clicked => {
                        root.sidebar-view = "communities";
                        root.view-changed("communities");
                    }
                }
                Rectangle { vertical-stretch: 1; }
                IconButton {
                    icon: @image-url("icons/settings.svg");
                    clicked => {
                        root.settings-status = "";
                        root.settings-open = true;
                        root.settings-opened();
                    }
                }
            }
        }

        Rectangle { width: 1px; background: Theme.border; }

        // Sidebar
        Rectangle {
            width: 380px;
            background: Theme.sidebar;

            VerticalBox {
                visible: root.sidebar-view == "status";
                width: 100%;
                height: 100%;
                padding: 0;
                spacing: 0;
                Rectangle {
                    height: 56px;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        Text {
                            text: @tr("Status");
                            color: Theme.text;
                            font-size: 21px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                }
                if root.statuses.length == 0: Text {
                    text: @tr("No recent updates");
                    color: Theme.text-dim;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
                ListView {
                    for st[i] in root.statuses: Rectangle {
                        height: 72px;
                        clip: true;
                        background: st-touch.has-hover ? Theme.hover : transparent;
                        st-touch := TouchArea {
                            clicked => { root.status-open(st.jid); }
                        }
                        HorizontalLayout {
                            padding-left: 13px;
                            padding-right: 15px;
                            spacing: 13px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 0;
                                Rectangle {
                                    width: 53px;
                                    height: 53px;
                                    border-radius: 26.5px;
                                    border-width: 2px;
                                    border-color: Theme.accent;
                                    Avatar {
                                        width: 46px;
                                        height: 46px;
                                        x: 3.5px;
                                        y: 3.5px;
                                        src: st.avatar;
                                        has-image: st.hasAvatar;
                                        initial: st.initial;
                                        color-idx: st.colorIdx;
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text {
                                    text: st.name;
                                    color: Theme.text;
                                    font-size: 15px;
                                    overflow: elide;
                                }
                                Text {
                                    text: st.time;
                                    color: Theme.text-dim;
                                    font-size: 12px;
                                }
                            }
                        }
                    }
                }
            }

            VerticalBox {
                visible: root.sidebar-view == "calls";
                width: 100%;
                height: 100%;
                padding: 0;
                spacing: 0;
                Rectangle {
                    height: 56px;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        Text {
                            text: @tr("Calls");
                            color: Theme.text;
                            font-size: 21px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                }
                if root.calls.length == 0: Text {
                    text: @tr("No calls yet");
                    color: Theme.text-dim;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
                ListView {
                    for call in root.calls: Rectangle {
                        height: 68px;
                        clip: true;
                        background: call-touch.has-hover ? Theme.hover : transparent;
                        call-touch := TouchArea {
                            clicked => { root.open-dm(call.from); }
                        }
                        HorizontalLayout {
                            padding-left: 13px;
                            padding-right: 15px;
                            spacing: 13px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 0;
                                Avatar {
                                    width: 46px;
                                    height: 46px;
                                    src: call.avatar;
                                    has-image: call.hasAvatar;
                                    initial: call.initial;
                                    color-idx: call.colorIdx;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                spacing: 3px;
                                Text {
                                    text: call.name;
                                    color: Theme.text;
                                    font-size: 15px;
                                    overflow: elide;
                                }
                                Text {
                                    text: call.detail;
                                    color: Theme.text-dim;
                                    font-size: 13px;
                                    overflow: elide;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 0;
                                spacing: 4px;
                                Text {
                                    text: call.time;
                                    color: Theme.text-dim;
                                    font-size: 11px;
                                    horizontal-alignment: right;
                                }
                                // Redial, the way the phone's call log does.
                                if !call.group: IconButton {
                                    icon: @image-url("icons/phone.svg");
                                    icon-size: 18px;
                                    width: 30px;
                                    height: 30px;
                                    clicked => { root.start-call(call.from); }
                                }
                            }
                        }
                    }
                }
            }

            VerticalBox {
                visible: root.sidebar-view != "status" && root.sidebar-view != "calls";
                width: 100%;
                height: 100%;
                padding: 0;
                spacing: 0;

                Rectangle {
                    height: 56px;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        Text {
                            text: root.sidebar-view == "channels" ? @tr("Channels")
                                : root.sidebar-view == "communities" ? @tr("Communities")
                                : @tr("Chats");
                            color: Theme.text;
                            font-size: 21px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                }

                Rectangle {
                    height: 46px;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-bottom: 8px;
                        search-box := LineEdit {
                            placeholder-text: @tr("Search chats");
                            edited => { root.search-changed(self.text); }
                        }
                    }
                }

                // Self-update banner under the search box.
                UpdateBanner {
                    state: root.update-state;
                    version: root.update-version;
                    apply-update => { root.update-apply(); }
                    restart => { root.update-restart(); }
                }

                Rectangle {
                    height: root.sidebar-view == "chats" ? 40px : 0;
                    visible: root.sidebar-view == "chats";
                    HorizontalLayout {
                        padding-left: 12px;
                        spacing: 8px;
                        alignment: start;
                        FilterChip {
                            label: @tr("All");
                            active: root.chat-tab == "all";
                            clicked => { root.chat-tab = "all"; root.tab-changed("all"); }
                        }
                        FilterChip {
                            label: @tr("Unread");
                            active: root.chat-tab == "unread";
                            clicked => { root.chat-tab = "unread"; root.tab-changed("unread"); }
                        }
                        FilterChip {
                            label: @tr("Archived");
                            active: root.chat-tab == "archived";
                            clicked => { root.chat-tab = "archived"; root.tab-changed("archived"); }
                        }
                    }
                }

                ListView {
                    for chat[i] in root.chats: Rectangle {
                        height: 72px;
                        clip: true;
                        background: chat.jid == root.selected-jid ? Theme.selected
                            : touch.has-hover ? Theme.hover : transparent;
                        touch := TouchArea {
                            clicked => { root.open-chat(chat.jid); }
                            changed has-hover => {
                                if (self.has-hover) { root.chat-hover(chat.jid); }
                            }
                        }
                        HorizontalLayout {
                            padding-left: 13px;
                            padding-right: 15px;
                            spacing: 13px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 0;
                                Avatar {
                                    width: 49px;
                                    height: 49px;
                                    src: chat.avatar;
                                    has-image: chat.hasAvatar;
                                    initial: chat.initial;
                                    color-idx: chat.colorIdx;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                spacing: 4px;
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: chat.name;
                                        color: Theme.text;
                                        font-size: 15px;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: chat.time;
                                        color: chat.unread > 0 ? Theme.accent : Theme.text-dim;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        horizontal-stretch: 0;
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: chat.preview;
                                        color: Theme.text-dim;
                                        font-size: 13px;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    if chat.pinned: Image {
                                        source: @image-url("icons/pin.svg");
                                        colorize: Theme.text-dim;
                                        width: 14px;
                                        height: 14px;
                                        y: (parent.height - self.height) / 2;
                                        horizontal-stretch: 0;
                                    }
                                    if chat.mentioned: Image {
                                        source: @image-url("icons/at.svg");
                                        colorize: Theme.accent;
                                        width: 15px;
                                        height: 15px;
                                        y: (parent.height - self.height) / 2;
                                        horizontal-stretch: 0;
                                    }
                                    if chat.unread > 0: Rectangle {
                                        width: max(20px, badge-text.preferred-width + 12px);
                                        height: 20px;
                                        border-radius: 10px;
                                        background: Theme.accent;
                                        badge-text := Text {
                                            text: chat.unread;
                                            color: Theme.dark ? #111b21 : #ffffff;
                                            font-size: 11px;
                                            font-weight: 700;
                                            width: parent.width;
                                            height: parent.height;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                        Rectangle {
                            x: 75px;
                            y: parent.height - 1px;
                            width: parent.width - 75px;
                            height: 1px;
                            background: Theme.border;
                        }
                    }
                }
            }

            // Mini player: keeps the running voice note reachable after
            // the user moves to another conversation.
            if root.mini-audio: Rectangle {
                y: parent.height - self.height;
                width: parent.width;
                height: 56px;
                background: #008069;
                mini-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.mini-audio-open(); }
                }
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 12px;
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 26px;
                            height: 26px;
                            play-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.mini-audio-toggle(); }
                            }
                            Image {
                                source: root.mini-audio-playing
                                    ? @image-url("icons/player-pause.svg")
                                    : @image-url("icons/player-play.svg");
                                colorize: white;
                                width: 18px;
                                height: 18px;
                            }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 30px;
                                    height: 30px;
                                    Avatar {
                                        width: 30px;
                                        height: 30px;
                                        src: root.mini-audio-avatar;
                                        has-image: root.mini-audio-avatar-has;
                                        initial: root.mini-audio-initial;
                                        color-idx: root.mini-audio-color-idx;
                                    }
                                    Image {
                                        source: @image-url("icons/microphone.svg");
                                        colorize: white;
                                        width: 14px;
                                        height: 14px;
                                        x: parent.width - self.width;
                                        y: parent.height - self.height;
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: root.mini-audio-name;
                                    color: white;
                                    font-size: 14px;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 24px;
                            height: 24px;
                            close-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.mini-audio-close(); }
                            }
                            Image {
                                source: @image-url("icons/x.svg");
                                colorize: white;
                                width: 16px;
                                height: 16px;
                            }
                        }
                    }
                }
                // Progress hairline along the bottom edge.
                Rectangle {
                    x: 0;
                    y: parent.height - 2px;
                    width: parent.width * root.mini-audio-progress;
                    height: 2px;
                    background: #ffffffcc;
                }
            }
        }

        Rectangle { width: 1px; background: Theme.border; }

        // Conversation pane
        Rectangle {
            background: Theme.conv-bg;

            VerticalBox {
                visible: !root.chat-open;
                width: 100%;
                height: 100%;
                alignment: center;
                Text {
                    text: "Zapive";
                    color: Theme.text;
                    font-size: 28px;
                    font-weight: 300;
                    horizontal-alignment: center;
                }
                Text {
                    text: @tr("Select a conversation to start");
                    color: Theme.text-dim;
                    font-size: 14px;
                    horizontal-alignment: center;
                }
            }

            VerticalBox {
                visible: root.chat-open;
                width: 100%;
                height: 100%;
                padding: 0;
                spacing: 0;

                Rectangle {
                    height: 54px;
                    background: Theme.header;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Avatar {
                                width: 40px;
                                height: 40px;
                                src: root.current-avatar;
                                has-image: root.current-avatar-has;
                                initial: root.current-initial;
                                color-idx: root.current-color-idx;
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            head-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.open-info(); }
                            }
                            VerticalLayout {
                                alignment: center;
                                width: parent.width;
                                height: parent.height;
                                spacing: 1px;
                                Text {
                                    text: root.current-chat-name;
                                    color: Theme.text;
                                    font-size: 16px;
                                    font-weight: 700;
                                    overflow: elide;
                                }
                                if root.current-status != "": Text {
                                    text: root.current-status;
                                    color: root.current-status == "online" ? Theme.text-dim : Theme.accent;
                                    font-size: 12px;
                                }
                            }
                        }
                        if root.current-callable: VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: @image-url("icons/video.svg");
                                clicked => { root.start-video-call(root.current-jid); }
                            }
                        }
                        if root.current-callable: VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: @image-url("icons/phone.svg");
                                clicked => { root.start-call(root.current-jid); }
                            }
                        }
                    }
                }

                if root.sync-banner != "": Rectangle {
                    height: 32px;
                    HorizontalLayout {
                        alignment: center;
                        padding-top: 6px;
                        Rectangle {
                            width: banner-text.preferred-width + 24px;
                            height: 24px;
                            border-radius: 12px;
                            background: Theme.pill;
                            banner-text := Text {
                                text: root.sync-banner;
                                color: Theme.text-dim;
                                font-size: 12px;
                                width: parent.width;
                                height: parent.height;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                msg-list := ListView {
                    opacity: root.conv-ready ? 1.0 : 0.0;
                    changed viewport-height => {
                        root.conv-viewport-h = self.viewport-height;
                    }
                    changed viewport-y => {
                        root.conv-scroll = self.viewport-y;
                        root.stick-bottom =
                            self.viewport-y <= self.height - self.viewport-height + 60px;
                        if (self.viewport-y < -120px && root.conv-ready) {
                            root.scroll-armed = true;
                        }
                        if (self.viewport-y >= -4px && self.viewport-height > self.height
                            && root.scroll-armed) {
                            root.load-older();
                        }
                    }
                    for msg in root.messages: msg-row := Rectangle {
                        row-hover := TouchArea {
                            mouse-cursor: default;
                            // Purely a hover probe: clicks fall through.
                            enabled: false;
                        }
                        // A link card drives the bubble width, so the text
                        // wraps at the card instead of stretching past it on
                        // a wide window.
                        property <length> max-text-w: msg.hasLink
                            ? min(360px, max(120px, self.width * 0.65 - 44px))
                            : max(120px, self.width * 0.65 - 44px);
                        // Media drives the bubble width; the header and the
                        // caption wrap inside it instead of widening the bubble.
                        property <length> content-w:
                            (msg.kind == "image" || msg.kind == "video") && msg.picW > 0
                                ? max(150px, msg.picW * 1px)
                                : max-text-w;
                        property <length> day-offset: msg.dayLabel != "" ? 34px : 0;
                        height: bubble.height + (msg.firstOfRun ? 16px : 6px)
                            + (msg.reactions != "" ? 14px : 0) + self.day-offset;
                        if msg.dayLabel != "": Rectangle {
                            y: 8px;
                            x: (parent.width - self.width) / 2;
                            width: day-text.preferred-width + 24px;
                            height: 24px;
                            border-radius: 6px;
                            background: Theme.pill;
                            day-text := Text {
                                text: msg.dayLabel;
                                color: Theme.text-dim;
                                font-size: 12px;
                                width: parent.width;
                                height: parent.height;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        if msg.showAvatar: Avatar {
                            width: 28px;
                            height: 28px;
                            x: 12px;
                            y: (msg.firstOfRun ? 12px : 3px) + msg-row.day-offset;
                            src: msg.senderAvatar;
                            has-image: msg.senderHasAvatar;
                            initial: msg.senderInitial;
                            color-idx: msg.senderColorIdx;
                        }
                        bubble := Rectangle {
                            y: (msg.firstOfRun ? 12px : 3px) + msg-row.day-offset;
                            x: msg.fromMe
                                ? parent.width - self.width - 30px
                                : (msg.groupIndent ? 48px : 30px);
                            width: content.preferred-width;
                            height: content.preferred-height;
                            background: msg.sticker
                                ? transparent
                                : (msg.fromMe ? Theme.bubble-out : Theme.bubble-in);
                            border-radius: 7px;
                            num-measure := Text {
                                text: msg.senderNumber;
                                font-size: 11px;
                                visible: false;
                                width: 0px;
                                height: 0px;
                            }
                            if msg.showSender && msg.senderNumber != "": Text {
                                text: msg.senderNumber;
                                font-size: 11px;
                                color: Theme.text-dim;
                                x: parent.width - self.width - 9px;
                                y: 7px;
                            }
                            content := VerticalLayout {
                                padding: 6px;
                                padding-left: 9px;
                                padding-right: 9px;
                                spacing: 2px;

                                if msg.showSender: HorizontalLayout {
                                    spacing: 8px;
                                    sender-touch := TouchArea {
                                        width: sender-text.width;
                                        height: sender-text.preferred-height;
                                        mouse-cursor: pointer;
                                        clicked => { root.open-dm(msg.senderJid); }
                                        sender-text := Text {
                                            text: msg.senderLabel;
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: Theme.sender;
                                            width: min(self.preferred-width,
                                                msg-row.content-w - 26px
                                                    - (msg.senderNumber != ""
                                                        ? num-measure.preferred-width + 24px
                                                        : 0px));
                                            overflow: elide;
                                        }
                                    }
                                    // Reserves the number's width without
                                    // depending on the bubble, which would
                                    // create a layout loop.
                                    if msg.senderNumber != "": Rectangle {
                                        width: num-measure.preferred-width + 24px;
                                    }
                                }

                                if msg.hasQuote && !msg.deleted: Rectangle {
                                    height: quote-col.preferred-height;
                                    border-radius: 4px;
                                    background: msg.fromMe ? #00000014 : #00000010;
                                    clip: true;
                                    quote-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.open-quote(msg.quoteId); }
                                    }
                                    Rectangle {
                                        x: 0;
                                        width: 4px;
                                        height: parent.height;
                                        background: Theme.accent;
                                    }
                                    quote-col := VerticalLayout {
                                        padding: 6px;
                                        padding-left: 12px;
                                        spacing: 2px;
                                        Text {
                                            text: msg.quoteName;
                                            color: Theme.accent;
                                            font-size: 12px;
                                            font-weight: 700;
                                            overflow: elide;
                                            width: min(self.preferred-width,
                                                msg-row.content-w - 20px);
                                        }
                                        Text {
                                            text: msg.quoteText;
                                            color: Theme.text-dim;
                                            font-size: 12.5px;
                                            overflow: elide;
                                            width: min(self.preferred-width,
                                                msg-row.content-w - 20px);
                                        }
                                    }
                                }

                                if msg.forwarded && !msg.deleted: HorizontalLayout {
                                    spacing: 4px;
                                    alignment: start;
                                    Image {
                                        source: @image-url("icons/corner-up-right.svg");
                                        colorize: Theme.text-dim;
                                        width: 12px;
                                        height: 12px;
                                        y: 1px;
                                    }
                                    Text {
                                        text: @tr("Forwarded");
                                        font-size: 11px;
                                        font-italic: true;
                                        color: Theme.text-dim;
                                    }
                                }

                                if msg.kind == "video" && !msg.mediaReady && msg.picW > 0: Rectangle {
                                    width: msg.picW * 1px;
                                    height: msg.picH * 1px;
                                    border-radius: 6px;
                                    background: Theme.hover;
                                }
                                if msg.kind == "video" && msg.mediaReady && msg.picW > 0: TouchArea {
                                    width: msg.picW * 1px;
                                    height: msg.picH * 1px;
                                    mouse-cursor: pointer;
                                    clicked => { root.open-video(msg.id); }
                                    Image {
                                        source: msg.picture;
                                        width: parent.width;
                                        height: parent.height;
                                    }
                                    // GIF badge, shown while the clip rests.
                                    if msg.gif && !msg.playing: Rectangle {
                                        x: 8px;
                                        y: parent.height - self.height - 8px;
                                        width: gif-label.preferred-width + 12px;
                                        height: 20px;
                                        border-radius: 4px;
                                        background: #000000a0;
                                        gif-label := Text {
                                            text: "GIF";
                                            color: white;
                                            font-size: 11px;
                                            font-weight: 700;
                                            width: parent.width;
                                            height: parent.height;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    if !msg.gif: Rectangle {
                                        width: 46px;
                                        height: 46px;
                                        border-radius: 23px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        background: #000000a0;
                                        Image {
                                            source: @image-url("icons/player-play.svg");
                                            colorize: white;
                                            width: 24px;
                                            height: 24px;
                                            x: 11px;
                                            y: 11px;
                                        }
                                    }
                                }
                                if msg.kind == "image" && msg.mediaReady: TouchArea {
                                    width: msg.picW * 1px;
                                    height: msg.picH * 1px;
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.lightbox-image = msg.picture;
                                        root.lightbox-open = true;
                                    }
                                    Image {
                                        source: msg.picture;
                                        width: parent.width;
                                        height: parent.height;
                                    }
                                }
                                // Placeholder of the final size: the bubble
                                // never changes height once the image lands.
                                if msg.kind == "image" && !msg.mediaReady: Rectangle {
                                    width: msg.picW * 1px;
                                    height: msg.picH * 1px;
                                    border-radius: 6px;
                                    background: Theme.hover;
                                }

                                if msg.kind == "doc": HorizontalLayout {
                                    spacing: 8px;
                                    IconButton {
                                        icon: @image-url("icons/file-text.svg");
                                        enabled: msg.mediaReady;
                                        clicked => { root.play-audio(msg.mediaPath); }
                                    }
                                    Text {
                                        text: msg.text;
                                        color: Theme.bubble-text;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        width: min(self.preferred-width, msg-row.max-text-w - 60px);
                                    }
                                }

                                // Voice-note player: waveform track, played
                                // portion clipped over it, click to seek.
                                if msg.kind == "audio": HorizontalLayout {
                                    spacing: 10px;
                                    VerticalLayout {
                                        alignment: center;
                                        IconButton {
                                            icon: msg.playing
                                                ? @image-url("icons/player-pause.svg")
                                                : @image-url("icons/player-play.svg");
                                            icon-size: 20px;
                                            enabled: msg.mediaReady;
                                            clicked => { root.audio-toggle(msg.id); }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 3px;
                                        wave-area := TouchArea {
                                            width: 220px;
                                            height: 30px;
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.audio-seek(msg.id,
                                                    self.mouse-x / self.width);
                                            }
                                            if msg.hasWave: Image {
                                                source: msg.wave;
                                                colorize: msg.fromMe
                                                    ? #9fd3c7 : Theme.text-dim;
                                                x: 0;
                                                y: 0;
                                                width: parent.width;
                                                height: parent.height;
                                                image-fit: fill;
                                            }
                                            // Played portion: same bitmap in the
                                            // accent color, clipped from the left.
                                            if msg.hasWave: Rectangle {
                                                x: 0;
                                                y: 0;
                                                width: parent.width * msg.progress;
                                                height: parent.height;
                                                clip: true;
                                                Image {
                                                    source: msg.wave;
                                                    colorize: #53bdeb;
                                                    x: 0;
                                                    y: 0;
                                                    width: wave-area.width;
                                                    height: wave-area.height;
                                                    image-fit: fill;
                                                }
                                            }
                                            if !msg.hasWave: Rectangle {
                                                width: parent.width;
                                                height: 3px;
                                                y: 14px;
                                                border-radius: 1.5px;
                                                background: Theme.text-dim;
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Text {
                                                text: msg.playing && msg.posLabel != ""
                                                    ? msg.posLabel : msg.text;
                                                color: msg.fromMe ? Theme.time-out : Theme.text-dim;
                                                font-size: 11px;
                                                horizontal-stretch: 1;
                                            }
                                            Text {
                                                text: msg.time;
                                                font-size: 10px;
                                                color: msg.fromMe ? Theme.time-out : Theme.text-dim;
                                                vertical-alignment: center;
                                            }
                                            if msg.ticks != "": Text {
                                                text: msg.ticks;
                                                font-size: 10px;
                                                font-weight: 700;
                                                color: msg.ticksBlue ? #53bdeb : Theme.time-out;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 38px;
                                            height: 38px;
                                            if !msg.playing: Avatar {
                                                width: 38px;
                                                height: 38px;
                                                src: msg.voiceAvatar;
                                                has-image: msg.voiceHasAvatar;
                                                initial: msg.voiceInitial;
                                                color-idx: msg.voiceColorIdx;
                                            }
                                            if !msg.playing: Image {
                                                source: @image-url("icons/microphone.svg");
                                                colorize: #53bdeb;
                                                width: 15px;
                                                height: 15px;
                                                x: parent.width - self.width;
                                                y: parent.height - self.height;
                                            }
                                            if msg.playing: Rectangle {
                                                width: rate-label.preferred-width + 16px;
                                                height: 24px;
                                                x: parent.width - self.width;
                                                y: (parent.height - self.height) / 2;
                                                border-radius: 12px;
                                                background: rate-touch.has-hover
                                                    ? #00000030 : #00000018;
                                                rate-touch := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.audio-cycle-rate(); }
                                                }
                                                rate-label := Text {
                                                    text: root.audio-rate-label;
                                                    color: Theme.text-dim;
                                                    font-size: 11px;
                                                    font-weight: 700;
                                                }
                                            }
                                        }
                                    }
                                }

                                // Link preview card. Blocks are placed by
                                // hand and the height is their exact sum, so
                                // the card never grows past its content.
                                if msg.hasLink: Rectangle {
                                    // The card spans the bubble like WhatsApp
                                    // does, instead of leaving a margin beside it.
                                    property <length> card-w: msg-row.max-text-w;
                                    property <length> img-h: msg.hasLinkThumb
                                        ? min(300px, card-w * msg.linkThumbH
                                            / max(msg.linkThumbW, 1))
                                        : 0px;
                                    property <length> host-h: msg.linkHost != "" ? 24px : 0px;
                                    property <length> title-h: msg.linkTitle != ""
                                        ? link-title.preferred-height + 8px : 0px;
                                    property <length> desc-h: msg.linkDesc != ""
                                        ? link-desc.preferred-height + 8px : 0px;

                                    width: card-w;
                                    height: img-h + host-h + title-h + desc-h;
                                    // A bare Rectangle stretches by default and
                                    // would swallow the bubble's leftover space.
                                    horizontal-stretch: 0;
                                    vertical-stretch: 0;
                                    border-radius: 6px;
                                    clip: true;
                                    background: msg.fromMe ? #ffffff14 : #00000014;

                                    if msg.hasLinkThumb: Image {
                                        source: msg.linkThumb;
                                        x: 0;
                                        y: 0;
                                        width: parent.width;
                                        height: parent.img-h;
                                        image-fit: cover;
                                    }
                                    if msg.linkHost != "": Rectangle {
                                        x: 0;
                                        y: parent.img-h;
                                        width: parent.width;
                                        height: parent.host-h;
                                        background: msg.fromMe ? #ffffff10 : #00000010;
                                        Text {
                                            text: msg.linkHost;
                                            color: Theme.text-dim;
                                            font-size: 11px;
                                            x: 9px;
                                            height: parent.height;
                                            vertical-alignment: center;
                                        }
                                    }
                                    link-title := Text {
                                        text: msg.linkTitle;
                                        visible: msg.linkTitle != "";
                                        color: Theme.bubble-text;
                                        font-size: 13px;
                                        font-weight: 700;
                                        wrap: word-wrap;
                                        x: 9px;
                                        y: parent.img-h + parent.host-h + 4px;
                                        width: parent.width - 18px;
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.open-dm(msg.linkUrl); }
                                    }
                                    link-desc := Text {
                                        text: msg.linkDesc;
                                        visible: msg.linkDesc != "";
                                        color: Theme.text-dim;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                        x: 9px;
                                        y: parent.img-h + parent.host-h + parent.title-h + 4px;
                                        width: parent.width - 18px;
                                    }
                                }

                                // Formatted text (bold/italic/strike/mono).
                                if msg.hasStyled: ContextMenuArea {
                                    width: styled-body.width;
                                    height: styled-body.preferred-height;
                                    Menu {
                                        MenuItem {
                                            title: @tr("Reply");
                                            activated => { root.request-reply(msg.id); }
                                        }
                                        MenuItem {
                                            title: @tr("Copy");
                                            activated => { root.copy-text(msg.id); }
                                        }
                                        MenuItem {
                                            title: @tr("Forward");
                                            activated => { root.request-forward(msg.id); }
                                        }
                                        MenuItem {
                                            title: msg.starred ? @tr("Unstar") : @tr("Star");
                                            activated => { root.toggle-star(msg.id); }
                                        }
                                        MenuItem {
                                            title: @tr("Delete");
                                            activated => { root.delete-message(msg.id); }
                                        }
                                    }
                                    styled-body := StyledText {
                                        text: msg.styled;
                                        default-color: Theme.bubble-text;
                                        default-font-size: 14px;
                                        link-color: Theme.accent;
                                        width: min(self.preferred-width, msg-row.max-text-w);
                                        link-clicked(target) => { root.open-dm(target); }
                                    }
                                }

                                if !msg.hasStyled && (msg.kind == "text" || (msg.kind == "image" && msg.text != "")): Rectangle {
                                    width: body-text.width;
                                    height: body-text.preferred-height;
                                    ContextMenuArea {
                                        width: parent.width;
                                        height: parent.height;
                                        Menu {
                                            MenuItem {
                                                title: @tr("Reply");
                                                activated => { root.request-reply(msg.id); }
                                            }
                                            MenuItem {
                                                title: @tr("Copy");
                                                activated => {
                                                    body-text.select-all();
                                                    body-text.copy();
                                                    body-text.clear-selection();
                                                }
                                            }
                                            MenuItem {
                                                title: @tr("Forward");
                                                activated => { root.request-forward(msg.id); }
                                            }
                                            MenuItem {
                                                title: msg.starred ? @tr("Unstar") : @tr("Star");
                                                activated => { root.toggle-star(msg.id); }
                                            }
                                            MenuItem {
                                                title: @tr("Delete");
                                                activated => { root.delete-message(msg.id); }
                                            }
                                        }
                                        body-text := TextInput {
                                            text: msg.deleted ? "🚫 " + msg.text : msg.text;
                                            read-only: true;
                                            single-line: false;
                                            wrap: word-wrap;
                                            font-size: 14px;
                                            font-italic: msg.deleted;
                                            color: msg.deleted ? Theme.text-dim : Theme.bubble-text;
                                            selection-background-color: #3390ec;
                                            selection-foreground-color: white;
                                            // captions wrap to the image width
                                            width: min(self.preferred-width,
                                                msg-row.content-w);
                                            height: self.preferred-height;
                                        }
                                    }
                                }

                                // Stickers have no bubble, so the timestamp
                                // gets its own pill like WhatsApp draws it,
                                // with breathing room under the artwork.
                                if msg.sticker: Rectangle { height: 6px; }
                                if msg.kind != "audio": HorizontalLayout {
                                    alignment: end;
                                    Rectangle {
                                        width: stamp.preferred-width + (msg.sticker ? 14px : 0);
                                        height: msg.sticker ? 20px : stamp.preferred-height;
                                        border-radius: 10px;
                                        background: msg.sticker
                                            ? (msg.fromMe ? Theme.bubble-out : Theme.bubble-in)
                                            : transparent;
                                        stamp := HorizontalLayout {
                                            spacing: 4px;
                                            padding-left: msg.sticker ? 7px : 0;
                                            padding-right: msg.sticker ? 7px : 0;
                                            Text {
                                                text: msg.time;
                                                font-size: 10px;
                                                color: msg.fromMe ? Theme.time-out : Theme.text-dim;
                                                vertical-alignment: center;
                                            }
                                            if msg.ticks != "": Text {
                                                text: msg.ticks;
                                                font-size: 10px;
                                                font-weight: 700;
                                                color: msg.ticksBlue ? #53bdeb : Theme.time-out;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        // Hover actions, mirroring WhatsApp: react, forward
                        // and the message menu.
                        if row-hover.has-hover || root.react-bar-id == msg.id: Rectangle {
                            y: bubble.y + 4px;
                            x: msg.fromMe
                                ? max(0px, bubble.x - self.width - 6px)
                                : bubble.x + bubble.width + 6px;
                            width: 64px;
                            height: 28px;
                            HorizontalLayout {
                                spacing: 4px;
                                IconButton {
                                    icon: @image-url("icons/mood-smile.svg");
                                    icon-size: 17px;
                                    clicked => {
                                        root.react-bar-id =
                                            root.react-bar-id == msg.id ? "" : msg.id;
                                    }
                                }
                                IconButton {
                                    icon: @image-url("icons/corner-up-right.svg");
                                    icon-size: 17px;
                                    clicked => { root.request-forward(msg.id); }
                                }
                            }
                        }

                        // Quick reactions, the same set WhatsApp offers.
                        if root.react-bar-id == msg.id: Rectangle {
                            y: max(0px, bubble.y - 34px);
                            x: msg.fromMe
                                ? max(4px, bubble.x + bubble.width - self.width)
                                : bubble.x;
                            width: 214px;
                            height: 38px;
                            border-radius: 19px;
                            background: Theme.panel;
                            drop-shadow-blur: 8px;
                            drop-shadow-color: #00000030;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 2px;
                                for e in ["\u{1f44d}", "\u{2764}", "\u{1f602}",
                                          "\u{1f62e}", "\u{1f622}", "\u{1f64f}"]:
                                    Rectangle {
                                        width: 30px;
                                        emoji-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.react-to(msg.id, e);
                                                root.react-bar-id = "";
                                            }
                                        }
                                        Text {
                                            text: e;
                                            font-size: emoji-touch.has-hover ? 24px : 20px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: parent.width;
                                            height: parent.height;
                                        }
                                    }
                                Rectangle {
                                    width: 26px;
                                    plus-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.react-bar-id = "";
                                            root.react-pick(msg.id);
                                        }
                                    }
                                    Image {
                                        source: @image-url("icons/plus.svg");
                                        colorize: Theme.text-dim;
                                        width: 16px;
                                        height: 16px;
                                    }
                                }
                            }
                        }

                        if msg.reactions != "": Rectangle {
                            y: bubble.y + bubble.height - 4px;
                            x: msg.fromMe
                                ? bubble.x + bubble.width - self.width - 4px
                                : bubble.x + 4px;
                            width: react-text.preferred-width + 14px;
                            height: 21px;
                            border-radius: 10.5px;
                            background: Theme.pill;
                            border-width: 1.5px;
                            border-color: Theme.conv-bg;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.show-reactions(msg.id); }
                            }
                            react-text := Text {
                                text: msg.reactions;
                                font-size: 11px;
                                color: Theme.text;
                                width: parent.width;
                                height: parent.height;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                Rectangle { height: 10px; }

                if root.reply-open: Rectangle {
                    height: 58px;
                    background: Theme.header;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 6px;
                        spacing: 10px;
                        Rectangle {
                            horizontal-stretch: 1;
                            background: Theme.pill;
                            border-radius: 6px;
                            Rectangle {
                                x: 0;
                                width: 4px;
                                height: parent.height;
                                background: Theme.accent;
                            }
                            VerticalLayout {
                                padding-left: 12px;
                                padding-right: 8px;
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: root.reply-name;
                                    color: Theme.accent;
                                    font-size: 13px;
                                    font-weight: 700;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.reply-text;
                                    color: Theme.text-dim;
                                    font-size: 13px;
                                    overflow: elide;
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: @image-url("icons/x.svg");
                                clicked => { root.cancel-reply(); }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 62px;
                    background: Theme.header;

                    // Recording bar (replaces the composer while capturing)
                    HorizontalBox {
                        visible: root.rec-active;
                        padding: 11px;
                        spacing: 10px;
                        IconButton {
                            icon: @image-url("icons/trash.svg");
                            clicked => { root.rec-cancel(); }
                        }
                        Rectangle {
                            width: 10px;
                            height: 10px;
                            border-radius: 5px;
                            background: #f05d4d;
                            y: 26px;
                        }
                        Text {
                            text: root.rec-elapsed;
                            color: Theme.text;
                            font-size: 15px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        vo-touch := TouchArea {
                            width: 40px;
                            height: 40px;
                            mouse-cursor: pointer;
                            clicked => { root.rec-view-once = !root.rec-view-once; }
                            Rectangle {
                                width: parent.width;
                                height: parent.height;
                                border-radius: 8px;
                                background: root.rec-view-once ? Theme.chip-active-bg
                                    : vo-touch.has-hover ? Theme.hover : transparent;
                                Image {
                                    source: @image-url("icons/eye.svg");
                                    colorize: root.rec-view-once ? Theme.accent : Theme.icon;
                                    width: 22px;
                                    height: 22px;
                                    x: 9px;
                                    y: 9px;
                                }
                            }
                        }
                        IconButton {
                            icon: @image-url("icons/send-2.svg");
                            clicked => { root.rec-stop(); }
                        }
                    }

                    HorizontalBox {
                        visible: !root.rec-active;
                        padding: 11px;
                        spacing: 8px;
                        IconButton {
                            icon: @image-url("icons/plus.svg");
                            clicked => {
                                root.picker-open = false;
                                root.attach-open = !root.attach-open;
                            }
                        }
                        IconButton {
                            icon: @image-url("icons/mood-smile.svg");
                            clicked => {
                                root.attach-open = false;
                                root.picker-open = !root.picker-open;
                                if (root.picker-open) { root.picker-opened(); }
                            }
                        }
                        message-input := LineEdit {
                            placeholder-text: @tr("Type a message");
                            accepted => {
                                root.send-message(self.text);
                                self.text = "";
                            }
                        }
                        IconButton {
                            icon: @image-url("icons/microphone.svg");
                            clicked => { root.rec-start(); }
                        }
                        IconButton {
                            icon: @image-url("icons/send-2.svg");
                            clicked => {
                                root.send-message(message-input.text);
                                message-input.text = "";
                            }
                        }
                    }
                }
            }

            // Floating "jump to latest" button
            if root.chat-open && !root.stick-bottom: Rectangle {
                x: parent.width - self.width - 24px;
                y: parent.height - self.height - 86px;
                width: 42px;
                height: 42px;
                border-radius: 21px;
                background: Theme.panel;
                drop-shadow-blur: 6px;
                drop-shadow-color: #00000055;
                jump-touch := TouchArea {
                    mouse-cursor: pointer;
                    // Routed through the host so the jump is re-applied
                    // while late-growing rows settle.
                    clicked => { root.jump-latest(); }
                }
                Image {
                    source: @image-url("icons/chevron-right.svg");
                    colorize: Theme.icon;
                    width: 22px;
                    height: 22px;
                    x: 10px;
                    y: 10px;
                    transform-rotation: 90deg;
                }
            }

            // Emoji / sticker picker above the composer
            if root.picker-open && root.chat-open: Rectangle {
                x: 12px;
                y: parent.height - self.height - 74px;
                width: 380px;
                height: 320px;
                background: Theme.panel;
                border-radius: 10px;
                drop-shadow-blur: 8px;
                drop-shadow-color: #00000055;
                VerticalLayout {
                    padding: 10px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        FilterChip {
                            label: @tr("Emoji");
                            active: root.picker-tab == "emoji";
                            clicked => { root.picker-tab = "emoji"; }
                        }
                        FilterChip {
                            label: @tr("Stickers");
                            active: root.picker-tab == "sticker";
                            clicked => { root.picker-tab = "sticker"; }
                        }
                        FilterChip {
                            label: @tr("Favorites");
                            active: root.picker-tab == "fav";
                            clicked => { root.picker-tab = "fav"; }
                        }
                        FilterChip {
                            label: "GIF";
                            active: root.picker-tab == "gif";
                            clicked => { root.picker-tab = "gif"; }
                        }
                    }
                    if root.picker-tab == "emoji": ListView {
                        for row in root.emoji-rows: Rectangle {
                            height: 44px;
                            HorizontalLayout {
                                spacing: 2px;
                                alignment: start;
                                for e in row: em-touch := TouchArea {
                                    width: 42px;
                                    height: 42px;
                                    mouse-cursor: pointer;
                                    Rectangle {
                                        width: parent.width;
                                        height: parent.height;
                                        border-radius: 6px;
                                        background: em-touch.has-hover ? Theme.hover : transparent;
                                        Text {
                                            text: e;
                                            font-size: 24px;
                                            width: parent.width;
                                            height: parent.height;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    clicked => { root.emoji-pick(e); }
                                }
                            }
                        }
                    }
                    if root.picker-tab == "gif": VerticalLayout {
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 6px;
                            gif-input := LineEdit {
                                placeholder-text: @tr("Search GIFs");
                                accepted => { root.gif-search(self.text); }
                            }
                            IconButton {
                                icon: @image-url("icons/search.svg");
                                clicked => { root.gif-search(gif-input.text); }
                            }
                        }
                        if root.gif-hint != "": Text {
                            text: root.gif-hint;
                            color: Theme.text-dim;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        ListView {
                        for row in root.gif-rows: Rectangle {
                            height: 92px;
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                for cell in row: gif-touch := TouchArea {
                                    width: 84px;
                                    height: 84px;
                                    mouse-cursor: pointer;
                                    Rectangle {
                                        width: parent.width;
                                        height: parent.height;
                                        border-radius: 8px;
                                        clip: true;
                                        background: gif-touch.has-hover ? Theme.hover : transparent;
                                        if cell.ready: Image {
                                            source: cell.pic;
                                            width: parent.width;
                                            height: parent.height;
                                            image-fit: cover;
                                        }
                                    }
                                    clicked => {
                                        root.gif-send(cell.id);
                                        root.picker-open = false;
                                    }
                                }
                            }
                        }
                        }
                    }
                    if root.picker-tab == "fav" && root.fav-hint != "": Text {
                        text: root.fav-hint;
                        color: Theme.text-dim;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    if root.picker-tab == "fav": ListView {
                        for row in root.fav-rows: Rectangle {
                            height: 92px;
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                for cell in row: fav-touch := TouchArea {
                                    width: 84px;
                                    height: 84px;
                                    mouse-cursor: pointer;
                                    Rectangle {
                                        width: parent.width;
                                        height: parent.height;
                                        border-radius: 8px;
                                        background: fav-touch.has-hover ? Theme.hover : transparent;
                                        if cell.ready: Image {
                                            source: cell.pic;
                                            width: 76px;
                                            height: 76px;
                                            x: 4px;
                                            y: 4px;
                                            image-fit: contain;
                                        }
                                    }
                                    clicked => {
                                        root.sticker-send(cell.id);
                                        root.picker-open = false;
                                    }
                                }
                            }
                        }
                    }
                    if root.picker-tab == "sticker": ListView {
                        for row in root.sticker-rows: Rectangle {
                            height: 92px;
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                for cell in row: sk-touch := TouchArea {
                                    width: 84px;
                                    height: 84px;
                                    mouse-cursor: pointer;
                                    Rectangle {
                                        width: parent.width;
                                        height: parent.height;
                                        border-radius: 8px;
                                        background: sk-touch.has-hover ? Theme.hover : transparent;
                                        if cell.ready: Image {
                                            source: cell.pic;
                                            width: 76px;
                                            height: 76px;
                                            x: 4px;
                                            y: 4px;
                                            image-fit: contain;
                                        }
                                    }
                                    clicked => {
                                        root.sticker-send(cell.id);
                                        root.picker-open = false;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // WhatsApp-style attach menu popping above the composer
            if root.attach-open && root.chat-open: Rectangle {
                x: 12px;
                y: parent.height - self.height - 74px;
                width: 220px;
                height: menu-col.preferred-height + 16px;
                background: Theme.panel;
                border-radius: 10px;
                drop-shadow-blur: 8px;
                drop-shadow-color: #00000055;
                menu-col := VerticalLayout {
                    padding: 8px;
                    spacing: 2px;
                    MenuRow {
                        icon: @image-url("icons/file-text.svg");
                        label: @tr("Document");
                        clicked => { root.attach-open = false; root.attach-doc(); }
                    }
                    MenuRow {
                        icon: @image-url("icons/photo.svg");
                        label: @tr("Photos");
                        clicked => { root.attach-open = false; root.attach-image(); }
                    }
                    MenuRow {
                        icon: @image-url("icons/music.svg");
                        label: @tr("Audio");
                        clicked => { root.attach-open = false; root.attach-audio(); }
                    }
                    MenuRow {
                        icon: @image-url("icons/sticker-2.svg");
                        label: @tr("Sticker");
                        clicked => { root.attach-open = false; root.attach-sticker(); }
                    }
                }
            }
        }
    }
    } // capture-scope

    // ---------- Contact / group info ----------
    if root.info-open: Rectangle {
        background: #00000066;
        TouchArea { clicked => { root.close-info(); } }
        Rectangle {
            width: 400px;
            height: parent.height;
            x: parent.width - self.width;
            background: Theme.panel;
            TouchArea { }
            VerticalBox {
                padding: 0;
                spacing: 0;
                Rectangle {
                    height: 54px;
                    background: Theme.header;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 10px;
                        IconButton {
                            icon: @image-url("icons/x.svg");
                            clicked => { root.close-info(); }
                        }
                        Text {
                            text: root.info-is-group ? @tr("Group info") : @tr("Contact info");
                            color: Theme.text;
                            font-size: 16px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                }
                Flickable {
                    viewport-height: info-col.preferred-height;
                    viewport-width: self.width;
                    Rectangle {
                        height: info-col.preferred-height;
                        width: parent.width;
                        info-col := VerticalLayout {
                            width: parent.width;
                            padding: 20px;
                            spacing: 14px;
                            HorizontalLayout {
                                alignment: center;
                                Avatar {
                                    width: 140px;
                                    height: 140px;
                                    src: root.info-avatar;
                                    has-image: root.info-has-avatar;
                                    initial: root.info-initial;
                                    color-idx: root.info-color-idx;
                                }
                            }
                            Text {
                                text: root.info-name;
                                color: Theme.text;
                                font-size: 20px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                            if root.info-id != "": Text {
                                text: root.info-id;
                                color: Theme.text-dim;
                                font-size: 14px;
                                horizontal-alignment: center;
                            }
                            if root.info-members != "": Text {
                                text: root.info-members;
                                color: Theme.text-dim;
                                font-size: 14px;
                                horizontal-alignment: center;
                            }
                            if root.info-about != "" || root.info-desc != "": Text {
                                text: root.info-is-group ? @tr("Description") : @tr("About");
                                color: Theme.accent;
                                font-size: 13px;
                                font-weight: 700;
                            }
                            if root.info-about != "" || root.info-desc != "": Text {
                                text: root.info-is-group ? root.info-desc : root.info-about;
                                color: Theme.text;
                                font-size: 14px;
                                wrap: word-wrap;
                            }
                            if root.info-media.length > 0: Text {
                                text: @tr("Shared media");
                                color: Theme.accent;
                                font-size: 13px;
                                font-weight: 700;
                            }
                            for row in root.info-media: HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                for cell in row: Rectangle {
                                    width: 84px;
                                    height: 84px;
                                    border-radius: 8px;
                                    clip: true;
                                    background: Theme.hover;
                                    if cell.ready: Image {
                                        source: cell.pic;
                                        width: parent.width;
                                        height: parent.height;
                                        image-fit: cover;
                                    }
                                }
                            }
                            Rectangle { height: 6px; }
                            MenuRow {
                                icon: @image-url("icons/archive.svg");
                                label: root.info-archived ? @tr("Unarchive chat") : @tr("Archive chat");
                                clicked => { root.toggle-archive(); }
                            }
                            MenuRow {
                                icon: @image-url("icons/trash.svg");
                                label: @tr("Clear messages on this device");
                                clicked => { root.clear-chat(); }
                            }
                        }
                    }
                }
            }
        }
    }

    // ---------- Status viewer ----------
    if root.sv-open: Rectangle {
        background: #000000f0;
        TouchArea { clicked => { root.status-next(); } }
        VerticalLayout {
            padding: 20px;
            spacing: 12px;
            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: root.sv-name;
                    color: white;
                    font-size: 16px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Text {
                    text: root.sv-time + "  ·  " + root.sv-index + "/" + root.sv-count;
                    color: #b0b8bd;
                    font-size: 13px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                IconButton {
                    icon: @image-url("icons/x.svg");
                    clicked => { root.status-close(); }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                if root.sv-has-image: Image {
                    source: root.sv-image;
                    width: parent.width * 0.9;
                    height: parent.height * 0.94;
                    x: parent.width * 0.05;
                    y: parent.height * 0.03;
                    image-fit: contain;
                }
                if !root.sv-has-image: Rectangle {
                    width: parent.width * 0.7;
                    height: parent.height * 0.7;
                    x: parent.width * 0.15;
                    y: parent.height * 0.15;
                    background: Theme.accent;
                    border-radius: 14px;
                    Text {
                        text: root.sv-text;
                        color: white;
                        font-size: 24px;
                        wrap: word-wrap;
                        width: parent.width - 60px;
                        x: 30px;
                        height: parent.height;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                IconButton {
                    icon: @image-url("icons/chevron-left.svg");
                    x: 4px;
                    y: (parent.height - self.height) / 2;
                    clicked => { root.status-prev(); }
                }
                IconButton {
                    icon: @image-url("icons/chevron-right.svg");
                    x: parent.width - self.width - 4px;
                    y: (parent.height - self.height) / 2;
                    clicked => { root.status-next(); }
                }
            }
            if root.sv-has-image && root.sv-text != "": Text {
                text: root.sv-text;
                color: white;
                font-size: 14px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }

    // ---------- Forward picker ----------
    if root.alert-open: Rectangle {
        background: #000000aa;
        TouchArea { }
        Rectangle {
            width: 380px;
            height: alert-col.preferred-height + 44px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.panel;
            border-radius: 12px;
            alert-col := VerticalLayout {
                padding: 22px;
                spacing: 12px;
                width: parent.width;
                Text {
                    text: root.alert-title;
                    color: Theme.text;
                    font-size: 17px;
                    font-weight: 700;
                    wrap: word-wrap;
                    width: parent.width - 44px;
                }
                Text {
                    text: root.alert-text;
                    color: Theme.text-dim;
                    font-size: 14px;
                    wrap: word-wrap;
                    width: parent.width - 44px;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;
                    Rectangle {
                        width: dismiss-text.preferred-width + 28px;
                        height: 36px;
                        border-radius: 18px;
                        background: dismiss-touch.has-hover ? Theme.hover : transparent;
                        dismiss-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.alert-dismiss(); }
                        }
                        dismiss-text := Text {
                            text: @tr("Close");
                            color: Theme.text-dim;
                            font-size: 14px;
                            width: parent.width;
                            height: parent.height;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        width: retry-text.preferred-width + 32px;
                        height: 36px;
                        border-radius: 18px;
                        background: retry-touch.has-hover ? Theme.accent.darker(0.15) : Theme.accent;
                        retry-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.alert-retry(); }
                        }
                        retry-text := Text {
                            text: root.alert-action;
                            color: white;
                            font-size: 14px;
                            font-weight: 700;
                            width: parent.width;
                            height: parent.height;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    if root.reactions-open: Rectangle {
        background: #00000066;
        TouchArea { clicked => { root.reactions-open = false; } }
        Rectangle {
            width: 380px;
            height: min(440px, 108px + root.reaction-rows.length * 56px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.panel;
            border-radius: 12px;
            TouchArea { }
            VerticalBox {
                padding: 18px;
                spacing: 8px;
                HorizontalLayout {
                    Text {
                        text: root.reactions-title;
                        color: Theme.text;
                        font-size: 16px;
                        font-weight: 700;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    IconButton {
                        icon: @image-url("icons/x.svg");
                        clicked => { root.reactions-open = false; }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                ListView {
                    for r in root.reaction-rows: Rectangle {
                        height: 56px;
                        background: react-row.has-hover ? Theme.hover : transparent;
                        react-row := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.reactions-open = false;
                                root.open-dm(r.jid);
                            }
                        }
                        HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 4px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                Avatar {
                                    width: 40px;
                                    height: 40px;
                                    src: r.avatar;
                                    has-image: r.hasAvatar;
                                    initial: r.initial;
                                    color-idx: r.colorIdx;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: r.name;
                                    color: Theme.text;
                                    font-size: 15px;
                                    overflow: elide;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: r.emoji;
                                    font-size: 20px;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.forward-open: Rectangle {
        background: #000000aa;
        TouchArea { clicked => { root.forward-open = false; } }
        Rectangle {
            width: 420px;
            height: 540px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.panel;
            border-radius: 12px;
            TouchArea { }
            VerticalBox {
                padding: 18px;
                spacing: 10px;
                HorizontalLayout {
                    Text {
                        text: @tr("Forward message to");
                        color: Theme.text;
                        font-size: 17px;
                        font-weight: 700;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    IconButton {
                        icon: @image-url("icons/x.svg");
                        clicked => { root.forward-open = false; }
                    }
                }
                Rectangle {
                    height: 38px;
                    border-radius: 19px;
                    background: Theme.pill;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("icons/search.svg");
                                colorize: Theme.text-dim;
                                width: 16px;
                                height: 16px;
                            }
                        }
                        fwd-search := TextInput {
                            color: Theme.text;
                            font-size: 14px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            single-line: true;
                            edited => { root.forward-search(self.text); }
                        }
                    }
                    if fwd-search.text == "": Text {
                        text: @tr("Search name or number");
                        color: Theme.text-dim;
                        font-size: 14px;
                        x: 40px;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                }
                ListView {
                    for chat[i] in root.forward-rows: Rectangle {
                        height: 56px;
                        background: fwd-touch.has-hover ? Theme.hover : transparent;
                        border-radius: 8px;
                        fwd-touch := TouchArea {
                            clicked => { root.forward-to(chat.jid); }
                        }
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                Avatar {
                                    width: 40px;
                                    height: 40px;
                                    src: chat.avatar;
                                    has-image: chat.hasAvatar;
                                    initial: chat.initial;
                                    color-idx: chat.colorIdx;
                                }
                            }
                            Text {
                                text: chat.name;
                                color: Theme.text;
                                font-size: 14px;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }
                Rectangle {
                    height: 56px;
                    border-radius: 8px;
                    background: Theme.pill;
                    HorizontalLayout {
                        padding: 8px;
                        spacing: 10px;
                        if root.forward-preview-has-image: Image {
                            source: root.forward-preview-image;
                            width: 40px;
                            height: 40px;
                            image-fit: cover;
                            y: (parent.height - self.height) / 2;
                        }
                        Text {
                            text: root.forward-preview-text;
                            color: Theme.text-dim;
                            font-size: 13px;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
        }
    }

    // ---------- Settings overlay ----------
    if root.settings-open: Rectangle {
        background: #000000aa;
        TouchArea { clicked => { root.settings-open = false; } }
        Rectangle {
            width: 440px;
            // Never taller than the window: the body scrolls instead, so
            // the sections can keep growing.
            height: min(720px, parent.height - 48px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.panel;
            border-radius: 12px;
            TouchArea { }
            VerticalBox {
                padding: 24px;
                spacing: 13px;
                HorizontalLayout {
                    vertical-stretch: 0;
                    Text {
                        text: @tr("Settings");
                        color: Theme.text;
                        font-size: 20px;
                        font-weight: 700;
                        horizontal-stretch: 1;
                    }
                    IconButton {
                        icon: @image-url("icons/x.svg");
                        clicked => { root.settings-open = false; }
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                    spacing: 13px;
                    padding-right: 12px;
                Text {
                    text: @tr("Appearance");
                    color: Theme.accent;
                    font-size: 14px;
                    font-weight: 700;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    FilterChip {
                        label: @tr("Dark");
                        active: root.theme-mode == "dark";
                        clicked => { root.theme-mode = "dark"; root.theme-changed("dark"); }
                    }
                    FilterChip {
                        label: @tr("Light");
                        active: root.theme-mode == "light";
                        clicked => { root.theme-mode = "light"; root.theme-changed("light"); }
                    }
                    FilterChip {
                        label: @tr("System");
                        active: root.theme-mode == "system";
                        clicked => { root.theme-mode = "system"; root.theme-changed("system"); }
                    }
                }
                Text {
                    text: @tr("Language");
                    color: Theme.accent;
                    font-size: 14px;
                    font-weight: 700;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    FilterChip {
                        label: "Português";
                        active: root.language-mode == "pt";
                        clicked => { root.language-mode = "pt"; root.language-changed("pt"); }
                    }
                    FilterChip {
                        label: "English";
                        active: root.language-mode == "en";
                        clicked => { root.language-mode = "en"; root.language-changed("en"); }
                    }
                    FilterChip {
                        label: @tr("System");
                        active: root.language-mode == "system";
                        clicked => { root.language-mode = "system"; root.language-changed("system"); }
                    }
                }
                Text {
                    text: @tr("Startup");
                    color: Theme.accent;
                    font-size: 14px;
                    font-weight: 700;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    FilterChip {
                        label: @tr("Open Zapive when I sign in");
                        active: root.autostart;
                        clicked => { root.autostart-changed(!root.autostart); }
                    }
                }
                Text {
                    text: @tr("Calls");
                    color: Theme.accent;
                    font-size: 14px;
                    font-weight: 700;
                }
                Text {
                    text: @tr("Microphone");
                    color: Theme.text-dim;
                    font-size: 13px;
                }
                ComboBox {
                    model: root.mic-devices;
                    current-value: root.mic-device;
                    selected(value) => {
                        root.mic-device = value;
                        root.device-changed("mic", value);
                    }
                }
                Text {
                    text: @tr("Speaker");
                    color: Theme.text-dim;
                    font-size: 13px;
                }
                ComboBox {
                    model: root.speaker-devices;
                    current-value: root.speaker-device;
                    selected(value) => {
                        root.speaker-device = value;
                        root.device-changed("speaker", value);
                    }
                }
                Text {
                    text: @tr("Camera");
                    color: Theme.text-dim;
                    font-size: 13px;
                }
                ComboBox {
                    model: root.camera-devices;
                    current-value: root.camera-device;
                    selected(value) => {
                        root.camera-device = value;
                        root.device-changed("camera", value);
                    }
                }
                Text {
                    text: @tr("A device picked here is used for every call. Changes apply to the next call.");
                    color: Theme.text-dim;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Text {
                    text: @tr("Security");
                    color: Theme.accent;
                    font-size: 14px;
                    font-weight: 700;
                }
                Text {
                    text: root.pin-set
                        ? @tr("PIN enabled: the vault key requires your PIN and is bound to your Windows account (DPAPI).")
                        : @tr("Local data is always encrypted (key protected by your Windows account). Set a PIN to require unlocking on launch.");
                    color: Theme.text-dim;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                current-pin := LineEdit {
                    visible: root.pin-set;
                    input-type: password;
                    placeholder-text: @tr("Current PIN");
                }
                new-pin := LineEdit {
                    input-type: password;
                    placeholder-text: @tr("New PIN (4 to 10 digits)");
                }
                HorizontalLayout {
                    spacing: 10px;
                    Button {
                        text: root.pin-set ? @tr("Change PIN") : @tr("Set PIN");
                        primary: true;
                        clicked => {
                            root.save-pin(current-pin.text, new-pin.text);
                            new-pin.text = "";
                        }
                    }
                    Button {
                        visible: root.pin-set;
                        text: @tr("Remove PIN");
                        clicked => {
                            root.remove-pin(current-pin.text);
                            current-pin.text = "";
                        }
                    }
                }
                Text {
                    text: root.settings-status;
                    color: #ffbc38;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                Rectangle { height: 6px; }
                Text {
                    text: @tr("Account");
                    color: Theme.accent;
                    font-size: 14px;
                    font-weight: 700;
                }
                HorizontalLayout {
                    alignment: start;
                    logout-btn := TouchArea {
                        mouse-cursor: pointer;
                        width: lb.preferred-width + 28px;
                        height: 36px;
                        clicked => { root.logout(); }
                        lb := Text {
                            text: @tr("Log out of WhatsApp");
                            color: white;
                            font-size: 14px;
                            font-weight: 700;
                            x: 14px;
                            height: parent.height;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            width: parent.width;
                            height: parent.height;
                            border-radius: 8px;
                            background: logout-btn.has-hover ? #d9534f : #c9302c;
                            z: -1;
                        }
                    }
                }
                    }
                }
            }
        }
    }

    // ---------- Send-image preview ----------
    if root.preview-open: Rectangle {
        background: #000000d9;
        TouchArea { }
        VerticalLayout {
            padding: 28px;
            spacing: 14px;
            HorizontalLayout {
                alignment: start;
                IconButton {
                    icon: @image-url("icons/x.svg");
                    clicked => { root.cancel-send-image(); }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                Image {
                    source: root.preview-image;
                    width: parent.width * 0.9;
                    height: parent.height * 0.96;
                    x: parent.width * 0.05;
                    y: parent.height * 0.02;
                    image-fit: contain;
                }
            }
            HorizontalLayout {
                alignment: center;
                spacing: 10px;
                preview-caption := LineEdit {
                    width: 420px;
                    placeholder-text: @tr("Add a caption");
                    accepted => {
                        root.confirm-send-image(self.text);
                        self.text = "";
                    }
                }
                Button {
                    text: @tr("Send");
                    primary: true;
                    clicked => {
                        root.confirm-send-image(preview-caption.text);
                        preview-caption.text = "";
                    }
                }
            }
        }
    }

    // ---------- Video player ----------
    if root.video-open: Rectangle {
        background: #000000ee;
        TouchArea { }
        VerticalLayout {
            padding: 16px;
            spacing: 10px;
            HorizontalLayout {
                alignment: end;
                IconButton {
                    icon: @image-url("icons/x.svg");
                    clicked => { root.close-video(); }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                Image {
                    source: root.video-frame;
                    width: min(parent.width * 0.94, root.video-w * 1.6px);
                    height: self.width * root.video-h / max(root.video-w, 1);
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    image-fit: contain;
                }
            }
        }
    }

    // ---------- Lightbox ----------
    if root.lightbox-open: Rectangle {
        background: #000000e6;
        TouchArea { clicked => { root.lightbox-open = false; } }
        Image {
            source: root.lightbox-image;
            width: parent.width * 0.92;
            height: parent.height * 0.92;
            x: parent.width * 0.04;
            y: parent.height * 0.04;
            image-fit: contain;
        }
        IconButton {
            icon: @image-url("icons/x.svg");
            x: parent.width - self.width - 16px;
            y: 16px;
            clicked => { root.lightbox-open = false; }
        }
    }
}

// One round call button with its caption underneath.
component CallAction inherits TouchArea {
    in property <string> label;
    in property <image> icon;
    in property <color> tint;
    in property <color> icon-tint: #ffffff;
    // The hang-up glyph is the handset upside down.
    in property <bool> rotated: false;
    mouse-cursor: pointer;
    width: 74px;
    height: 92px;
    VerticalLayout {
        spacing: 8px;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 60px;
                height: 60px;
                border-radius: 30px;
                background: root.tint;
                opacity: root.has-hover ? 0.85 : 1.0;
                Image {
                    source: root.icon;
                    colorize: root.icon-tint;
                    width: 27px;
                    height: 27px;
                    transform-rotation: root.rotated ? 135deg : 0deg;
                }
            }
        }
        Text {
            text: root.label;
            color: Theme.text;
            font-size: 13px;
            horizontal-alignment: center;
        }
    }
}

// The call screen: a window of its own, the way WhatsApp Desktop puts
// calls outside the chat list. Incoming calls ring here instead of
// covering the conversation with a modal.
export component CallWindow inherits Window {
    // Not translated: the platform layer finds this window by its title.
    title: "Zapive Call";
    icon: @image-url("zapive.png");
    // Preferred, not fixed: a fixed width/height binding would override
    // the resize the host does when a call turns into a video one.
    preferred-width: 360px;
    preferred-height: 540px;
    background: Theme.dark ? #111b21 : #f0f2f5;
    init => {
        Theme.dark = root.dark-theme;
    }
    in-out property <bool> dark-theme: true;
    changed dark-theme => {
        Theme.dark = self.dark-theme;
    }

    // "incoming" | "outgoing" | "connecting" | "active" | "ended"
    in-out property <string> state: "incoming";
    in-out property <string> peer-name: "";
    in-out property <string> detail: "";
    in-out property <string> timer: "";
    in-out property <image> avatar;
    in-out property <bool> has-avatar: false;
    in-out property <string> initial: "";
    in-out property <int> color-idx: 0;
    in-out property <bool> muted: false;
    // Video: `video-call` means this call has a picture at all, `video-on`
    // is our own camera, `peer-video` is theirs, and `video-wanted` is the
    // peer asking us to switch ours on.
    in-out property <bool> video-call: false;
    in-out property <bool> video-on: false;
    in-out property <bool> peer-video: false;
    in-out property <bool> video-wanted: false;
    in-out property <image> remote-video;
    in-out property <bool> has-remote-video: false;
    in-out property <image> local-video;
    in-out property <bool> has-local-video: false;
    callback accept();
    callback decline();
    callback hangup();
    callback toggle-mute();
    callback toggle-video();

    // The peer's picture fills the window; the name and controls float on
    // top of it, the way WhatsApp lays a video call out.
    if root.has-remote-video: Image {
        source: root.remote-video;
        width: parent.width;
        height: parent.height;
        image-fit: contain;
    }
    // The self-view sits in the corner, small enough to stay out of the way.
    if root.has-local-video: Rectangle {
        width: 116px;
        height: 88px;
        x: parent.width - self.width - 16px;
        y: 16px;
        border-radius: 8px;
        clip: true;
        background: #000000;
        Image {
            source: root.local-video;
            width: parent.width;
            height: parent.height;
            image-fit: cover;
        }
    }

    // Video is bright and busy; the name needs its own ground to stay
    // readable on top of it.
    if root.has-remote-video: Rectangle {
        width: parent.width;
        height: 110px;
        // Without an explicit y a child is centred, which put this
        // gradient's hard edge across the middle of the picture.
        y: 0;
        background: @linear-gradient(180deg, #000000b0 0%, #00000000 100%);
    }
    if root.has-remote-video: Rectangle {
        width: parent.width;
        height: 150px;
        y: parent.height - self.height;
        background: @linear-gradient(0deg, #000000b0 0%, #00000000 100%);
    }

    VerticalLayout {
        padding: 28px;
        spacing: 16px;

        Rectangle { vertical-stretch: root.has-remote-video ? 0 : 1; }
        Text {
            text: root.peer-name;
            color: root.has-remote-video ? #ffffff : Theme.text;
            font-size: 26px;
            font-weight: 700;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        Text {
            text: root.timer != "" ? root.timer : root.detail;
            color: root.has-remote-video ? #d0d8dc : Theme.text-dim;
            font-size: 14px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if !root.has-remote-video: HorizontalLayout {
            alignment: center;
            Avatar {
                width: 160px;
                height: 160px;
                src: root.avatar;
                has-image: root.has-avatar;
                initial: root.initial;
                color-idx: root.color-idx;
            }
        }
        // Pushes the controls to the bottom edge of the picture.
        Rectangle { vertical-stretch: 1; }

        // Ringing: decline on the left, answer on the right, as on the
        // phone. Everything else gets mute plus a single hang-up.
        HorizontalLayout {
            alignment: center;
            spacing: root.state == "incoming" ? 44px : 12px;
            if root.state == "incoming": CallAction {
                label: @tr("Decline");
                icon: @image-url("icons/phone.svg");
                tint: #ea0038;
                rotated: true;
                clicked => { root.decline(); }
            }
            if root.state == "incoming": CallAction {
                label: @tr("Accept");
                icon: root.video-call
                    ? @image-url("icons/video.svg")
                    : @image-url("icons/phone.svg");
                tint: #00a884;
                clicked => { root.accept(); }
            }
            // The camera can only be switched once the call is up. It
            // lights up when the peer has asked for video.
            if root.state == "active": CallAction {
                label: root.video-on ? @tr("Stop video") : @tr("Video");
                icon: @image-url("icons/video.svg");
                tint: root.video-wanted
                    ? #00a884
                    : (root.video-on ? #2a3942 : (Theme.dark ? #2a3942 : #d1d7db));
                icon-tint: root.video-wanted || root.video-on ? #ffffff : Theme.text;
                clicked => { root.toggle-video(); }
            }
            // Muting only means something once the media plane is up.
            if root.state == "active": CallAction {
                label: root.muted ? @tr("Unmute") : @tr("Mute");
                icon: @image-url("icons/microphone.svg");
                tint: root.muted ? #ea0038 : (Theme.dark ? #2a3942 : #d1d7db);
                icon-tint: root.muted ? #ffffff : Theme.text;
                clicked => { root.toggle-mute(); }
            }
            if root.state != "incoming" && root.state != "ended": CallAction {
                label: @tr("End");
                icon: @image-url("icons/phone.svg");
                tint: #ea0038;
                rotated: true;
                clicked => { root.hangup(); }
            }
        }
    }
}
