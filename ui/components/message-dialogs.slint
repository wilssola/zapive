import { ListView, ScrollView, VerticalBox } from "std-widgets.slint";
import { KeyFocus, FocusRing } from "a11y.slint";
import { Avatar } from "avatar.slint";
import { DialogButton } from "dialog-button.slint";
import { EmojiText } from "emoji.slint";
import { IconButton } from "icon-button.slint";
import { Ticks } from "message-parts.slint";
import { ModalLayer } from "modal.slint";
import { Theme } from "theme.slint";
import { DetailRow, ReactionItem, ReactionTab } from "types.slint";

export component DetailsLayer inherits ModalLayer {
    in-out property <bool> details-open;
    in property <string> details-text;
    in property <image> details-image;
    in property <bool> details-has-image;
    in property <[DetailRow]> details-rows;
    in property <length> win-width;

    if root.mounted: Rectangle {
        width: 100%;
        height: 100%;
        FocusScope {
            init => { self.focus(); }
            key-pressed(e) => {
                if (e.text == Key.Escape) { root.details-open = false; return accept; }
                return reject;
            }
        }
        Rectangle {
            width: min(336px, root.win-width);
            height: parent.height;
            x: parent.width - self.width + (1 - root.progress) * self.width;
            opacity: root.progress;
            background: Theme.panel;
            backdrop-blur: 0px;
            border-width: 1px;
            border-color: Theme.border;
            TouchArea { }
            VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: 64px;
                    background: Theme.header;
                    HorizontalLayout {
                        padding: 16px;
                        Text { text: @tr("msg.details.title"); color: Theme.text; font-size: 17px; font-weight: 600; vertical-alignment: center; }
                        Rectangle {
                            width: 28px;
                            Text { text: "×"; color: Theme.text-dim; font-size: 26px; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea {
                                accessible-role: button;
                                accessible-label: @tr("common.action.close");
                                accessible-action-default => { root.details-open = false; }
                                clicked => { root.details-open = false; }
                                KeyFocus { activate => { root.details-open = false; } }
                            }
                        }
                    }
                }
                ScrollView {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;
                        Rectangle {
                            border-radius: 10px;
                            background: Theme.bubble-in;
                            height: details-preview.preferred-height;
                            details-preview := VerticalLayout {
                                padding: 12px;
                                spacing: 8px;
                                if root.details-has-image: Image {
                                    source: root.details-image;
                                    height: 154px;
                                    image-fit: contain;
                                }
                                Text { text: root.details-text; color: Theme.text; wrap: word-wrap; }
                            }
                        }
                        for row in root.details-rows: Rectangle {
                            background: row.kind == "status" ? Theme.bubble-in : transparent;
                            border-radius: 8px;
                            height: row.kind == "person" ? 38px : row.kind == "participant-heading" ? 28px : detail-content.preferred-height;
                            detail-content := HorizontalLayout {
                                padding: row.kind == "heading" || row.kind == "person" || row.kind == "participant-heading" ? 0px : 10px;
                                spacing: row.kind == "person" ? 8px : 10px;
                                alignment: start;
                                if row.kind == "person": Avatar {
                                    width: 28px; height: 28px;
                                    vertical-stretch: 0;
                                    src: row.avatar; has-image: row.hasAvatar;
                                    initial: row.initial; color-idx: row.colorIdx;
                                }
                                if row.kind == "status" || row.kind == "participant-heading": Ticks {
                                    ticks: row.ticks; blue: row.blue;
                                    vertical-stretch: 0;
                                }
                                if row.kind == "version": Rectangle {
                                    width: 10px;
                                    background: transparent;
                                    Rectangle { x: 4px; width: 2px; height: parent.height; background: Theme.accent; }
                                    Rectangle { y: 4px; width: 10px; height: 10px; border-radius: 5px; background: Theme.accent; }
                                }
                                VerticalLayout {
                                    spacing: row.kind == "person" ? 1px : 5px;
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: row.title;
                                        color: row.kind == "participant-heading" ? Theme.text-dim : row.kind == "heading" ? Theme.accent : Theme.text;
                                        font-size: row.kind == "heading" ? 14px : row.kind == "person" ? 12px : 13px;
                                        horizontal-alignment: left;
                                        font-weight: row.kind == "heading" || row.kind == "version" || row.kind == "person" ? 600 : 400;
                                        wrap: row.kind == "person" ? no-wrap : word-wrap;
                                        overflow: elide;
                                    }
                                    if row.text != "": Text { text: row.text; color: Theme.text; wrap: word-wrap; font-size: 13px; }
                                    if row.time != "": Text { text: row.time; color: Theme.text-dim; wrap: word-wrap; font-size: 11px; horizontal-alignment: left; }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component MessageDialogLayer inherits ModalLayer {
    callback submit-edit(string, string);
    // Splices a line break into the text (Slint's TextInput ignores Ctrl+Enter).
    callback edit-newline(string, int, int) -> string;
    in-out property <bool> message-dialog-open;
    in property <bool> message-dialog-edit;
    in property <string> message-dialog-title;
    in-out property <string> message-dialog-text;
    in property <string> message-dialog-id;
    in property <length> win-width;
    property <int> max-chars: 4096;
    property <bool> can-save: root.message-dialog-text.character-count > 0
        && root.message-dialog-text.character-count <= root.max-chars;

    if root.mounted: Rectangle {
        width: 100%;
        height: 100%;
        FocusScope {
            init => { self.focus(); }
            key-pressed(e) => {
                if (e.text == Key.Escape) { root.message-dialog-open = false; return accept; }
                return reject;
            }
        }
        Rectangle {
            width: min(root.message-dialog-edit ? 520px : 480px, root.win-width - 32px);
            height: (root.message-dialog-edit ? edit-col.preferred-height : message-dialog-col.preferred-height) + 40px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 20px;
            opacity: root.progress;
            transform-scale: 0.96 + 0.04 * root.progress;
            background: Theme.panel;
            backdrop-blur: 0px;
            border-width: Theme.glass ? 1px : 0px;
            border-color: Theme.glass-rim;
            if Theme.glass: Rectangle {
                border-radius: parent.border-radius;
                background: Theme.glass-sheen;
            }
            TouchArea { }
            message-dialog-col := VerticalLayout {
                visible: !root.message-dialog-edit;
                padding: 20px;
                spacing: 14px;
                Text { text: root.message-dialog-title; color: Theme.text; font-size: 18px; }
                Text {
                    text: root.message-dialog-text;
                    color: Theme.text-dim;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    DialogButton {
                        label: @tr("common.action.close");
                        clicked => { root.message-dialog-open = false; }
                    }
                }
            }
            edit-col := VerticalLayout {
                visible: root.message-dialog-edit;
                padding: 24px;
                spacing: 18px;
                HorizontalLayout {
                    spacing: 14px;
                    Rectangle {
                        width: 44px;
                        height: 44px;
                        border-radius: 14px;
                        background: Theme.accent.with-alpha(0.18);
                        Image {
                            width: 22px;
                            height: 22px;
                            source: @image-url("../icons/edit.svg");
                            colorize: Theme.accent-text;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: @tr("message.dialog.edit_title");
                            color: Theme.text;
                            font-size: 18px;
                            font-weight: 700;
                            overflow: elide;
                        }
                        Text {
                            text: @tr("message.dialog.edit_subtitle");
                            color: Theme.text-dim;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }
                    VerticalLayout {
                        alignment: start;
                        IconButton {
                            label: @tr("common.action.close");
                            icon: @image-url("../icons/x.svg");
                            clicked => { root.message-dialog-open = false; }
                        }
                    }
                }
                Rectangle {
                    height: 170px;
                    border-radius: 16px;
                    background: Theme.field;
                    border-width: 1px;
                    border-color: edit-input.has-focus ? Theme.accent : Theme.field-border;
                    animate border-color { duration: Theme.motion-fast; easing: ease-out; }
                    edit-scroll := Flickable {
                        x: 16px;
                        y: 14px;
                        width: parent.width - 32px;
                        height: parent.height - 48px;
                        content-height: max(self.height, edit-input.preferred-height);
                        content-width: self.width;
                        interactive: true;
                        edit-input := TextInput {
                            accessible-label: @tr("message.dialog.edit_title");
                            width: parent.width;
                            height: max(parent.height, self.preferred-height);
                            text <=> root.message-dialog-text;
                            color: Theme.text;
                            font-size: 15px;
                            single-line: false;
                            wrap: word-wrap;
                            vertical-alignment: top;
                            selection-background-color: Theme.selection;
                            selection-foreground-color: white;
                            // TextInput never scrolls itself into view.
                            cursor-position-changed(pos) => {
                                if (pos.y < -edit-scroll.content-y) {
                                    edit-scroll.content-y = -pos.y;
                                } else if (pos.y + self.font-size * 1.4
                                        > -edit-scroll.content-y + edit-scroll.height) {
                                    edit-scroll.content-y =
                                        edit-scroll.height - pos.y - self.font-size * 1.4;
                                }
                            }
                            init => {
                                if (!root.message-dialog-edit) { return; }
                                self.focus();
                                // Opens with the caret after the last character.
                                self.set-selection-offsets(1000000000, 1000000000);
                            }
                            key-pressed(e) => {
                                if (e.text == Key.Escape) {
                                    root.message-dialog-open = false;
                                    return accept;
                                }
                                if (e.text == Key.Return && e.modifiers.control) {
                                    let at = min(self.cursor-position-byte-offset, self.anchor-position-byte-offset);
                                    self.text = root.edit-newline(self.text, self.anchor-position-byte-offset, self.cursor-position-byte-offset);
                                    self.set-selection-offsets(at + 1, at + 1);
                                    return accept;
                                }
                                if (e.text == Key.Return && !e.modifiers.shift) {
                                    if (root.can-save) {
                                        root.submit-edit(root.message-dialog-id, root.message-dialog-text);
                                    }
                                    return accept;
                                }
                                return reject;
                            }
                        }
                    }
                    Text {
                        x: parent.width - self.width - 16px;
                        y: parent.height - self.height - 10px;
                        text: @tr("message.dialog.counter", root.message-dialog-text.character-count);
                        color: root.message-dialog-text.character-count > root.max-chars ? Theme.danger : Theme.text-dim;
                        font-size: 12px;
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;
                    DialogButton {
                        label: @tr("message.dialog.cancel");
                        clicked => { root.message-dialog-open = false; }
                    }
                    DialogButton {
                        label: @tr("message.dialog.save_changes");
                        primary: true;
                        enabled: root.can-save;
                        opacity: self.enabled ? 1 : 0.5;
                        clicked => { root.submit-edit(root.message-dialog-id, root.message-dialog-text); }
                    }
                }
            }
        }
    }
}

export component ConfirmLayer inherits ModalLayer {
    in-out property <bool> confirm-open;
    in property <string> confirm-title;
    in property <string> confirm-text;
    in property <string> confirm-action;
    in property <string> confirm-secondary;
    callback confirm-accept();
    callback confirm-other();

    if root.mounted: Rectangle {
        opacity: root.progress;
        transform-scale: 0.96 + 0.04 * root.progress;
        width: 400px;
        height: confirm-col.preferred-height + 44px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.panel;
        backdrop-blur: 0px;
        border-width: Theme.glass ? 1px : 0px;
        border-color: Theme.glass-rim;
        if Theme.glass: Rectangle {
            border-radius: parent.border-radius;
            background: Theme.glass-sheen;
        }
        border-radius: 20px;
        TouchArea { }
        confirm-col := VerticalLayout {
            padding: 22px;
            spacing: 14px;
            width: parent.width;
            Text {
                text: root.confirm-title;
                color: Theme.text;
                font-size: 17px;
                font-weight: 700;
                wrap: word-wrap;
                width: parent.width - 44px;
            }
            Text {
                text: root.confirm-text;
                color: Theme.text-dim;
                font-size: 14px;
                wrap: word-wrap;
                width: parent.width - 44px;
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                DialogButton {
                    label: @tr("message.confirm.cancel");
                    clicked => { root.confirm-open = false; }
                }
                if root.confirm-secondary != "": DialogButton {
                    label: root.confirm-secondary;
                    clicked => { root.confirm-other(); }
                }
                DialogButton {
                    label: root.confirm-action;
                    primary: true;
                    danger: true;
                    clicked => { root.confirm-accept(); }
                }
            }
        }
    }
}

export component ReactionsLayer inherits ModalLayer {
    in property <[ReactionItem]> reaction-rows;
    in property <[ReactionTab]> reaction-tabs;
    in property <string> reactions-title;
    in-out property <bool> reactions-open;
    callback open-dm(string);
    callback remove-own-reaction();
    // "" = All, otherwise the emoji of the selected tab.
    property <string> active-tab: "";
    changed open => { if (!root.open) { root.active-tab = ""; } }

    if root.mounted: Rectangle {
        opacity: root.progress;
        transform-scale: 0.96 + 0.04 * root.progress;
        width: 380px;
        height: min(480px, 108px + (root.reaction-tabs.length > 0 ? 44px : 0px) + root.reaction-rows.length * 56px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.panel;
        backdrop-blur: 0px;
        border-width: Theme.glass ? 1px : 0px;
        border-color: Theme.glass-rim;
        if Theme.glass: Rectangle {
            border-radius: parent.border-radius;
            background: Theme.glass-sheen;
        }
        border-radius: 20px;
        TouchArea { }
        VerticalBox {
            padding: 18px;
            spacing: 8px;
            HorizontalLayout {
                Text {
                    text: root.reactions-title;
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 700;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                IconButton {
                    label: @tr("common.action.close");
                    icon: @image-url("../icons/x.svg");
                    clicked => { root.reactions-open = false; }
                }
            }
            if root.reaction-tabs.length > 0: HorizontalLayout {
                spacing: 6px;
                height: 34px;
                alignment: start;
                Rectangle {
                    width: all-label.preferred-width + 22px;
                    border-radius: 17px;
                    background: root.active-tab == "" ? Theme.chip-active-bg : (all-touch.has-hover ? Theme.hover : Theme.chip-bg);
                    border-width: 1px;
                    border-color: root.active-tab == "" ? Theme.chip-active-border : Theme.glass ? Theme.glass-rim-soft : Theme.border;
                    all-touch := TouchArea {
                        mouse-cursor: pointer;
                        accessible-role: button;
                        clicked => { root.active-tab = ""; }
                    }
                    all-label := Text {
                        text: @tr("reactions.tab_all", root.reaction-rows.length);
                        color: Theme.text;
                        font-size: 13px;
                        font-weight: root.active-tab == "" ? 700 : 500;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                for tab in root.reaction-tabs: Rectangle {
                    width: tab-row.preferred-width + 22px;
                    border-radius: 17px;
                    background: root.active-tab == tab.emoji ? Theme.chip-active-bg : (tab-touch.has-hover ? Theme.hover : Theme.chip-bg);
                    border-width: 1px;
                    border-color: root.active-tab == tab.emoji ? Theme.chip-active-border : Theme.glass ? Theme.glass-rim-soft : Theme.border;
                    tab-touch := TouchArea {
                        mouse-cursor: pointer;
                        accessible-role: button;
                        accessible-label: tab.emoji;
                        clicked => { root.active-tab = tab.emoji; }
                    }
                    tab-row := HorizontalLayout {
                        alignment: center;
                        spacing: 5px;
                        EmojiText { text: tab.emoji; font-size: 15px; }
                        Text {
                            text: tab.count;
                            color: Theme.text;
                            font-size: 13px;
                            font-weight: root.active-tab == tab.emoji ? 700 : 500;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                alignment: start;
                for r in root.reaction-rows: Rectangle {
                    visible: root.active-tab == "" || r.emoji == root.active-tab;
                    height: root.active-tab == "" || r.emoji == root.active-tab ? 56px : 0px;
                    clip: true;
                    background: react-row.has-hover ? Theme.hover : transparent;
                    react-row := TouchArea {
                        accessible-role: button;
                        accessible-label: r.name + " " + r.emoji + (r.own ? ", " + @tr("reactions.click_to_remove") : "");
                        accessible-action-default => { if (r.own) { root.reactions-open = false; root.remove-own-reaction(); } else { root.reactions-open = false; root.open-dm(r.jid); } }
                        mouse-cursor: pointer;
                        clicked => {
                            if (r.own) {
                                root.reactions-open = false;
                                root.remove-own-reaction();
                            } else {
                                root.reactions-open = false;
                                root.open-dm(r.jid);
                            }
                        }
                        react-key := KeyFocus {
                            activate => { if (r.own) { root.reactions-open = false; root.remove-own-reaction(); } else { root.reactions-open = false; root.open-dm(r.jid); } }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 4px;
                        padding-right: 4px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Avatar {
                                width: 40px;
                                height: 40px;
                                src: r.avatar;
                                has-image: r.hasAvatar;
                                initial: r.initial;
                                color-idx: r.colorIdx;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: r.name;
                                color: Theme.text;
                                font-size: 15px;
                                overflow: elide;
                            }
                            if r.own: Text {
                                text: @tr("reactions.click_to_remove");
                                color: Theme.text-dim;
                                font-size: 12px;
                                overflow: elide;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            EmojiText {
                                text: r.emoji;
                                font-size: 20px;
                            }
                        }
                    }
                }
                }
            }
        }
    }
}
