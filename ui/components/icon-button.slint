import { Theme } from "theme.slint";
import { KeyFocus, FocusRing } from "a11y.slint";

// Small bubble shown by `Tooltip` on hover.
export component TipBubble inherits Rectangle {
    in property <string> text;
    width: min(320px, tip-text.preferred-width + 20px);
    height: tip-text.preferred-height + 12px;
    background: Theme.header;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: 6px;
    tip-text := Text {
        x: 10px;
        y: 6px;
        width: parent.width - 20px;
        text: root.text;
        color: Theme.text;
        font-size: 12px;
        wrap: word-wrap;
    }
}

export component IconButton inherits TouchArea {
    // Hover tooltip; empty = none.
    in property <string> tip;
    in property <image> icon;
    in property <bool> active: false;
    in property <length> icon-size: 22px;
    in property <color> tint: Theme.icon;
    in property <brush> background: transparent;
    in property <brush> active-background: Theme.selected;
    // Shown while hovered; the icon follows `hover-tint`.
    in property <brush> hover-background: Theme.hover;
    in property <color> hover-tint: root.tint;
    in property <length> radius: 8px;
    in property <int> badge-count: 0;
    in property <bool> badge-dot: false;
    in property <color> badge-border: Theme.sidebar;
    width: 40px;
    height: 40px;
    mouse-cursor: pointer;
    in property <string> label;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    forward-focus: key-focus;
    key-focus := KeyFocus {
        enabled: root.enabled;
        activate => { root.clicked(); }
    }
    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: root.radius;
        background: root.active ? root.active-background : root.has-hover ? root.hover-background : root.background;
        opacity: root.pressed ? 0.82 : 1;
        animate background, opacity { duration: Theme.motion-normal; easing: ease-in-out; }
        Image {
            source: root.icon;
            colorize: root.has-hover ? root.hover-tint : root.tint;
            animate colorize { duration: Theme.motion-normal; easing: ease-in-out; }
            width: root.icon-size;
            height: root.icon-size;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }
    if root.badge-count > 0 || root.badge-dot: Rectangle {
        x: parent.width - self.width + 2px;
        y: -2px;
        width: root.badge-count > 0 ? max(20px, badge-label.preferred-width + 8px) : 10px;
        height: root.badge-count > 0 ? 20px : 10px;
        border-radius: self.height / 2;
        border-width: 2px;
        border-color: root.badge-border;
        background: Theme.accent;
        badge-label := Text {
            text: root.badge-count > 99 ? "99+" : root.badge-count > 0 ? root.badge-count : "";
            color: #ffffff;
            font-size: 10px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    FocusRing {
        width: parent.width;
        height: parent.height;
        border-radius: root.radius;
        shown: key-focus.has-focus;
    }
    if root.tip != "": Tooltip {
        TipBubble { text: root.tip; }
    }
}
