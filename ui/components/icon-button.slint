import { Theme } from "theme.slint";

export component IconButton inherits TouchArea {
    in property <image> icon;
    in property <bool> active: false;
    in property <length> icon-size: 22px;
    in property <color> tint: Theme.icon;
    in property <brush> background: transparent;
    in property <brush> active-background: Theme.selected;
    in property <length> radius: 8px;
    in property <int> badge-count: 0;
    in property <bool> badge-dot: false;
    in property <color> badge-border: Theme.sidebar;
    width: 40px;
    height: 40px;
    mouse-cursor: pointer;
    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: root.radius;
        background: root.active ? root.active-background : root.has-hover ? Theme.hover : root.background;
        opacity: root.pressed ? 0.82 : 1;
        animate background, opacity { duration: Theme.motion-fast; easing: ease-out; }
        Image {
            source: root.icon;
            colorize: root.tint;
            width: root.icon-size;
            height: root.icon-size;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }
    if root.badge-count > 0 || root.badge-dot: Rectangle {
        x: parent.width - self.width + 2px;
        y: -2px;
        width: root.badge-count > 0 ? max(20px, badge-label.preferred-width + 8px) : 10px;
        height: root.badge-count > 0 ? 20px : 10px;
        border-radius: self.height / 2;
        border-width: 2px;
        border-color: root.badge-border;
        background: Theme.accent;
        badge-label := Text {
            text: root.badge-count > 99 ? "99+" : root.badge-count > 0 ? root.badge-count : "";
            color: #ffffff;
            font-size: 10px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
