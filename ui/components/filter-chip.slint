import { Theme } from "theme.slint";

export component FilterChip inherits TouchArea {
    in property <string> label;
    in property <bool> active: false;
    mouse-cursor: pointer;
    width: chip.preferred-width;
    height: 30px;
    chip := Rectangle {
        height: parent.height;
        border-radius: 15px;
        background: root.active ? Theme.chip-active-bg : Theme.chip-bg;
        HorizontalLayout {
            padding-left: 13px;
            padding-right: 13px;
            Text {
                text: root.label;
                color: root.active ? Theme.accent : Theme.text-dim;
                font-size: 13px;
                vertical-alignment: center;
            }
        }
    }
}
