import { Theme } from "theme.slint";

export component FilterChip inherits TouchArea {
    in property <string> label;
    in property <int> count: 0;
    in property <bool> active: false;
    mouse-cursor: pointer;
    width: chip.preferred-width;
    height: 28px;
    chip := Rectangle {
        height: parent.height;
        border-radius: 14px;
        border-width: 1px;
        border-color: root.active ? (Theme.dark ? #239b66 : Theme.accent) : Theme.border;
        background: root.active ? (Theme.dark ? #164737 : Theme.chip-active-bg)
            : root.has-hover ? Theme.selected : Theme.chip-bg;
        opacity: root.pressed ? 0.84 : 1;
        animate background, border-color, opacity { duration: Theme.motion-fast; easing: ease-out; }
        HorizontalLayout {
            padding-left: 11px;
            padding-right: 11px;
            spacing: 5px;
            Text {
                text: root.label;
                color: root.active ? (Theme.dark ? #c5f1db : Theme.accent) : Theme.text-dim;
                font-size: 11px;
                font-weight: root.active ? 600 : 400;
                vertical-alignment: center;
            }
            if root.count > 0: Text {
                text: root.count;
                color: root.active ? (Theme.dark ? #c5f1db : Theme.accent) : Theme.text-dim;
                font-size: 11px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }
}
