export struct ReleaseItem {
    tag: string,
    date: string,
    notes: string,
    installed: bool,
    newer: bool,
}

export struct DetailRow {
    kind: string,
    title: string,
    text: string,
    time: string,
    avatar: image,
    hasAvatar: bool,
    initial: string,
    colorIdx: int,
    blue: bool,
    ticks: string,
}

export struct ChatItem {
    jid: string,
    name: string,
    preview: string,
    typing: bool,
    draft: bool,
    ticks: string,
    ticksBlue: bool,
    time: string,
    avatar: image,
    hasAvatar: bool,
    initial: string,
    colorIdx: int,
    unread: int,
    mentioned: bool,
    pinned: bool,
    muted: bool,
}

// A message found by search, in the sidebar (name = chat) or inside the
// open conversation (name = author).
export struct SearchHit {
    jid: string,
    // Whose picture the row shows (the author inside a chat).
    face: string,
    id: string,
    name: string,
    sender: string,
    snippet: string,
    time: string,
    avatar: image,
    hasAvatar: bool,
    initial: string,
    colorIdx: int,
}

export struct MemberItem {
    jid: string,
    name: string,
    number: string,
    avatar: image,
    hasAvatar: bool,
    initial: string,
    colorIdx: int,
    checked: bool,
    admin: bool,
}

// One page of the open PDF, laid out by the host (viewer coordinates).
export struct PdfPage {
    index: int,
    y: float,
    w: float,
    h: float,
    pic: image,
    ready: bool,
}

export struct LabelItem {
    id: string,
    name: string,
    active: bool,
}

export struct ReactionItem {
    jid: string,
    name: string,
    emoji: string,
    avatar: image,
    hasAvatar: bool,
    initial: string,
    colorIdx: int,
}

export struct CallItem {
    id: string,
    from: string,
    name: string,
    detail: string,
    time: string,
    avatar: image,
    hasAvatar: bool,
    initial: string,
    colorIdx: int,
    video: bool,
    group: bool,
}

// A link (or mention) inside a styled bubble: byte offsets into `plain`.
export struct LinkSpan {
    start: int,
    end: int,
}

// One linked account, for the switcher.
export struct AccountItem {
    id: string,
    name: string,
    // The phone number, when the name is something else.
    detail: string,
    initial: string,
    colorIdx: int,
    avatar: image,
    hasAvatar: bool,
    active: bool,
}

export struct StickerCell {
    id: string,
    pic: image,
    ready: bool,
}

export struct MessageItem {
    sendState: string,
    sendPending: bool,
    sendRetry: bool,
    id: string,
    kind: string,          // "text" | "image" | "audio" | "doc"
    text: string,          // body, caption, filename or audio duration
    fromMe: bool,
    sender: string,
    senderJid: string,
    showSender: bool,
    firstOfRun: bool,
    forwarded: bool,
    deleted: bool,
    // The sender revoked this message but it was kept ("apply deletions"
    // off); shown as a small indicator, unlike `deleted` which replaces
    // the whole bubble with "This message was deleted".
    revoked: bool,
    starred: bool,
    pinned: bool,
    editable: bool,
    privateReply: bool,
    hasQuote: bool,
    quoteName: string,
    quoteText: string,
    quoteId: string,
    quoteJid: string,
    time: string,
    picture: image,
    picW: int,
    picH: int,
    mediaPath: string,
    mediaReady: bool,
    mediaLoading: bool,
    // Download percentage: -1 means unknown; otherwise 0..100.
    mediaProgress: float,
    // Media the user has to ask for: the bubble shows its kind, its size
    // and (once accepted) the download progress instead of opening it.
    mediaOffer: bool,
    // "Image", "Video", "Audio", "Document": what the offer is about.
    mediaKind: string,
    // Formatted file size (KB / MB), empty when unavailable.
    mediaSize: string,
    documentType: string,
    reactions: string,
    reactionCount: string,
    dayLabel: string,
    unread-boundary: bool,
    ticks: string,
    ticksBlue: bool,
    senderAvatar: image,
    senderHasAvatar: bool,
    senderInitial: string,
    senderColorIdx: int,
    voiceMessage: bool,
    audioFilename: string,
    voiceJid: string,
    voiceAvatar: image,
    voiceHasAvatar: bool,
    voiceInitial: string,
    voiceColorIdx: int,
    groupIndent: bool,
    showAvatar: bool,
    senderNumber: string,
    senderLabel: string,
    sticker: bool,
    gif: bool,
    // "1:23" on a video bubble; empty for GIFs.
    videoLen: string,
    styled: styled-text,
    hasStyled: bool,
    // The styled text as drawn, for the selectable overlay.
    plain: string,
    // Where its links are, for the hand cursor.
    links: [LinkSpan],
    linkTitle: string,
    linkDesc: string,
    linkHost: string,
    linkUrl: string,
    hasLink: bool,
    linkThumb: image,
    hasLinkThumb: bool,
    linkThumbW: int,
    linkThumbH: int,
    wave: image,
    hasWave: bool,
    playing: bool,
    progress: float,
    posLabel: string,
    // The day this message belongs to, on every row (the floating
    // header reads it from whichever row is at the top).
    dayFull: string,
    selected: bool,
    // A notice that opens the group info when clicked.
    clickable: bool,
}

// One emoji picker row: either a translated section header (label) or a row
// of up to 8 emoji cells.
export struct EmojiRow {
    label: string,
    cells: [string],
}
