export struct ChatItem {
    jid: string,
    name: string,
    preview: string,
    time: string,
    avatar: image,
    hasAvatar: bool,
    initial: string,
    colorIdx: int,
    unread: int,
    mentioned: bool,
    pinned: bool,
}

export struct ReactionItem {
    jid: string,
    name: string,
    emoji: string,
    avatar: image,
    hasAvatar: bool,
    initial: string,
    colorIdx: int,
}

export struct CallItem {
    id: string,
    from: string,
    name: string,
    detail: string,
    time: string,
    avatar: image,
    hasAvatar: bool,
    initial: string,
    colorIdx: int,
    video: bool,
    group: bool,
}

export struct StickerCell {
    id: string,
    pic: image,
    ready: bool,
}

export struct MessageItem {
    id: string,
    kind: string,          // "text" | "image" | "audio" | "doc"
    text: string,          // body, caption, filename or audio duration
    fromMe: bool,
    sender: string,
    senderJid: string,
    showSender: bool,
    firstOfRun: bool,
    forwarded: bool,
    deleted: bool,
    starred: bool,
    hasQuote: bool,
    quoteName: string,
    quoteText: string,
    quoteId: string,
    time: string,
    picture: image,
    picW: int,
    picH: int,
    mediaPath: string,
    mediaReady: bool,
    reactions: string,
    dayLabel: string,
    ticks: string,
    ticksBlue: bool,
    senderAvatar: image,
    senderHasAvatar: bool,
    senderInitial: string,
    senderColorIdx: int,
    voiceJid: string,
    voiceAvatar: image,
    voiceHasAvatar: bool,
    voiceInitial: string,
    voiceColorIdx: int,
    groupIndent: bool,
    showAvatar: bool,
    senderNumber: string,
    senderLabel: string,
    sticker: bool,
    gif: bool,
    styled: styled-text,
    hasStyled: bool,
    linkTitle: string,
    linkDesc: string,
    linkHost: string,
    linkUrl: string,
    hasLink: bool,
    linkThumb: image,
    hasLinkThumb: bool,
    linkThumbW: int,
    linkThumbH: int,
    wave: image,
    hasWave: bool,
    playing: bool,
    progress: float,
    posLabel: string,
}
