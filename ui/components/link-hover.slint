// The hand cursor over a link in a styled bubble.
//
// The words of such a bubble are drawn by a StyledText, and a transparent
// TextInput with the same words lies over it to make them selectable. A
// TextInput sets the I-beam on every mouse move it sees, and nothing laid
// under or around it gets a say after that, so the hand has to come from
// something on top -- which would then also eat the press that starts a
// selection on the link. Hence the two halves here:
//
// - where: an invisible TextInput with the same text, width and font is
//   asked for the cursor position at the link's first and last byte, and
//   the link's box (up to three of them when it wraps) follows from those;
// - how: the boxes are TouchAreas that show the hand and, on a press, step
//   aside (`pass-through`) while the host plays the press again, this time
//   reaching the TextInput underneath. Selecting from inside a link, a
//   double click on it and the click that opens it all still belong to
//   the overlay, exactly as without this.
component LinkBox inherits TouchArea {
    in property <bool> pass-through;
    callback press(length, length);
    callback release();
    mouse-cursor: pointer;
    enabled: !self.pass-through;
    pointer-event(e) => {
        if (e.button == PointerEventButton.left) {
            if (e.kind == PointerEventKind.down) {
                root.press(self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            } else if (e.kind == PointerEventKind.up) {
                root.release();
            }
        }
    }
}

export component LinkHover inherits Rectangle {
    in property <string> text;
    in property <int> start;
    in property <int> end;
    in property <bool> pass-through;
    callback press(length, length);
    callback release();

    // Where the link starts and ends, in this element's coordinates.
    out property <length> sx;
    out property <length> sy;
    out property <length> ex;
    out property <length> ey;
    property <bool> at-end: false;
    out property <length> line-h: line.preferred-height;
    out property <bool> one-line: abs((self.ey - self.sy) / 1px) < 2;
    out property <bool> hovered: first.has-hover || middle.has-hover || last.has-hover;

    line := Text {
        text: "Ag";
        font-size: 14px;
        visible: false;
    }
    probe := TextInput {
        text: root.text;
        visible: false;
        enabled: false;
        read-only: true;
        single-line: false;
        wrap: word-wrap;
        font-size: 14px;
        width: root.width;
        height: root.height;
        cursor-position-changed(p) => {
            if (root.at-end) {
                root.ex = p.x;
                root.ey = p.y;
            } else {
                root.sx = p.x;
                root.sy = p.y;
            }
        }
    }
    function measure() {
        root.at-end = false;
        probe.set-selection-offsets(root.start, root.start);
        root.at-end = true;
        probe.set-selection-offsets(root.end, root.end);
    }
    // The row may be laid out after it is created, and it is recycled
    // for other messages and re-wrapped when the window is resized.
    init => { self.measure(); }
    changed width => { self.measure(); }
    changed text => { self.measure(); }
    changed start => { self.measure(); }
    Timer {
        interval: 30ms;
        running: true;
        triggered => {
            self.running = false;
            root.measure();
        }
    }

    // First line, whole lines in between, last line.
    first := LinkBox {
        x: root.sx;
        y: root.sy;
        width: max(0px, (root.one-line ? root.ex : root.width) - root.sx);
        height: root.line-h;
        pass-through: root.pass-through;
        press(x, y) => { root.press(x, y); }
        release => { root.release(); }
    }
    middle := LinkBox {
        visible: !root.one-line && root.ey - root.sy > root.line-h * 1.5;
        x: 0;
        y: root.sy + root.line-h;
        width: root.width;
        height: max(0px, root.ey - root.sy - root.line-h);
        pass-through: root.pass-through;
        press(x, y) => { root.press(x, y); }
        release => { root.release(); }
    }
    last := LinkBox {
        visible: !root.one-line;
        x: 0;
        y: root.ey;
        width: max(0px, root.ex);
        height: root.line-h;
        pass-through: root.pass-through;
        press(x, y) => { root.press(x, y); }
        release => { root.release(); }
    }
}
