import { Theme } from "theme.slint";

// A settings group: a title over a card of rows, and an optional note
// under it.
export component SettingsCard inherits VerticalLayout {
    in property <string> title;
    in property <string> hint;
    spacing: 8px;
    alignment: start;
    vertical-stretch: 0;
    Text {
        text: root.title;
        color: Theme.text;
        font-size: 13px;
        font-weight: 700;
    }
    Rectangle {
        height: card-content.preferred-height;
        border-radius: 10px;
        background: Theme.dark ? #101f27 : Theme.panel;
        border-width: 1px;
        border-color: Theme.border;
        card-content := VerticalLayout {
            alignment: start;
            padding-top: 2px;
            padding-bottom: 2px;
            @children
        }
    }
    if root.hint != "": Text {
        text: root.hint;
        color: Theme.text-dim;
        font-size: 12px;
        wrap: word-wrap;
    }
}
