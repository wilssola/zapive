import { Theme } from "theme.slint";
import { SilencedCall } from "types.slint";

// A calm glass card for a call the anti-spam rule held back: no sound, no
// pulsing, only a single finite fade-in. Sits under the chat header.
export component SilencedCallBanner inherits Rectangle {
    in property <SilencedCall> call;
    callback answer();
    callback decline();
    height: 56px;
    property <bool> shown: false;
    init => { self.shown = true; }
    opacity: self.shown ? 1.0 : 0.0;
    animate opacity { duration: 220ms; easing: ease-out; }

    Rectangle {
        x: 12px;
        width: parent.width - 24px;
        height: 52px;
        border-radius: 16px;
        background: Theme.glass ? Theme.glass-fill-strong : Theme.panel;
        border-width: 1px;
        border-color: Theme.glass ? Theme.glass-rim : Theme.border;
        drop-shadow-blur: Theme.glass ? 14px : 0px;
        drop-shadow-color: Theme.glass-shadow;
        clip: true;
        if Theme.glass: Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: parent.border-radius;
            background: Theme.glass-sheen;
        }
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 10px;
            spacing: 10px;
            Rectangle {
                width: 32px;
                height: 32px;
                y: 10px;
                border-radius: 16px;
                background: Theme.tile;
                Image {
                    source: root.call.video ? @image-url("../icons/video.svg") : @image-url("../icons/phone.svg");
                    colorize: Theme.icon;
                    width: 18px;
                    height: 18px;
                    x: 7px;
                    y: 7px;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                horizontal-stretch: 1;
                Text {
                    text: root.call.name;
                    color: Theme.text;
                    font-size: 13px;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: root.call.group && root.call.caller != ""
                        ? root.call.kind + " · " + root.call.caller + " · " + root.call.time
                        : root.call.kind + " · " + root.call.time;
                    color: Theme.text-dim;
                    font-size: 11.5px;
                    overflow: elide;
                }
            }
            Rectangle {
                width: answer-label.preferred-width + 24px;
                height: 32px;
                y: 10px;
                border-radius: 16px;
                background: answer-touch.pressed ? Theme.accent.darker(0.25) : answer-touch.has-hover ? Theme.accent.darker(0.1) : Theme.accent;
                animate background { duration: Theme.motion-fast; }
                answer-touch := TouchArea {
                    mouse-cursor: pointer;
                    accessible-role: button;
                    accessible-label: @tr("call.silenced.answer");
                    clicked => { root.answer(); }
                }
                answer-label := Text {
                    text: @tr("call.silenced.answer");
                    color: #ffffff;
                    font-size: 13px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                width: decline-label.preferred-width + 24px;
                height: 32px;
                y: 10px;
                border-radius: 16px;
                background: decline-touch.has-hover ? Theme.danger.with-alpha(0.22) : Theme.danger.with-alpha(0.12);
                border-width: 1px;
                border-color: Theme.danger.with-alpha(0.45);
                animate background { duration: Theme.motion-fast; }
                decline-touch := TouchArea {
                    mouse-cursor: pointer;
                    accessible-role: button;
                    accessible-label: @tr("call.silenced.decline");
                    clicked => { root.decline(); }
                }
                decline-label := Text {
                    text: @tr("call.silenced.decline");
                    color: Theme.danger;
                    font-size: 13px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
