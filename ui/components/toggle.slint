import { Theme } from "theme.slint";

// A switch for the on/off settings.
export component Toggle inherits TouchArea {
    in property <bool> on;
    in property <string> label: "";
    width: 42px;
    height: 24px;
    mouse-cursor: pointer;
    accessible-role: button;
    accessible-label: root.label;
    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 12px;
        background: root.on ? Theme.accent : (Theme.dark ? #3b4a54 : #c5ccd1);
        animate background { duration: Theme.motion-normal; easing: ease-out; }
        Rectangle {
            width: 18px;
            height: 18px;
            border-radius: 9px;
            y: 3px;
            x: root.on ? parent.width - self.width - 3px : 3px;
            background: white;
            drop-shadow-blur: 2px;
            drop-shadow-color: #00000040;
            animate x { duration: 150ms; easing: ease-out; }
        }
    }
}
