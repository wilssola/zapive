import { Theme } from "theme.slint";

// One row of a card: a label (and an optional second line) with the
// control on the right. Controls center themselves with a `y` binding.
export component SettingsRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <image> icon;
    height: max(46px, row.preferred-height);
    row := HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 12px;
        if root.icon != @image-url(""): Rectangle {
            width: 32px;
            height: 32px;
            y: (parent.height - self.height) / 2;
            border-radius: 8px;
            background: Theme.hover;
            Image {
                x: 7px; y: 7px;
                width: 18px; height: 18px;
                source: root.icon;
                colorize: Theme.icon;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.label;
                color: Theme.text;
                font-size: 14px;
                wrap: word-wrap;
            }
            if root.detail != "": Text {
                text: root.detail;
                color: Theme.text-dim;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
        @children
    }
}
