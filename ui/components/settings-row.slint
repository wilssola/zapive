import { Theme } from "theme.slint";

// One row of a card: a label (and an optional second line) with the
// control on the right. Controls center themselves with a `y` binding.
export component SettingsRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    height: max(46px, row.preferred-height);
    hover := TouchArea {
        width: parent.width;
        height: parent.height;
    }
    background: hover.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.motion-fast; easing: ease-out; }
    row := HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.label;
                color: Theme.text;
                font-size: 14px;
                wrap: word-wrap;
            }
            if root.detail != "": Text {
                text: root.detail;
                color: Theme.text-dim;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
        @children
    }
}
