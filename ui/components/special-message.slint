import { Theme } from "theme.slint";
import { MessageItem, PollOption } from "types.slint";
import { PrivacyVeil } from "privacy-veil.slint";

export component SpecialMessage inherits Rectangle {
    in property <MessageItem> message;
    in property <bool> privacy-hidden;
    callback details();
    callback vote(int);
    property <int> expanded: -1;
    property <bool> interactive-poll: poll && message.poll-options.length > 0;
    property <bool> location: message.cardKind == "location" || message.cardKind == "live-location";
    property <bool> contact: message.cardKind == "contact";
    property <bool> poll: message.cardKind == "poll";
    property <bool> view-once: message.cardKind == "view-once";
    property <color> surface: message.fromMe
        ? (Theme.glass ? Theme.bubble-out : Theme.dark ? #003c32 : #c9edc6)
        : (Theme.glass ? Theme.glass-fill-soft : Theme.dark ? #182831 : #f3f6f5);
    height: card-layout.preferred-height;
    border-radius: 12px;
    background: root.view-once
        ? (Theme.dark ? #20343c : #e8f0f1) : surface;
    border-width: root.view-once ? 1px : 0px;
    border-color: Theme.dark ? #3b535c : #c3d4d8;
    clip: true;

    card-layout := VerticalLayout {
        padding: 0px;
        spacing: 0px;
        if root.location: Rectangle {
            height: root.message.cardHasPicture ? 158px : 92px;
            background: Theme.dark ? #142e3c : #dce8e9;
            clip: true;
            if root.message.cardHasPicture: Image {
                source: root.message.cardPicture;
                width: parent.width;
                height: parent.height;
                image-fit: cover;
            }
            if !root.message.cardHasPicture: Rectangle {
                width: 52px;
                height: 52px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: 26px;
                background: Theme.dark ? #164d4c : #c0dcd4;
                Image {
                    source: root.message.cardKind == "live-location"
                        ? @image-url("../icons/circle-dot.svg") : @image-url("../icons/pin.svg");
                    colorize: Theme.accent;
                    width: 30px;
                    height: 30px;
                    x: 11px;
                    y: 11px;
                }
            }
        }
        HorizontalLayout {
            padding: 14px;
            spacing: 12px;
            Rectangle {
                width: root.contact || root.view-once ? 54px : 42px;
                height: max(self.width, header-text.preferred-height);
                Rectangle {
                    width: parent.width;
                    height: self.width;
                    y: (parent.height - self.height) / 2;
                    border-radius: self.width / 2;
                    background: root.contact ? Theme.accent : (Theme.dark ? #075448 : #d2e8df);
                    if root.contact: Text {
                        text: root.message.cardInitial;
                        color: white;
                        font-size: 21px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    if !root.contact: Image {
                        source: root.poll ? @image-url("../icons/list-details.svg")
                            : root.location ? (root.message.cardKind == "live-location"
                                ? @image-url("../icons/circle-dot.svg") : @image-url("../icons/pin.svg"))
                            : root.view-once ? @image-url("../icons/view-once.svg")
                            : @image-url("../icons/file-text.svg");
                        colorize: root.location || root.poll || root.view-once ? Theme.accent : Theme.icon;
                        width: 23px;
                        height: 23px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                height: max(root.contact || root.view-once ? 54px : 42px, header-text.preferred-height);
                header-text := VerticalLayout {
                    y: (parent.height - self.preferred-height) / 2;
                    height: self.preferred-height;
                    spacing: 5px;
                    Text {
                        text: root.message.cardTitle;
                        color: Theme.bubble-text;
                        font-size: 14px;
                        font-weight: 700;
                        wrap: word-wrap;
                    }
                    if root.message.cardBody != "": Text {
                        text: root.message.cardBody;
                        color: root.message.fromMe ? Theme.time-out : Theme.text-dim;
                        font-size: 12.5px;
                        wrap: word-wrap;
                    }
                    if root.message.cardDetail != "" && !root.poll: Text {
                        text: root.message.cardDetail;
                        color: root.message.fromMe ? Theme.time-out : Theme.text-dim;
                        font-size: 11.5px;
                        wrap: word-wrap;
                    }
                }
            }
        }
        if root.interactive-poll: Rectangle {
            height: 1px;
            background: root.message.fromMe
                ? (Theme.dark ? #175247 : #b6dcb4) : Theme.border;
        }
        if root.interactive-poll: Text {
            x: 14px;
            text: root.message.poll-multi ? @tr("poll.hint.multiple") : @tr("poll.hint.single");
            color: root.message.fromMe ? Theme.time-out : Theme.text-dim;
            font-size: 11.5px;
            height: 28px;
            vertical-alignment: center;
        }
        if root.interactive-poll: VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-bottom: 6px;
            spacing: 2px;
            for opt[i] in root.message.poll-options: VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: opt-row.preferred-height + 8px;
                    border-radius: 8px;
                    background: opt-touch.has-hover && root.message.poll-can-vote ? Theme.hover : transparent;
                    opt-touch := TouchArea {
                        enabled: root.message.poll-can-vote;
                        mouse-cursor: root.message.poll-can-vote ? pointer : default;
                        clicked => { root.vote(i); }
                    }
                    opt-row := VerticalLayout {
                        y: 4px;
                        padding-left: 4px;
                        padding-right: 4px;
                        spacing: 4px;
                        HorizontalLayout {
                            spacing: 10px;
                            Rectangle {
                                width: 20px;
                                height: 20px;
                                border-radius: root.message.poll-multi ? 5px : 10px;
                                border-width: opt.voted ? 0px : 2px;
                                border-color: root.message.fromMe ? Theme.time-out : Theme.text-dim;
                                background: opt.voted ? Theme.accent : transparent;
                                animate background { duration: Theme.motion-fast; }
                                if opt.voted: Image {
                                    source: @image-url("../icons/check.svg");
                                    colorize: white;
                                    width: 14px;
                                    height: 14px;
                                    x: 3px;
                                    y: 3px;
                                }
                            }
                            Text {
                                text: opt.name;
                                color: Theme.bubble-text;
                                font-size: 14px;
                                wrap: word-wrap;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: opt.votes;
                                color: Theme.bubble-text;
                                font-size: 13px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle {
                            height: 5px;
                            border-radius: 2.5px;
                            background: Theme.dark ? #ffffff1f : #1b2d4022;
                            Rectangle {
                                x: 0px;
                                width: root.message.poll-total > 0
                                    ? parent.width * Math.min(1.0, opt.votes / root.message.poll-total) : 0px;
                                height: parent.height;
                                border-radius: 2.5px;
                                background: opt.voted ? Theme.accent-text : Theme.accent;
                                animate width { duration: Theme.motion-normal; easing: ease-out; }
                            }
                        }
                    }
                }
                if opt.votes > 0 && opt.voters != "": Rectangle {
                    height: 20px;
                    expand-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.expanded = root.expanded == i ? -1 : i; }
                    }
                    HorizontalLayout {
                        padding-left: 34px;
                        spacing: 4px;
                        alignment: start;
                        Text {
                            text: root.expanded == i ? @tr("poll.votes.hide") : @tr("poll.votes.view");
                            color: Theme.accent-text;
                            font-size: 11.5px;
                            vertical-alignment: center;
                        }
                        Image {
                            source: root.expanded == i ? @image-url("../icons/chevron-up.svg") : @image-url("../icons/chevron-down.svg");
                            colorize: Theme.accent-text;
                            width: 12px;
                            height: 12px;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
                if root.expanded == i && opt.voters != "": Text {
                    x: 34px;
                    text: opt.voters;
                    color: root.message.fromMe ? Theme.time-out : Theme.text-dim;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
        }
        for option in root.message.cardOptions: Rectangle {
            visible: !root.interactive-poll;
            height: root.interactive-poll ? 0px : option-layout.preferred-height;
            border-width: 1px;
            border-color: root.message.fromMe
                ? (Theme.dark ? #175247 : #b6dcb4) : Theme.border;
            option-layout := HorizontalLayout {
                padding: 14px;
                spacing: 14px;
                Rectangle {
                    width: 20px;
                    Rectangle {
                        width: 20px;
                        height: 20px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 10px;
                        border-width: 2px;
                        border-color: root.message.fromMe ? Theme.time-out : Theme.text-dim;
                    }
                }
                Text {
                    text: option;
                    min-height: 20px;
                    vertical-alignment: center;
                    color: Theme.bubble-text;
                    font-size: 14px;
                    wrap: word-wrap;
                }
            }
        }
        if root.poll && !root.message.poll-can-vote: VerticalLayout {
            padding: 14px;
            Text {
                text: root.message.cardDetail;
                color: root.message.fromMe ? Theme.time-out : Theme.text-dim;
                font-size: 11.5px;
                wrap: word-wrap;
            }
        }
        Rectangle {
            height: 1px;
            background: root.message.fromMe
                ? (Theme.dark ? #175247 : #b6dcb4) : Theme.border;
        }
        details-touch := TouchArea {
            height: 42px;
            mouse-cursor: pointer;
            clicked => { root.details(); }
            Rectangle {
                background: details-touch.has-hover ? Theme.accent.with-alpha(0.12) : transparent;
            }
            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                Rectangle {
                    width: 17px;
                    Image {
                        source: @image-url("../icons/info-circle.svg");
                        colorize: Theme.bubble-text;
                        width: 17px;
                        height: 17px;
                        y: (parent.height - self.height) / 2;
                    }
                }
                Text {
                    text: @tr("message.special.view_details");
                    color: Theme.bubble-text;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }
    }
    if root.privacy-hidden: PrivacyVeil {
        width: parent.width;
        height: parent.height;
        radius: 12px;
        tint: root.surface;
    }
    if root.privacy-hidden: PrivacyVeil {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        radius: 11px;
        tint: root.surface;
    }
}
