import { Theme } from "theme.slint";
import { KeyFocus, FocusRing } from "a11y.slint";

// Round accent button with a label, for dialogs.
export component DialogButton inherits TouchArea {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> danger: false;
    mouse-cursor: pointer;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    forward-focus: key-focus;
    key-focus := KeyFocus {
        enabled: root.enabled;
        activate => { root.clicked(); }
    }
    width: btn-text.preferred-width + 32px;
    height: 36px;
    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 18px;
        background: root.primary
            ? (root.has-hover ? (root.danger ? #c9302c : Theme.accent.darker(0.15)) : (root.danger ? #ea0038 : Theme.accent))
            : (root.has-hover ? Theme.selected : Theme.glass ? Theme.glass-fill-soft : transparent);
        border-width: root.primary || !Theme.glass ? 0px : 1px;
        border-color: Theme.glass-rim-soft;
        opacity: root.pressed ? 0.84 : 1;
        animate background, opacity { duration: Theme.motion-fast; easing: ease-out; }
        btn-text := Text {
            text: root.label;
            color: root.primary ? white : Theme.accent-text;
            font-size: 14px;
            font-weight: 700;
            width: parent.width;
            height: parent.height;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    FocusRing {
        width: parent.width;
        height: parent.height;
        border-radius: 18px;
        shown: key-focus.has-focus;
    }
}
