import { Avatar } from "avatar.slint";
import { Theme } from "theme.slint";
import { MemberItem } from "types.slint";
import { FocusRing } from "a11y.slint";

export component MentionPicker inherits Rectangle {
    in property <[MemberItem]> rows;
    in property <int> selected-index;
    in property <int> member-count: 0;
    callback pick(int);
    callback select(int);
    callback dismiss();
    accessible-role: list;
    accessible-label: @tr("accessibility.mention_suggestions");
    property <bool> has-all: root.rows.length > 0 && root.rows[0].jid == "all";
    property <length> section-height: root.rows.length > (root.has-all ? 1 : 0) ? 34px : 0px;
    property <length> list-height: root.rows.length * 60px + (root.has-all ? 16px : 0px) + root.section-height;
    property <length> selected-top: root.has-all && root.selected-index == 0 ? 0px
        : root.selected-index * 60px + (root.has-all ? 16px : 0px) + root.section-height;
    preferred-height: root.list-height + 20px;
    background: Theme.glass-fill-strong;
    border-radius: 18px;
    border-width: 1px;
    border-color: Theme.glass-rim-soft;
    drop-shadow-blur: 16px;
    drop-shadow-color: Theme.glass-shadow;
    clip: true;

    mention-list := Flickable {
        x: 10px;
        y: 10px;
        width: parent.width - 20px;
        height: max(0px, parent.height - 20px);
        content-width: self.width;
        content-height: root.list-height;
        content-y: -max(0px, min(root.selected-top - self.height
            + (root.has-all && root.selected-index == 0 ? 76px : 60px), self.content-height - self.height));

        for m[i] in root.rows: Rectangle {
            property <bool> all: m.jid == "all";
            accessible-role: list-item;
            accessible-label: self.all
                ? @tr("mention.picker.all_members") + ", " + (root.member-count > 0
                    ? @tr("mention.picker.all_count", root.member-count)
                    : @tr("mention.picker.all_hint"))
                : m.name + (m.number != "" ? ", " + m.number : "") + (m.admin ? ", " + @tr("mention.picker.admin") : "");
            accessible-item-selectable: true;
            accessible-item-selected: root.selected-index == i;
            accessible-item-index: i + 1;
            accessible-item-count: root.rows.length;
            accessible-action-default => { root.pick(i); }
            forward-focus: row-focus;
            row-focus := FocusScope {
                x: 0px;
                width: 0px;
                focus-on-click: false;
                changed has-focus => { if (self.has-focus) { root.select(i); } }
                key-pressed(event) => {
                    if (event.text == Key.Return || event.text == Key.Space || (event.text == Key.Tab && !event.modifiers.shift)) {
                        root.pick(root.selected-index);
                        return accept;
                    }
                    if (event.text == Key.UpArrow || event.text == Key.DownArrow) {
                        root.select(Math.mod(root.selected-index + root.rows.length
                            + (event.text == Key.DownArrow ? 1 : -1), root.rows.length));
                        return accept;
                    }
                    if (event.text == Key.Escape) {
                        root.dismiss();
                        return accept;
                    }
                    reject
                }
            }
            x: 0px;
            y: self.all ? 0px : i * 60px + (root.has-all ? 16px : 0px) + root.section-height;
            width: mention-list.width;
            height: self.all ? 76px : 60px;
            border-radius: self.all ? 12px : 9px;
            background: self.all ? Theme.accent.with-alpha(root.selected-index == i ? 0.24 : 0.14)
                : root.selected-index == i ? Theme.accent.with-alpha(0.12)
                : row-touch.has-hover ? Theme.hover : transparent;
            border-width: self.all || root.selected-index == i ? 1px : 0px;
            border-color: Theme.accent.with-alpha(root.selected-index == i ? 0.45 : 0.22);

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    if m.jid == "all": Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 20px;
                        background: Theme.accent.with-alpha(0.2);
                        border-width: 1px;
                        border-color: Theme.accent.with-alpha(0.65);
                        Image {
                            x: 9px;
                            y: 9px;
                            width: 22px;
                            height: 22px;
                            source: @image-url("../icons/users.svg");
                            colorize: Theme.accent-text;
                        }
                    }
                    if m.jid != "all": Avatar {
                        width: 38px;
                        height: 38px;
                        src: m.avatar;
                        has-image: m.hasAvatar;
                        initial: m.initial;
                        color-idx: m.colorIdx;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    horizontal-stretch: 1;
                    Text {
                        text: m.jid == "all" ? @tr("mention.picker.all_members") : m.name;
                        color: Theme.text;
                        font-size: 14px;
                        font-weight: m.jid == "all" ? 700 : 500;
                        overflow: elide;
                    }
                    if m.jid == "all" || m.number != "": Text {
                        text: m.jid == "all" ? (root.member-count > 0
                            ? @tr("mention.picker.all_count", root.member-count)
                            : @tr("mention.picker.all_hint")) : m.number;
                        color: Theme.accent-text;
                        font-size: 12px;
                        overflow: elide;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    if m.jid == "all" || m.admin: Rectangle {
                        width: badge.preferred-width + (m.admin && m.jid != "all" ? 34px : 16px);
                        height: 24px;
                        border-radius: 8px;
                        background: Theme.accent.with-alpha(0.12);
                        border-width: 1px;
                        border-color: Theme.accent.with-alpha(0.75);
                        if m.admin && m.jid != "all": Image {
                            x: 8px;
                            y: 5px;
                            width: 14px;
                            height: 14px;
                            source: @image-url("../icons/crown.svg");
                            colorize: Theme.accent-text;
                        }
                        badge := Text {
                            text: m.jid == "all" ? @tr("mention.picker.all_tag") : @tr("mention.picker.admin");
                            color: Theme.text-dim;
                            font-size: 11px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            x: m.admin && m.jid != "all" ? 24px : 0px;
                            width: parent.width - self.x;
                            height: parent.height;
                        }
                    }
                }
            }
            if m.jid != "all" && i < root.rows.length - 1: Rectangle {
                x: 58px;
                y: parent.height - 1px;
                width: max(0px, parent.width - 68px);
                height: 1px;
                background: Theme.glass-divider;
            }
            FocusRing {
                width: parent.width;
                height: parent.height;
                border-radius: parent.border-radius;
                shown: row-focus.has-focus;
            }
            row-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.pick(i); }
            }
        }
        if root.section-height > 0px: Rectangle {
            y: root.has-all ? 76px : 0px;
            width: mention-list.width;
            height: root.section-height;
            Text {
                x: 10px;
                width: parent.width - 20px;
                height: parent.height;
                text: @tr("mention.picker.participants");
                color: Theme.text-dim;
                font-size: 11px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}
