import { IconButton } from "icon-button.slint";
import { ModalLayer } from "modal.slint";
import { Theme } from "theme.slint";

export component SvLayer inherits ModalLayer {
    in property <string> sv-name;
    in property <string> sv-time;
    in property <string> sv-text;
    in property <bool> sv-has-image;
    in property <image> sv-image;
    in property <int> sv-index;
    in property <int> sv-count;
    callback status-next();
    callback status-prev();
    callback status-close();
    in property <bool> sv-is-video;
    in property <bool> sv-video-ready;
    callback status-play();

    if root.mounted: Rectangle {
        width: 100%;
        height: 100%;
        opacity: root.progress;
        TouchArea { clicked => { root.status-next(); } }
        VerticalLayout {
            padding: 20px;
            spacing: 12px;
            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: root.sv-name;
                    color: white;
                    font-size: 16px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Text {
                    text: root.sv-time + "  ·  " + root.sv-index + "/" + root.sv-count;
                    color: #b0b8bd;
                    font-size: 13px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                IconButton {
                    label: @tr("common.action.close");
                    icon: @image-url("../icons/x.svg");
                    clicked => { root.status-close(); }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                if root.sv-has-image: Image {
                    source: root.sv-image;
                    width: parent.width * 0.9;
                    height: parent.height * 0.94;
                    x: parent.width * 0.05;
                    y: parent.height * 0.03;
                    image-fit: contain;
                }
                if root.sv-is-video: Rectangle {
                    width: 72px;
                    height: 72px;
                    border-radius: 36px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    background: root.sv-video-ready ? Theme.media-chip : Theme.media-chip-soft;
                    TouchArea {
                        mouse-cursor: pointer;
                        enabled: root.sv-video-ready;
                        clicked => { root.status-play(); }
                    }
                    Image {
                        source: @image-url("../icons/player-play.svg");
                        colorize: white;
                        width: 34px;
                        height: 34px;
                        x: 21px;
                        y: 19px;
                    }
                }
                if !root.sv-has-image: Rectangle {
                    width: parent.width * 0.7;
                    height: parent.height * 0.7;
                    x: parent.width * 0.15;
                    y: parent.height * 0.15;
                    background: Theme.accent;
                    border-radius: 14px;
                    Text {
                        text: root.sv-text;
                        color: white;
                        font-size: 24px;
                        wrap: word-wrap;
                        width: parent.width - 60px;
                        x: 30px;
                        height: parent.height;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                IconButton {
                    label: @tr("accessibility.previous");
                    icon: @image-url("../icons/chevron-left.svg");
                    x: 4px;
                    y: (parent.height - self.height) / 2;
                    clicked => { root.status-prev(); }
                }
                IconButton {
                    label: @tr("accessibility.next");
                    icon: @image-url("../icons/chevron-right.svg");
                    x: parent.width - self.width - 4px;
                    y: (parent.height - self.height) / 2;
                    clicked => { root.status-next(); }
                }
            }
            if root.sv-has-image && root.sv-text != "": Text {
                text: root.sv-text;
                color: white;
                font-size: 14px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}
