import { MemberItem } from "../types.slint";
import { Avatar } from "../avatar.slint";
import { Theme } from "../theme.slint";

// One row of a people list (mention popup, member picker, group info).
export component MemberRow inherits TouchArea {
    in property <MemberItem> item;
    in property <bool> pickable: false;
    mouse-cursor: pointer;
    height: 52px;
    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 6px;
        background: root.has-hover ? Theme.hover : transparent;
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 12px;
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                Avatar {
                    width: 36px;
                    height: 36px;
                    src: root.item.avatar;
                    has-image: root.item.hasAvatar;
                    initial: root.item.initial;
                    color-idx: root.item.colorIdx;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: root.item.name;
                    color: Theme.text;
                    font-size: 14px;
                    overflow: elide;
                }
                if root.item.number != "": Text {
                    text: root.item.number;
                    color: Theme.text-dim;
                    font-size: 12px;
                    overflow: elide;
                }
            }
            if root.item.admin: Rectangle {
                width: admin-text.preferred-width + 12px;
                height: 20px;
                y: (parent.height - self.height) / 2;
                border-radius: 4px;
                border-width: 1px;
                border-color: Theme.accent;
                admin-text := Text {
                    text: @tr("Group admin");
                    color: Theme.accent;
                    font-size: 10px;
                    width: parent.width;
                    height: parent.height;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            if root.pickable: Rectangle {
                width: 20px;
                height: 20px;
                y: (parent.height - self.height) / 2;
                border-radius: 4px;
                border-width: 2px;
                border-color: root.item.checked ? Theme.accent : Theme.text-dim;
                background: root.item.checked ? Theme.accent : transparent;
                if root.item.checked: Image {
                    source: @image-url("../../icons/check.svg");
                    colorize: white;
                    width: 14px;
                    height: 14px;
                }
            }
        }
    }
}
