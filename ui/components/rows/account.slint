import { AccountItem } from "../types.slint";
import { Avatar } from "../avatar.slint";
import { Theme } from "../theme.slint";
import { KeyFocus, FocusRing } from "../a11y.slint";

// One account in the switcher: the one on screen carries a check, the
// others their unread count and a button that removes them from this
// computer.
export component AccountRow inherits TouchArea {
    in property <AccountItem> account;
    callback remove();
    mouse-cursor: pointer;
    height: 52px;
    accessible-role: button;
    accessible-label: (root.account.detail != "" ? root.account.name + ", " + root.account.detail : root.account.name)
        + (!root.account.active && root.account.unread > 0 ? ", " + @tr("accessibility.account_unread", root.account.unread) : "");
    accessible-checkable: true;
    accessible-checked: root.account.active;
    accessible-action-default => { root.clicked(); }
    forward-focus: key-focus;
    key-focus := KeyFocus {
        activate => { root.clicked(); }
    }
    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 6px;
        background: root.has-hover || drop.has-hover ? Theme.hover : transparent;
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        Avatar {
            width: 36px;
            height: 36px;
            y: (parent.height - self.height) / 2;
            src: root.account.avatar;
            has-image: root.account.hasAvatar;
            initial: root.account.initial;
            color-idx: root.account.colorIdx;
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            Text {
                text: root.account.name;
                color: Theme.text;
                font-size: 14px;
                overflow: elide;
            }
            if root.account.detail != "": Text {
                text: root.account.detail;
                color: Theme.text-dim;
                font-size: 11px;
                overflow: elide;
            }
        }
        if !root.account.active && root.account.unread > 0: VerticalLayout {
            alignment: center;
            Rectangle {
                width: max(20px, unread-label.preferred-width + 8px);
                height: 20px;
                border-radius: 10px;
                background: Theme.accent;
                unread-label := Text {
                    text: root.account.unread > 99 ? "99+" : root.account.unread;
                    color: #ffffff;
                    font-size: 11px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle { width: 24px; }
    }
    if root.account.active: Image {
        source: @image-url("../../icons/check.svg");
        colorize: Theme.accent;
        x: parent.width - self.width - 14px;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
    }
    drop := TouchArea {
        visible: !root.account.active;
        x: parent.width - self.width - 8px;
        y: (parent.height - self.height) / 2;
        width: 30px;
        height: 30px;
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: @tr("accessibility.remove_account", root.account.name);
        accessible-action-default => { root.remove(); }
        clicked => { root.remove(); }
        KeyFocus {
            enabled: drop.visible;
            activate => { root.remove(); }
        }
        Image {
            source: @image-url("../../icons/trash.svg");
            colorize: drop.has-hover ? #f05d4d : Theme.text-dim;
            width: 16px;
            height: 16px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }
}
