import { Theme } from "theme.slint";

// Loading splash: a centred glass card with the app mark and a smooth
// spinner. It covers the window until `loading` turns false, then fades out
// and unmounts (so the spinner stops driving redraws).
export component Splash inherits Rectangle {
    in property <bool> loading: true;
    out property <float> progress: root.loading ? 1.0 : 0.0;
    animate progress { duration: Theme.motion-slow; easing: ease-in-out; }
    out property <bool> mounted: root.loading || root.progress > 0.001;
    visible: root.mounted;
    opacity: root.progress;
    // Full-window veil: blurs and frosts everything behind the card.
    background: Theme.glass ? Theme.glass-fill : Theme.bg;
    backdrop-blur: Theme.glass ? 48px : 0px;
    if Theme.glass: Rectangle {
        background: Theme.glass-sheen;
    }
    // Swallow input while the app is not ready.
    TouchArea { enabled: root.mounted; }
    if root.mounted: Rectangle {
        width: 220px;
        height: 200px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + (1 - root.progress) * 6px;
        border-radius: 28px;
        background: Theme.glass ? Theme.glass-fill-soft : Theme.panel;
        backdrop-blur: Theme.glass ? Theme.glass-blur : 0px;
        border-width: 1px;
        border-color: Theme.glass ? Theme.glass-rim : Theme.border;
        drop-shadow-blur: 32px;
        drop-shadow-color: Theme.glass-shadow;
        Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: parent.border-radius;
            background: Theme.glass ? Theme.glass-sheen : transparent;
        }
        VerticalLayout {
            alignment: center;
            spacing: 14px;
            HorizontalLayout {
                alignment: center;
                Image {
                    source: @image-url("../zapive.png");
                    width: 64px;
                    height: 64px;
                    image-fit: contain;
                    accessible-role: none;
                }
            }
            Text {
                text: "Zapive";
                color: Theme.text;
                font-size: 20px;
                font-weight: 700;
                horizontal-alignment: center;
            }
            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                for i in 3: Rectangle {
                    // Each dot rises and fades in turn, on one 1.2s cycle.
                    property <float> phase: Math.mod(animation-tick() / 1.2s + i * 0.18, 1.0);
                    property <float> wave: Math.max(0.0, Math.sin(phase * 360deg));
                    width: 9px;
                    height: 9px;
                    y: -self.wave * 5px;
                    border-radius: 4.5px;
                    background: Theme.accent-text;
                    opacity: 0.55 + self.wave * 0.45;
                }
            }
        }
    }
}
