import { Theme } from "theme.slint";

// Loading splash: a centred glass card with the app mark and a smooth
// spinner. It covers the window until `loading` turns false, then fades out
// and unmounts (so the spinner stops driving redraws).
export component Splash inherits Rectangle {
    in property <bool> loading: true;
    out property <float> progress: root.loading ? 1.0 : 0.0;
    animate progress { duration: Theme.motion-slow; easing: ease-in-out; }
    out property <bool> mounted: root.loading || root.progress > 0.001;
    // Nothing below exists once the fade has finished: no blur layer, no
    // timer, no animated dots, so an idle window never redraws for it.
    visible: root.mounted;
    property <int> step: 0;
    Timer {
        running: root.loading;
        interval: 320ms;
        triggered => { root.step = Math.mod(root.step + 1, 3); }
    }
    if root.mounted: Rectangle {
        width: parent.width;
        height: parent.height;
        opacity: root.progress;
        // Full-window veil: frosts everything behind the card (one blur).
        background: Theme.glass ? Theme.glass-fill : Theme.bg;
        backdrop-blur: 0px;
        if Theme.glass: Rectangle {
            background: Theme.glass-sheen;
        }
        // Swallow input while the app is not ready.
        TouchArea { }
        card := Rectangle {
            width: 220px;
            height: 200px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 + (1 - root.progress) * 6px;
            border-radius: 28px;
            background: Theme.glass ? Theme.glass-fill-soft : Theme.panel;
            border-width: 1px;
            border-color: Theme.glass ? Theme.glass-rim : Theme.border;
            drop-shadow-blur: 32px;
            drop-shadow-color: Theme.glass-shadow;
            Rectangle {
                width: parent.width;
                height: parent.height;
                border-radius: parent.border-radius;
                background: Theme.glass ? Theme.glass-sheen : transparent;
            }
            VerticalLayout {
                alignment: center;
                spacing: 14px;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 64px;
                        height: 64px;
                        border-radius: 16px;
                        clip: true;
                        Image {
                            source: @image-url("../zapive.png");
                            width: parent.width;
                            height: parent.height;
                            image-fit: contain;
                            accessible-role: none;
                        }
                    }
                }
                Text {
                    text: "Zapive";
                    color: Theme.text;
                    font-size: 20px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    for i in 3: Rectangle {
                        width: 9px;
                        height: 9px;
                        y: root.step == i ? -5px : 0px;
                        border-radius: 4.5px;
                        background: Theme.accent-text;
                        opacity: root.step == i ? 1.0 : 0.45;
                        animate y, opacity { duration: 220ms; easing: ease-in-out; }
                    }
                }
            }
        }
    }
}
