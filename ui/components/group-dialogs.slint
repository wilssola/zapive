import { LineEdit, ListView, VerticalBox } from "std-widgets.slint";
import { KeyFocus, FocusRing } from "a11y.slint";
import { Avatar } from "avatar.slint";
import { DialogButton } from "dialog-button.slint";
import { IconButton } from "icon-button.slint";
import { ModalLayer } from "modal.slint";
import { MemberRow } from "rows/member.slint";
import { Theme } from "theme.slint";
import { ChatItem, ForwardRecipient, MemberItem } from "types.slint";

export component ShareLayer inherits ModalLayer {
    in property <string> share-name;
    in property <image> share-avatar;
    in property <bool> share-has-avatar;
    in property <string> share-initial;
    in property <int> share-color-idx;
    in property <bool> share-sending;
    callback share-accept();
    callback share-cancel();

    if root.mounted: Rectangle {
        opacity: root.progress;
        transform-scale: 0.96 + 0.04 * root.progress;
        width: 500px;
        height: share-col.preferred-height + 48px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.panel;
        backdrop-blur: 0px;
        border-width: Theme.glass ? 1px : 0px;
        border-color: Theme.glass-rim;
        if Theme.glass: Rectangle {
            border-radius: parent.border-radius;
            background: Theme.glass-sheen;
        }
        border-radius: 20px;
        TouchArea { }
        share-col := VerticalLayout {
            padding: 24px;
            spacing: 14px;
            width: parent.width;
            HorizontalLayout {
                alignment: center;
                Avatar {
                    width: 66px;
                    height: 66px;
                    src: root.share-avatar;
                    has-image: root.share-has-avatar;
                    initial: root.share-initial;
                    color-idx: root.share-color-idx;
                }
            }
            Text {
                text: @tr("chat.history_share.title", root.share-name);
                color: Theme.text;
                font-size: 18px;
                font-weight: 700;
                wrap: word-wrap;
                width: parent.width - 48px;
            }
            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                Text {
                    text: root.share-name + " ";
                    color: Theme.text;
                    font-size: 14px;
                }
                Text {
                    text: @tr("chat.history_share.prefix");
                    color: Theme.text;
                    font-size: 14px;
                }
                Text {
                    text: @tr("chat.history_share.highlight");
                    color: Theme.accent;
                    font-size: 14px;
                }
                Text {
                    text: @tr("chat.history_share.suffix");
                    color: Theme.text;
                    font-size: 14px;
                }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                DialogButton {
                    label: @tr("chat.history_share.cancel");
                    clicked => { root.share-cancel(); }
                }
                DialogButton {
                    label: root.share-sending ? @tr("chat.history_share.sending") : @tr("chat.history_share.send");
                    primary: true;
                    enabled: !root.share-sending;
                    clicked => { root.share-accept(); }
                }
            }
        }
    }
}

export component NewListLayer inherits ModalLayer {
    callback menu-new-list(string);
    in-out property <bool> new-list-open;

    if root.mounted: Rectangle {
        opacity: root.progress;
        transform-scale: 0.96 + 0.04 * root.progress;
        width: 380px;
        height: list-col.preferred-height + 44px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.panel;
        backdrop-blur: 0px;
        border-width: Theme.glass ? 1px : 0px;
        border-color: Theme.glass-rim;
        if Theme.glass: Rectangle {
            border-radius: parent.border-radius;
            background: Theme.glass-sheen;
        }
        border-radius: 20px;
        TouchArea { }
        list-col := VerticalLayout {
            padding: 22px;
            spacing: 14px;
            width: parent.width;
            Text {
                text: @tr("chat.list.new_title");
                color: Theme.text;
                font-size: 17px;
                font-weight: 700;
            }
            Text {
                text: @tr("chat.list.new_hint");
                color: Theme.text-dim;
                font-size: 13px;
                wrap: word-wrap;
                width: parent.width - 44px;
            }
            new-list-name := LineEdit {
                placeholder-text: @tr("chat.list.name_placeholder");
                accepted => {
                    root.menu-new-list(self.text);
                    self.text = "";
                    root.new-list-open = false;
                }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                DialogButton {
                    label: @tr("chat.list.new_cancel");
                    clicked => { root.new-list-open = false; }
                }
                DialogButton {
                    label: @tr("chat.list.create");
                    primary: true;
                    clicked => {
                        root.menu-new-list(new-list-name.text);
                        new-list-name.text = "";
                        root.new-list-open = false;
                    }
                }
            }
        }
    }
}

export component MemberPickLayer inherits ModalLayer {
    in-out property <bool> member-pick-open;
    in property <[MemberItem]> member-rows;
    in property <int> member-count;
    callback member-search(string);
    callback member-toggle(string);
    callback member-confirm();

    if root.mounted: Rectangle {
        opacity: root.progress;
        transform-scale: 0.96 + 0.04 * root.progress;
        width: 420px;
        height: 560px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.panel;
        backdrop-blur: 0px;
        border-width: Theme.glass ? 1px : 0px;
        border-color: Theme.glass-rim;
        if Theme.glass: Rectangle {
            border-radius: parent.border-radius;
            background: Theme.glass-sheen;
        }
        border-radius: 20px;
        TouchArea { }
        VerticalBox {
            padding: 18px;
            spacing: 10px;
            HorizontalLayout {
                Text {
                    text: @tr("group.add_member.title");
                    color: Theme.text;
                    font-size: 17px;
                    font-weight: 700;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                IconButton {
                    label: @tr("common.action.close");
                    icon: @image-url("../icons/x.svg");
                    clicked => { root.member-pick-open = false; }
                }
            }
            LineEdit {
                placeholder-text: @tr("group.add_member.search_placeholder");
                edited => { root.member-search(self.text); }
            }
            ListView {
                for m in root.member-rows: MemberRow {
                    item: m;
                    pickable: true;
                    clicked => { root.member-toggle(m.jid); }
                }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Text {
                    text: @tr("group.add_member.selected_count.one" | "group.add_member.selected_count.other" % root.member-count);
                    color: Theme.text-dim;
                    font-size: 13px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                DialogButton {
                    label: @tr("group.add_member.confirm");
                    primary: true;
                    enabled: root.member-count > 0;
                    clicked => { root.member-confirm(); }
                }
            }
        }
    }
}

export component ForwardLayer inherits ModalLayer {
    in-out property <bool> forward-open;
    in property <[ForwardRecipient]> forward-rows;
    in property <[ChatItem]> forward-selected;
    in-out property <string> forward-filter: "recent";
    in property <string> forward-preview-text;
    in property <image> forward-preview-image;
    in property <bool> forward-preview-has-image;
    callback forward-search(string);
    callback forward-to(string);
    callback forward-clear();
    callback forward-confirm();
    callback forward-filter-changed(string);

    if root.mounted: Rectangle {
        search-focus := Timer {
            interval: 20ms;
            triggered => {
                self.running = false;
                if (root.forward-open) { fwd-search.focus(); }
            }
        }
        opacity: root.progress;
        transform-scale: 0.96 + 0.04 * root.progress;
        width: min(720px, root.width - 32px);
        height: min(760px, root.height - 32px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.panel;
        backdrop-blur: 0px;
        border-width: 1px;
        border-color: Theme.glass ? Theme.glass-rim : Theme.border;
        border-radius: 24px;
        if Theme.glass: Rectangle {
            border-radius: parent.border-radius;
            background: Theme.glass-sheen;
        }
        TouchArea { }
        VerticalLayout {
            padding: 24px;
            spacing: 16px;
            HorizontalLayout {
                height: 64px;
                spacing: 16px;
                Rectangle {
                    width: 52px;
                    Rectangle {
                        width: 52px;
                        height: 52px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 26px;
                        background: Theme.chip-active-bg;
                        Image {
                            source: @image-url("../icons/corner-up-right.svg");
                            colorize: Theme.accent-text;
                            width: 26px;
                            height: 26px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
                VerticalLayout {
                    padding-top: 7px;
                    padding-bottom: 7px;
                    spacing: 4px;
                    horizontal-stretch: 1;
                    Text {
                        text: @tr("message.forward.title");
                        color: Theme.text;
                        font-size: 23px;
                        font-weight: 700;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    Text {
                        text: @tr("message.forward.subtitle");
                        color: Theme.text-dim;
                        font-size: 13px;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    width: 40px;
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        label: @tr("common.action.close");
                        icon: @image-url("../icons/x.svg");
                        radius: 20px;
                        clicked => { root.forward-open = false; }
                    }
                }
            }
            Rectangle {
                height: 48px;
                border-radius: 14px;
                background: Theme.field;
                border-width: fwd-search.has-focus ? 2px : 1px;
                border-color: fwd-search.has-focus ? Theme.accent : Theme.field-border;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 12px;
                    Rectangle {
                        width: 20px;
                        Image {
                            source: @image-url("../icons/search.svg");
                            colorize: Theme.text-dim;
                            width: 20px;
                            height: 20px;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                    fwd-search := TextInput {
                        accessible-label: @tr("message.forward.search_placeholder");
                        color: Theme.text;
                        font-size: 14px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        single-line: true;
                        edited => { root.forward-search(self.text); }
                    }
                }
                if fwd-search.text == "": Text {
                    text: @tr("message.forward.search_placeholder");
                    color: Theme.text-dim;
                    font-size: 14px;
                    x: 48px;
                    width: parent.width - 64px;
                    vertical-alignment: center;
                    overflow: elide;
                    height: parent.height;
                }
            }
            HorizontalLayout {
                height: 36px;
                spacing: 8px;
                for filter in [
                    { key: "recent", label: @tr("message.forward.filter_recent"), icon: @image-url("../icons/clock-pause.svg") },
                    { key: "all", label: @tr("chat.filter.all"), icon: @image-url("../icons/list-details.svg") },
                    { key: "contacts", label: @tr("message.forward.filter_contacts"), icon: @image-url("../icons/users.svg") },
                    { key: "groups", label: @tr("chat.filter.groups"), icon: @image-url("../icons/users-group.svg") }
                ]: TouchArea {
                    width: filter-content.preferred-width;
                    height: 36px;
                    mouse-cursor: pointer;
                    accessible-role: tab;
                    accessible-label: filter.label;
                    accessible-item-selectable: true;
                    accessible-item-selected: root.forward-filter == filter.key;
                    accessible-action-default => { self.clicked(); }
                    forward-focus: filter-key;
                    clicked => {
                        root.forward-filter = filter.key;
                        root.forward-filter-changed(filter.key);
                    }
                    filter-key := KeyFocus {
                        activate => {
                            root.forward-filter = filter.key;
                            root.forward-filter-changed(filter.key);
                        }
                    }
                    Rectangle {
                        width: parent.width;
                        height: parent.height;
                        border-radius: 18px;
                        background: root.forward-filter == filter.key ? Theme.chip-active-bg
                            : parent.has-hover ? Theme.selected : Theme.chip-bg;
                        border-width: 1px;
                        border-color: root.forward-filter == filter.key ? Theme.chip-active-border
                            : Theme.glass ? Theme.glass-rim-soft : Theme.border;
                        filter-content := HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 6px;
                            Rectangle {
                                width: 16px;
                                Image {
                                    width: 16px;
                                    height: 16px;
                                    y: (parent.height - self.height) / 2;
                                    source: filter.icon;
                                    colorize: root.forward-filter == filter.key ? Theme.accent-text : Theme.text-dim;
                                }
                            }
                            Text {
                                text: filter.label;
                                color: root.forward-filter == filter.key ? Theme.accent-text : Theme.text-dim;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                    FocusRing {
                        width: parent.width;
                        height: parent.height;
                        border-radius: 18px;
                        shown: filter-key.has-focus;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            Rectangle {
                vertical-stretch: 1;
                ListView {
                    width: parent.width;
                    height: parent.height;
                    accessible-role: list;
                    accessible-label: @tr("message.forward.title");
                    accessible-item-count: root.forward-rows.length;
                    for recipient[i] in root.forward-rows: Rectangle {
                        height: 68px;
                        border-radius: 12px;
                        background: recipient.selected ? Theme.chat-active : fwd-touch.has-hover ? Theme.selected : transparent;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 16px;
                            spacing: 14px;
                            Rectangle {
                                width: 22px;
                                Rectangle {
                                    width: 22px;
                                    height: 22px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 6px;
                                    background: recipient.selected ? Theme.accent : transparent;
                                    border-width: 1px;
                                    border-color: recipient.selected ? Theme.accent : Theme.text-dim;
                                    if recipient.selected: Image {
                                        source: @image-url("../icons/check.svg");
                                        colorize: white;
                                        width: 16px;
                                        height: 16px;
                                        x: 3px;
                                        y: 3px;
                                    }
                                }
                            }
                            Rectangle {
                                width: 44px;
                                Avatar {
                                    width: 44px;
                                    height: 44px;
                                    y: (parent.height - self.height) / 2;
                                    src: recipient.chat.avatar;
                                    has-image: recipient.chat.hasAvatar;
                                    initial: recipient.chat.initial;
                                    color-idx: recipient.chat.colorIdx;
                                }
                            }
                            Text {
                                text: recipient.chat.name;
                                color: Theme.text;
                                font-size: 15px;
                                font-weight: recipient.selected ? 600 : 400;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            if recipient.favorite: Rectangle {
                                width: 18px;
                                Image {
                                    source: @image-url("../icons/star.svg");
                                    colorize: Theme.warning;
                                    width: 18px;
                                    height: 18px;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                        fwd-touch := TouchArea {
                            mouse-cursor: pointer;
                            accessible-role: list-item;
                            accessible-label: recipient.chat.name;
                            accessible-item-index: i;
                            accessible-item-count: root.forward-rows.length;
                            accessible-item-selectable: true;
                            accessible-item-selected: recipient.selected;
                            accessible-checkable: true;
                            accessible-checked: recipient.selected;
                            accessible-action-default => { root.forward-to(recipient.chat.jid); }
                            forward-focus: fwd-key;
                            clicked => { root.forward-to(recipient.chat.jid); }
                            fwd-key := KeyFocus {
                                activate => { root.forward-to(recipient.chat.jid); }
                            }
                            FocusRing {
                                shown: fwd-key.has-focus;
                                width: parent.width;
                                height: parent.height;
                                border-radius: 12px;
                            }
                        }
                    }
                }
                if root.forward-rows.length == 0: Text {
                    text: @tr("message.forward.empty");
                    color: Theme.text-dim;
                    font-size: 14px;
                    width: parent.width;
                    height: parent.height;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
            if root.forward-preview-text != "": Rectangle {
                height: 32px;
                border-radius: 8px;
                background: Theme.glass ? Theme.glass-fill-soft : Theme.well;
                Text {
                    x: 12px;
                    width: parent.width - 24px;
                    height: parent.height;
                    text: root.forward-preview-text;
                    color: Theme.text-dim;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                    wrap: no-wrap;
                }
            }
            Rectangle {
                height: 60px;
                border-radius: 14px;
                background: Theme.glass ? Theme.glass-fill-soft : Theme.tile;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 10px;
                    spacing: 10px;
                    Text {
                        text: @tr("message.forward.selected_count", root.forward-selected.length);
                        color: Theme.text;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    for index in min(3, root.forward-selected.length): Rectangle {
                        width: 32px;
                        Avatar {
                            width: 32px;
                            height: 32px;
                            y: (parent.height - self.height) / 2;
                            src: root.forward-selected[index].avatar;
                            has-image: root.forward-selected[index].hasAvatar;
                            initial: root.forward-selected[index].initial;
                            color-idx: root.forward-selected[index].colorIdx;
                        }
                    }
                    if root.forward-selected.length > 3: Rectangle {
                        width: 32px;
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 16px;
                            background: Theme.selected;
                            Text {
                                text: "+" + (root.forward-selected.length - 3);
                                color: Theme.text-dim;
                                font-size: 11px;
                                font-weight: 600;
                                width: parent.width;
                                height: parent.height;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Rectangle {
                        width: clear-button.width;
                        clear-button := DialogButton {
                            y: (parent.height - self.height) / 2;
                            label: @tr("message.forward.clear");
                            enabled: root.forward-selected.length > 0;
                            opacity: self.enabled ? 1 : 0.45;
                            clicked => { root.forward-clear(); }
                        }
                    }
                }
            }
            Rectangle {
                height: 1px;
                background: Theme.border;
            }
            HorizontalLayout {
                height: 40px;
                spacing: 12px;
                Rectangle { horizontal-stretch: 1; }
                DialogButton {
                    label: @tr("accessibility.cancel");
                    height: 40px;
                    clicked => { root.forward-open = false; }
                }
                DialogButton {
                    label: @tr("message.forward.confirm", root.forward-selected.length);
                    primary: true;
                    height: 40px;
                    enabled: root.forward-selected.length > 0;
                    opacity: self.enabled ? 1 : 0.45;
                    clicked => { root.forward-confirm(); }
                }
            }
        }
    }
}
