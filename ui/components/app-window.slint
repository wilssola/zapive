import { Button, ComboBox, LineEdit, ListView, ScrollView, VerticalBox, HorizontalBox, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { DetailRow, ChatItem, SearchHit, MemberItem, PdfPage, LabelItem, ReactionItem, CallItem, LinkSpan, AccountItem, StickerCell, MessageItem, EmojiRow } from "types.slint";
import { Avatar } from "avatar.slint";
import { GreenLink } from "green-link.slint";
import { IconButton } from "icon-button.slint";
import { FilterChip } from "filter-chip.slint";
import { DialogButton } from "dialog-button.slint";
import { Toggle } from "toggle.slint";
import { SettingsCard } from "settings-card.slint";
import { SettingsRow } from "settings-row.slint";
import { LinkHover } from "link-hover.slint";
import { EmojiText } from "emoji.slint";
import { UpdateBanner } from "update-banner.slint";
import { HomeScreen } from "home-screen.slint";
import { ImagePreview } from "image-preview.slint";
import { MenuRow } from "rows/menu.slint";
import { MemberRow } from "rows/member.slint";
import { HitRow } from "rows/hit.slint";
import { AccountRow } from "rows/account.slint";

// Delivery ticks drawn as vectors in WhatsApp's Material shape
// (done/done_all): the "✓" glyph comes from the emoji fallback font,
// whose wide bitmap cell leaves the two checks far apart; paths sit
// tight and render identically on every platform.
// Outlines: Material Icons (Apache 2.0), Google LLC,
// https://github.com/google/material-design-icons
component Ticks {
    in property <string> ticks;
    in property <bool> blue;
    property <length> mark-size: 14px;
    width: mark-size;
    height: mark-size;
    if ticks != "": Path {
        commands: ticks == "✓✓"
            ? "M18 7l-1.41-1.41-6.34 6.34 1.41 1.41L18 7zm4.24-1.41L11.66 16.17 7.48 12l-1.41 1.41L11.66 19l12-12-1.42-1.41zM.41 13.41L6 19l1.41-1.41L1.83 12 .41 13.41z"
            : "M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z";
        viewbox-width: 24;
        viewbox-height: 24;
        width: mark-size;
        height: mark-size;
        fill: blue ? #53bdeb : Theme.time-out;
    }
}

// The time/ticks cluster that floats at the bottom-right of a bubble's
// text block, on the space the trailing NBSP run reserves.
component BubbleMeta {
    in property <string> time;
    in property <string> ticks;
    in property <bool> blue;
    in property <bool> fromMe;
    height: 14px;
    HorizontalLayout {
        spacing: 4px;
        if ticks != "": Ticks { ticks: ticks; blue: blue; }
        Text {
            text: time;
            font-size: 10px;
            color: fromMe ? Theme.time-out : Theme.text-dim;
            vertical-alignment: center;
        }
    }
}

component MediaPlaceholder inherits TouchArea {
    in property <image> preview;
    in property <bool> privacy-blurred: false;
    in property <bool> sticker;
    in property <bool> video;
    in property <string> file-size;
    in property <bool> loading;
    in property <float> progress: -1;
    mouse-cursor: root.loading ? default : pointer;
    enabled: !root.loading;

    Rectangle {
        border-radius: 6px;
        clip: true;
        background: Theme.hover;
        Image {
            source: root.preview;
            width: parent.width;
            height: parent.height;
            image-fit: cover;
            opacity: root.privacy-blurred && !root.has-hover ? 0.05 : 1;
            animate opacity { duration: 120ms; easing: ease-out; }
        }
        Rectangle {
            width: parent.width;
            height: parent.height;
            visible: root.privacy-blurred && !root.has-hover;
            background: Theme.dark ? #172126 : #dfe5e8;
            animate background { duration: 120ms; easing: ease-out; }
        }
        Rectangle {
            width: parent.width;
            height: parent.height;
            backdrop-blur: 12px;
            visible: !root.privacy-blurred || root.has-hover;
            background: #00000050;
        }
        Rectangle {
            width: 50px;
            height: 50px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 25px;
            background: root.has-hover ? #ffffff28 : #ffffff18;
            Image {
                source: root.sticker ? @image-url("../icons/sticker-2.svg")
                    : root.video ? @image-url("../icons/video.svg")
                    : @image-url("../icons/photo.svg");
                width: 28px;
                height: 28px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                colorize: white;
            }
        }
        if root.loading: Text {
            text: root.progress < 0 ? @tr("Downloading…") : round(clamp(root.progress, 0, 100)) + "%";
            color: white;
            font-size: 11px;
            width: parent.width;
            horizontal-alignment: center;
            y: parent.height / 2 + 30px;
        }
        if root.file-size != "": Text {
            text: root.file-size;
            color: white;
            font-size: 11px;
            x: parent.width - self.width - 8px;
            y: parent.height - self.height - 6px;
        }
    }
}

component InfoAction inherits TouchArea {
    in property <image> icon;
    in property <string> label;
    mouse-cursor: self.enabled ? pointer : default;
    height: 62px;
    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 12px;
        background: root.has-hover && root.enabled ? Theme.selected : Theme.dark ? #15262d : Theme.header;
        opacity: root.enabled ? 1 : 0.4;
        Image {
            source: root.icon;
            colorize: Theme.icon;
            width: 20px;
            height: 20px;
            x: (parent.width - self.width) / 2;
            y: 11px;
        }
        Text {
            text: root.label;
            color: Theme.text-dim;
            font-size: 11px;
            width: parent.width;
            height: 16px;
            y: 37px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component TypingBubbles inherits Rectangle {
    in property <[MemberItem]> members;
    in property <int> extra;
    in property <bool> privacy-blurred;
    property <int> avatar-count: min(root.members.length, 5) + (root.extra > 0 ? 1 : 0);
    property <int> bounce-phase: 0;
    width: root.avatar-count * 22px + 54px;
    height: 32px;
    Timer {
        interval: 160ms;
        running: root.members.length > 0;
        triggered => { root.bounce-phase = mod(root.bounce-phase + 1, 8); }
    }
    for member[index] in root.members: Rectangle {
        visible: index < 5;
        x: index * 22px;
        y: 1px;
        width: 30px;
        height: 30px;
        border-radius: 15px;
        background: Theme.conv-bg;
        typing-hover := TouchArea { enabled: false; }
        Avatar {
            x: 2px;
            y: 2px;
            width: 26px;
            height: 26px;
            src: member.avatar;
            has-image: member.hasAvatar;
            initial: member.initial;
            color-idx: member.colorIdx;
            privacy-blurred: root.privacy-blurred;
            privacy-reveal: typing-hover.has-hover;
        }
    }
    if root.extra > 0: Rectangle {
        x: min(root.members.length, 5) * 22px;
        y: 1px;
        width: 30px;
        height: 30px;
        border-radius: 15px;
        border-width: 2px;
        border-color: Theme.conv-bg;
        background: Theme.chip-bg;
        Text {
            text: "+" + root.extra;
            color: Theme.text;
            font-size: 10px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Rectangle {
        x: root.avatar-count * 22px + 12px;
        y: 1px;
        width: 42px;
        height: 30px;
        border-radius: 15px;
        background: Theme.bubble-in;
        Rectangle {
            x: 1px;
            y: 21px;
            width: 8px;
            height: 7px;
            border-bottom-right-radius: 7px;
            background: Theme.bubble-in;
        }
        for index in 3: Rectangle {
            x: 11px + index * 8px;
            y: root.bounce-phase == index + 1 || root.bounce-phase == index + 2 ? 9px : 14px;
            width: 4px;
            height: 4px;
            border-radius: 2px;
            background: Theme.dark ? #ad93ff : #7654d6;
            animate y { duration: 240ms; easing: ease-in-out; }
        }
    }
}

export component AppWindow inherits Window {
    title: "Zapive";
    icon: @image-url("../zapive.png");
    preferred-width: 1100px;
    preferred-height: 700px;
    in property <bool> native-backdrop: false;
    in-out property <string> theme-style: "glass";
    in-out property <bool> notifications: true;
    in-out property <bool> notify-previews: false;
    in-out property <bool> blur-names: false;
    in-out property <bool> blur-photos: false;
    in-out property <bool> blur-messages: false;
    in-out property <bool> blur-media: false;
    in property <bool> window-active: true;
    callback style-changed(string);
    callback notifications-changed(bool);
    callback notify-previews-changed(bool);
    callback privacy-blur-changed(string, bool);
    // Glass only while the OS backdrop is live and the window has focus;
    // an unfocused backdrop turns grey, so fall back to the opaque theme.
    out property <bool> glass: native-backdrop && theme-style == "glass" && window-active;
    background: glass ? transparent : Theme.bg;
    default-font-weight: 400;
    init => {
        Palette.color-scheme = root.dark-theme ? ColorScheme.dark : ColorScheme.light;
        Theme.dark = root.dark-theme;
    }

    // Theme + language (resolved by the host)
    in-out property <bool> dark-theme: true;
    in-out property <string> theme-mode: "dark";      // "dark" | "light" | "system"
    in-out property <string> language-mode: "system"; // "pt" | "en" | "system"
    callback theme-changed(string);
    callback language-changed(string);
    changed dark-theme => {
        Theme.dark = self.dark-theme;
        Palette.color-scheme = self.dark-theme ? ColorScheme.dark : ColorScheme.light;
    }

    // "locked" | "login" | "main"
    in-out property <string> screen: "login";
    changed screen => {
        if (self.screen == "main") { capture-scope.focus(); }
    }
    in-out property <string> status-text: @tr("Connecting...");

    // Lock screen
    in-out property <string> lock-error: "";
    callback unlock(string);

    // Login
    in-out property <image> qr-image;
    in-out property <bool> pairing-mode: false;
    in-out property <string> pairing-code: "";
    callback request-pairing-code(string);
    // Blocking error the user has to answer (session taken over, offline).
    in-out property <bool> alert-open;
    in-out property <string> alert-title;
    in-out property <string> alert-text;
    in-out property <string> alert-action;
    callback alert-retry();
    callback alert-dismiss();

    // Chats
    in-out property <[ChatItem]> chats;
    in-out property <[ChatItem]> statuses;
    in-out property <string> sidebar-view: "chats";
    in-out property <int> chats-unread-count: 0;
    in-out property <int> channels-unread-count: 0;
    in-out property <int> communities-unread-count: 0;
    in-out property <int> calls-unseen-count: 0;
    in-out property <bool> statuses-unseen: false;
    callback status-open(string);
    callback view-changed(string);
    // Calls (the ringing/in-call UI lives in CallWindow)
    in-out property <[CallItem]> calls;
    // Voice calls only make sense one-to-one, so groups, channels and
    // status hide the button.
    in-out property <bool> current-callable: false;
    callback start-call(string);
    callback start-video-call(string);
    // Audio and camera pickers in Settings. The first entry of each list
    // is the "system default" label.
    in-out property <[string]> mic-devices;
    in-out property <[string]> speaker-devices;
    in-out property <[string]> camera-devices;
    in-out property <string> mic-device;
    in-out property <string> speaker-device;
    in-out property <string> camera-device;
    callback device-changed(string, string);
    callback settings-opened();
    // Status viewer
    in-out property <bool> sv-open: false;
    in-out property <string> sv-name: "";
    in-out property <string> sv-time: "";
    in-out property <string> sv-text: "";
    in-out property <bool> sv-has-image: false;
    in-out property <image> sv-image;
    in-out property <int> sv-index: 0;
    in-out property <int> sv-count: 0;
    callback status-next();
    callback status-prev();
    callback status-close();
    in-out property <string> selected-jid: "";
    in-out property <string> chat-tab: "all";
    in-out property <int> archived-unread-count: 0;
    in-out property <bool> archived-mentioned: false;
    callback open-chat(string);
    // Fired when the pointer settles on a chat row: the backend preloads
    // that chat's messages so a likely click opens instantly.
    callback chat-hover(string);
    // Self-update: 0 = idle, 1 = update available, 2 = downloading,
    // 3 = installed (restart pending).
    in-out property <int> update-state: 0;
    in-out property <string> update-version;
    in property <string> update-error;
    in-out property <string> app-version;
    callback update-check();
    callback update-apply();
    callback update-restart();
    callback search-changed(string);
    callback tab-changed(string);

    // Conversation
    in-out property <bool> chat-open: false;
    out property <length> composer-tail-space: composer-dock.height + 8px;
    in-out property <string> sync-banner: "";
    in-out property <string> current-chat-name;
    in-out property <string> current-jid: "";
    in-out property <string> current-status: "";
    in-out property <image> current-avatar;
    in-out property <bool> current-avatar-has: false;
    in-out property <string> current-initial: "";
    in-out property <int> current-color-idx: 0;
    in-out property <[MessageItem]> messages;
    in-out property <[MemberItem]> typing-members;
    in-out property <int> typing-extra: 0;
    in-out property <bool> attach-open: false;
    in-out property <bool> stick-bottom: true;
    // Kept invisible until the host anchors it, so opening a chat never
    // shows the list scrolling into place.
    in-out property <bool> conv-ready: false;
    in-out property <bool> picker-open: false;
    in-out property <string> picker-tab: "emoji";
    in-out property <[EmojiRow]> emoji-rows;
    in-out property <[[StickerCell]]> sticker-rows;
    in-out property <[[StickerCell]]> gif-rows;
    in-out property <[[StickerCell]]> fav-rows;
    callback gif-send(string);
    in-out property <length> conv-scroll: 0;
    in-out property <length> conv-viewport-h: 0;
    // Cleared when a chat is opened anchored on a message, so landing at
    // the top does not immediately pull the older rows back in.
    in-out property <bool> scroll-armed: true;
    in-out property <bool> rec-active: false;
    in-out property <string> rec-elapsed: "0:00";
    in-out property <bool> rec-view-once: false;
    callback jump-latest();
    // Contact / group info
    in-out property <bool> info-open: false;
    in-out property <string> info-name: "";
    in-out property <string> info-id: "";
    in-out property <string> info-about: "";
    in-out property <string> info-desc: "";
    in-out property <bool> info-is-group: false;
    in-out property <string> info-members: "";
    in-out property <bool> info-archived: false;
    in-out property <image> info-avatar;
    in-out property <bool> info-has-avatar: false;
    in-out property <string> info-initial: "";
    in-out property <int> info-color-idx: 0;
    in-out property <[[StickerCell]]> info-media;
    callback open-info();
    callback close-info();
    callback toggle-archive();
    callback clear-chat();
    callback rec-start();
    callback rec-stop();
    callback rec-cancel();
    callback emoji-pick(string);
    callback sticker-send(string);
    callback picker-opened();
    callback picker-closed();
    changed picker-open => {
        if (!self.picker-open) { root.picker-closed(); }
    }
    callback gif-search(string);
    in-out property <string> gif-hint: "";
    in-out property <string> fav-hint: "";
    callback attach-sticker();
    callback send-message(string);
    callback attach-image();
    callback attach-audio();
    callback attach-doc();
    callback play-audio(string);
    callback copy-text(string);
    callback copy-image(string);
    // A plain click on a styled message, as a byte offset into `plain`.
    callback open-link-at(string, int);
    callback audio-toggle(string);
    callback audio-seek(string, float);
    callback audio-cycle-rate();
    // Who reacted to a message, opened from the reaction chip.
    in-out property <[ReactionItem]> reaction-rows;
    in-out property <string> reactions-title;
    in-out property <bool> reactions-open;
    callback show-reactions(string);
    callback request-reply(string);
    callback open-quote(string, string);
    callback toggle-star(string);
    callback delete-message(string);
    callback message-action(string, string);
    callback submit-edit(string, string);
    in-out property <bool> details-open;
    in-out property <string> details-id;
    in-out property <string> details-text;
    in-out property <image> details-image;
    in-out property <bool> details-has-image;
    in-out property <[DetailRow]> details-rows;
    in-out property <bool> message-dialog-open;
    in-out property <bool> message-dialog-edit;
    in-out property <string> message-dialog-title;
    in-out property <string> message-dialog-text;
    in-out property <string> message-dialog-id;
    property <int> message-menu-request;
    property <length> message-menu-request-x;
    property <length> message-menu-request-y;
    property <MessageItem> menu-message;
    in-out property <bool> message-menu-open;
    property <length> message-menu-x;
    property <length> message-menu-y;
    public function open-message-menu(x: float, y: float) -> bool {
        if (root.screen != "main" || !root.chat-open || !root.conv-ready || root.select-mode
            || root.message-menu-open || root.message-dialog-open || root.details-open || root.confirm-open
            || root.settings-open || root.forward-open || root.share-open || root.preview-open
            || root.lightbox-open || root.video-open || root.pdf-open || root.sv-open
            || root.alert-open || root.member-pick-open || root.reactions-open
            || root.picker-open || root.attach-open || root.chat-menu-open || root.account-menu-open
            || x * 1px < msg-list.absolute-position.x || x * 1px >= msg-list.absolute-position.x + msg-list.width
            || y * 1px < contact-header.absolute-position.y + contact-header.height
            || y * 1px >= composer-dock.absolute-position.y) {
            return false;
        }
        root.message-menu-request-x = x * 1px;
        root.message-menu-request-y = y * 1px;
        root.message-menu-request += 1;
        return true;
    }
    callback react-to(string, string);
    callback react-pick(string);
    // Quick reaction bar: the message it belongs to, empty when hidden.
    in-out property <string> react-bar-id;
    // Reply being composed.
    in-out property <bool> reply-open;
    in-out property <string> reply-name;
    in-out property <string> reply-text;
    callback cancel-reply();
    in-out property <string> audio-rate-label: "1x";
    // Mini player shown while a voice note plays in another chat.
    in-out property <bool> mini-audio;
    in-out property <string> mini-audio-name;
    in-out property <image> mini-audio-avatar;
    in-out property <bool> mini-audio-avatar-has;
    in-out property <string> mini-audio-initial;
    in-out property <int> mini-audio-color-idx;
    in-out property <bool> mini-audio-playing;
    in-out property <float> mini-audio-progress;
    callback mini-audio-toggle();
    callback mini-audio-open();
    callback mini-audio-close();
    callback load-older();
    callback paste-clipboard();
    callback open-dm(string);
    callback request-forward(string);

    // Forward picker
    in-out property <bool> forward-open: false;
    in-out property <[ChatItem]> forward-rows;
    in-out property <string> forward-preview-text;
    in-out property <image> forward-preview-image;
    in-out property <bool> forward-preview-has-image;
    callback forward-search(string);
    callback forward-to(string);

    // Sync banner and its progress dialog
    in-out property <bool> sync-open: false;
    in-out property <string> sync-detail: "";
    callback sync-clicked();

    // Composer state the host needs: mentions and who may write here.
    in-out property <bool> current-can-send: true;
    in-out property <bool> current-left: false;
    in-out property <bool> current-is-group: false;
    in-out property <bool> current-admin: false;
    in-out property <bool> current-muted: false;
    in-out property <string> current-mute-label: "";
    in-out property <bool> current-favorite: false;
    in-out property <int> current-ephemeral: 0;
    in-out property <string> current-ephemeral-label: "";
    out property <string> composer-text: message-input.text;
    callback composer-changed(string, int);
    in-out property <bool> mention-open: false;
    in-out property <[MemberItem]> mention-rows;
    callback mention-pick(int);
    callback mention-close();

    // Selection mode over the conversation
    in-out property <bool> select-mode: false;
    in-out property <int> select-count: 0;
    callback select-start(string);
    callback toggle-select(string);
    callback select-cancel();
    callback select-copy();
    callback select-forward();
    callback select-star();
    callback select-delete();

    // Chat header menu
    in-out property <bool> chat-menu-open: false;
    // "" | "mute" | "ephemeral" | "lists"
    in-out property <string> chat-menu-sub: "";
    in-out property <[LabelItem]> labels;
    in-out property <[LabelItem]> label-chips;
    callback menu-add-member();
    callback menu-search();
    callback menu-mute(int);
    callback menu-ephemeral(int);
    callback menu-favorite();
    callback menu-list(string);
    callback menu-new-list(string);
    callback menu-delete-list(string);
    callback menu-export();
    callback menu-close-chat();
    callback menu-clear();
    callback menu-delete-chat();
    callback menu-exit-group();
    in-out property <bool> new-list-open: false;

    // Confirm dialog
    in-out property <bool> confirm-open: false;
    in-out property <string> confirm-title;
    in-out property <string> confirm-text;
    in-out property <string> confirm-action;
    in-out property <string> confirm-secondary;
    callback confirm-accept();
    callback confirm-other();

    // Member picker (add to group) and the group roster
    in-out property <bool> member-pick-open: false;
    in-out property <[MemberItem]> member-rows;
    in-out property <int> member-count: 0;
    callback member-search(string);
    callback member-toggle(string);
    callback member-confirm();
    in-out property <[MemberItem]> info-member-rows;
    in-out property <[MemberItem]> info-common-groups;
    in-out property <string> info-common-groups-state;
    callback open-member(string);

    // Search: sidebar hits across chats, and the in-chat panel
    in-out property <[SearchHit]> search-hits;
    callback open-hit(string, string);
    in-out property <bool> chat-search-open: false;
    in-out property <[SearchHit]> chat-search-rows;
    in-out property <string> chat-search-count: "";
    callback chat-search-changed(string);
    callback chat-search-step(int);
    callback chat-search-close();
    // The message a search just jumped to; drawn with a flash.
    in-out property <string> highlight-id: "";

    // Floating day header while the conversation scrolls.
    in-out property <string> floating-day: "";
    in-out property <bool> scrolling: false;
    callback day-at-top(string);
    // Every visible row reports where it sits (list coordinates) so a
    // drag across the conversation can pick the rows it covers.
    callback row-geom(string, float, float);
    callback conv-scrolled();
    callback drag-start(string, float);
    callback drag-move(float);
    callback drag-end();

    // Documents
    callback doc-view(string);
    callback doc-save(string);

    // PDF viewer
    in-out property <bool> pdf-open: false;
    in-out property <string> pdf-title: "";
    in-out property <[PdfPage]> pdf-pages;
    in-out property <float> pdf-total-h: 0;
    in-out property <float> pdf-total-w: 0;
    in-out property <int> pdf-page: 0;
    in-out property <int> pdf-count: 0;
    in-out property <string> pdf-zoom-label: "100%";
    in-out property <string> pdf-status: "";
    in-out property <bool> pdf-engine-missing: false;
    in-out property <bool> pdf-installing: false;
    out property <float> pdf-view-w: pdf-flick.width / 1px;
    out property <float> pdf-view-h: pdf-flick.height / 1px;
    out property <float> pdf-scroll: -pdf-flick.viewport-y / 1px;
    callback pdf-close();
    callback pdf-scrolled(float);
    callback pdf-zoom(int);
    callback pdf-goto(int);
    callback pdf-view-resized();
    callback pdf-open-external();
    callback pdf-save-as();
    callback pdf-install-engine();
    public function pdf-set-scroll(y: float) {
        pdf-flick.viewport-y = -y * 1px;
    }

    // Status viewer: video updates
    in-out property <bool> sv-is-video: false;
    in-out property <bool> sv-video-ready: false;
    callback status-play();

    public function focus-composer() {
        if (root.screen == "main" && root.chat-open && root.current-can-send && !root.select-mode
            && !root.message-menu-open && !root.message-dialog-open && !root.details-open && !root.confirm-open
            && !root.settings-open && !root.forward-open && !root.share-open && !root.preview-open
            && !root.lightbox-open && !root.video-open && !root.pdf-open && !root.sv-open
            && !root.alert-open && !root.member-pick-open && !root.reactions-open
            && !root.picker-open && !root.attach-open && !root.chat-menu-open && !root.account-menu-open
            && !root.chat-search-open && !root.sync-open && !root.new-list-open && !root.info-open) {
            message-input.focus();
        }
    }
    public function append-composer(t: string) {
        message-input.text = message-input.text + t;
    }
    // The host rewrote the composer (a mention was picked).
    public function set-composer(t: string, cursor: int) {
        message-input.text = t;
        message-input.set-selection-offsets(cursor, cursor);
        message-input.focus();
    }
    public function scroll-conversation-end() {
        msg-list.viewport-y = min(0px, msg-list.height - msg-list.viewport-height);
    }
    public function scroll-conversation-top() {
        msg-list.viewport-y = 0;
    }
    public function set-conversation-scroll(y: length) {
        msg-list.viewport-y = y;
    }

    // Settings
    in-out property <bool> settings-open: false;
    in-out property <bool> pin-set: false;
    in-out property <bool> autostart: false;
    in-out property <string> settings-status: "";
    callback autostart-changed(bool);
    callback save-pin(string, string);
    callback remove-pin(string);
    callback logout();
    // Accounts (up to five, one loaded at a time).
    in property <[AccountItem]> accounts;
    // The loaded one, for the rail.
    in property <AccountItem> my-account;
    in property <int> account-count: 1;
    in property <bool> can-add-account: true;
    in-out property <bool> account-menu-open: false;
    in property <bool> account-switching: false;
    // The login screen: conversations a past session left on disk, and
    // the number they belong to.
    in property <bool> kept-conversations: false;
    in property <string> kept-number;
    callback switch-account(string);
    callback add-account();
    callback remove-account(string);
    callback forget-conversations();
    // Privacy: both off by default (see Bridge::send_view_receipts and
    // the deletion routing in Bridge::on_messages).
    in-out property <bool> send-receipts: false;
    in-out property <bool> apply-deletions: false;
    callback send-receipts-changed(bool);
    callback apply-deletions-changed(bool);
    callback download-media(string);
    in-out property <bool> auto-download-photos: true;
    callback auto-download-photos-changed(bool);
    in-out property <bool> auto-download-audio: true;
    callback auto-download-audio-changed(bool);
    in-out property <bool> auto-download-video: true;
    callback auto-download-video-changed(bool);
    in-out property <bool> auto-download-documents: true;
    callback auto-download-documents-changed(bool);
    in-out property <bool> auto-download-stickers: true;
    callback auto-download-stickers-changed(bool);

    // Lightbox
    in-out property <bool> lightbox-open: false;
    in-out property <image> lightbox-image;
    in-out property <string> lightbox-id: "";
    callback open-lightbox(string);
    callback notice-clicked(string);

    // Share the group's recent history with someone who joined by link.
    in-out property <bool> share-open: false;
    in-out property <string> share-name: "";
    in-out property <image> share-avatar;
    in-out property <bool> share-has-avatar: false;
    in-out property <string> share-initial: "";
    in-out property <int> share-color-idx: 0;
    in-out property <bool> share-sending: false;
    callback share-accept();
    callback share-cancel();
    // In-app video player
    in-out property <bool> video-open: false;
    in-out property <image> video-frame;
    in-out property <int> video-w: 0;
    in-out property <int> video-h: 0;
    callback open-video(string);
    callback close-video();
    // The hand cursor over links (see LinkHover): a press on a link's box
    // is played again by the host with the boxes stepped aside.
    in-out property <bool> link-press-through: false;
    in-out property <bool> link-release-seen: false;
    callback link-pressed(length, length);
    // A clip gets the transport; the GIF zoom is just the picture.
    in property <bool> video-is-clip: false;
    in property <bool> video-loading: false;
    in property <bool> video-playing: false;
    in property <bool> video-ended: false;
    in property <float> video-progress: 0;
    in property <string> video-pos-label: "0:00";
    in property <string> video-duration-label: "0:00";
    in property <float> video-volume: 1;
    in property <bool> video-muted: false;
    callback video-toggle();
    // A fraction of the clip's length.
    callback video-seek(float);
    // Seconds, either way.
    callback video-seek-by(float);
    callback video-set-volume(float);
    callback video-mute-toggle();
    callback video-save();

    // Send-image preview (paste / attach confirmation)
    in-out property <bool> preview-open: false;
    in-out property <image> preview-image;
    callback confirm-send-image(string);
    callback cancel-send-image();
    callback crop-preview(float, float, float, float);
    callback text-preview(string, float, float);
    callback draw-preview(string, color, float);
    in-out property <bool> preview-busy: false;
    callback reset-preview();
    public function focus-preview-caption() { image-editor.focus-caption(); }
    changed preview-open => {
        if (!root.preview-open) { image-editor.clear(); }
    }

    // ---------- Lock screen ----------
    if root.screen == "locked": VerticalBox {
        alignment: center;
        spacing: 14px;
        HorizontalBox {
            alignment: center;
            UpdateBanner {
                width: 360px;
                inset: 0;
                state: root.update-state;
                version: root.update-version;
                error: root.update-error;
                apply-update => { root.update-apply(); }
                restart => { root.update-restart(); }
            }
        }
        HorizontalBox {
            alignment: center;
            spacing: 10px;
            Image {
                source: @image-url("../icons/lock.svg");
                colorize: Theme.text;
                width: 26px;
                height: 26px;
                y: 2px;
            }
            Text {
                text: "Zapive";
                color: Theme.text;
                font-size: 26px;
                font-weight: 700;
            }
        }
        Text {
            text: @tr("Enter your PIN to unlock");
            color: Theme.text-dim;
            font-size: 14px;
            horizontal-alignment: center;
        }
        HorizontalBox {
            alignment: center;
            pin-input := LineEdit {
                width: 220px;
                input-type: password;
                placeholder-text: @tr("PIN");
                accepted => { root.unlock(self.text); self.text = ""; }
            }
            Button {
                text: @tr("Unlock");
                primary: true;
                clicked => { root.unlock(pin-input.text); pin-input.text = ""; }
            }
        }
        Text {
            text: root.lock-error;
            color: #f05d4d;
            font-size: 13px;
            horizontal-alignment: center;
        }
    }

    // ---------- Login ----------
    if root.screen == "login": VerticalBox {
        alignment: center;
        HorizontalBox {
            alignment: center;
            UpdateBanner {
                width: 820px;
                inset: 0;
                state: root.update-state;
                version: root.update-version;
                error: root.update-error;
                apply-update => { root.update-apply(); }
                restart => { root.update-restart(); }
            }
        }
        HorizontalBox {
            alignment: center;
            Rectangle {
                width: 820px;
                height: 420px;
                background: Theme.panel;
                border-radius: 12px;

                if !root.pairing-mode: HorizontalLayout {
                    padding: 48px;
                    spacing: 40px;
                    VerticalLayout {
                        alignment: start;
                        spacing: 22px;
                        horizontal-stretch: 1;
                        Text {
                            text: @tr("Log in to WhatsApp");
                            color: Theme.text;
                            font-size: 24px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.status-text;
                            color: Theme.text-dim;
                            font-size: 13px;
                        }
                        Text { text: @tr("1.  Open WhatsApp on your phone"); color: Theme.text; font-size: 15px; }
                        Text { text: @tr("2.  Tap Menu and then Linked devices"); color: Theme.text; font-size: 15px; }
                        Text { text: @tr("3.  Tap Link a device"); color: Theme.text; font-size: 15px; }
                        Text { text: @tr("4.  Point your camera at this code"); color: Theme.text; font-size: 15px; }
                        Rectangle { height: 8px; }
                        GreenLink {
                            label: @tr("Log in with phone number  ›");
                            clicked => { root.pairing-mode = true; }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 264px;
                            height: 264px;
                            background: white;
                            border-radius: 8px;
                            Image {
                                source: root.qr-image;
                                width: 240px;
                                height: 240px;
                                image-rendering: pixelated;
                            }
                        }
                    }
                }

                if root.pairing-mode: VerticalLayout {
                    padding: 48px;
                    spacing: 20px;
                    alignment: start;
                    Text {
                        text: @tr("Log in with phone number");
                        color: Theme.text;
                        font-size: 24px;
                        font-weight: 700;
                    }
                    Text {
                        text: @tr("Enter your number with the country code to receive a code to type on your phone.");
                        color: Theme.text-dim;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        phone-input := LineEdit {
                            width: 300px;
                            placeholder-text: @tr("E.g.: 5511999998888");
                        }
                        Button {
                            text: @tr("Get code");
                            primary: true;
                            clicked => { root.request-pairing-code(phone-input.text); }
                        }
                    }
                    Text {
                        text: root.pairing-code;
                        color: Theme.accent;
                        font-size: 36px;
                        font-weight: 700;
                        letter-spacing: 4px;
                    }
                    Rectangle { vertical-stretch: 1; }
                    GreenLink {
                        label: @tr("‹  Back to QR code");
                        clicked => { root.pairing-mode = false; }
                    }
                }
            }
        }
        // A past session's conversations are still here: linking the
        // same number again carries on from them.
        if root.kept-conversations: HorizontalBox {
            alignment: center;
            Rectangle {
                width: 820px;
                height: kept-row.preferred-height;
                background: Theme.panel;
                border-radius: 12px;
                kept-row := HorizontalLayout {
                    padding: 16px;
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 16px;
                    Image {
                        source: @image-url("../icons/archive.svg");
                        colorize: Theme.accent;
                        width: 22px;
                        height: 22px;
                        y: (parent.height - self.height) / 2;
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;
                        horizontal-stretch: 1;
                        Text {
                            text: root.kept-number != ""
                                ? @tr("Conversations of {} are saved on this computer", root.kept-number)
                                : @tr("Conversations are saved on this computer");
                            color: Theme.text;
                            font-size: 14px;
                            font-weight: 600;
                            wrap: word-wrap;
                        }
                        Text {
                            text: @tr("Link the same number and the app picks up where it left off, without downloading everything again. A different number starts clean.");
                            color: Theme.text-dim;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        DialogButton {
                            label: @tr("Erase");
                            clicked => { root.forget-conversations(); }
                        }
                    }
                }
            }
        }
        if root.account-count > 1: HorizontalBox {
            alignment: center;
            Rectangle {
                width: 820px;
                height: others-col.preferred-height;
                background: Theme.panel;
                border-radius: 12px;
                others-col := VerticalLayout {
                    padding: 10px;
                    spacing: 2px;
                    Text {
                        text: @tr("Other accounts");
                        color: Theme.text-dim;
                        font-size: 12px;
                        height: 24px;
                        x: 12px;
                        vertical-alignment: center;
                    }
                    for acc in root.accounts: AccountRow {
                        visible: !acc.active;
                        height: acc.active ? 0 : 52px;
                        account: acc;
                        enabled: !root.account-switching;
                        clicked => { root.switch-account(acc.id); }
                        remove => { root.remove-account(acc.id); }
                    }
                }
            }
        }
    }

    // ---------- Main ----------
    // capture-key-pressed sees Ctrl+V even while the composer LineEdit is
    // focused; rejecting keeps normal text paste working while the app
    // checks the clipboard for an image (WhatsApp-style paste-to-send).
    capture-scope := FocusScope {
        visible: root.screen == "main";
        capture-key-pressed(event) => {
            if (event.text == "f" && event.modifiers.control) {
                search-box.focus();
                return accept;
            }
            if (event.text == "v" && event.modifiers.control && root.chat-open) {
                root.paste-clipboard();
            }
            if (event.text == "c" && event.modifiers.control && root.select-mode) {
                root.select-copy();
                return accept;
            }
            if (event.text == Key.Escape) {
                if (root.video-open) { root.close-video(); }
                else if (root.lightbox-open) { root.lightbox-open = false; }
                else if (root.pdf-open) { root.pdf-close(); }
                else if (root.message-menu-open) { root.message-menu-open = false; }
                else if (root.details-open) { root.details-open = false; }
                else if (root.message-dialog-open) { root.message-dialog-open = false; }
                else if (root.confirm-open) { root.confirm-open = false; }
                else if (root.preview-open) { root.cancel-send-image(); }
                else if (root.share-open) { root.share-cancel(); }
                else if (root.member-pick-open) { root.member-pick-open = false; }
                else if (root.new-list-open) { root.new-list-open = false; }
                else if (root.forward-open) { root.forward-open = false; }
                else if (root.settings-open) { root.settings-open = false; }
                else if (root.account-menu-open) { root.account-menu-open = false; }
                else if (root.sv-open) { root.status-close(); }
                else if (root.sync-open) { root.sync-open = false; }
                else if (root.chat-menu-open) { root.chat-menu-open = false; }
                else if (root.mention-open) { root.mention-close(); }
                else if (root.picker-open) { root.picker-open = false; }
                else if (root.attach-open) { root.attach-open = false; }
                else if (root.select-mode) { root.select-cancel(); }
                else if (root.info-open) { root.close-info(); }
                else if (root.chat-search-open) { root.chat-search-close(); }
                else {
                    root.menu-close-chat();
                    root.sidebar-view = "chats";
                    root.view-changed("chats");
                    search-box.text = "";
                    root.search-changed("");
                }
                capture-scope.focus();
                return accept;
            }
            reject
        }

    main-pane := HorizontalLayout {
        padding: 0;
        spacing: 0;

        // Icon rail
        Rectangle {
            width: 60px;
            background: Theme.dark ? #1c2c35 : Theme.header;
            VerticalLayout {
                width: 100%;
                padding: 10px;
                spacing: 8px;
                alignment: start;
                IconButton {
                    icon: @image-url("../icons/message-circle.svg");
                    active-background: Theme.dark ? #1a3d37 : Theme.chip-active-bg;
                    tint: self.active ? (Theme.dark ? #39d99b : Theme.accent) : Theme.icon;
                    badge-border: Theme.dark ? #1c2c35 : Theme.header;
                    badge-count: root.chats-unread-count;
                    active: root.sidebar-view == "chats";
                    clicked => {
                        root.sidebar-view = "chats";
                        root.view-changed("chats");
                    }
                }
                IconButton {
                    icon: @image-url("../icons/circle-dot.svg");
                    active-background: Theme.dark ? #1a3d37 : Theme.chip-active-bg;
                    tint: self.active ? (Theme.dark ? #39d99b : Theme.accent) : Theme.icon;
                    badge-border: Theme.dark ? #1c2c35 : Theme.header;
                    badge-dot: root.statuses-unseen;
                    active: root.sidebar-view == "status";
                    clicked => { root.sidebar-view = "status"; }
                }
                IconButton {
                    icon: @image-url("../icons/phone.svg");
                    active-background: Theme.dark ? #1a3d37 : Theme.chip-active-bg;
                    tint: self.active ? (Theme.dark ? #39d99b : Theme.accent) : Theme.icon;
                    badge-border: Theme.dark ? #1c2c35 : Theme.header;
                    badge-count: root.calls-unseen-count;
                    active: root.sidebar-view == "calls";
                    clicked => { root.sidebar-view = "calls"; root.view-changed("calls"); }
                }
                IconButton {
                    icon: @image-url("../icons/speakerphone.svg");
                    active-background: Theme.dark ? #1a3d37 : Theme.chip-active-bg;
                    tint: self.active ? (Theme.dark ? #39d99b : Theme.accent) : Theme.icon;
                    badge-border: Theme.dark ? #1c2c35 : Theme.header;
                    badge-count: root.channels-unread-count;
                    active: root.sidebar-view == "channels";
                    clicked => {
                        root.sidebar-view = "channels";
                        root.view-changed("channels");
                    }
                }
                IconButton {
                    icon: @image-url("../icons/users-group.svg");
                    active-background: Theme.dark ? #1a3d37 : Theme.chip-active-bg;
                    tint: self.active ? (Theme.dark ? #39d99b : Theme.accent) : Theme.icon;
                    badge-border: Theme.dark ? #1c2c35 : Theme.header;
                    badge-count: root.communities-unread-count;
                    active: root.sidebar-view == "communities";
                    clicked => {
                        root.sidebar-view = "communities";
                        root.view-changed("communities");
                    }
                }
            }
            VerticalLayout {
                width: 100%;
                height: self.preferred-height;
                y: parent.height - self.height;
                padding-left: 10px;
                padding-right: 10px;
                padding-bottom: 0px;
                spacing: 8px;
                Rectangle { height: 1px; background: Theme.border; }
                IconButton {
                    icon: @image-url("../icons/settings.svg");
                    clicked => {
                        root.settings-status = "";
                        root.settings-open = true;
                        root.settings-opened();
                    }
                }
                // Whose conversations these are; opens the switcher.
                TouchArea {
                    height: 40px;
                    mouse-cursor: pointer;
                    clicked => { root.account-menu-open = !root.account-menu-open; }
                    Avatar {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 32px;
                        height: 32px;
                        src: root.my-account.avatar;
                        has-image: root.my-account.hasAvatar;
                        initial: root.my-account.initial;
                        color-idx: root.my-account.colorIdx;
                    }
                }
            }
        }

        Rectangle { width: 1px; background: Theme.border; }

        // Sidebar
        Rectangle {
            width: 380px;
            background: root.glass
                ? (Theme.dark ? #111b21b8 : #ffffffc8) : Theme.sidebar;
            border-width: root.glass ? 1px : 0px;
            border-color: Theme.dark ? #ffffff35 : #111b2130;

            VerticalBox {
                visible: root.sidebar-view == "status";
                width: 100%;
                height: 100%;
                padding: 0;
                spacing: 0;
                Rectangle {
                    height: 56px;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        Text {
                            text: @tr("Status");
                            color: Theme.text;
                            font-size: 21px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                }
                if root.statuses.length == 0: Text {
                    text: @tr("No recent updates");
                    color: Theme.text-dim;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
                ListView {
                    for st[i] in root.statuses: Rectangle {
                        height: 72px;
                        clip: true;
                        background: st-touch.has-hover ? Theme.hover : transparent;
                        st-touch := TouchArea {
                            clicked => { root.status-open(st.jid); }
                        }
                        HorizontalLayout {
                            padding-left: 13px;
                            padding-right: 15px;
                            spacing: 13px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 0;
                                Rectangle {
                                    width: 53px;
                                    height: 53px;
                                    border-radius: 26.5px;
                                    border-width: 2px;
                                    border-color: Theme.accent;
                                    Avatar {
                                        width: 46px;
                                        height: 46px;
                                        x: 3.5px;
                                        y: 3.5px;
                                        src: st.avatar;
                                        has-image: st.hasAvatar;
                                        initial: st.initial;
                                        color-idx: st.colorIdx;
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text {
                                    text: st.name;
                                    color: Theme.text;
                                    font-size: 15px;
                                    overflow: elide;
                                }
                                Text {
                                    text: st.time;
                                    color: Theme.text-dim;
                                    font-size: 12px;
                                }
                            }
                        }
                    }
                }
            }

            VerticalBox {
                visible: root.sidebar-view == "calls";
                width: 100%;
                height: 100%;
                padding: 0;
                spacing: 0;
                Rectangle {
                    height: 56px;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        Text {
                            text: @tr("Calls");
                            color: Theme.text;
                            font-size: 21px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                }
                if root.calls.length == 0: Text {
                    text: @tr("No calls yet");
                    color: Theme.text-dim;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
                ListView {
                    for call in root.calls: Rectangle {
                        height: 68px;
                        clip: true;
                        background: call-touch.has-hover ? Theme.hover : transparent;
                        call-touch := TouchArea {
                            clicked => { root.open-dm(call.from); }
                        }
                        HorizontalLayout {
                            padding-left: 13px;
                            padding-right: 15px;
                            spacing: 13px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 0;
                                Avatar {
                                    width: 46px;
                                    height: 46px;
                                    src: call.avatar;
                                    has-image: call.hasAvatar;
                                    initial: call.initial;
                                    color-idx: call.colorIdx;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                spacing: 3px;
                                Text {
                                    text: call.name;
                                    color: Theme.text;
                                    font-size: 15px;
                                    overflow: elide;
                                }
                                Text {
                                    text: call.detail;
                                    color: Theme.text-dim;
                                    font-size: 13px;
                                    overflow: elide;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 0;
                                spacing: 4px;
                                Text {
                                    text: call.time;
                                    color: Theme.text-dim;
                                    font-size: 11px;
                                    horizontal-alignment: right;
                                }
                                // Redial, the way the phone's call log does.
                                if !call.group: IconButton {
                                    icon: @image-url("../icons/phone.svg");
                                    icon-size: 18px;
                                    width: 30px;
                                    height: 30px;
                                    clicked => { root.start-call(call.from); }
                                }
                            }
                        }
                    }
                }
            }

            VerticalBox {
                visible: root.sidebar-view != "status" && root.sidebar-view != "calls";
                width: 100%;
                height: 100%;
                padding: 0;
                spacing: 0;

                Rectangle {
                    height: 56px;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        Text {
                            text: root.sidebar-view == "channels" ? @tr("Channels")
                                : root.sidebar-view == "communities" ? @tr("Communities")
                                : @tr("Chats");
                            color: Theme.text;
                            font-size: 21px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                }

                Rectangle {
                    height: 46px;
                    Rectangle {
                        x: 14px;
                        width: parent.width - 28px;
                        height: 34px;
                        border-radius: 10px;
                        background: Theme.dark ? #1e2b34 : #ffffff;
                        border-width: 1px;
                        border-color: search-box.has-focus ? Theme.accent
                            : Theme.dark ? #2b3b46 : Theme.border;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 6px;
                            spacing: 8px;
                            Rectangle {
                                width: 16px;
                                Image {
                                    source: @image-url("../icons/search.svg");
                                    colorize: Theme.icon;
                                    width: 16px;
                                    height: 16px;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                search-box := TextInput {
                                    width: parent.width;
                                    height: parent.height;
                                    color: Theme.text;
                                    font-size: 12px;
                                    single-line: true;
                                    vertical-alignment: center;
                                    selection-background-color: Theme.accent;
                                    selection-foreground-color: white;
                                    edited => { root.search-changed(self.text); }
                                }
                                if search-box.text == "": Text {
                                    text: @tr("Search chats");
                                    color: Theme.text-dim;
                                    font-size: 12px;
                                    width: parent.width;
                                    height: parent.height;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                            Rectangle {
                                width: 52px;
                                HorizontalLayout {
                                    y: (parent.height - self.height) / 2;
                                    height: 22px;
                                    spacing: 4px;
                                    for shortcut in ["Ctrl", "F"]: Rectangle {
                                        width: shortcut == "Ctrl" ? 28px : 20px;
                                        border-radius: 5px;
                                        background: Theme.dark ? #293944 : Theme.header;
                                        Text {
                                            text: shortcut;
                                            color: Theme.text-dim;
                                            font-size: 10px;
                                            width: parent.width;
                                            height: parent.height;
                                            vertical-alignment: center;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Self-update banner under the search box.
                UpdateBanner {
                    state: root.update-state;
                    version: root.update-version;
                error: root.update-error;
                    apply-update => { root.update-apply(); }
                    restart => { root.update-restart(); }
                }

                // Filter chips scroll sideways once the lists add up.
                Flickable {
                    height: root.sidebar-view == "chats" ? 40px : 0;
                    visible: root.sidebar-view == "chats";
                    content-width: chips.preferred-width;
                    content-height: self.height;
                    interactive: chips.preferred-width > self.width;
                    chips := HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 5px;
                        alignment: start;
                        FilterChip {
                            label: @tr("All");
                            active: root.chat-tab == "all";
                            clicked => { root.chat-tab = "all"; root.tab-changed("all"); }
                        }
                        FilterChip {
                            label: @tr("Unread");
                            count: root.chats-unread-count;
                            active: root.chat-tab == "unread";
                            clicked => { root.chat-tab = "unread"; root.tab-changed("unread"); }
                        }
                        FilterChip {
                            label: @tr("Favorites");
                            active: root.chat-tab == "favorites";
                            clicked => { root.chat-tab = "favorites"; root.tab-changed("favorites"); }
                        }
                        FilterChip {
                            label: @tr("Groups");
                            active: root.chat-tab == "groups";
                            clicked => { root.chat-tab = "groups"; root.tab-changed("groups"); }
                        }
                        FilterChip {
                            label: @tr("Archived");
                            active: root.chat-tab == "archived";
                            clicked => { root.chat-tab = "archived"; root.tab-changed("archived"); }
                        }
                        for lb in root.label-chips: FilterChip {
                            label: lb.name;
                            active: root.chat-tab == "label:" + lb.id;
                            clicked => {
                                root.chat-tab = "label:" + lb.id;
                                root.tab-changed("label:" + lb.id);
                            }
                        }
                    }
                }

                if root.sidebar-view == "chats" && root.search-hits.length == 0: Rectangle {
                    height: 48px;
                    background: root.chat-tab == "archived" ? Theme.selected : archive-touch.has-hover ? Theme.hover : transparent;
                    HorizontalLayout {
                        padding-left: 24px;
                        padding-right: 20px;
                        spacing: 24px;
                        Rectangle {
                            width: 20px;
                            Image {
                                width: 20px;
                                height: 20px;
                                y: (parent.height - self.height) / 2;
                                source: @image-url("../icons/archive.svg");
                                colorize: Theme.icon;
                            }
                        }
                        Text {
                            text: @tr("Archived");
                            color: Theme.text;
                            font-size: 14px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        if root.archived-mentioned: Text {
                            text: "@";
                            color: Theme.accent;
                            font-size: 16px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        if root.archived-unread-count > 0: Text {
                            text: root.archived-unread-count;
                            color: Theme.accent;
                            font-size: 13px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                    archive-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.chat-tab = root.chat-tab == "archived" ? "all" : "archived";
                            root.tab-changed(root.chat-tab);
                        }
                    }
                }

                // Searching: chats by name on top, then messages by content.
                if root.search-hits.length > 0: Rectangle {
                    height: 28px;
                    Text {
                        text: @tr("Chats");
                        color: Theme.accent;
                        font-size: 13px;
                        font-weight: 700;
                        x: 16px;
                        height: parent.height;
                        vertical-alignment: center;
                    }
                }
                ListView {
                    vertical-stretch: root.search-hits.length > 0 ? 1 : 3;
                    for chat[i] in root.chats: Rectangle {
                        height: 56px;
                        clip: true;
                        Rectangle {
                            x: 4px;
                            y: 1px;
                            width: parent.width - 8px;
                            height: parent.height - 2px;
                            border-radius: 10px;
                            background: chat.jid == root.selected-jid
                                ? (Theme.dark ? #182f30 : #e2f3e9)
                                : touch.has-hover ? Theme.hover : transparent;
                            border-width: chat.jid == root.selected-jid ? 1px : 0px;
                            border-color: Theme.dark ? #255044 : #a6d8bf;
                            animate background { duration: 140ms; easing: ease-out; }
                            animate border-color { duration: 140ms; easing: ease-out; }
                        }
                        touch := TouchArea {
                            clicked => { root.open-chat(chat.jid); }
                            changed has-hover => {
                                if (self.has-hover) { root.chat-hover(chat.jid); }
                            }
                        }
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 18px;
                            spacing: 13px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 0;
                                Avatar {
                                    width: 40px;
                                    height: 40px;
                                    src: chat.avatar;
                                    has-image: chat.hasAvatar;
                                    initial: chat.initial;
                                    color-idx: chat.colorIdx;
                                    privacy-blurred: root.blur-photos;
                                    privacy-reveal: touch.has-hover;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                spacing: 4px;
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: chat.name;
                                        color: Theme.text;
                                        opacity: root.blur-names && !touch.has-hover ? 0.08 : 1;
                                        animate opacity { duration: 120ms; easing: ease-out; }
                                        font-size: 14px;
                                        font-weight: chat.jid == root.selected-jid || chat.unread > 0 ? 600 : 400;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: chat.time;
                                        color: chat.unread > 0 ? Theme.accent : Theme.text-dim;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        horizontal-stretch: 0;
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    if chat.ticks != "": Ticks {
                                        ticks: chat.ticks;
                                        blue: chat.ticksBlue;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: chat.preview;
                                        color: chat.draft ? #d99028 : chat.typing ? Theme.accent : Theme.text-dim;
                                        opacity: root.blur-messages && !touch.has-hover ? 0.08 : 1;
                                        animate opacity { duration: 120ms; easing: ease-out; }
                                        font-size: 13px;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                        Tooltip {
                                            Rectangle {
                                                width: min(420px, preview-tooltip.preferred-width + 24px);
                                                height: preview-tooltip.preferred-height + 16px;
                                                background: Theme.header;
                                                border-color: Theme.border;
                                                border-width: 1px;
                                                border-radius: 6px;
                                                preview-tooltip := Text {
                                                    x: 12px;
                                                    y: 8px;
                                                    width: parent.width - 24px;
                                                    text: chat.preview;
                                                    color: Theme.text;
                                                    font-size: 13px;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }
                                    }
                                    if chat.muted: Image {
                                        source: @image-url("../icons/bell-off.svg");
                                        colorize: Theme.text-dim;
                                        width: 14px;
                                        height: 14px;
                                        y: (parent.height - self.height) / 2;
                                        horizontal-stretch: 0;
                                    }
                                    if chat.pinned: Image {
                                        source: @image-url("../icons/pin.svg");
                                        colorize: Theme.text-dim;
                                        width: 14px;
                                        height: 14px;
                                        y: (parent.height - self.height) / 2;
                                        horizontal-stretch: 0;
                                    }
                                    if chat.mentioned: Image {
                                        source: @image-url("../icons/at.svg");
                                        colorize: Theme.accent;
                                        width: 15px;
                                        height: 15px;
                                        y: (parent.height - self.height) / 2;
                                        horizontal-stretch: 0;
                                    }
                                    if chat.unread > 0: Rectangle {
                                        width: max(20px, badge-text.preferred-width + 12px);
                                        height: 20px;
                                        border-radius: 10px;
                                        background: Theme.accent;
                                        badge-text := Text {
                                            text: chat.unread;
                                            color: Theme.dark ? #111b21 : #ffffff;
                                            font-size: 11px;
                                            font-weight: 700;
                                            width: parent.width;
                                            height: parent.height;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                        Rectangle {
                            x: 67px;
                            y: parent.height - 1px;
                            width: parent.width - 85px;
                            height: 1px;
                            background: chat.jid == root.selected-jid ? transparent : Theme.border;
                        }
                    }
                }

                if root.search-hits.length > 0: Rectangle {
                    height: 28px;
                    Text {
                        text: @tr("Messages");
                        color: Theme.accent;
                        font-size: 13px;
                        font-weight: 700;
                        x: 16px;
                        height: parent.height;
                        vertical-alignment: center;
                    }
                }
                if root.search-hits.length > 0: ListView {
                    vertical-stretch: 2;
                    for hit in root.search-hits: HitRow {
                        hit: hit;
                        clicked => { root.open-hit(hit.jid, hit.id); }
                    }
                }
            }

            // Mini player: keeps the running voice note reachable after
            // the user moves to another conversation.
            if root.mini-audio: Rectangle {
                y: parent.height - self.height;
                width: parent.width;
                height: 56px;
                background: #008069e8;
                border-width: 1px;
                border-color: #ffffff55;
                mini-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.mini-audio-open(); }
                }
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 12px;
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 26px;
                            height: 26px;
                            play-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.mini-audio-toggle(); }
                            }
                            Image {
                                source: root.mini-audio-playing
                                    ? @image-url("../icons/player-pause.svg")
                                    : @image-url("../icons/player-play.svg");
                                colorize: white;
                                width: 18px;
                                height: 18px;
                            }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 30px;
                                    height: 30px;
                                    Avatar {
                                        width: 30px;
                                        height: 30px;
                                        src: root.mini-audio-avatar;
                                        has-image: root.mini-audio-avatar-has;
                                        initial: root.mini-audio-initial;
                                        color-idx: root.mini-audio-color-idx;
                                    }
                                    Image {
                                        source: @image-url("../icons/microphone.svg");
                                        colorize: white;
                                        width: 14px;
                                        height: 14px;
                                        x: parent.width - self.width;
                                        y: parent.height - self.height;
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: root.mini-audio-name;
                                    color: white;
                                    font-size: 14px;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 24px;
                            height: 24px;
                            close-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.mini-audio-close(); }
                            }
                            Image {
                                source: @image-url("../icons/x.svg");
                                colorize: white;
                                width: 16px;
                                height: 16px;
                            }
                        }
                    }
                }
                // Progress hairline along the bottom edge.
                Rectangle {
                    x: 0;
                    y: parent.height - 2px;
                    width: parent.width * root.mini-audio-progress;
                    height: 2px;
                    background: #ffffffcc;
                }
            }
        }

        Rectangle { width: 1px; background: Theme.border; }

        // Conversation pane
        Rectangle {
            background: root.glass
                ? (Theme.dark ? #101c2390 : #efeae2a8) : Theme.conv-background;

            HomeScreen {
                visible: !root.chat-open;
                width: 100%;
                height: 100%;
                conversations => {
                    root.sidebar-view = "chats";
                    root.view-changed("chats");
                    root.chat-tab = "all";
                    root.tab-changed("all");
                    search-box.text = "";
                    root.search-changed("");
                    search-box.focus();
                }
                groups => {
                    root.sidebar-view = "chats";
                    root.view-changed("chats");
                    root.chat-tab = "groups";
                    root.tab-changed("groups");
                    search-box.text = "";
                    root.search-changed("");
                    search-box.focus();
                }
                settings => {
                    root.settings-open = true;
                    root.settings-opened();
                }
            }

            Rectangle {
                visible: root.chat-open;
                width: 100%;
                height: 100%;

                // The conversation and the day pill floating over it.
                Rectangle {
                    width: parent.width;
                    height: parent.height;
                    // Fades the floating day out once the wheel stops.
                    scroll-idle := Timer {
                        interval: 1400ms;
                        running: false;
                        triggered => { root.scrolling = false; self.running = false; }
                    }
                    typing-restick := Timer {
                        interval: 1ms;
                        running: false;
                        triggered => {
                            self.running = false;
                            if (root.conv-ready && root.stick-bottom) {
                                root.scroll-conversation-end();
                            }
                        }
                    }
                    if root.messages.length == 0 && msg-list.typing-space > 0px && root.conv-ready: TypingBubbles {
                        x: 48px + (root.select-mode ? 30px : 0px);
                        y: contact-header.height + 4px;
                        members: root.typing-members;
                        extra: root.typing-extra;
                        privacy-blurred: root.blur-photos;
                    }
                msg-list := ListView {
                    width: parent.width;
                    height: parent.height;
                    opacity: root.conv-ready ? 1.0 : 0.0;
                    animate opacity {
                        duration: 160ms;
                        easing: ease-out;
                        enabled: root.conv-ready;
                    }
                    property <length> typing-space: root.current-is-group && root.typing-members.length > 0 ? 40px : 0px;
                    changed typing-space => {
                        typing-restick.running = root.conv-ready && root.stick-bottom;
                    }
                    changed viewport-height => {
                        root.conv-viewport-h = self.viewport-height;
                    }
                    changed viewport-y => {
                        root.conv-scroll = self.viewport-y;
                        root.stick-bottom =
                            self.viewport-y <= self.height - self.viewport-height + 60px;
                        if (self.viewport-y < -120px && root.conv-ready) {
                            root.scroll-armed = true;
                        }
                        if (self.viewport-y >= -4px && self.viewport-height > self.height
                            && root.scroll-armed) {
                            root.load-older();
                        }
                        if (root.conv-ready) {
                            root.scrolling = true;
                            scroll-idle.running = false;
                            scroll-idle.running = true;
                            root.conv-scrolled();
                        }
                    }
                    for msg[i] in root.messages: msg-row := Rectangle {
                        property <int> menu-request: root.message-menu-request;
                        changed menu-request => {
                            if (self.menu-request > 0 && !msg.deleted && msg.kind != "system"
                                && root.message-menu-request-x >= self.absolute-position.x
                                && root.message-menu-request-x < self.absolute-position.x + self.width
                                && root.message-menu-request-y >= self.absolute-position.y + bubble.y
                                && root.message-menu-request-y < self.absolute-position.y + bubble.y + bubble.height) {
                                root.menu-message = msg;
                                root.message-menu-x = root.message-menu-request-x;
                                root.message-menu-y = root.message-menu-request-y;
                                root.message-menu-open = true;
                            }
                        }
                        property <length> header-offset: i == 0 ? contact-header.height : 0px;
                        // The row crossing the top edge names the day in
                        // the floating pill. Rows sit in viewport
                        // coordinates; the ListView re-anchors every
                        // visible row on each scroll step, so the check
                        // rides on y as well as on the visible offset.
                        property <length> vis-y: self.y + msg-list.viewport-y;
                        changed vis-y => {
                            if (self.vis-y <= contact-header.height + 6px && self.vis-y + self.height > contact-header.height + 6px) {
                                root.day-at-top(msg.dayFull);
                            }
                            root.row-geom(msg.id, self.vis-y / 1px, self.height / 1px);
                        }
                        changed y => {
                            if (self.vis-y <= contact-header.height + 6px && self.vis-y + self.height > contact-header.height + 6px) {
                                root.day-at-top(msg.dayFull);
                            }
                            root.row-geom(msg.id, self.vis-y / 1px, self.height / 1px);
                        }
                        changed height => {
                            root.row-geom(msg.id, self.vis-y / 1px, self.height / 1px);
                        }
                        // Pressing on the row's background and dragging
                        // sweeps whole messages into the selection, the way
                        // dragging over a page selects across bubbles.
                        if msg.kind != "system": TouchArea {
                            mouse-cursor: default;
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                    root.drag-start(msg.id, msg-row.vis-y / 1px + self.pressed-y / 1px);
                                }
                                if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                                    root.drag-end();
                                }
                            }
                            moved => {
                                if (self.pressed) {
                                    root.drag-move(msg-row.vis-y / 1px + self.mouse-y / 1px);
                                }
                            }
                            double-clicked => {
                                if (!root.select-mode && !msg.deleted) {
                                    root.request-reply(msg.id);
                                    root.focus-composer();
                                }
                            }
                        }
                        if root.select-mode && msg.selected: Rectangle {
                            background: Theme.accent.with-alpha(0.14);
                        }
                        if root.highlight-id == msg.id: Rectangle {
                            background: Theme.accent.with-alpha(0.22);
                        }
                        row-hover := TouchArea {
                            mouse-cursor: default;
                            // Purely a hover probe: clicks fall through.
                            enabled: false;
                        }
                        // System notices: one centered pill, no bubble.
                        sys-pill := Rectangle {
                            property <bool> is-system: msg.kind == "system";
                            visible: self.is-system;
                            y: 6px + msg-row.day-offset;
                            x: (parent.width - self.width) / 2;
                            width: self.is-system
                                ? min(parent.width * 0.8, sys-text.preferred-width + 28px) : 0;
                            height: self.is-system ? sys-text.preferred-height + 12px : 0;
                            border-radius: 8px;
                            background: sys-touch.has-hover && msg.clickable ? Theme.selected : Theme.pill;
                            sys-touch := TouchArea {
                                enabled: sys-pill.is-system;
                                mouse-cursor: msg.clickable ? pointer : default;
                                clicked => { if (msg.clickable) { root.notice-clicked(msg.id); } }
                            }
                            sys-text := Text {
                                text: sys-pill.is-system ? msg.text : "";
                                opacity: root.blur-messages && !sys-touch.has-hover ? 0.08 : 1;
                                animate opacity { duration: 120ms; easing: ease-out; }
                                color: msg.clickable ? Theme.accent : Theme.text-dim;
                                font-size: 12px;
                                wrap: word-wrap;
                                horizontal-alignment: center;
                                width: max(0px, parent.width - 28px);
                                x: 14px;
                                y: 6px;
                            }
                        }
                        if root.select-mode && msg.kind != "system": Rectangle {
                            x: 14px;
                            // Centred on short bubbles, pinned near the top of tall ones.
                            y: bubble.y + max(0px, min((bubble.height - self.height) / 2, 8px));
                            width: 20px;
                            height: 20px;
                            border-radius: 10px;
                            border-width: 2px;
                            border-color: msg.selected ? Theme.accent : Theme.text-dim;
                            background: msg.selected ? Theme.accent : transparent;
                            animate background, border-color { duration: 120ms; easing: ease-out; }
                            if msg.selected: Image {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                source: @image-url("../icons/check.svg");
                                colorize: white;
                                width: 13px;
                                height: 13px;
                            }
                        }
                        // A link card drives the bubble width, so the text
                        // wraps at the card instead of stretching past it on
                        // a wide window.
                        property <length> max-text-w: msg.hasLink
                            ? min(360px, max(120px, self.width * 0.65 - 44px))
                            : max(120px, self.width * 0.65 - 44px);
                        // Media drives the bubble width; the header and the
                        // caption wrap inside it instead of widening the bubble.
                        property <length> content-w:
                            (msg.kind == "image" || msg.kind == "video") && msg.picW > 0
                                ? max(150px, msg.picW * 1px)
                                : max-text-w;
                        // Whether the time/ticks float on the last text line (text paths only).
                        property <bool> meta-inline:
                            (msg.hasStyled || msg.kind == "text"
                                || ((msg.kind == "image" || msg.kind == "video") && msg.text != ""))
                            && (msg.text != "" || msg.deleted);
                        property <length> unread-offset: msg.unread-boundary ? 28px : 0;
                        property <length> day-offset: (msg.dayLabel != "" ? 40px : 0) + unread-offset + header-offset;
                        if msg.unread-boundary: Rectangle {
                            y: (msg.dayLabel != "" ? 40px : 0px) + msg-row.header-offset;
                            width: parent.width;
                            height: 28px;
                            HorizontalLayout {
                                padding-left: 20px;
                                padding-right: 20px;
                                spacing: 12px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    Rectangle {
                                        y: (parent.height - self.height) / 2;
                                        height: 1px;
                                        background: Theme.conversation-divider;
                                    }
                                }
                                Text {
                                    text: @tr("Unread messages");
                                    color: Theme.text-dim;
                                    font-size: 11px;
                                    horizontal-stretch: 0;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    Rectangle {
                                        y: (parent.height - self.height) / 2;
                                        height: 1px;
                                        background: Theme.conversation-divider;
                                    }
                                }
                            }
                        }
                        property <length> message-height: msg.kind == "system"
                            ? sys-pill.height + 12px + self.day-offset
                            : bubble.height + (msg.firstOfRun ? 16px : 6px)
                                + (msg.reactions != "" ? 14px : 0) + self.day-offset;
                        height: self.message-height + (i == root.messages.length - 1
                            ? msg-list.typing-space + root.composer-tail-space : 0px);
                        if i == root.messages.length - 1 && msg-list.typing-space > 0px: TypingBubbles {
                            x: 48px + (root.select-mode ? 30px : 0px);
                            y: msg-row.message-height + 4px;
                            members: root.typing-members;
                            extra: root.typing-extra;
                            privacy-blurred: root.blur-photos;
                        }
                        if msg.dayLabel != "": Rectangle {
                            y: 8px + msg-row.header-offset;
                            x: (parent.width - self.width) / 2;
                            width: day-text.preferred-width + 24px;
                            height: 24px;
                            border-radius: 12px;
                            background: Theme.day-bg;
                            border-width: 1px;
                            border-color: Theme.day-border;
                            day-text := Text {
                                text: msg.dayLabel;
                                color: Theme.text-dim;
                                font-size: 11px;
                                width: parent.width;
                                height: parent.height;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        if msg.showAvatar: Avatar {
                            width: 28px;
                            height: 28px;
                            privacy-blurred: root.blur-photos;
                            privacy-reveal: row-hover.has-hover;
                            x: root.select-mode ? 42px : 12px;
                            animate x { duration: 140ms; easing: ease-out; }
                            y: (msg.firstOfRun ? 12px : 3px) + msg-row.day-offset;
                            src: msg.senderAvatar;
                            has-image: msg.senderHasAvatar;
                            initial: msg.senderInitial;
                            color-idx: msg.senderColorIdx;
                        }
                        bubble := Rectangle {
                            visible: msg.kind != "system";
                            y: (msg.firstOfRun ? 12px : 3px) + msg-row.day-offset;
                            x: msg.fromMe
                                ? parent.width - self.width - 30px
                                : (msg.groupIndent ? 48px : 30px) + (root.select-mode ? 30px : 0px);
                            animate x { duration: 140ms; easing: ease-out; }
                            width: msg.kind == "system" ? 0 : content.preferred-width;
                            height: msg.kind == "system" ? 0 : content.preferred-height;
                            background: msg.sticker
                                ? transparent
                                : (msg.fromMe ? Theme.bubble-out : Theme.bubble-in);
                            border-radius: 10px;
                            num-measure := Text {
                                text: msg.senderNumber;
                                font-size: 11px;
                                visible: false;
                                width: 0px;
                                height: 0px;
                            }
                            if msg.showSender && msg.senderNumber != "": Text {
                                text: msg.senderNumber;
                                font-size: 11px;
                                color: Theme.text-dim;
                                x: parent.width - self.width - 9px;
                                y: 7px;
                            }
                            TouchArea {
                                enabled: !root.select-mode && !msg.deleted;
                                double-clicked => {
                                    root.request-reply(msg.id);
                                    root.focus-composer();
                                }
                            }
                            content := VerticalLayout {
                                padding: 7px;
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 2px;

                                if msg.showSender: HorizontalLayout {
                                    spacing: 8px;
                                    sender-touch := TouchArea {
                                        width: sender-text.width;
                                        height: sender-text.preferred-height;
                                        mouse-cursor: pointer;
                                        clicked => { root.open-dm(msg.senderJid); }
                                        sender-text := Text {
                                            text: msg.senderLabel;
                                            opacity: root.blur-names && !sender-touch.has-hover ? 0.08 : 1;
                                            animate opacity { duration: 120ms; easing: ease-out; }
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: Theme.sender;
                                            width: min(self.preferred-width,
                                                msg-row.content-w - 26px
                                                    - (msg.senderNumber != ""
                                                        ? num-measure.preferred-width + 24px
                                                        : 0px));
                                            overflow: elide;
                                        }
                                    }
                                    // Reserves the number's width without
                                    // depending on the bubble, which would
                                    // create a layout loop.
                                    if msg.senderNumber != "": Rectangle {
                                        width: num-measure.preferred-width + 24px;
                                    }
                                }

                                if msg.hasQuote && !msg.deleted: Rectangle {
                                    height: quote-col.preferred-height;
                                    border-radius: 4px;
                                    background: msg.fromMe ? #00000014 : #00000010;
                                    clip: true;
                                    quote-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.open-quote(msg.quoteJid, msg.quoteId); }
                                    }
                                    Rectangle {
                                        x: 0;
                                        width: 4px;
                                        height: parent.height;
                                        background: Theme.accent;
                                    }
                                    quote-col := VerticalLayout {
                                        padding: 6px;
                                        padding-left: 12px;
                                        spacing: 2px;
                                        Text {
                                            text: msg.quoteName;
                                            opacity: root.blur-names && !row-hover.has-hover ? 0.08 : 1;
                                            animate opacity { duration: 120ms; easing: ease-out; }
                                            color: Theme.accent;
                                            font-size: 12px;
                                            font-weight: 700;
                                            overflow: elide;
                                            width: min(self.preferred-width,
                                                msg-row.content-w - 20px);
                                        }
                                        Text {
                                            text: msg.quoteText;
                                            opacity: root.blur-messages && !row-hover.has-hover ? 0.08 : 1;
                                            animate opacity { duration: 120ms; easing: ease-out; }
                                            color: Theme.text-dim;
                                            font-size: 12.5px;
                                            overflow: elide;
                                            width: min(self.preferred-width,
                                                msg-row.content-w - 20px);
                                        }
                                    }
                                }

                                if msg.forwarded && !msg.deleted: HorizontalLayout {
                                    spacing: 4px;
                                    alignment: start;
                                    Image {
                                        source: @image-url("../icons/corner-up-right.svg");
                                        colorize: Theme.text-dim;
                                        width: 12px;
                                        height: 12px;
                                        y: 1px;
                                    }
                                    Text {
                                        text: @tr("Forwarded");
                                        font-size: 11px;
                                        font-italic: true;
                                        color: Theme.text-dim;
                                    }
                                }

                                // "Apply deletions" is off: the sender took
                                // this back but the message was kept, so a
                                // small indicator is all that changes.
                                if msg.revoked && !msg.deleted: HorizontalLayout {
                                    spacing: 4px;
                                    alignment: start;
                                    Image {
                                        source: @image-url("../icons/trash.svg");
                                        colorize: Theme.text-dim;
                                        width: 12px;
                                        height: 12px;
                                        y: 1px;
                                    }
                                    Text {
                                        text: @tr("Deleted by sender");
                                        font-size: 11px;
                                        font-italic: true;
                                        color: Theme.text-dim;
                                    }
                                }

                                if (msg.kind == "image" || msg.kind == "video") && !msg.mediaReady: MediaPlaceholder {
                                    width: msg.picW * 1px;
                                    height: msg.picH * 1px;
                                    preview: msg.picture;
                                    privacy-blurred: root.blur-media;
                                    sticker: msg.sticker;
                                    video: msg.kind == "video";
                                    file-size: msg.mediaSize;
                                    loading: msg.mediaLoading;
                                    progress: msg.mediaProgress;
                                    clicked => { root.download-media(msg.id); }
                                }
                                if msg.kind == "video" && msg.mediaReady && msg.picW > 0: TouchArea {
                                    property <bool> media-hover: self.has-hover;
                                    width: msg.picW * 1px;
                                    height: msg.picH * 1px;
                                    mouse-cursor: pointer;
                                    clicked => { root.open-video(msg.id); }
                                    Rectangle {
                                        border-radius: 6px;
                                        clip: true;
                                        background: black;
                                        Image {
                                            source: msg.picture;
                                            width: parent.width;
                                            height: parent.height;
                                            image-fit: cover;
                                            opacity: root.blur-media && !media-hover ? 0.05 : 1;
                                            animate opacity { duration: 120ms; easing: ease-out; }
                                        }
                                        if root.blur-media && !media-hover: Rectangle {
                                            width: parent.width;
                                            height: parent.height;
                                            background: Theme.dark ? #172126 : #dfe5e8;
                                        }
                                    }
                                    if msg.videoLen != "": Rectangle {
                                        x: 8px;
                                        y: parent.height - self.height - 8px;
                                        width: len-row.preferred-width + 12px;
                                        height: 20px;
                                        border-radius: 10px;
                                        background: #000000a0;
                                        len-row := HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            spacing: 4px;
                                            Image {
                                                source: @image-url("../icons/video.svg");
                                                colorize: white;
                                                width: 12px;
                                                height: 12px;
                                                y: (parent.height - self.height) / 2;
                                            }
                                            Text {
                                                text: msg.videoLen;
                                                color: white;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    // GIF badge, shown while the clip rests.
                                    if msg.gif && !msg.playing: Rectangle {
                                        x: 8px;
                                        y: parent.height - self.height - 8px;
                                        width: gif-label.preferred-width + 12px;
                                        height: 20px;
                                        border-radius: 4px;
                                        background: #000000a0;
                                        gif-label := Text {
                                            text: "GIF";
                                            color: white;
                                            font-size: 11px;
                                            font-weight: 700;
                                            width: parent.width;
                                            height: parent.height;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    if !msg.gif: Rectangle {
                                        width: 56px;
                                        height: 56px;
                                        border-radius: 28px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        background: #000000a0;
                                        Image {
                                            source: @image-url("../icons/player-play.svg");
                                            colorize: white;
                                            width: 28px;
                                            height: 28px;
                                            x: 15px;
                                            y: 14px;
                                        }
                                    }
                                }
                                if msg.kind == "image" && msg.mediaReady: TouchArea {
                                    property <bool> media-hover: self.has-hover;
                                    width: msg.picW * 1px;
                                    height: msg.picH * 1px;
                                    mouse-cursor: pointer;
                                    clicked => { root.open-lightbox(msg.id); }
                                    Image {
                                        source: msg.picture;
                                        width: parent.width;
                                        height: parent.height;
                                        opacity: root.blur-media && !media-hover ? 0.05 : 1;
                                        animate opacity { duration: 120ms; easing: ease-out; }
                                    }
                                    if root.blur-media && !media-hover: Rectangle {
                                        width: parent.width;
                                        height: parent.height;
                                        background: Theme.dark ? #172126 : #dfe5e8;
                                    }
                                }

                                if msg.kind == "doc": VerticalLayout {
                                    spacing: 6px;
                                    Rectangle {
                                        height: 52px;
                                        border-radius: 6px;
                                        background: msg.fromMe ? #00000014 : #00000010;
                                        doc-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.doc-view(msg.id); }
                                        }
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 12px;
                                            spacing: 8px;
                                            VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    property <bool> sheet: msg.documentType == "XLS" || msg.documentType == "XLSX" || msg.documentType == "CSV" || msg.documentType == "ODS";
                                                    property <bool> slides: msg.documentType == "PPT" || msg.documentType == "PPTX" || msg.documentType == "ODP";
                                                    property <bool> archive: msg.documentType == "ZIP" || msg.documentType == "RAR" || msg.documentType == "7Z" || msg.documentType == "GZ" || msg.documentType == "TAR";
                                                    width: 38px;
                                                    height: 42px;
                                                    border-radius: 8px;
                                                    background: msg.documentType == "PDF" ? #fa5252
                                                        : self.sheet ? #0cba68
                                                        : self.slides ? #ef8534
                                                        : self.archive ? #9671d5
                                                        : msg.documentType == "DOC" || msg.documentType == "DOCX" || msg.documentType == "ODT" ? #4285e0 : #718894;
                                                    Image {
                                                        source: parent.archive ? @image-url("../icons/archive.svg")
                                                            : parent.sheet ? @image-url("../icons/list-details.svg")
                                                            : @image-url("../icons/file-text.svg");
                                                        colorize: white;
                                                        width: 22px;
                                                        height: 22px;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 4px;
                                                Text {
                                                    text: msg.text;
                                                    opacity: root.blur-messages && !row-hover.has-hover ? 0.08 : 1;
                                                    animate opacity { duration: 120ms; easing: ease-out; }
                                                    color: Theme.bubble-text;
                                                    font-size: 13px;
                                                    overflow: elide;
                                                    width: min(max(self.preferred-width, 180px), msg-row.max-text-w - 68px);
                                                }
                                                Text {
                                                    text: (msg.mediaSize != "" ? msg.mediaSize + " · " : "") + msg.documentType;
                                                    color: msg.fromMe ? Theme.time-out : Theme.text-dim;
                                                    font-size: 11px;
                                                }
                                            }
                                        }
                                    }
                                    // WhatsApp's two actions under a file.
                                    HorizontalLayout {
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            height: 30px;
                                            view-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.doc-view(msg.id); }
                                            }
                                            Text {
                                                text: msg.mediaReady ? @tr("View") : @tr("Download");
                                                color: msg.mediaReady ? Theme.accent : Theme.text-dim;
                                                font-size: 13px;
                                                font-weight: 700;
                                                width: parent.width;
                                                height: parent.height;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Rectangle { width: 1px; height: 30px; background: Theme.border; }
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            height: 30px;
                                            save-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                enabled: msg.mediaReady;
                                                clicked => { root.doc-save(msg.id); }
                                            }
                                            Text {
                                                text: @tr("Save as...");
                                                color: msg.mediaReady ? Theme.accent : Theme.text-dim;
                                                font-size: 13px;
                                                font-weight: 700;
                                                width: parent.width;
                                                height: parent.height;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                // Voice-note player: waveform track, played
                                // portion clipped over it, click to seek.
                                if msg.kind == "audio" && !msg.voiceMessage: VerticalLayout {
                                    spacing: 10px;
                                    HorizontalLayout {
                                        spacing: 10px;
                                        Rectangle {
                                            width: 36px;
                                            height: 36px;
                                            border-radius: 10px;
                                            background: #00000018;
                                            Image {
                                                source: @image-url("../icons/music.svg");
                                                colorize: Theme.icon;
                                                width: 20px;
                                                height: 20px;
                                                x: 8px;
                                                y: 8px;
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 3px;
                                            Text {
                                                text: msg.audioFilename;
                                                width: 230px;
                                                overflow: elide;
                                                color: Theme.bubble-text;
                                                font-size: 13px;
                                                font-weight: 600;
                                            }
                                            Text {
                                                text: @tr("Audio") + " · " + msg.text;
                                                color: msg.fromMe ? Theme.time-out : Theme.text-dim;
                                                font-size: 11px;
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        IconButton {
                                            width: 34px;
                                            height: 34px;
                                            icon-size: 20px;
                                            icon: msg.playing ? @image-url("../icons/player-pause.svg") : @image-url("../icons/player-play.svg");
                                            clicked => { root.audio-toggle(msg.id); }
                                        }
                                        audio-track := TouchArea {
                                            width: 194px;
                                            height: 34px;
                                            mouse-cursor: pointer;
                                            clicked => { root.audio-seek(msg.id, self.mouse-x / self.width); }
                                            Rectangle {
                                                width: parent.width;
                                                height: 4px;
                                                y: 15px;
                                                border-radius: 2px;
                                                background: #8696a060;
                                                Rectangle {
                                                    width: parent.width * msg.progress;
                                                    height: parent.height;
                                                    border-radius: 2px;
                                                    background: #53bdeb;
                                                }
                                            }
                                        }
                                        Text {
                                            text: msg.posLabel != "" ? msg.posLabel : "0:00";
                                            width: 38px;
                                            height: 34px;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                            color: msg.fromMe ? Theme.time-out : Theme.text-dim;
                                            font-size: 11px;
                                        }
                                    }
                                    HorizontalLayout {
                                        alignment: end;
                                        BubbleMeta {
                                            time: msg.time;
                                            ticks: msg.ticks;
                                            blue: msg.ticksBlue;
                                            fromMe: msg.fromMe;
                                        }
                                    }
                                }
                                if msg.kind == "audio" && msg.voiceMessage: HorizontalLayout {
                                    spacing: 10px;
                                    VerticalLayout {
                                        alignment: center;
                                        IconButton {
                                            icon: msg.playing
                                                ? @image-url("../icons/player-pause.svg")
                                                : @image-url("../icons/player-play.svg");
                                            icon-size: 20px;
                                            clicked => { root.audio-toggle(msg.id); }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 3px;
                                        wave-area := TouchArea {
                                            width: 220px;
                                            height: 30px;
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.audio-seek(msg.id,
                                                    self.mouse-x / self.width);
                                            }
                                            if msg.hasWave: Image {
                                                source: msg.wave;
                                                colorize: msg.fromMe
                                                    ? #9fd3c7 : Theme.text-dim;
                                                x: 0;
                                                y: 0;
                                                width: parent.width;
                                                height: parent.height;
                                                image-fit: fill;
                                            }
                                            // Played portion: same bitmap in the
                                            // accent color, clipped from the left.
                                            if msg.hasWave: Rectangle {
                                                x: 0;
                                                y: 0;
                                                width: parent.width * msg.progress;
                                                height: parent.height;
                                                clip: true;
                                                Image {
                                                    source: msg.wave;
                                                    colorize: #53bdeb;
                                                    x: 0;
                                                    y: 0;
                                                    width: wave-area.width;
                                                    height: wave-area.height;
                                                    image-fit: fill;
                                                }
                                            }
                                            if !msg.hasWave: Rectangle {
                                                width: parent.width;
                                                height: 3px;
                                                y: 14px;
                                                border-radius: 1.5px;
                                                background: Theme.text-dim;
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Text {
                                                text: msg.playing && msg.posLabel != ""
                                                    ? msg.posLabel : msg.text;
                                                color: msg.fromMe ? Theme.time-out : Theme.text-dim;
                                                font-size: 11px;
                                                horizontal-stretch: 1;
                                            }
                                            if msg.ticks != "": Ticks { ticks: msg.ticks; blue: msg.ticksBlue; }
                                            Text {
                                                text: msg.time;
                                                font-size: 10px;
                                                color: msg.fromMe ? Theme.time-out : Theme.text-dim;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 38px;
                                            height: 38px;
                                            if !msg.playing: Avatar {
                                                width: 38px;
                                                height: 38px;
                                                src: msg.voiceAvatar;
                                                has-image: msg.voiceHasAvatar;
                                                initial: msg.voiceInitial;
                                                color-idx: msg.voiceColorIdx;
                                            }
                                            if !msg.playing: Image {
                                                source: @image-url("../icons/microphone.svg");
                                                colorize: #53bdeb;
                                                width: 15px;
                                                height: 15px;
                                                x: parent.width - self.width;
                                                y: parent.height - self.height;
                                            }
                                            if msg.playing: Rectangle {
                                                width: rate-label.preferred-width + 16px;
                                                height: 24px;
                                                x: parent.width - self.width;
                                                y: (parent.height - self.height) / 2;
                                                border-radius: 12px;
                                                background: rate-touch.has-hover
                                                    ? #00000030 : #00000018;
                                                rate-touch := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.audio-cycle-rate(); }
                                                }
                                                rate-label := Text {
                                                    text: root.audio-rate-label;
                                                    color: Theme.text-dim;
                                                    font-size: 11px;
                                                    font-weight: 700;
                                                }
                                            }
                                        }
                                    }
                                }

                                // Link preview card. Blocks are placed by
                                // hand and the height is their exact sum, so
                                // the card never grows past its content.
                                if msg.hasLink: Rectangle {
                                    // The card spans the bubble like WhatsApp
                                    // does, instead of leaving a margin beside it.
                                    property <length> card-w: msg-row.max-text-w;
                                    property <length> img-h: msg.hasLinkThumb
                                        ? min(300px, card-w * msg.linkThumbH
                                            / max(msg.linkThumbW, 1))
                                        : 0px;
                                    property <length> host-h: msg.linkHost != "" ? 24px : 0px;
                                    property <length> title-h: msg.linkTitle != ""
                                        ? link-title.preferred-height + 8px : 0px;
                                    property <length> desc-h: msg.linkDesc != ""
                                        ? link-desc.preferred-height + 8px : 0px;

                                    width: card-w;
                                    height: img-h + host-h + title-h + desc-h;
                                    // A bare Rectangle stretches by default and
                                    // would swallow the bubble's leftover space.
                                    horizontal-stretch: 0;
                                    vertical-stretch: 0;
                                    border-radius: 6px;
                                    clip: true;
                                    background: msg.fromMe ? #ffffff14 : #00000014;

                                    if msg.hasLinkThumb: Image {
                                        source: msg.linkThumb;
                                        x: 0;
                                        y: 0;
                                        width: parent.width;
                                        height: parent.img-h;
                                        image-fit: cover;
                                    }
                                    if msg.linkHost != "": Rectangle {
                                        x: 0;
                                        y: parent.img-h;
                                        width: parent.width;
                                        height: parent.host-h;
                                        background: msg.fromMe ? #ffffff10 : #00000010;
                                        Text {
                                            text: msg.linkHost;
                                            color: Theme.text-dim;
                                            font-size: 11px;
                                            x: 9px;
                                            height: parent.height;
                                            vertical-alignment: center;
                                        }
                                    }
                                    link-title := Text {
                                        text: msg.linkTitle;
                                        visible: msg.linkTitle != "";
                                        color: Theme.bubble-text;
                                        font-size: 13px;
                                        font-weight: 700;
                                        wrap: word-wrap;
                                        x: 9px;
                                        y: parent.img-h + parent.host-h + 4px;
                                        width: parent.width - 18px;
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.open-dm(msg.linkUrl); }
                                    }
                                    link-desc := Text {
                                        text: msg.linkDesc;
                                        visible: msg.linkDesc != "";
                                        color: Theme.text-dim;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                        x: 9px;
                                        y: parent.img-h + parent.host-h + parent.title-h + 4px;
                                        width: parent.width - 18px;
                                    }
                                }

                                // Formatted text (bold/italic/strike/mono).
                                // The bubble's own context menu (below)
                                // handles right-clicks: StyledText swallows
                                // every press, so a menu wrapped around it
                                // never saw them.
                                // StyledText cannot select text, so a
                                // transparent TextInput with the same
                                // words lies over it: it owns the mouse
                                // (drag to select, Ctrl+C), and a click
                                // that moves nothing is a link click,
                                // resolved by the host from the offset.
                                if msg.hasStyled: Rectangle {
                                    width: styled-body.width;
                                    height: styled-body.preferred-height;
                                    styled-body := StyledText {
                                        text: msg.styled;
                                        opacity: root.blur-messages && !row-hover.has-hover ? 0.08 : 1;
                                        animate opacity { duration: 120ms; easing: ease-out; }
                                        default-color: Theme.bubble-text;
                                        default-font-size: 14px;
                                        link-color: Theme.accent;
                                        width: min(self.preferred-width, msg-row.max-text-w);
                                    }
                                    stamp-in := Rectangle {
                                        width: stamp-lay.preferred-width;
                                        height: stamp-lay.preferred-height;
                                        x: bubble.width - 24px - stamp-lay.preferred-width;
                                        y: parent.height - stamp-lay.preferred-height - 1px;
                                        stamp-lay := HorizontalLayout {
                                            BubbleMeta {
                                                time: msg.time;
                                                ticks: msg.ticks;
                                                blue: msg.ticksBlue;
                                                fromMe: msg.fromMe;
                                            }
                                        }
                                    }
                                    sel-overlay := TextInput {
                                        text: msg.plain;
                                        read-only: true;
                                        single-line: false;
                                        wrap: word-wrap;
                                        font-size: 14px;
                                        // Not fully transparent: the renderer
                                        // skips a TextInput whose color has no
                                        // alpha, selection highlight included.
                                        color: #00000001;
                                        selection-background-color: #3390ec;
                                        selection-foreground-color: white;
                                        width: parent.width;
                                        height: parent.height;
                                        // Slint moves the cursor for more
                                        // than clicks: a recycled row gets
                                        // new text and the cursor is clamped
                                        // to it, and arrow keys walk it. A
                                        // link opens only for a press that
                                        // lands on the text it was seen on.
                                        property <string> seen-text;
                                        property <bool> key-down: false;
                                        init => { self.seen-text = self.text; }
                                        cursor-position-changed(pos) => {
                                            link-click.running = false;
                                            if (self.text != self.seen-text) {
                                                self.seen-text = self.text;
                                            } else if (self.has-focus && !self.key-down
                                                    && self.anchor-position-byte-offset
                                                        == self.cursor-position-byte-offset) {
                                                link-click.running = true;
                                            }
                                        }
                                        key-pressed(event) => { self.key-down = true; reject }
                                        key-released(event) => { self.key-down = false; reject }
                                    }
                                    for span in msg.links: LinkHover {
                                        width: parent.width;
                                        height: parent.height;
                                        text: msg.plain;
                                        start: span.start;
                                        end: span.end;
                                        pass-through: root.link-press-through || root.select-mode;
                                        press(x, y) => {
                                            root.link-release-seen = false;
                                            root.link-pressed(x, y);
                                        }
                                        release => { root.link-release-seen = true; }
                                    }
                                    // A press that is still a click (no drag
                                    // moved the cursor away from the anchor)
                                    // once a double-click would have shown up.
                                    link-click := Timer {
                                        interval: 220ms;
                                        running: false;
                                        triggered => {
                                            self.running = false;
                                            if (sel-overlay.has-focus
                                                && sel-overlay.anchor-position-byte-offset
                                                    == sel-overlay.cursor-position-byte-offset) {
                                                root.open-link-at(msg.id, sel-overlay.cursor-position-byte-offset);
                                            }
                                        }
                                    }
                                }

                                if !msg.hasStyled && (msg.kind == "text" || ((msg.kind == "image" || msg.kind == "video") && msg.text != "")): Rectangle {
                                    width: min(plain-text.preferred-width, msg-row.content-w);
                                    height: plain-text.preferred-height;
                                    plain-text := TextInput {
                                        text: (msg.deleted ? "🚫 " + msg.text : msg.text)
                                            + (msg-row.meta-inline ? "\u{A0}\u{A0}\u{A0}\u{A0}\u{A0}\u{A0}\u{A0}\u{A0}\u{A0}\u{A0}\u{A0}\u{A0}\u{A0}\u{A0}" : "");
                                        opacity: root.blur-messages && !row-hover.has-hover ? 0.08 : 1;
                                        animate opacity { duration: 120ms; easing: ease-out; }
                                        read-only: true;
                                        single-line: false;
                                        wrap: word-wrap;
                                        font-size: 14px;
                                        font-italic: msg.deleted;
                                        color: msg.deleted ? Theme.text-dim : Theme.bubble-text;
                                        selection-background-color: #3390ec;
                                        selection-foreground-color: white;
                                        // captions wrap to the image width
                                        width: parent.width;
                                        height: self.preferred-height;
                                    }
                                    stamp-in2 := Rectangle {
                                        width: stamp-lay2.preferred-width;
                                        height: stamp-lay2.preferred-height;
                                        x: bubble.width - 24px - stamp-lay2.preferred-width;
                                        y: parent.height - stamp-lay2.preferred-height - 1px;
                                        stamp-lay2 := HorizontalLayout {
                                            BubbleMeta {
                                                time: msg.time;
                                                ticks: msg.ticks;
                                                blue: msg.ticksBlue;
                                                fromMe: msg.fromMe;
                                            }
                                        }
                                    }
                                }

                                // Stickers have no bubble, so the timestamp
                                // gets its own pill like WhatsApp draws it,
                                // with breathing room under the artwork.
                                if msg.sticker: Rectangle { height: 6px; }
                                if msg.kind != "audio" && msg.kind != "system" && !msg-row.meta-inline: HorizontalLayout {
                                    alignment: end;
                                    Rectangle {
                                        width: stamp.preferred-width + (msg.sticker ? 14px : 0);
                                        height: msg.sticker ? 20px : stamp.preferred-height;
                                        border-radius: 10px;
                                        background: msg.sticker
                                            ? (msg.fromMe ? Theme.bubble-out : Theme.bubble-in)
                                            : transparent;
                                        stamp := HorizontalLayout {
                                            spacing: 4px;
                                            padding-left: msg.sticker ? 7px : 0;
                                            padding-right: msg.sticker ? 7px : 0;
                                            if msg.ticks != "": Ticks { ticks: msg.ticks; blue: msg.ticksBlue; }
                                            Text {
                                                text: msg.time;
                                                font-size: 10px;
                                                color: msg.fromMe ? Theme.time-out : Theme.text-dim;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        // Hover actions, mirroring WhatsApp: react, forward
                        // and the message menu.
                        if (row-hover.has-hover || root.react-bar-id == msg.id)
                            && !root.select-mode && msg.kind != "system": Rectangle {
                            y: bubble.y + 4px;
                            x: msg.fromMe
                                ? max(0px, bubble.x - self.width - 6px)
                                : bubble.x + bubble.width + 6px;
                            width: 96px;
                            height: 28px;
                            HorizontalLayout {
                                spacing: 4px;
                                IconButton {
                                    icon: @image-url("../icons/mood-smile.svg");
                                    icon-size: 17px;
                                    clicked => {
                                        root.react-bar-id =
                                            root.react-bar-id == msg.id ? "" : msg.id;
                                    }
                                }
                                IconButton {
                                    icon: @image-url("../icons/corner-up-right.svg");
                                    icon-size: 17px;
                                    clicked => { root.request-forward(msg.id); }
                                }
                                IconButton {
                                    icon: @image-url("../icons/chevron-down.svg");
                                    icon-size: 17px;
                                    clicked => {
                                        root.menu-message = msg;
                                        root.message-menu-x = self.absolute-position.x;
                                        root.message-menu-y = self.absolute-position.y + self.height;
                                        root.message-menu-open = true;
                                    }
                                }
                            }
                        }

                        // Quick reactions, the same set WhatsApp offers.
                        if root.react-bar-id == msg.id: Rectangle {
                            y: max(0px, bubble.y - 34px);
                            x: msg.fromMe
                                ? max(4px, bubble.x + bubble.width - self.width)
                                : bubble.x;
                            width: 214px;
                            height: 38px;
                            border-radius: 19px;
                            background: Theme.panel;
                            drop-shadow-blur: 8px;
                            drop-shadow-color: #00000030;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 2px;
                                for e in ["\u{1f44d}", "\u{2764}\u{fe0f}", "\u{1f602}",
                                          "\u{1f62e}", "\u{1f622}", "\u{1f64f}"]:
                                    Rectangle {
                                        width: 30px;
                                        emoji-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.react-to(msg.id, e);
                                                root.react-bar-id = "";
                                            }
                                        }
                                        EmojiText {
                                            text: e;
                                            font-size: emoji-touch.has-hover ? 24px : 20px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: parent.width;
                                            height: parent.height;
                                        }
                                    }
                                Rectangle {
                                    width: 26px;
                                    plus-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.react-bar-id = "";
                                            root.react-pick(msg.id);
                                        }
                                    }
                                    Image {
                                        source: @image-url("../icons/plus.svg");
                                        colorize: Theme.text-dim;
                                        width: 16px;
                                        height: 16px;
                                    }
                                }
                            }
                        }

                        if msg.reactions != "": Rectangle {
                            y: bubble.y + bubble.height - 4px;
                            x: msg.fromMe
                                ? bubble.x + bubble.width - self.width - 4px
                                : bubble.x + 4px;
                            width: chip-row.preferred-width + 14px;
                            height: 21px;
                            border-radius: 10.5px;
                            background: Theme.pill;
                            border-width: 1.5px;
                            border-color: Theme.conv-bg;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.show-reactions(msg.id); }
                            }
                            // The emoji and the count apart: the emoji font
                            // has digits of its own.
                            chip-row := HorizontalLayout {
                                alignment: center;
                                spacing: 3px;
                                EmojiText {
                                    text: msg.reactions;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                                if msg.reactionCount != "": Text {
                                    text: msg.reactionCount;
                                    font-size: 11px;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        // Selection mode: a click anywhere on the row
                        // toggles it, over whatever the bubble holds.
                        if root.select-mode && msg.kind != "system": TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle-select(msg.id); }
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                    root.drag-start(msg.id, msg-row.vis-y / 1px + self.pressed-y / 1px);
                                }
                                if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                                    root.drag-end();
                                }
                            }
                            moved => {
                                if (self.pressed) {
                                    root.drag-move(msg-row.vis-y / 1px + self.mouse-y / 1px);
                                }
                            }
                        }
                    }
                }
                    // Floating day: the date of the row at the top edge,
                    // shown while the list moves.
                    if root.scrolling && root.floating-day != "" && root.conv-ready: Rectangle {
                        y: contact-header.height + 8px;
                        x: (parent.width - self.width) / 2;
                        width: float-day.preferred-width + 24px;
                        height: 24px;
                        border-radius: 12px;
                        background: Theme.day-bg;
                        border-width: 1px;
                        border-color: Theme.day-border;
                        float-day := Text {
                            text: root.floating-day;
                            color: Theme.text-dim;
                            font-size: 11px;
                            width: parent.width;
                            height: parent.height;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                composer-dock := Rectangle {
                    x: 0px;
                    width: parent.width;
                    height: dock-col.preferred-height;
                    y: parent.height - self.height;
                    background: Theme.dark ? #0b141a28 : #ffffff28;
                    backdrop-blur: 12px;
                    dock-touch := TouchArea {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                    }
                    dock-col := VerticalLayout {
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 6px;

                if root.reply-open: Rectangle {
                    height: 58px;
                    background: Theme.header;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 6px;
                        spacing: 10px;
                        Rectangle {
                            horizontal-stretch: 1;
                            background: Theme.pill;
                            border-radius: 6px;
                            Rectangle {
                                x: 0;
                                width: 4px;
                                height: parent.height;
                                background: Theme.accent;
                            }
                            VerticalLayout {
                                padding-left: 12px;
                                padding-right: 8px;
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: root.reply-name;
                                    color: Theme.accent;
                                    font-size: 13px;
                                    font-weight: 700;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.reply-text;
                                    color: Theme.text-dim;
                                    font-size: 13px;
                                    overflow: elide;
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: @image-url("../icons/x.svg");
                                clicked => { root.cancel-reply(); }
                            }
                        }
                    }
                }

                // Selection bar: what to do with the picked messages.
                if root.select-mode: Rectangle {
                    height: 56px;
                    Rectangle {
                    x: 12px;
                    width: parent.width - 24px;
                    height: parent.height;
                    background: Theme.dark ? #1c2b34ee : #f0f2f5ee;
                    border-width: 1px;
                    border-color: Theme.dark ? #24343e : Theme.border;
                    border-radius: 18px;
                    drop-shadow-blur: 10px;
                    drop-shadow-color: #00000040;
                    HorizontalBox {
                        padding: 8px;
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        IconButton {
                            icon: @image-url("../icons/x.svg");
                            clicked => { root.select-cancel(); }
                        }
                        Text {
                            text: @tr("{} selected", root.select-count);
                            color: Theme.text;
                            font-size: 15px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        IconButton {
                            icon: @image-url("../icons/star.svg");
                            enabled: root.select-count > 0;
                            clicked => { root.select-star(); }
                        }
                        IconButton {
                            icon: @image-url("../icons/copy.svg");
                            enabled: root.select-count > 0;
                            clicked => { root.select-copy(); }
                        }
                        IconButton {
                            icon: @image-url("../icons/corner-up-right.svg");
                            enabled: root.select-count > 0;
                            clicked => { root.select-forward(); }
                        }
                        IconButton {
                            icon: @image-url("../icons/trash.svg");
                            enabled: root.select-count > 0;
                            clicked => { root.select-delete(); }
                        }
                    }
                    }
                }

                // Read-only conversation: announcement groups and groups
                // we are no longer in.
                if !root.select-mode && !root.current-can-send: Rectangle {
                    height: 62px;
                    background: Theme.header;
                    HorizontalLayout {
                        alignment: center;
                        if root.current-left: Text {
                            text: @tr("You can't send messages to this group because you're no longer a member.");
                            color: Theme.text-dim;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                        if !root.current-left: Text {
                            text: @tr("Only ");
                            color: Theme.text-dim;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                        if !root.current-left: Text {
                            text: @tr("admins");
                            color: Theme.accent;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                        if !root.current-left: Text {
                            text: @tr(" can send messages");
                            color: Theme.text-dim;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    height: root.select-mode || !root.current-can-send ? 0
                        : max(52px, min(190px, message-input.preferred-height + 32px));
                    visible: !root.select-mode && root.current-can-send;
                    background: transparent;

                    Rectangle {
                        x: 12px;
                        width: parent.width - 24px;
                        height: parent.height;
                        background: Theme.dark ? #1c2b34ee : #f0f2f5ee;
                        border-width: 1px;
                        border-color: Theme.dark ? #24343e : Theme.border;
                        border-radius: 18px;
                        drop-shadow-blur: 10px;
                        drop-shadow-color: #00000040;

                        // Recording bar (replaces the composer while capturing)
                        HorizontalBox {
                            visible: root.rec-active;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;
                            IconButton {
                                icon: @image-url("../icons/trash.svg");
                                clicked => { root.rec-cancel(); }
                            }
                            Rectangle {
                                width: 10px;
                                height: 10px;
                                border-radius: 5px;
                                background: #f05d4d;
                                y: 26px;
                            }
                            Text {
                                text: root.rec-elapsed;
                                color: Theme.text;
                                font-size: 15px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            vo-touch := TouchArea {
                                width: 40px;
                                height: 40px;
                                mouse-cursor: pointer;
                                clicked => { root.rec-view-once = !root.rec-view-once; }
                                Rectangle {
                                    width: parent.width;
                                    height: parent.height;
                                    border-radius: 8px;
                                    background: root.rec-view-once ? Theme.chip-active-bg
                                        : vo-touch.has-hover ? Theme.hover : transparent;
                                    Image {
                                        source: @image-url("../icons/eye.svg");
                                        colorize: root.rec-view-once ? Theme.accent : Theme.icon;
                                        width: 22px;
                                        height: 22px;
                                        x: 9px;
                                        y: 9px;
                                    }
                                }
                            }
                            IconButton {
                                icon: @image-url("../icons/send-2.svg");
                                clicked => { root.rec-stop(); }
                            }
                        }

                        HorizontalBox {
                            visible: !root.rec-active;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 8px;
                            IconButton {
                                width: 32px;
                                height: 32px;
                                icon-size: 20px;
                                radius: 10px;
                                background: Theme.dark ? #17232b : Theme.pill;
                                icon: @image-url("../icons/plus.svg");
                                clicked => {
                                    root.picker-open = false;
                                    root.attach-open = !root.attach-open;
                                }
                            }
                            IconButton {
                                width: 32px;
                                height: 32px;
                                icon-size: 20px;
                                icon: @image-url("../icons/mood-smile.svg");
                                clicked => {
                                    root.attach-open = false;
                                    root.picker-open = !root.picker-open;
                                    if (root.picker-open) { root.picker-opened(); }
                                }
                            }
                            // A TextInput rather than a LineEdit: it wraps,
                            // takes Shift+Enter for a new line and tells the
                            // host where the cursor is (for "@" mentions).
                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 12px;
                                background: Theme.dark ? #1e2b33 : Theme.pill;
                                composer-scroll := Flickable {
                                    x: 12px;
                                    y: 8px;
                                    width: parent.width - 24px;
                                    height: parent.height - 16px;
                                    content-height: max(self.height, message-input.preferred-height);
                                    content-width: self.width;
                                    // TextInput never scrolls itself into view
                                    // (that's the enclosing widget's job, per
                                    // Slint's own docs) -- interactive lets a
                                    // mouse-wheel/drag also scroll a long
                                    // composed message, and cursor-position-changed
                                    // below keeps the caret itself always visible.
                                    interactive: true;
                                    message-input := TextInput {
                                        width: parent.width;
                                        height: max(parent.height, self.preferred-height);
                                        color: Theme.text;
                                        font-size: 15px;
                                        single-line: false;
                                        wrap: word-wrap;
                                        vertical-alignment: center;
                                        selection-background-color: #3390ec;
                                        selection-foreground-color: white;
                                        edited => {
                                            root.composer-changed(self.text, self.cursor-position-byte-offset);
                                        }
                                        cursor-position-changed(pos) => {
                                            if (pos.y < -composer-scroll.viewport-y) {
                                                composer-scroll.viewport-y = -pos.y;
                                            } else if (pos.y + self.font-size * 1.3
                                                    > -composer-scroll.viewport-y + composer-scroll.height) {
                                                composer-scroll.viewport-y =
                                                    composer-scroll.height - pos.y - self.font-size * 1.3;
                                            }
                                        }
                                        key-pressed(event) => {
                                            if (event.text == Key.Return && !event.modifiers.shift) {
                                                if (root.mention-open) {
                                                    root.mention-pick(0);
                                                } else {
                                                    root.send-message(self.text);
                                                    self.text = "";
                                                    composer-scroll.viewport-y = 0;
                                                }
                                                return accept;
                                            }
                                            if (event.text == Key.Escape && root.mention-open) {
                                                root.mention-close();
                                                return accept;
                                            }
                                            reject
                                        }
                                    }
                                }
                                if message-input.text == "": Text {
                                    text: @tr("Type a message");
                                    color: Theme.text-dim;
                                    font-size: 15px;
                                    x: 12px;
                                    height: parent.height;
                                    vertical-alignment: center;
                                }
                            }
                            IconButton {
                                width: 32px;
                                height: 32px;
                                icon-size: 20px;
                                icon: @image-url("../icons/microphone.svg");
                                y: parent.height - self.height - 8px;
                                clicked => { root.rec-start(); }
                            }
                            IconButton {
                                width: 40px;
                                height: 32px;
                                icon-size: 20px;
                                radius: 10px;
                                background: #21885b;
                                tint: #ffffff;
                                icon: @image-url("../icons/send-2.svg");
                                y: parent.height - self.height - 8px;
                                clicked => {
                                    root.send-message(message-input.text);
                                    message-input.text = "";
                                    composer-scroll.viewport-y = 0;
                                }
                            }

                    }
                    }
                }
                    }
                }
            }

            contact-header := Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                visible: root.chat-open;
                height: 80px;

                background: Theme.dark ? #0b141a28 : #ffffff28;
                backdrop-blur: 12px;
                Rectangle {
                    x: 12px;
                    y: 8px;
                    width: parent.width - 24px;
                    height: 64px;
                    border-radius: 18px;
                    background: Theme.dark ? #1c2b34ee : #f0f2f5ee;
                    border-width: 1px;
                    border-color: Theme.dark ? #24343e : Theme.border;
                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 14px;
                        spacing: 12px;
                        Rectangle {
                            width: 40px;
                            Avatar {
                                y: (parent.height - self.height) / 2;
                                width: 40px;
                                height: 40px;
                                src: root.current-avatar;
                                has-image: root.current-avatar-has;
                                initial: root.current-initial;
                                color-idx: root.current-color-idx;
                                privacy-blurred: root.blur-photos;
                                privacy-reveal: header-avatar-touch.has-hover;
                            }
                            header-avatar-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.open-info(); }
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            head-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.open-info(); }
                            }
                            VerticalLayout {
                                alignment: center;
                                width: parent.width;
                                height: parent.height;
                                spacing: 4px;
                                Text {
                                    text: root.current-chat-name;
                                    color: Theme.text;
                                    opacity: root.blur-names && !head-touch.has-hover ? 0.08 : 1;
                                    animate opacity { duration: 120ms; easing: ease-out; }
                                    font-size: 15px;
                                    font-weight: 600;
                                    overflow: elide;
                                }
                                if root.current-status != "": Text {
                                    text: root.current-status;
                                    color: Theme.text-dim;
                                    font-size: 11px;
                                    wrap: no-wrap;
                                    overflow: elide;
                                    opacity: root.blur-names && !head-touch.has-hover ? 0.08 : 1;
                                    animate opacity { duration: 120ms; easing: ease-out; }
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                width: 32px;
                                height: 32px;
                                icon-size: 20px;
                                icon: @image-url("../icons/search.svg");
                                active: root.chat-search-open;
                                clicked => { root.menu-search(); }
                            }
                        }
                        if root.current-callable: VerticalLayout {
                            alignment: center;
                            IconButton {
                                width: 32px;
                                height: 32px;
                                icon-size: 20px;
                                icon: @image-url("../icons/video.svg");
                                clicked => { root.start-video-call(root.current-jid); }
                            }
                        }
                        if root.current-callable: VerticalLayout {
                            alignment: center;
                            IconButton {
                                width: 32px;
                                height: 32px;
                                icon-size: 20px;
                                icon: @image-url("../icons/phone.svg");
                                clicked => { root.start-call(root.current-jid); }
                            }
                        }
                        Rectangle {
                            width: 1px;
                            height: 24px;
                            y: (parent.height - self.height) / 2;
                            background: Theme.dark ? #30414c : Theme.border;
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                width: 32px;
                                height: 32px;
                                icon-size: 20px;
                                icon: @image-url("../icons/dots-vertical.svg");
                                active: root.chat-menu-open;
                                clicked => {
                                    root.chat-menu-sub = "";
                                    root.chat-menu-open = !root.chat-menu-open;
                                }
                            }
                        }
                    }
                }
            }

            if root.chat-open && root.sync-banner != "": Rectangle {
                y: contact-header.height + 4px;
                width: parent.width;
                height: 32px;
                HorizontalLayout {
                    alignment: center;
                    padding-top: 6px;
                    Rectangle {
                        width: banner-text.preferred-width + 44px;
                        height: 24px;
                        border-radius: 12px;
                        background: banner-touch.has-hover ? Theme.selected : Theme.pill;
                        banner-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.sync-clicked(); }
                        }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            Image {
                                source: @image-url("../icons/refresh.svg");
                                colorize: Theme.text-dim;
                                width: 13px;
                                height: 13px;
                                y: (parent.height - self.height) / 2;
                            }
                            banner-text := Text {
                                text: root.sync-banner;
                                color: Theme.text-dim;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }


            // Floating "jump to latest" button
            if root.chat-open && !root.stick-bottom: Rectangle {
                x: parent.width - self.width - 24px;
                y: parent.height - self.height - composer-dock.height - 16px;
                width: 42px;
                height: 42px;
                border-radius: 21px;
                background: Theme.panel;
                drop-shadow-blur: 6px;
                drop-shadow-color: #00000055;
                jump-touch := TouchArea {
                    mouse-cursor: pointer;
                    // Routed through the host so the jump is re-applied
                    // while late-growing rows settle.
                    clicked => { root.jump-latest(); }
                }
                Image {
                    source: @image-url("../icons/chevron-right.svg");
                    colorize: Theme.icon;
                    width: 22px;
                    height: 22px;
                    x: 10px;
                    y: 10px;
                    transform-rotation: 90deg;
                }
            }

            // Emoji / sticker picker above the composer
            if root.picker-open && root.chat-open: Rectangle {
                x: 12px;
                y: parent.height - self.height - composer-dock.height - 8px;
                width: 380px;
                height: 320px;
                background: Theme.panel;
                border-radius: 10px;
                drop-shadow-blur: 8px;
                drop-shadow-color: #00000055;
                VerticalLayout {
                    padding: 10px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        FilterChip {
                            label: @tr("Emoji");
                            active: root.picker-tab == "emoji";
                            clicked => { root.picker-tab = "emoji"; }
                        }
                        FilterChip {
                            label: @tr("Stickers");
                            active: root.picker-tab == "sticker";
                            clicked => { root.picker-tab = "sticker"; }
                        }
                        FilterChip {
                            label: @tr("Favorites");
                            active: root.picker-tab == "fav";
                            clicked => { root.picker-tab = "fav"; }
                        }
                        FilterChip {
                            label: "GIF";
                            active: root.picker-tab == "gif";
                            clicked => { root.picker-tab = "gif"; }
                        }
                    }
                    if root.picker-tab == "emoji": ListView {
                        for row in root.emoji-rows: Rectangle {
                            height: row.label != "" ? 28px : 44px;
                            if row.label != "": Text {
                                text: row.label;
                                font-size: 12px;
                                color: Theme.text-dim;
                                x: 6px;
                                width: parent.width - 6px;
                                height: parent.height;
                                vertical-alignment: center;
                            }
                            if row.label == "": HorizontalLayout {
                                spacing: 2px;
                                alignment: start;
                                for e in row.cells: em-touch := TouchArea {
                                    width: 42px;
                                    height: 42px;
                                    mouse-cursor: pointer;
                                    Rectangle {
                                        width: parent.width;
                                        height: parent.height;
                                        border-radius: 6px;
                                        background: em-touch.has-hover ? Theme.hover : transparent;
                                        EmojiText {
                                            text: e;
                                            font-size: 24px;
                                            width: parent.width;
                                            height: parent.height;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    clicked => { root.emoji-pick(e); }
                                }
                            }
                        }
                    }
                    if root.picker-tab == "gif": VerticalLayout {
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 6px;
                            gif-input := LineEdit {
                                placeholder-text: @tr("Search GIFs");
                                accepted => { root.gif-search(self.text); }
                            }
                            IconButton {
                                icon: @image-url("../icons/search.svg");
                                clicked => { root.gif-search(gif-input.text); }
                            }
                        }
                        if root.gif-hint != "": Text {
                            text: root.gif-hint;
                            color: Theme.text-dim;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        ListView {
                        for row in root.gif-rows: Rectangle {
                            height: 92px;
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                for cell in row: gif-touch := TouchArea {
                                    width: 84px;
                                    height: 84px;
                                    mouse-cursor: pointer;
                                    Rectangle {
                                        width: parent.width;
                                        height: parent.height;
                                        border-radius: 8px;
                                        clip: true;
                                        background: gif-touch.has-hover ? Theme.hover : transparent;
                                        if cell.ready: Image {
                                            source: cell.pic;
                                            width: parent.width;
                                            height: parent.height;
                                            image-fit: cover;
                                        }
                                    }
                                    clicked => {
                                        root.gif-send(cell.id);
                                        root.picker-open = false;
                                    }
                                }
                            }
                        }
                        }
                    }
                    if root.picker-tab == "fav" && root.fav-hint != "": Text {
                        text: root.fav-hint;
                        color: Theme.text-dim;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    if root.picker-tab == "fav": ListView {
                        for row in root.fav-rows: Rectangle {
                            height: 92px;
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                for cell in row: fav-touch := TouchArea {
                                    width: 84px;
                                    height: 84px;
                                    mouse-cursor: pointer;
                                    Rectangle {
                                        width: parent.width;
                                        height: parent.height;
                                        border-radius: 8px;
                                        background: fav-touch.has-hover ? Theme.hover : transparent;
                                        if cell.ready: Image {
                                            source: cell.pic;
                                            width: 76px;
                                            height: 76px;
                                            x: 4px;
                                            y: 4px;
                                            image-fit: contain;
                                        }
                                    }
                                    clicked => {
                                        root.sticker-send(cell.id);
                                        root.picker-open = false;
                                    }
                                }
                            }
                        }
                    }
                    if root.picker-tab == "sticker": ListView {
                        for row in root.sticker-rows: Rectangle {
                            height: 92px;
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                for cell in row: sk-touch := TouchArea {
                                    width: 84px;
                                    height: 84px;
                                    mouse-cursor: pointer;
                                    Rectangle {
                                        width: parent.width;
                                        height: parent.height;
                                        border-radius: 8px;
                                        background: sk-touch.has-hover ? Theme.hover : transparent;
                                        if cell.ready: Image {
                                            source: cell.pic;
                                            width: 76px;
                                            height: 76px;
                                            x: 4px;
                                            y: 4px;
                                            image-fit: contain;
                                        }
                                    }
                                    clicked => {
                                        root.sticker-send(cell.id);
                                        root.picker-open = false;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // "@" mention list above the composer.
            if root.mention-open && root.chat-open && !root.select-mode: Rectangle {
                x: 12px;
                y: parent.height - self.height - composer-dock.height - 8px;
                width: 360px;
                height: min(320px, mention-col.preferred-height + 12px);
                background: Theme.panel;
                border-radius: 10px;
                drop-shadow-blur: 8px;
                drop-shadow-color: #00000055;
                clip: true;
                mention-col := VerticalLayout {
                    padding: 6px;
                    spacing: 0;
                    for m[i] in root.mention-rows: MemberRow {
                        item: m;
                        clicked => { root.mention-pick(i); }
                    }
                }
            }

            // Chat header menu, dropping from the "⋮" button.
            if root.chat-menu-open && root.chat-open: Rectangle {
                x: parent.width - self.width - 8px;
                y: 50px;
                width: 260px;
                height: chat-menu-col.preferred-height + 12px;
                background: Theme.panel;
                border-radius: 10px;
                drop-shadow-blur: 10px;
                drop-shadow-color: #00000066;
                chat-menu-col := VerticalLayout {
                    padding: 6px;
                    spacing: 1px;
                    if root.chat-menu-sub == "": VerticalLayout {
                        spacing: 1px;
                        if root.current-is-group && !root.current-left: MenuRow {
                            icon: @image-url("../icons/user-plus.svg");
                            label: @tr("Add member");
                            clicked => { root.menu-add-member(); }
                        }
                        MenuRow {
                            icon: @image-url("../icons/info-circle.svg");
                            label: root.current-is-group ? @tr("Group info") : @tr("Contact info");
                            clicked => { root.chat-menu-open = false; root.open-info(); }
                        }
                        MenuRow {
                            icon: @image-url("../icons/search.svg");
                            label: @tr("Search");
                            clicked => { root.menu-search(); }
                        }
                        MenuRow {
                            icon: @image-url("../icons/checkbox.svg");
                            label: @tr("Select messages");
                            clicked => { root.select-start(""); }
                        }
                        MenuRow {
                            icon: root.current-muted ? @image-url("../icons/bell.svg") : @image-url("../icons/bell-off.svg");
                            label: root.current-muted ? @tr("Unmute notifications") : @tr("Mute notifications");
                            detail: root.current-mute-label;
                            submenu: !root.current-muted;
                            clicked => {
                                if (root.current-muted) { root.menu-mute(0); }
                                else { root.chat-menu-sub = "mute"; }
                            }
                        }
                        if !root.current-left && (!root.current-is-group || root.current-admin): MenuRow {
                            icon: @image-url("../icons/clock-pause.svg");
                            label: @tr("Disappearing messages");
                            detail: root.current-ephemeral-label;
                            submenu: true;
                            clicked => { root.chat-menu-sub = "ephemeral"; }
                        }
                        MenuRow {
                            icon: root.current-favorite ? @image-url("../icons/heart-filled.svg") : @image-url("../icons/heart.svg");
                            label: root.current-favorite ? @tr("Remove from Favorites") : @tr("Add to Favorites");
                            clicked => { root.menu-favorite(); }
                        }
                        MenuRow {
                            icon: @image-url("../icons/list-details.svg");
                            label: @tr("Add to list");
                            submenu: true;
                            clicked => { root.chat-menu-sub = "lists"; }
                        }
                        MenuRow {
                            icon: @image-url("../icons/download.svg");
                            label: @tr("Export chat");
                            clicked => { root.menu-export(); }
                        }
                        MenuRow {
                            icon: @image-url("../icons/circle-x.svg");
                            label: @tr("Close chat");
                            clicked => { root.chat-menu-open = false; root.menu-close-chat(); }
                        }
                        Rectangle { height: 1px; background: Theme.border; }
                        MenuRow {
                            icon: @image-url("../icons/circle-minus.svg");
                            label: @tr("Clear chat");
                            clicked => { root.menu-clear(); }
                        }
                        if root.current-is-group && !root.current-left: MenuRow {
                            icon: @image-url("../icons/logout.svg");
                            label: @tr("Exit group");
                            tint: #f05d4d;
                            clicked => { root.menu-exit-group(); }
                        }
                        if !root.current-is-group || root.current-left: MenuRow {
                            icon: @image-url("../icons/trash.svg");
                            label: @tr("Delete chat");
                            tint: #f05d4d;
                            clicked => { root.menu-delete-chat(); }
                        }
                    }
                    if root.chat-menu-sub == "mute": VerticalLayout {
                        spacing: 1px;
                        MenuRow {
                            icon: @image-url("../icons/arrow-left.svg");
                            label: @tr("Mute notifications");
                            clicked => { root.chat-menu-sub = ""; }
                        }
                        Rectangle { height: 1px; background: Theme.border; }
                        MenuRow { icon: @image-url("../icons/bell-off.svg"); label: @tr("8 hours"); clicked => { root.menu-mute(8); } }
                        MenuRow { icon: @image-url("../icons/bell-off.svg"); label: @tr("1 week"); clicked => { root.menu-mute(168); } }
                        MenuRow { icon: @image-url("../icons/bell-off.svg"); label: @tr("Always"); clicked => { root.menu-mute(-1); } }
                    }
                    if root.chat-menu-sub == "ephemeral": VerticalLayout {
                        spacing: 1px;
                        MenuRow {
                            icon: @image-url("../icons/arrow-left.svg");
                            label: @tr("Disappearing messages");
                            clicked => { root.chat-menu-sub = ""; }
                        }
                        Rectangle { height: 1px; background: Theme.border; }
                        MenuRow {
                            icon: root.current-ephemeral == 86400 ? @image-url("../icons/check.svg") : @image-url("../icons/clock-pause.svg");
                            label: @tr("24 hours");
                            clicked => { root.menu-ephemeral(86400); }
                        }
                        MenuRow {
                            icon: root.current-ephemeral == 604800 ? @image-url("../icons/check.svg") : @image-url("../icons/clock-pause.svg");
                            label: @tr("7 days");
                            clicked => { root.menu-ephemeral(604800); }
                        }
                        MenuRow {
                            icon: root.current-ephemeral == 7776000 ? @image-url("../icons/check.svg") : @image-url("../icons/clock-pause.svg");
                            label: @tr("90 days");
                            clicked => { root.menu-ephemeral(7776000); }
                        }
                        MenuRow {
                            icon: root.current-ephemeral == 0 ? @image-url("../icons/check.svg") : @image-url("../icons/circle-x.svg");
                            label: @tr("Off");
                            clicked => { root.menu-ephemeral(0); }
                        }
                    }
                    if root.chat-menu-sub == "lists": VerticalLayout {
                        spacing: 1px;
                        MenuRow {
                            icon: @image-url("../icons/arrow-left.svg");
                            label: @tr("Add to list");
                            clicked => { root.chat-menu-sub = ""; }
                        }
                        Rectangle { height: 1px; background: Theme.border; }
                        for lb in root.labels: MenuRow {
                            icon: lb.active ? @image-url("../icons/check.svg") : @image-url("../icons/list-details.svg");
                            label: lb.name;
                            tint: lb.active ? Theme.accent : Theme.text;
                            clicked => { root.menu-list(lb.id); }
                        }
                        MenuRow {
                            icon: @image-url("../icons/plus.svg");
                            label: @tr("New list");
                            clicked => { root.chat-menu-open = false; root.new-list-open = true; }
                        }
                    }
                }
            }

            // WhatsApp-style attach menu popping above the composer
            if root.attach-open && root.chat-open: Rectangle {
                x: 12px;
                y: parent.height - self.height - composer-dock.height - 8px;
                width: 220px;
                height: menu-col.preferred-height + 16px;
                background: Theme.panel;
                border-radius: 10px;
                drop-shadow-blur: 8px;
                drop-shadow-color: #00000055;
                menu-col := VerticalLayout {
                    padding: 8px;
                    spacing: 2px;
                    MenuRow {
                        icon: @image-url("../icons/file-text.svg");
                        label: @tr("Document");
                        clicked => { root.attach-open = false; root.attach-doc(); }
                    }
                    MenuRow {
                        icon: @image-url("../icons/photo.svg");
                        label: @tr("Photos");
                        clicked => { root.attach-open = false; root.attach-image(); }
                    }
                    MenuRow {
                        icon: @image-url("../icons/music.svg");
                        label: @tr("Audio");
                        clicked => { root.attach-open = false; root.attach-audio(); }
                    }
                    MenuRow {
                        icon: @image-url("../icons/sticker-2.svg");
                        label: @tr("Sticker");
                        clicked => { root.attach-open = false; root.attach-sticker(); }
                    }
                }
            }
            image-editor := ImagePreview {
                visible: root.preview-open && root.chat-open;
                width: parent.width;
                height: parent.height;
                picture: root.preview-image;
                busy: root.preview-busy;
                cancel => { root.cancel-send-image(); }
                send(caption) => { root.confirm-send-image(caption); }
                crop(x, y, w, h) => { root.crop-preview(x, y, w, h); }
                annotate(text, x, y) => { root.text-preview(text, x, y); }
                draw(points, ink, thickness) => { root.draw-preview(points, ink, thickness); }
                reset => { root.reset-preview(); }
            }
        }
    }

    // ---------- Contact / group info ----------
    if root.info-open: Rectangle {
        background: #00000030;
        TouchArea { clicked => { root.close-info(); } }
        info-panel := Rectangle {
            property <bool> media-expanded: false;
            property <bool> actions-expanded: false;
            width: min(360px, parent.width - 16px);
            height: parent.height - 16px;
            x: parent.width - self.width - 8px;
            y: 8px;
            border-radius: 18px;
            border-width: 1px;
            border-color: Theme.dark ? #1c3038 : Theme.border;
            background: Theme.dark ? @linear-gradient(155deg, #0e1c22 0%, #0c171c 100%) : Theme.panel;
            clip: true;
            TouchArea { }
            VerticalLayout {
                padding: 0px;
                spacing: 0px;
                Rectangle {
                    height: 56px;
                    HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 12px;
                        spacing: 8px;
                        Text {
                            text: root.info-is-group ? @tr("Group info") : @tr("Contact info");
                            color: Theme.text;
                            font-size: 14px;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        IconButton {
                            width: 32px;
                            height: 32px;
                            icon-size: 18px;
                            y: (parent.height - self.height) / 2;
                            icon: @image-url("../icons/x.svg");
                            clicked => { root.close-info(); }
                        }
                    }
                }
                Flickable {
                    content-height: info-col.preferred-height;
                    content-width: self.width;
                    Rectangle {
                        height: info-col.preferred-height;
                        width: parent.width;
                        info-col := VerticalLayout {
                            width: parent.width;
                            padding-left: 18px;
                            padding-right: 18px;
                            padding-top: 10px;
                            padding-bottom: 18px;
                            spacing: 0px;
                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 84px;
                                    height: 84px;
                                    border-radius: 42px;
                                    border-width: 2px;
                                    border-color: Theme.dark ? #174039 : Theme.border;
                                    Avatar {
                                        x: 5px;
                                        y: 5px;
                                        width: 74px;
                                        height: 74px;
                                        src: root.info-avatar;
                                        has-image: root.info-has-avatar;
                                        initial: root.info-initial;
                                        color-idx: root.info-color-idx;
                                    }
                                }
                            }
                            Rectangle { height: 14px; }
                            TextInput {
                                read-only: true;
                                single-line: false;
                                selection-background-color: Theme.accent;
                                selection-foreground-color: white;
                                text: root.info-name;
                                color: Theme.text;
                                font-size: 16px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                            Rectangle { height: 5px; }
                            if !root.info-is-group && root.info-id != "": TextInput {
                                read-only: true;
                                single-line: false;
                                wrap: word-wrap;
                                selection-background-color: Theme.accent;
                                selection-foreground-color: white;
                                text: root.info-id;
                                color: Theme.text-dim;
                                font-size: 12px;
                                horizontal-alignment: center;
                            }
                            if root.info-members != "": Text {
                                text: root.info-members;
                                color: Theme.text-dim;
                                font-size: 12px;
                                horizontal-alignment: center;
                            }
                            Rectangle { height: 18px; }
                            HorizontalLayout {
                                spacing: 10px;
                                InfoAction {
                                    icon: @image-url("../icons/phone.svg");
                                    label: @tr("Call");
                                    enabled: root.current-callable;
                                    clicked => { root.start-call(root.current-jid); }
                                }
                                InfoAction {
                                    icon: @image-url("../icons/video.svg");
                                    label: @tr("Video");
                                    enabled: root.current-callable;
                                    clicked => { root.start-video-call(root.current-jid); }
                                }
                                InfoAction {
                                    icon: @image-url("../icons/search.svg");
                                    label: @tr("Search");
                                    clicked => { root.close-info(); root.menu-search(); }
                                }
                                InfoAction {
                                    icon: @image-url("../icons/dots-vertical.svg");
                                    label: @tr("More");
                                    clicked => { info-panel.actions-expanded = !info-panel.actions-expanded; }
                                }
                            }
                            Rectangle { height: 16px; }
                            if info-panel.actions-expanded: VerticalLayout {
                                spacing: 0px;
                                MenuRow {
                                    icon: root.current-muted ? @image-url("../icons/bell.svg") : @image-url("../icons/bell-off.svg");
                                    label: root.current-muted ? @tr("Unmute notifications") : @tr("Mute notifications");
                                    clicked => { root.menu-mute(root.current-muted ? 0 : -1); }
                                }
                                MenuRow {
                                    icon: @image-url("../icons/archive.svg");
                                    label: root.info-archived ? @tr("Unarchive chat") : @tr("Archive chat");
                                    clicked => { root.toggle-archive(); }
                                }
                                MenuRow {
                                    icon: @image-url("../icons/trash.svg");
                                    label: @tr("Clear messages on this device");
                                    clicked => { root.clear-chat(); }
                                }
                                Rectangle { height: 12px; }
                            }
                            Rectangle { height: 1px; background: Theme.border; }
                            if root.info-about != "" || root.info-desc != "": VerticalLayout {
                                padding-top: 14px;
                                padding-bottom: 14px;
                                TextInput {
                                    read-only: true;
                                    single-line: false;
                                    selection-background-color: Theme.accent;
                                    selection-foreground-color: white;
                                    text: root.info-is-group ? root.info-desc : root.info-about;
                                    color: Theme.text;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                                Rectangle { height: 14px; }
                                Rectangle { height: 1px; background: Theme.border; }
                            }
                            MenuRow {
                                icon: @image-url("../icons/photo.svg");
                                label: @tr("Shared media");
                                submenu: true;
                                clicked => { info-panel.media-expanded = !info-panel.media-expanded; }
                            }
                            if info-panel.media-expanded: VerticalLayout {
                                padding-top: 8px;
                                padding-bottom: 12px;
                                spacing: 6px;
                                if root.info-media.length == 0: Text {
                                    text: @tr("No media preview available");
                                    color: Theme.text-dim;
                                    font-size: 12px;
                                }
                                for row in root.info-media: HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    for cell in row: Rectangle {
                                        width: (info-panel.width - 56px) / 4;
                                        height: self.width;
                                        border-radius: 8px;
                                        clip: true;
                                        background: Theme.hover;
                                        if cell.ready: Image {
                                            source: cell.pic;
                                            width: parent.width;
                                            height: parent.height;
                                            image-fit: cover;
                                        }
                                    }
                                }
                            }
                            Rectangle { height: 1px; background: Theme.border; }
                            if root.info-is-group: HorizontalLayout {
                                padding-top: 16px;
                                padding-bottom: 10px;
                                spacing: 8px;
                                Text {
                                    text: root.info-members != "" ? root.info-members : @tr("Participants");
                                    color: Theme.text-dim;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                if !root.current-left: TouchArea {
                                    width: add-member-label.preferred-width;
                                    height: 24px;
                                    mouse-cursor: pointer;
                                    add-member-label := Text {
                                        text: @tr("Add member");
                                        color: Theme.accent;
                                        font-size: 12px;
                                        height: parent.height;
                                        vertical-alignment: center;
                                    }
                                    clicked => { root.close-info(); root.menu-add-member(); }
                                }
                            }
                            if !root.info-is-group: VerticalLayout {
                                padding-top: 16px;
                                spacing: 8px;
                                Text {
                                    text: @tr("Groups in common") + (root.info-common-groups-state == "ready" ? " (" + root.info-common-groups.length + ")" : "");
                                    color: Theme.text-dim;
                                    font-size: 12px;
                                }
                                if root.info-common-groups-state != "ready" || root.info-common-groups.length == 0: Text {
                                    text: root.info-common-groups-state == "loading" ? @tr("Loading groups…")
                                        : root.info-common-groups-state == "error" ? @tr("Could not load groups in common")
                                        : @tr("No groups in common");
                                    color: Theme.text-dim;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                                for group in root.info-common-groups: MemberRow {
                                    item: group;
                                    compact: true;
                                    clicked => { root.close-info(); root.open-chat(group.jid); }
                                }
                            }
                            for m in root.info-member-rows: MemberRow {
                                item: m;
                                compact: true;
                                clicked => { root.open-member(m.jid); }
                            }
                        }
                    }
                }
            }
        }
    }

    // ---------- In-chat search panel ----------
    if root.chat-search-open && root.chat-open: Rectangle {
        width: 380px;
        height: parent.height;
        x: parent.width - self.width;
        background: Theme.panel;
        TouchArea { }
        VerticalBox {
            padding: 0;
            spacing: 0;
            Rectangle {
                height: 54px;
                background: Theme.header;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 10px;
                    IconButton {
                        icon: @image-url("../icons/x.svg");
                        clicked => { root.chat-search-close(); }
                    }
                    Text {
                        text: @tr("Search messages");
                        color: Theme.text;
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    IconButton {
                        icon: @image-url("../icons/chevron-up.svg");
                        enabled: root.chat-search-rows.length > 0;
                        clicked => { root.chat-search-step(1); }
                    }
                    IconButton {
                        icon: @image-url("../icons/chevron-down.svg");
                        enabled: root.chat-search-rows.length > 0;
                        clicked => { root.chat-search-step(-1); }
                    }
                }
            }
            Rectangle {
                height: 58px;
                HorizontalLayout {
                    padding: 10px;
                    chat-search-input := LineEdit {
                        placeholder-text: @tr("Search");
                        init => { self.focus(); }
                        edited => { root.chat-search-changed(self.text); }
                        accepted => { root.chat-search-step(0); }
                    }
                }
            }
            if root.chat-search-count != "": Text {
                text: root.chat-search-count;
                color: Theme.text-dim;
                font-size: 12px;
                horizontal-alignment: center;
            }
            if chat-search-input.text == "": Text {
                text: @tr("Search for messages in this chat");
                color: Theme.text-dim;
                font-size: 13px;
                horizontal-alignment: center;
            }
            ListView {
                for hit in root.chat-search-rows: HitRow {
                    hit: hit;
                    clicked => { root.open-hit(hit.jid, hit.id); }
                }
            }
        }
    }

    // ---------- Sync progress ----------
    if root.sync-open: Rectangle {
        background: #00000088;
        TouchArea { clicked => { root.sync-open = false; } }
        Rectangle {
            width: 400px;
            height: sync-col.preferred-height + 44px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.panel;
            border-radius: 12px;
            TouchArea { }
            sync-col := VerticalLayout {
                padding: 22px;
                spacing: 14px;
                width: parent.width;
                Text {
                    text: @tr("Syncing older messages");
                    color: Theme.text;
                    font-size: 18px;
                    font-weight: 700;
                }
                Rectangle { height: 1px; background: Theme.border; }
                Text {
                    text: root.sync-detail;
                    color: Theme.text-dim;
                    font-size: 14px;
                    wrap: word-wrap;
                    width: parent.width - 44px;
                }
                HorizontalLayout {
                    alignment: end;
                    DialogButton {
                        label: "OK";
                        primary: true;
                        clicked => { root.sync-open = false; }
                    }
                }
            }
        }
    }

    // ---------- Account switcher ----------
    if root.account-menu-open && root.screen == "main": Rectangle {
        TouchArea { clicked => { root.account-menu-open = false; } }
        Rectangle {
            x: 64px;
            y: parent.height - self.height - 10px;
            width: 300px;
            height: account-col.preferred-height;
            background: Theme.panel;
            border-radius: 10px;
            drop-shadow-blur: 10px;
            drop-shadow-color: #00000066;
            TouchArea { }
            account-col := VerticalLayout {
                padding: 6px;
                spacing: 1px;
                for acc in root.accounts: AccountRow {
                    account: acc;
                    clicked => {
                        if (acc.active) { root.account-menu-open = false; }
                        else { root.switch-account(acc.id); }
                    }
                    remove => { root.remove-account(acc.id); }
                }
                Rectangle { height: 1px; background: Theme.border; }
                if root.can-add-account: MenuRow {
                    icon: @image-url("../icons/user-plus.svg");
                    label: @tr("Add account");
                    clicked => { root.add-account(); }
                }
                if !root.can-add-account: Text {
                    text: @tr("Up to 5 accounts");
                    color: Theme.text-dim;
                    font-size: 12px;
                    height: 32px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                MenuRow {
                    icon: @image-url("../icons/logout.svg");
                    label: @tr("Log out");
                    tint: #f05d4d;
                    clicked => {
                        root.account-menu-open = false;
                        root.logout();
                    }
                }
            }
        }
    }

    // Swapping sessions takes a moment; nothing underneath belongs to
    // either account while it lasts.
    if root.account-switching: Rectangle {
        background: Theme.bg;
        TouchArea { }
        Text {
            text: @tr("Switching accounts...");
            color: Theme.text-dim;
            font-size: 15px;
            width: parent.width;
            height: parent.height;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if root.message-menu-open: Rectangle {
        TouchArea { clicked => { root.message-menu-open = false; } }
        Rectangle {
            x: max(8px, min(root.message-menu-x, root.width - self.width - 8px));
            y: max(8px, min(root.message-menu-y, root.height - self.height - 8px));
            width: 264px;
            height: min(root.height - 16px, message-menu-items.preferred-height + 12px);
            border-radius: 12px;
            background: Theme.dark ? (root.theme-style == "glass" ? #222c32f5 : #222c32) : Theme.panel;
            border-width: 1px;
            border-color: Theme.dark ? #ffffff18 : Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000066;
            TouchArea { }
            ScrollView {
                x: 6px; y: 6px;
                width: parent.width - 12px;
                height: parent.height - 12px;
                message-menu-items := VerticalLayout {
                    spacing: 1px;
                    MenuRow {
                        height: 32px;
                        icon: @image-url("../icons/message-circle.svg");
                        label: @tr("Reply");
                        clicked => { root.message-menu-open = false; root.request-reply(root.menu-message.id); }
                    }
                    if root.menu-message.privateReply: MenuRow {
                        height: 32px;
                        icon: @image-url("../icons/users.svg");
                        label: @tr("Reply privately");
                        clicked => { root.message-menu-open = false; root.message-action(root.menu-message.id, "private"); }
                    }
                    MenuRow {
                        height: 32px;
                        icon: @image-url("../icons/corner-up-right.svg");
                        label: @tr("Forward");
                        clicked => { root.message-menu-open = false; root.request-forward(root.menu-message.id); }
                    }
                    if root.menu-message.text != "" && (root.menu-message.kind == "text" || root.menu-message.kind == "image" || root.menu-message.kind == "video"): MenuRow {
                        height: 32px;
                        icon: @image-url("../icons/copy.svg");
                        label: @tr("Copy text");
                        clicked => { root.message-menu-open = false; root.copy-text(root.menu-message.id); }
                    }
                    if root.menu-message.kind == "image" && root.menu-message.mediaReady: MenuRow {
                        height: 32px;
                        icon: @image-url("../icons/photo.svg");
                        label: @tr("Copy image");
                        clicked => { root.message-menu-open = false; root.copy-image(root.menu-message.id); }
                    }
                    if root.menu-message.linkUrl != "": MenuRow {
                        height: 32px;
                        icon: @image-url("../icons/copy.svg");
                        label: @tr("Copy link");
                        clicked => { root.message-menu-open = false; root.message-action(root.menu-message.id, "link"); }
                    }
                    if root.menu-message.kind != "text" && root.menu-message.mediaReady: MenuRow {
                        height: 32px;
                        icon: @image-url("../icons/download.svg");
                        label: @tr("Save as…");
                        clicked => { root.message-menu-open = false; root.message-action(root.menu-message.id, "save"); }
                    }
                    MenuRow {
                        height: 32px;
                        icon: @image-url("../icons/mood-smile.svg");
                        label: @tr("React");
                        clicked => { root.message-menu-open = false; root.react-pick(root.menu-message.id); }
                    }
                    if root.menu-message.editable: MenuRow {
                        height: 32px;
                        icon: @image-url("../icons/file-text.svg");
                        label: @tr("Edit");
                        clicked => { root.message-menu-open = false; root.message-action(root.menu-message.id, "edit"); }
                    }
                    MenuRow {
                        height: 32px;
                        icon: @image-url("../icons/pin.svg");
                        label: root.menu-message.pinned ? @tr("Unpin") : @tr("Pin for 7 days");
                        clicked => { root.message-menu-open = false; root.message-action(root.menu-message.id, "pin"); }
                    }
                    MenuRow {
                        height: 32px;
                        icon: @image-url("../icons/message-circle.svg");
                        label: @tr("Mark conversation unread");
                        clicked => { root.message-menu-open = false; root.message-action(root.menu-message.id, "unread"); }
                    }
                    MenuRow {
                        height: 32px;
                        icon: @image-url("../icons/star.svg");
                        label: root.menu-message.starred ? @tr("Unstar") : @tr("Star");
                        clicked => { root.message-menu-open = false; root.toggle-star(root.menu-message.id); }
                    }
                    MenuRow {
                        height: 32px;
                        icon: @image-url("../icons/checkbox.svg");
                        label: @tr("Select");
                        clicked => { root.message-menu-open = false; root.select-start(root.menu-message.id); }
                    }
                    MenuRow {
                        height: 32px;
                        icon: @image-url("../icons/info-circle.svg");
                        label: @tr("Details");
                        clicked => { root.message-menu-open = false; root.message-action(root.menu-message.id, "details"); }
                    }
                    Rectangle { height: 1px; background: Theme.dark ? #ffffff18 : Theme.border; }
                    MenuRow {
                        height: 34px;
                        icon: @image-url("../icons/trash.svg");
                        label: @tr("Delete");
                        tint: #f47783;
                        clicked => { root.message-menu-open = false; root.message-action(root.menu-message.id, "delete"); }
                    }
                }
            }
        }
    }

    if root.details-open: Rectangle {
        background: #00000025;
        TouchArea { clicked => { root.details-open = false; } }
        FocusScope {
            init => { self.focus(); }
            key-pressed(e) => {
                if (e.text == Key.Escape) { root.details-open = false; return accept; }
                return reject;
            }
        }
        Rectangle {
            width: min(336px, root.width);
            height: parent.height;
            x: parent.width - self.width;
            background: Theme.dark ? #1b252dee : Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            TouchArea { }
            VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: 64px;
                    background: Theme.header;
                    HorizontalLayout {
                        padding: 16px;
                        Text { text: @tr("Detalhes da mensagem"); color: Theme.text; font-size: 17px; font-weight: 600; vertical-alignment: center; }
                        Rectangle {
                            width: 28px;
                            Text { text: "×"; color: Theme.text-dim; font-size: 26px; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.details-open = false; } }
                        }
                    }
                }
                ScrollView {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;
                        Rectangle {
                            border-radius: 10px;
                            background: Theme.bubble-in;
                            height: details-preview.preferred-height;
                            details-preview := VerticalLayout {
                                padding: 12px;
                                spacing: 8px;
                                if root.details-has-image: Image {
                                    source: root.details-image;
                                    height: 154px;
                                    image-fit: contain;
                                }
                                Text { text: root.details-text; color: Theme.text; wrap: word-wrap; }
                            }
                        }
                        for row in root.details-rows: Rectangle {
                            background: row.kind == "status" ? Theme.bubble-in : transparent;
                            border-radius: 8px;
                            height: row.kind == "person" ? 38px : row.kind == "participant-heading" ? 28px : detail-content.preferred-height;
                            detail-content := HorizontalLayout {
                                padding: row.kind == "heading" || row.kind == "person" || row.kind == "participant-heading" ? 0px : 10px;
                                spacing: row.kind == "person" ? 8px : 10px;
                                alignment: start;
                                if row.kind == "person": Avatar {
                                    width: 28px; height: 28px;
                                    vertical-stretch: 0;
                                    src: row.avatar; has-image: row.hasAvatar;
                                    initial: row.initial; color-idx: row.colorIdx;
                                }
                                if row.kind == "status" || row.kind == "participant-heading": Ticks {
                                    ticks: row.ticks; blue: row.blue;
                                    vertical-stretch: 0;
                                }
                                if row.kind == "version": Rectangle {
                                    width: 10px;
                                    background: transparent;
                                    Rectangle { x: 4px; width: 2px; height: parent.height; background: Theme.accent; }
                                    Rectangle { y: 4px; width: 10px; height: 10px; border-radius: 5px; background: Theme.accent; }
                                }
                                VerticalLayout {
                                    spacing: row.kind == "person" ? 1px : 5px;
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: row.title;
                                        color: row.kind == "participant-heading" ? Theme.text-dim : row.kind == "heading" ? Theme.accent : Theme.text;
                                        font-size: row.kind == "heading" ? 14px : row.kind == "person" ? 12px : 13px;
                                        horizontal-alignment: left;
                                        font-weight: row.kind == "heading" || row.kind == "version" || row.kind == "person" ? 600 : 400;
                                        wrap: row.kind == "person" ? no-wrap : word-wrap;
                                        overflow: elide;
                                    }
                                    if row.text != "": Text { text: row.text; color: Theme.text; wrap: word-wrap; font-size: 13px; }
                                    if row.time != "": Text { text: row.time; color: Theme.text-dim; wrap: word-wrap; font-size: 11px; horizontal-alignment: left; }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.message-dialog-open: Rectangle {
        background: #00000088;
        TouchArea { clicked => { root.message-dialog-open = false; } }
        FocusScope {
            init => { self.focus(); }
            key-pressed(e) => {
                if (e.text == Key.Escape) { root.message-dialog-open = false; return accept; }
                return reject;
            }
        }
        Rectangle {
            width: min(480px, root.width - 32px);
            height: message-dialog-col.preferred-height + 40px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 12px;
            background: Theme.panel;
            TouchArea { }
            message-dialog-col := VerticalLayout {
                padding: 20px;
                spacing: 14px;
                Text { text: root.message-dialog-title; color: Theme.text; font-size: 18px; }
                if !root.message-dialog-edit: Text {
                    text: root.message-dialog-text;
                    color: Theme.text-dim;
                    wrap: word-wrap;
                }
                if root.message-dialog-edit: TextInput {
                    text <=> root.message-dialog-text;
                    color: Theme.text;
                    wrap: word-wrap;
                    height: 120px;
                    init => { self.focus(); }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    DialogButton {
                        label: @tr("Close");
                        clicked => { root.message-dialog-open = false; }
                    }
                    if root.message-dialog-edit: DialogButton {
                        label: @tr("Save");
                        primary: true;
                        enabled: root.message-dialog-text != "";
                        clicked => { root.submit-edit(root.message-dialog-id, root.message-dialog-text); }
                    }
                }
            }
        }
    }

    // ---------- Confirm dialog ----------
    if root.confirm-open: Rectangle {
        background: #00000088;
        TouchArea { clicked => { root.confirm-open = false; } }
        Rectangle {
            width: 400px;
            height: confirm-col.preferred-height + 44px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.panel;
            border-radius: 12px;
            TouchArea { }
            confirm-col := VerticalLayout {
                padding: 22px;
                spacing: 14px;
                width: parent.width;
                Text {
                    text: root.confirm-title;
                    color: Theme.text;
                    font-size: 17px;
                    font-weight: 700;
                    wrap: word-wrap;
                    width: parent.width - 44px;
                }
                Text {
                    text: root.confirm-text;
                    color: Theme.text-dim;
                    font-size: 14px;
                    wrap: word-wrap;
                    width: parent.width - 44px;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    DialogButton {
                        label: @tr("Cancel");
                        clicked => { root.confirm-open = false; }
                    }
                    if root.confirm-secondary != "": DialogButton {
                        label: root.confirm-secondary;
                        clicked => { root.confirm-other(); }
                    }
                    DialogButton {
                        label: root.confirm-action;
                        primary: true;
                        danger: true;
                        clicked => { root.confirm-accept(); }
                    }
                }
            }
        }
    }

    // ---------- Share group history ----------
    if root.share-open: Rectangle {
        background: #00000088;
        TouchArea { clicked => { root.share-cancel(); } }
        Rectangle {
            width: 500px;
            height: share-col.preferred-height + 48px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.panel;
            border-radius: 12px;
            TouchArea { }
            share-col := VerticalLayout {
                padding: 24px;
                spacing: 14px;
                width: parent.width;
                HorizontalLayout {
                    alignment: center;
                    Avatar {
                        width: 66px;
                        height: 66px;
                        src: root.share-avatar;
                        has-image: root.share-has-avatar;
                        initial: root.share-initial;
                        color-idx: root.share-color-idx;
                    }
                }
                Text {
                    text: @tr("Send message history to {}?", root.share-name);
                    color: Theme.text;
                    font-size: 18px;
                    font-weight: 700;
                    wrap: word-wrap;
                    width: parent.width - 48px;
                }
                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    Text {
                        text: root.share-name + " ";
                        color: Theme.text;
                        font-size: 14px;
                    }
                    Text {
                        text: @tr("will get");
                        color: Theme.text;
                        font-size: 14px;
                    }
                    Text {
                        text: @tr("recent messages");
                        color: Theme.accent;
                        font-size: 14px;
                    }
                    Text {
                        text: @tr("from this group.");
                        color: Theme.text;
                        font-size: 14px;
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    DialogButton {
                        label: @tr("Cancel");
                        clicked => { root.share-cancel(); }
                    }
                    DialogButton {
                        label: root.share-sending ? @tr("Sending…") : @tr("Send");
                        primary: true;
                        enabled: !root.share-sending;
                        clicked => { root.share-accept(); }
                    }
                }
            }
        }
    }

    // ---------- New list ----------
    if root.new-list-open: Rectangle {
        background: #00000088;
        TouchArea { clicked => { root.new-list-open = false; } }
        Rectangle {
            width: 380px;
            height: list-col.preferred-height + 44px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.panel;
            border-radius: 12px;
            TouchArea { }
            list-col := VerticalLayout {
                padding: 22px;
                spacing: 14px;
                width: parent.width;
                Text {
                    text: @tr("New list");
                    color: Theme.text;
                    font-size: 17px;
                    font-weight: 700;
                }
                Text {
                    text: @tr("Lists organize your chats. This chat is added to the new list.");
                    color: Theme.text-dim;
                    font-size: 13px;
                    wrap: word-wrap;
                    width: parent.width - 44px;
                }
                new-list-name := LineEdit {
                    placeholder-text: @tr("List name");
                    accepted => {
                        root.menu-new-list(self.text);
                        self.text = "";
                        root.new-list-open = false;
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    DialogButton {
                        label: @tr("Cancel");
                        clicked => { root.new-list-open = false; }
                    }
                    DialogButton {
                        label: @tr("Create");
                        primary: true;
                        clicked => {
                            root.menu-new-list(new-list-name.text);
                            new-list-name.text = "";
                            root.new-list-open = false;
                        }
                    }
                }
            }
        }
    }

    // ---------- Add member ----------
    if root.member-pick-open: Rectangle {
        background: #000000aa;
        TouchArea { clicked => { root.member-pick-open = false; } }
        Rectangle {
            width: 420px;
            height: 560px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.panel;
            border-radius: 12px;
            TouchArea { }
            VerticalBox {
                padding: 18px;
                spacing: 10px;
                HorizontalLayout {
                    Text {
                        text: @tr("Add member");
                        color: Theme.text;
                        font-size: 17px;
                        font-weight: 700;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    IconButton {
                        icon: @image-url("../icons/x.svg");
                        clicked => { root.member-pick-open = false; }
                    }
                }
                LineEdit {
                    placeholder-text: @tr("Search name or number");
                    edited => { root.member-search(self.text); }
                }
                ListView {
                    for m in root.member-rows: MemberRow {
                        item: m;
                        pickable: true;
                        clicked => { root.member-toggle(m.jid); }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Text {
                        text: @tr("{} selected", root.member-count);
                        color: Theme.text-dim;
                        font-size: 13px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    DialogButton {
                        label: @tr("Add");
                        primary: true;
                        enabled: root.member-count > 0;
                        clicked => { root.member-confirm(); }
                    }
                }
            }
        }
    }

    // ---------- Status viewer ----------
    if root.sv-open: Rectangle {
        background: #000000f0;
        TouchArea { clicked => { root.status-next(); } }
        VerticalLayout {
            padding: 20px;
            spacing: 12px;
            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: root.sv-name;
                    color: white;
                    font-size: 16px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Text {
                    text: root.sv-time + "  ·  " + root.sv-index + "/" + root.sv-count;
                    color: #b0b8bd;
                    font-size: 13px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                IconButton {
                    icon: @image-url("../icons/x.svg");
                    clicked => { root.status-close(); }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                if root.sv-has-image: Image {
                    source: root.sv-image;
                    width: parent.width * 0.9;
                    height: parent.height * 0.94;
                    x: parent.width * 0.05;
                    y: parent.height * 0.03;
                    image-fit: contain;
                }
                if root.sv-is-video: Rectangle {
                    width: 72px;
                    height: 72px;
                    border-radius: 36px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    background: root.sv-video-ready ? #000000a0 : #00000050;
                    TouchArea {
                        mouse-cursor: pointer;
                        enabled: root.sv-video-ready;
                        clicked => { root.status-play(); }
                    }
                    Image {
                        source: @image-url("../icons/player-play.svg");
                        colorize: white;
                        width: 34px;
                        height: 34px;
                        x: 21px;
                        y: 19px;
                    }
                }
                if !root.sv-has-image: Rectangle {
                    width: parent.width * 0.7;
                    height: parent.height * 0.7;
                    x: parent.width * 0.15;
                    y: parent.height * 0.15;
                    background: Theme.accent;
                    border-radius: 14px;
                    Text {
                        text: root.sv-text;
                        color: white;
                        font-size: 24px;
                        wrap: word-wrap;
                        width: parent.width - 60px;
                        x: 30px;
                        height: parent.height;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                IconButton {
                    icon: @image-url("../icons/chevron-left.svg");
                    x: 4px;
                    y: (parent.height - self.height) / 2;
                    clicked => { root.status-prev(); }
                }
                IconButton {
                    icon: @image-url("../icons/chevron-right.svg");
                    x: parent.width - self.width - 4px;
                    y: (parent.height - self.height) / 2;
                    clicked => { root.status-next(); }
                }
            }
            if root.sv-has-image && root.sv-text != "": Text {
                text: root.sv-text;
                color: white;
                font-size: 14px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }

    // ---------- Forward picker ----------
    if root.alert-open: Rectangle {
        background: #000000aa;
        TouchArea { }
        Rectangle {
            width: 380px;
            height: alert-col.preferred-height + 44px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.panel;
            border-radius: 12px;
            alert-col := VerticalLayout {
                padding: 22px;
                spacing: 12px;
                width: parent.width;
                Text {
                    text: root.alert-title;
                    color: Theme.text;
                    font-size: 17px;
                    font-weight: 700;
                    wrap: word-wrap;
                    width: parent.width - 44px;
                }
                Text {
                    text: root.alert-text;
                    color: Theme.text-dim;
                    font-size: 14px;
                    wrap: word-wrap;
                    width: parent.width - 44px;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;
                    Rectangle {
                        width: dismiss-text.preferred-width + 28px;
                        height: 36px;
                        border-radius: 18px;
                        background: dismiss-touch.has-hover ? Theme.hover : transparent;
                        dismiss-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.alert-dismiss(); }
                        }
                        dismiss-text := Text {
                            text: @tr("Close");
                            color: Theme.text-dim;
                            font-size: 14px;
                            width: parent.width;
                            height: parent.height;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        width: retry-text.preferred-width + 32px;
                        height: 36px;
                        border-radius: 18px;
                        background: retry-touch.has-hover ? Theme.accent.darker(0.15) : Theme.accent;
                        retry-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.alert-retry(); }
                        }
                        retry-text := Text {
                            text: root.alert-action;
                            color: white;
                            font-size: 14px;
                            font-weight: 700;
                            width: parent.width;
                            height: parent.height;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    if root.reactions-open: Rectangle {
        background: #00000066;
        TouchArea { clicked => { root.reactions-open = false; } }
        Rectangle {
            width: 380px;
            height: min(440px, 108px + root.reaction-rows.length * 56px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.panel;
            border-radius: 12px;
            TouchArea { }
            VerticalBox {
                padding: 18px;
                spacing: 8px;
                HorizontalLayout {
                    Text {
                        text: root.reactions-title;
                        color: Theme.text;
                        font-size: 16px;
                        font-weight: 700;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    IconButton {
                        icon: @image-url("../icons/x.svg");
                        clicked => { root.reactions-open = false; }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                ListView {
                    for r in root.reaction-rows: Rectangle {
                        height: 56px;
                        background: react-row.has-hover ? Theme.hover : transparent;
                        react-row := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.reactions-open = false;
                                root.open-dm(r.jid);
                            }
                        }
                        HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 4px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                Avatar {
                                    width: 40px;
                                    height: 40px;
                                    src: r.avatar;
                                    has-image: r.hasAvatar;
                                    initial: r.initial;
                                    color-idx: r.colorIdx;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: r.name;
                                    color: Theme.text;
                                    font-size: 15px;
                                    overflow: elide;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                EmojiText {
                                    text: r.emoji;
                                    font-size: 20px;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.forward-open: Rectangle {
        background: #000000aa;
        TouchArea { clicked => { root.forward-open = false; } }
        Rectangle {
            width: 420px;
            height: 540px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.panel;
            border-radius: 12px;
            TouchArea { }
            VerticalBox {
                padding: 18px;
                spacing: 10px;
                HorizontalLayout {
                    Text {
                        text: @tr("Forward message to");
                        color: Theme.text;
                        font-size: 17px;
                        font-weight: 700;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    IconButton {
                        icon: @image-url("../icons/x.svg");
                        clicked => { root.forward-open = false; }
                    }
                }
                Rectangle {
                    height: 38px;
                    border-radius: 19px;
                    background: Theme.pill;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../icons/search.svg");
                                colorize: Theme.text-dim;
                                width: 16px;
                                height: 16px;
                            }
                        }
                        fwd-search := TextInput {
                            color: Theme.text;
                            font-size: 14px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            single-line: true;
                            edited => { root.forward-search(self.text); }
                        }
                    }
                    if fwd-search.text == "": Text {
                        text: @tr("Search name or number");
                        color: Theme.text-dim;
                        font-size: 14px;
                        x: 40px;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                }
                ListView {
                    for chat[i] in root.forward-rows: Rectangle {
                        height: 56px;
                        background: fwd-touch.has-hover ? Theme.hover : transparent;
                        border-radius: 8px;
                        fwd-touch := TouchArea {
                            clicked => { root.forward-to(chat.jid); }
                        }
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                Avatar {
                                    width: 40px;
                                    height: 40px;
                                    src: chat.avatar;
                                    has-image: chat.hasAvatar;
                                    initial: chat.initial;
                                    color-idx: chat.colorIdx;
                                }
                            }
                            Text {
                                text: chat.name;
                                color: Theme.text;
                                font-size: 14px;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }
                Rectangle {
                    height: 56px;
                    border-radius: 8px;
                    background: Theme.pill;
                    HorizontalLayout {
                        padding: 8px;
                        spacing: 10px;
                        if root.forward-preview-has-image: Image {
                            source: root.forward-preview-image;
                            width: 40px;
                            height: 40px;
                            image-fit: cover;
                            y: (parent.height - self.height) / 2;
                        }
                        Text {
                            text: root.forward-preview-text;
                            color: Theme.text-dim;
                            font-size: 13px;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
        }
    }

    // ---------- Settings overlay ----------
    if root.settings-open: Rectangle {
        background: #000000aa;
        TouchArea { clicked => { root.settings-open = false; } }
        Rectangle {
            width: min(500px, parent.width - 32px);
            // Never taller than the window: the body scrolls instead, so
            // the sections can keep growing.
            height: min(780px, parent.height - 48px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.panel;
            border-radius: 14px;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000066;
            clip: true;
            TouchArea { }
            VerticalLayout {
                padding: 0;
                spacing: 0;
                Rectangle {
                    height: 64px;
                    HorizontalLayout {
                        padding-left: 24px;
                        padding-right: 14px;
                        Text {
                            text: @tr("Settings");
                            color: Theme.text;
                            font-size: 20px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        IconButton {
                            icon: @image-url("../icons/x.svg");
                            y: (parent.height - self.height) / 2;
                            clicked => { root.settings-open = false; }
                        }
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.border;
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 24px;
                        padding-top: 18px;
                        spacing: 20px;
                        SettingsCard {
                            title: @tr("Appearance");
                            SettingsRow {
                                label: @tr("Theme");
                                HorizontalLayout {
                                    spacing: 6px;
                                    height: 30px;
                                    y: (parent.height - self.height) / 2;
                                    FilterChip {
                                        label: @tr("Dark");
                                        active: root.theme-mode == "dark";
                                        clicked => { root.theme-mode = "dark"; root.theme-changed("dark"); }
                                    }
                                    FilterChip {
                                        label: @tr("Light");
                                        active: root.theme-mode == "light";
                                        clicked => { root.theme-mode = "light"; root.theme-changed("light"); }
                                    }
                                    FilterChip {
                                        label: @tr("System");
                                        active: root.theme-mode == "system";
                                        clicked => { root.theme-mode = "system"; root.theme-changed("system"); }
                                    }
                                }
                            }
                            SettingsRow {
                                label: @tr("Style");
                                HorizontalLayout {
                                    spacing: 6px;
                                    height: 30px;
                                    y: (parent.height - self.height) / 2;
                                    FilterChip {
                                        label: @tr("Glass");
                                        active: root.theme-style == "glass";
                                        clicked => { root.theme-style = "glass"; root.style-changed("glass"); }
                                    }
                                    FilterChip {
                                        label: @tr("Opaque");
                                        active: root.theme-style == "opaque";
                                        clicked => { root.theme-style = "opaque"; root.style-changed("opaque"); }
                                    }
                                }
                            }
                            SettingsRow {
                                label: @tr("Language");
                                HorizontalLayout {
                                    spacing: 6px;
                                    height: 30px;
                                    y: (parent.height - self.height) / 2;
                                    FilterChip {
                                        label: "Português";
                                        active: root.language-mode == "pt";
                                        clicked => { root.language-mode = "pt"; root.language-changed("pt"); }
                                    }
                                    FilterChip {
                                        label: "English";
                                        active: root.language-mode == "en";
                                        clicked => { root.language-mode = "en"; root.language-changed("en"); }
                                    }
                                    FilterChip {
                                        label: @tr("System");
                                        active: root.language-mode == "system";
                                        clicked => { root.language-mode = "system"; root.language-changed("system"); }
                                    }
                                }
                            }
                        }
                        SettingsCard {
                            title: @tr("General");
                            SettingsRow {
                                label: @tr("Open Zapive when I sign in");
                                Toggle {
                                    on: root.autostart;
                                    y: (parent.height - self.height) / 2;
                                    clicked => { root.autostart-changed(!root.autostart); }
                                }
                            }
                        }
                        SettingsCard {
                            title: @tr("Calls");
                            hint: @tr("A device picked here is used for every call. Changes apply to the next call.");
                            SettingsRow {
                                label: @tr("Microphone");
                                ComboBox {
                                    width: 200px;
                                    height: 34px;
                                    y: (parent.height - self.height) / 2;
                                    model: root.mic-devices;
                                    current-value: root.mic-device;
                                    selected(value) => {
                                        root.mic-device = value;
                                        root.device-changed("mic", value);
                                    }
                                }
                            }
                            SettingsRow {
                                label: @tr("Speaker");
                                ComboBox {
                                    width: 200px;
                                    height: 34px;
                                    y: (parent.height - self.height) / 2;
                                    model: root.speaker-devices;
                                    current-value: root.speaker-device;
                                    selected(value) => {
                                        root.speaker-device = value;
                                        root.device-changed("speaker", value);
                                    }
                                }
                            }
                            SettingsRow {
                                label: @tr("Camera");
                                ComboBox {
                                    width: 200px;
                                    height: 34px;
                                    y: (parent.height - self.height) / 2;
                                    model: root.camera-devices;
                                    current-value: root.camera-device;
                                    selected(value) => {
                                        root.camera-device = value;
                                        root.device-changed("camera", value);
                                    }
                                }
                            }
                        }
                        SettingsCard {
                            title: @tr("Privacy");
                            hint: @tr("Both are off by default: nobody is told when you read a message, and a message someone deletes stays visible here, marked as deleted.");
                            SettingsRow {
                                label: @tr("Send read receipts");
                                Toggle {
                                    on: root.send-receipts;
                                    y: (parent.height - self.height) / 2;
                                    clicked => { root.send-receipts-changed(!root.send-receipts); }
                                }
                            }
                            SettingsRow {
                                label: @tr("Apply messages deleted by the sender");
                                Toggle {
                                    on: root.apply-deletions;
                                    y: (parent.height - self.height) / 2;
                                    clicked => { root.apply-deletions-changed(!root.apply-deletions); }
                                }
                            }
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                Text {
                                    text: @tr("settings.privacyBlurHint");
                                    color: Theme.text-dim;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                            }
                            SettingsRow {
                                label: @tr("settings.blurNames");
                                Toggle {
                                    label: @tr("settings.blurNames");
                                    on: root.blur-names;
                                    y: (parent.height - self.height) / 2;
                                    clicked => { root.privacy-blur-changed("names", !root.blur-names); }
                                }
                            }
                            SettingsRow {
                                label: @tr("settings.blurPhotos");
                                Toggle {
                                    label: @tr("settings.blurPhotos");
                                    on: root.blur-photos;
                                    y: (parent.height - self.height) / 2;
                                    clicked => { root.privacy-blur-changed("photos", !root.blur-photos); }
                                }
                            }
                            SettingsRow {
                                label: @tr("settings.blurMessages");
                                Toggle {
                                    label: @tr("settings.blurMessages");
                                    on: root.blur-messages;
                                    y: (parent.height - self.height) / 2;
                                    clicked => { root.privacy-blur-changed("messages", !root.blur-messages); }
                                }
                            }
                            SettingsRow {
                                label: @tr("settings.blurMedia");
                                Toggle {
                                    label: @tr("settings.blurMedia");
                                    on: root.blur-media;
                                    y: (parent.height - self.height) / 2;
                                    clicked => { root.privacy-blur-changed("media", !root.blur-media); }
                                }
                            }
                            SettingsRow {
                                label: @tr("Show notifications");
                                detail: @tr("When turned off, no banners appear for messages or calls. Unread counts still update.");
                                Toggle {
                                    accessible-role: button;
                                    accessible-label: @tr("Show notifications");
                                    on: root.notifications;
                                    y: (parent.height - self.height) / 2;
                                    clicked => { root.notifications-changed(!root.notifications); }
                                }
                            }
                            SettingsRow {
                                label: @tr("settings.notifyPreviews");
                                detail: @tr("settings.notifyPreviewsHint");
                                Toggle {
                                    accessible-role: button;
                                    accessible-label: @tr("settings.notifyPreviews");
                                    on: root.notify-previews;
                                    y: (parent.height - self.height) / 2;
                                    clicked => { root.notify-previews-changed(!root.notify-previews); }
                                }
                            }
                        }
                        SettingsCard {
                            title: @tr("Security");
                            VerticalLayout {
                                padding: 14px;
                                padding-top: 10px;
                                spacing: 10px;
                                Text {
                                    text: root.pin-set
                                        ? @tr("PIN enabled: the vault key requires your PIN and is bound to your Windows account (DPAPI).")
                                        : @tr("Local data is always encrypted (key protected by your Windows account). Set a PIN to require unlocking on launch.");
                                    color: Theme.text-dim;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                                current-pin := LineEdit {
                                    visible: root.pin-set;
                                    input-type: password;
                                    placeholder-text: @tr("Current PIN");
                                }
                                new-pin := LineEdit {
                                    input-type: password;
                                    placeholder-text: @tr("New PIN (4 to 10 digits)");
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    Button {
                                        text: root.pin-set ? @tr("Change PIN") : @tr("Set PIN");
                                        primary: true;
                                        clicked => {
                                            root.save-pin(current-pin.text, new-pin.text);
                                            new-pin.text = "";
                                        }
                                    }
                                    Button {
                                        visible: root.pin-set;
                                        text: @tr("Remove PIN");
                                        clicked => {
                                            root.remove-pin(current-pin.text);
                                            current-pin.text = "";
                                        }
                                    }
                                }
                            }
                        }
                        SettingsCard {
                            title: @tr("Automatic downloads");
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                padding-top: 8px;
                                padding-bottom: 4px;
                                Text { text: @tr("Voice messages are always downloaded automatically."); color: Theme.text-dim; font-size: 12px; wrap: word-wrap; }
                            }
                            SettingsRow {
                                label: @tr("Photos");
                                Toggle {
                                    on: root.auto-download-photos;
                                    clicked => { root.auto-download-photos-changed(!root.auto-download-photos); }
                                }
                            }
                            SettingsRow {
                                label: @tr("Audio");
                                Toggle {
                                    on: root.auto-download-audio;
                                    clicked => { root.auto-download-audio-changed(!root.auto-download-audio); }
                                }
                            }
                            SettingsRow {
                                label: @tr("Videos");
                                Toggle {
                                    on: root.auto-download-video;
                                    clicked => { root.auto-download-video-changed(!root.auto-download-video); }
                                }
                            }
                            SettingsRow {
                                label: @tr("Documents");
                                Toggle {
                                    on: root.auto-download-documents;
                                    clicked => { root.auto-download-documents-changed(!root.auto-download-documents); }
                                }
                            }
                            SettingsRow {
                                label: @tr("Stickers");
                                Toggle {
                                    on: root.auto-download-stickers;
                                    clicked => { root.auto-download-stickers-changed(!root.auto-download-stickers); }
                                }
                            }
                        }
                        SettingsCard {
                            title: @tr("About");
                            SettingsRow {
                                label: "Zapive";
                                detail: root.update-state == 1 ? @tr("Version {} is available", root.update-version)
                                    : root.update-state == 2 ? @tr("Downloading update…")
                                    : root.update-state == 3 ? @tr("Restart to use version {}", root.update-version)
                                    : root.update-state == 4 ? @tr("Update failed: {}", root.update-error)
                                    : @tr("Version {}", root.app-version);
                                DialogButton {
                                    y: (parent.height - self.height) / 2;
                                    primary: root.update-state != 0;
                                    enabled: root.update-state != 2;
                                    label: root.update-state == 1 ? @tr("Update")
                                        : root.update-state == 2 ? @tr("Downloading update…")
                                        : root.update-state == 3 ? @tr("Restart")
                                        : root.update-state == 4 ? @tr("Try again")
                                        : @tr("Check for updates");
                                    clicked => {
                                        if (root.update-state == 1 || root.update-state == 4) { root.update-apply(); }
                                        else if (root.update-state == 3) { root.update-restart(); }
                                        else if (root.update-state == 0) { root.update-check(); }
                                    }
                                }
                            }
                        }
                        SettingsCard {
                            title: @tr("Account");
                            SettingsRow {
                                label: @tr("Log out of WhatsApp");
                                DialogButton {
                                    y: (parent.height - self.height) / 2;
                                    primary: true;
                                    danger: true;
                                    label: @tr("Log out");
                                    clicked => { root.logout(); }
                                }
                            }
                        }
                    }
                }
                // Feedback from the host (PIN saved, restart to apply a
                // language, update check result), pinned under the body.
                if root.settings-status != "": Rectangle {
                    height: status-text.preferred-height + 20px;
                    background: #ffbc38.with-alpha(0.12);
                    status-text := Text {
                        x: 24px;
                        y: 10px;
                        width: parent.width - 48px;
                        text: root.settings-status;
                        color: #ffbc38;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }

    // Kept in the tree (hidden) so the Flickable's geometry is always
    // readable by the host; the pages are laid out by the host.
    Rectangle {
        visible: root.pdf-open;
        background: Theme.dark ? #0b141a : #e9edef;
        TouchArea { }
        VerticalLayout {
            padding: 0;
            spacing: 0;
            Rectangle {
                height: 56px;
                background: Theme.header;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;
                    IconButton {
                        icon: @image-url("../icons/x.svg");
                        clicked => { root.pdf-close(); }
                    }
                    Text {
                        text: root.pdf-title;
                        color: Theme.text;
                        font-size: 15px;
                        font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    if root.pdf-count > 0: HorizontalLayout {
                        spacing: 2px;
                        IconButton {
                            icon: @image-url("../icons/chevron-up.svg");
                            icon-size: 18px;
                            clicked => { root.pdf-goto(-1); }
                        }
                        Text {
                            text: root.pdf-page + " / " + root.pdf-count;
                            color: Theme.text;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        IconButton {
                            icon: @image-url("../icons/chevron-down.svg");
                            icon-size: 18px;
                            clicked => { root.pdf-goto(1); }
                        }
                    }
                    Rectangle { width: 12px; }
                    if root.pdf-count > 0: HorizontalLayout {
                        spacing: 2px;
                        IconButton {
                            icon: @image-url("../icons/circle-minus.svg");
                            icon-size: 18px;
                            clicked => { root.pdf-zoom(-1); }
                        }
                        zoom-touch := TouchArea {
                            width: zoom-text.preferred-width + 16px;
                            mouse-cursor: pointer;
                            clicked => { root.pdf-zoom(0); }
                            zoom-text := Text {
                                text: root.pdf-zoom-label;
                                color: Theme.text;
                                font-size: 13px;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                                width: parent.width;
                                height: parent.height;
                            }
                        }
                        IconButton {
                            icon: @image-url("../icons/plus.svg");
                            icon-size: 18px;
                            clicked => { root.pdf-zoom(1); }
                        }
                    }
                    Rectangle { width: 12px; }
                    IconButton {
                        icon: @image-url("../icons/download.svg");
                        clicked => { root.pdf-save-as(); }
                    }
                    IconButton {
                        icon: @image-url("../icons/corner-up-right.svg");
                        clicked => { root.pdf-open-external(); }
                    }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                pdf-flick := Flickable {
                    width: parent.width;
                    height: parent.height;
                    content-height: max(self.height, root.pdf-total-h * 1px);
                    content-width: max(self.width, root.pdf-total-w * 1px);
                    changed viewport-y => { root.pdf-scrolled(-self.viewport-y / 1px); }
                    changed width => { if (root.pdf-open) { root.pdf-view-resized(); } }
                    for p in root.pdf-pages: Rectangle {
                        x: (pdf-flick.viewport-width - p.w * 1px) / 2;
                        y: p.y * 1px;
                        width: p.w * 1px;
                        height: p.h * 1px;
                        background: white;
                        drop-shadow-blur: 6px;
                        drop-shadow-color: #00000055;
                        if p.ready: Image {
                            source: p.pic;
                            width: parent.width;
                            height: parent.height;
                            image-fit: fill;
                        }
                    }
                }
                if root.pdf-status != "": Rectangle {
                    width: min(parent.width - 48px, 420px);
                    height: status-col.preferred-height + 40px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    background: Theme.panel;
                    border-radius: 12px;
                    drop-shadow-blur: 10px;
                    drop-shadow-color: #00000055;
                    status-col := VerticalLayout {
                        padding: 20px;
                        spacing: 14px;
                        width: parent.width;
                        Text {
                            text: root.pdf-status;
                            color: Theme.text;
                            font-size: 14px;
                            wrap: word-wrap;
                            width: parent.width - 40px;
                            horizontal-alignment: center;
                        }
                        if root.pdf-engine-missing: HorizontalLayout {
                            alignment: center;
                            spacing: 8px;
                            DialogButton {
                                label: @tr("Open with another app");
                                clicked => { root.pdf-open-external(); }
                            }
                            DialogButton {
                                label: root.pdf-installing ? @tr("Downloading…") : @tr("Download viewer");
                                primary: true;
                                enabled: !root.pdf-installing;
                                clicked => { root.pdf-install-engine(); }
                            }
                        }
                    }
                }
            }
        }
    }

    // ---------- Video player ----------
    if root.video-open: Rectangle {
        background: #000000f2;
        // The bar, the close button and the pointer fade out while a clip
        // plays untouched, and any movement brings them back.
        property <bool> chrome: true;
        property <bool> show-chrome: !root.video-is-clip || !root.video-playing
            || self.chrome || bar-hover.has-hover || top-hover.has-hover || seek-area.pressed
            || vol-area.pressed;
        idle := Timer {
            interval: 2.6s;
            running: root.video-is-clip && root.video-playing;
            triggered => { parent.chrome = false; }
        }
        stage := TouchArea {
            mouse-cursor: parent.show-chrome ? MouseCursor.default : MouseCursor.none;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.move) {
                    parent.chrome = true;
                    idle.running = false;
                    idle.running = root.video-is-clip && root.video-playing;
                }
            }
            clicked => {
                if (root.video-is-clip) { root.video-toggle(); }
                else { root.close-video(); }
            }
        }
        keys := FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == Key.Escape) { root.close-video(); return accept; }
                if (!root.video-is-clip) { return reject; }
                if (event.text == " " || event.text == "k") { root.video-toggle(); return accept; }
                if (event.text == Key.LeftArrow) { root.video-seek-by(-5); return accept; }
                if (event.text == Key.RightArrow) { root.video-seek-by(5); return accept; }
                if (event.text == Key.UpArrow) { root.video-set-volume(min(1, root.video-volume + 0.1)); return accept; }
                if (event.text == Key.DownArrow) { root.video-set-volume(max(0, root.video-volume - 0.1)); return accept; }
                if (event.text == "m") { root.video-mute-toggle(); return accept; }
                reject
            }
        }
        // Fit inside the window both ways (a tall clip used to run off
        // the bottom), and never blow a small one up past 3x.
        property <float> ratio: root.video-w / max(root.video-h, 1);
        property <length> fit-w: min(self.width - 32px, (self.height - 32px) * self.ratio,
            root.video-w * 3px);
        Image {
            source: root.video-frame;
            width: parent.fit-w;
            height: self.width / max(parent.ratio, 0.01);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            image-fit: contain;
        }
        if root.video-is-clip && root.video-loading: Rectangle {
            width: loading-text.preferred-width + 28px;
            height: 34px;
            border-radius: 17px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #000000b0;
            loading-text := Text {
                text: @tr("Loading…");
                color: white;
                font-size: 13px;
                width: parent.width;
                height: parent.height;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        if root.video-is-clip && !root.video-playing && !root.video-loading: Rectangle {
            width: 76px;
            height: 76px;
            border-radius: 38px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #000000a8;
            Image {
                source: root.video-ended
                    ? @image-url("../icons/rotate-clockwise.svg")
                    : @image-url("../icons/player-play.svg");
                colorize: white;
                width: 36px;
                height: 36px;
                x: (parent.width - self.width) / 2 + (root.video-ended ? 0 : 2px);
                y: (parent.height - self.height) / 2;
            }
        }

        // Top: save and close.
        top-hover := TouchArea {
            visible: parent.show-chrome;
            height: 64px;
            y: 0;
            clicked => { if (root.video-is-clip) { root.video-toggle(); } }
            Rectangle {
                background: @linear-gradient(180deg, #000000b0 0%, #00000000 100%);
            }
            HorizontalLayout {
                padding: 12px;
                spacing: 6px;
                alignment: end;
                if root.video-is-clip: IconButton {
                    icon: @image-url("../icons/download.svg");
                    tint: white;
                    clicked => { root.video-save(); }
                }
                IconButton {
                    icon: @image-url("../icons/x.svg");
                    tint: white;
                    clicked => { root.close-video(); }
                }
            }
        }

        // Bottom: transport.
        bar-hover := TouchArea {
            visible: root.video-is-clip && parent.show-chrome;
            height: 84px;
            y: parent.height - self.height;
            Rectangle {
                background: @linear-gradient(180deg, #00000000 0%, #000000d0 100%);
            }
            // Seek bar: a press jumps, a drag scrubs.
            seek-area := TouchArea {
                x: 20px;
                y: 18px;
                width: parent.width - 40px;
                height: 20px;
                mouse-cursor: pointer;
                property <float> at: 0;
                function pick() {
                    self.at = max(0, min(1, self.mouse-x / self.width));
                    root.video-seek(self.at);
                }
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { self.pick(); }
                }
                moved => { if (self.pressed) { self.pick(); } }
                property <float> shown: self.pressed ? self.at : root.video-progress;
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: seek-area.has-hover || seek-area.pressed ? 6px : 4px;
                    border-radius: self.height / 2;
                    background: #ffffff40;
                    Rectangle {
                        x: 0;
                        width: parent.width * seek-area.shown;
                        border-radius: parent.border-radius;
                        background: Theme.accent;
                    }
                }
                Rectangle {
                    visible: seek-area.has-hover || seek-area.pressed;
                    width: 14px;
                    height: 14px;
                    border-radius: 7px;
                    background: white;
                    x: parent.width * seek-area.shown - self.width / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
            HorizontalLayout {
                x: 12px;
                y: 40px;
                width: parent.width - 24px;
                height: 36px;
                spacing: 10px;
                IconButton {
                    icon: root.video-ended
                        ? @image-url("../icons/rotate-clockwise.svg")
                        : (root.video-playing
                            ? @image-url("../icons/player-pause.svg")
                            : @image-url("../icons/player-play.svg"));
                    tint: white;
                    clicked => { root.video-toggle(); }
                }
                Text {
                    text: root.video-pos-label + " / " + root.video-duration-label;
                    color: white;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                IconButton {
                    icon: root.video-muted || root.video-volume <= 0
                        ? @image-url("../icons/volume-off.svg")
                        : @image-url("../icons/volume.svg");
                    tint: white;
                    clicked => { root.video-mute-toggle(); }
                }
                vol-area := TouchArea {
                    width: 90px;
                    mouse-cursor: pointer;
                    function pick() {
                        root.video-set-volume(max(0, min(1, self.mouse-x / self.width)));
                    }
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { self.pick(); }
                    }
                    moved => { if (self.pressed) { self.pick(); } }
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 4px;
                        border-radius: 2px;
                        background: #ffffff40;
                        Rectangle {
                            x: 0;
                            width: parent.width * (root.video-muted ? 0 : root.video-volume);
                            border-radius: 2px;
                            background: white;
                        }
                    }
                    Rectangle {
                        width: 12px;
                        height: 12px;
                        border-radius: 6px;
                        background: white;
                        x: parent.width * (root.video-muted ? 0 : root.video-volume) - self.width / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
                Rectangle { width: 4px; }
            }
        }
    }

    // ---------- Lightbox ----------
    if root.lightbox-open: Rectangle {
        background: #000000e6;
        TouchArea { clicked => { root.lightbox-open = false; } }
        Image {
            source: root.lightbox-image;
            width: parent.width * 0.92;
            height: parent.height * 0.92;
            x: parent.width * 0.04;
            y: parent.height * 0.04;
            image-fit: contain;
        }
        IconButton {
            icon: @image-url("../icons/x.svg");
            x: parent.width - self.width - 16px;
            y: 16px;
            clicked => { root.lightbox-open = false; }
        }
    }
    }
}
