        dismiss => { root.sync-open = false; }

        sync-open <=> root.sync-open;
        sync-detail: root.sync-detail;
    }

    // ---------- Account switcher ----------
    account-layer := AccountLayer {
        open: root.account-menu-open && root.screen == "main";
        scrim: transparent;
        dismiss => { root.account-menu-open = false; }

        logout() => { root.logout(); }
        accounts: root.accounts;
        can-add-account: root.can-add-account;
        account-menu-open <=> root.account-menu-open;
        switch-account(a0) => { root.switch-account(a0); }
        add-account() => { root.add-account(); }
        remove-account(a0) => { root.remove-account(a0); }
    }

    // Swapping sessions takes a moment; nothing underneath belongs to
    // either account while it lasts.
    if root.account-switching: Rectangle {
        background: Theme.bg;
        TouchArea { }
        Text {
            text: @tr("account.switching.progress");
            color: Theme.text-dim;
            font-size: 15px;
            width: parent.width;
            height: parent.height;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    message-menu-layer := MessageMenuLayer {
        open: root.message-menu-open;
        scrim: transparent;
        dismiss => { root.message-menu-open = false; }

        theme-style: root.theme-style;
        copy-text(a0) => { root.copy-text(a0); }
        copy-image(a0) => { root.copy-image(a0); }
        request-reply(a0) => { root.request-reply(a0); }
        toggle-star(a0) => { root.toggle-star(a0); }
        message-action(a0, a1) => { root.message-action(a0, a1); }
        menu-message: root.menu-message;
        message-menu-open <=> root.message-menu-open;
        message-menu-x: root.message-menu-x;
        message-menu-y: root.message-menu-y;
        react-pick(a0) => { root.react-pick(a0); }
        request-forward(a0) => { root.request-forward(a0); }
        select-start(a0) => { root.select-start(a0); }
        can-translate(a0) => { return root.can-translate(a0); }
        win-width: root.width;
        win-height: root.height;
    }

    details-layer := DetailsLayer {
        open: root.details-open;
        scrim: Theme.scrim;
        dismiss => { root.details-open = false; }

        details-open <=> root.details-open;
        details-text: root.details-text;
        details-image: root.details-image;
        details-has-image: root.details-has-image;
        details-rows: root.details-rows;
        win-width: root.width;
    }

    message-dialog-layer := MessageDialogLayer {
        open: root.message-dialog-open;
        scrim: Theme.scrim;
        dismiss => { root.message-dialog-open = false; }

        submit-edit(a0, a1) => { root.submit-edit(a0, a1); }
        message-dialog-open <=> root.message-dialog-open;
        message-dialog-edit: root.message-dialog-edit;
        message-dialog-title: root.message-dialog-title;
        message-dialog-text <=> root.message-dialog-text;
        message-dialog-id: root.message-dialog-id;
        win-width: root.width;
    }

    // ---------- Confirm dialog ----------
    confirm-layer := ConfirmLayer {
        open: root.confirm-open;
        scrim: Theme.scrim;
        dismiss => { root.confirm-open = false; }

        confirm-open <=> root.confirm-open;
        confirm-title: root.confirm-title;
        confirm-text: root.confirm-text;
        confirm-action: root.confirm-action;
        confirm-secondary: root.confirm-secondary;
        confirm-accept() => { root.confirm-accept(); }
        confirm-other() => { root.confirm-other(); }
    }

    // ---------- Share group history ----------
    share-layer := ShareLayer {
        open: root.share-open;
        scrim: Theme.scrim;
        dismiss => { root.share-cancel(); }

        share-name: root.share-name;
        share-avatar: root.share-avatar;
        share-has-avatar: root.share-has-avatar;
        share-initial: root.share-initial;
        share-color-idx: root.share-color-idx;
        share-sending: root.share-sending;
        share-accept() => { root.share-accept(); }
        share-cancel() => { root.share-cancel(); }
    }

    // ---------- New list ----------
    new-list-layer := NewListLayer {
        open: root.new-list-open;
        scrim: Theme.scrim;
        dismiss => { root.new-list-open = false; }

        menu-new-list(a0) => { root.menu-new-list(a0); }
        new-list-open <=> root.new-list-open;
    }

    // ---------- Add member ----------
    member-pick-layer := MemberPickLayer {
        open: root.member-pick-open;
        scrim: Theme.scrim;
        dismiss => { root.member-pick-open = false; }

        member-pick-open <=> root.member-pick-open;
        member-rows: root.member-rows;
        member-count: root.member-count;
        member-search(a0) => { root.member-search(a0); }
        member-toggle(a0) => { root.member-toggle(a0); }
        member-confirm() => { root.member-confirm(); }
    }

    // ---------- Status viewer ----------
    sv-layer := SvLayer {
        open: root.sv-open;
        scrim: Theme.glass ? #000000c8 : #000000ee;
        dismissible: false;

        sv-name: root.sv-name;
        sv-time: root.sv-time;
        sv-text: root.sv-text;
        sv-has-image: root.sv-has-image;
        sv-image: root.sv-image;
        sv-index: root.sv-index;
        sv-count: root.sv-count;
        status-next() => { root.status-next(); }
        status-prev() => { root.status-prev(); }
        status-close() => { root.status-close(); }
        sv-is-video: root.sv-is-video;
        sv-video-ready: root.sv-video-ready;
        status-play() => { root.status-play(); }
    }

    // ---------- Blocking alert ----------
    alert-layer := AlertLayer {
        open: root.alert-open;
        scrim: Theme.scrim;
        dismissible: false;

        alert-title: root.alert-title;
        alert-text: root.alert-text;
        alert-action: root.alert-action;
        alert-retry() => { root.alert-retry(); }
        alert-dismiss() => { root.alert-dismiss(); }
    }

    reactions-layer := ReactionsLayer {
        open: root.reactions-open;
        scrim: Theme.scrim;
        dismiss => { root.reactions-open = false; }

        reaction-rows: root.reaction-rows;
        reaction-tabs: root.reaction-tabs;
        reactions-title: root.reactions-title;
        reactions-open <=> root.reactions-open;
        open-dm(a0) => { root.open-dm(a0); }
        remove-own-reaction() => { root.remove-own-reaction(root.reactions-msg-id); }
    }

    // ---------- Polls / starred / shortcuts ----------
    poll-composer-layer := PollComposerLayer {
        open: root.poll-composer-open && root.chat-open;
        scrim: Theme.scrim;
        dismiss => { root.poll-composer-open = false; }
        poll-composer-open <=> root.poll-composer-open;
        create-poll(a0, a1, a2) => { root.create-poll(a0, a1, a2); }
    }
    starred-layer := StarredLayer {
        open: root.starred-open && root.screen == "main";
        scrim: transparent;
        dismiss => { root.starred-open = false; }
        starred-open <=> root.starred-open;
        starred-items: root.starred-items;
        current-only: root.starred-current-only;
        open-starred-item(a0, a1) => { root.open-starred-item(a0, a1); }
    }
    shortcuts-layer := ShortcutsLayer {
        open: root.shortcuts-open;
        scrim: Theme.scrim;
        dismiss => { root.shortcuts-open = false; }
        shortcuts-open <=> root.shortcuts-open;
        is-macos: root.is-macos;
    }

    // ---------- Forward picker ----------
    forward-layer := ForwardLayer {
        open: root.forward-open;
        scrim: Theme.scrim;
        dismiss => { root.forward-open = false; }

        forward-open <=> root.forward-open;
        forward-rows: root.forward-rows;
        forward-preview-text: root.forward-preview-text;
        forward-preview-image: root.forward-preview-image;
        forward-preview-has-image: root.forward-preview-has-image;
        forward-search(a0) => { root.forward-search(a0); }
        forward-to(a0) => { root.forward-to(a0); }
    }

    // ---------- Settings ----------
    settings-layer := SettingsLayer {
        open: root.settings-open;
        scrim: transparent;
        dismissible: false;
        x: 61px;
        width: parent.width - self.x;
        height: parent.height;

        theme-style <=> root.theme-style;
        notifications: root.notifications;
        notify-previews: root.notify-previews;
        call-silence-repeat: root.call-silence-repeat;
        call-silence-minutes: root.call-silence-minutes;
        message-sound: root.message-sound;
        blur-names: root.blur-names;
        blur-photos: root.blur-photos;
        blur-messages: root.blur-messages;
        blur-media: root.blur-media;
        style-changed(a0) => { root.style-changed(a0); }
        notifications-changed(a0) => { root.notifications-changed(a0); }
        message-sound-changed(a0) => { root.message-sound-changed(a0); }
        show-shortcuts() => { root.shortcuts-open = true; }
        wallpaper-colors-changed(bg, fg) => {
            root.wallpaper-bg = bg;
            root.wallpaper-fg = fg;
            root.wallpaper-custom = true;
            root.wallpaper-colors-changed(bg, fg);
        }
        wallpaper-reset() => { root.wallpaper-custom = false; root.wallpaper-reset(); }
        wallpaper-hex-entered(fg, hex) => { root.wallpaper-hex-entered(fg, hex); }
        notify-previews-changed(a0) => { root.notify-previews-changed(a0); }
        call-silence-repeat-changed(a0) => { root.call-silence-repeat = a0; root.call-silence-repeat-changed(a0); }
        call-silence-minutes-changed(a0) => { root.call-silence-minutes = a0; root.call-silence-minutes-changed(a0); }
        privacy-blur-changed(a0, a1) => { root.privacy-blur-changed(a0, a1); }
        theme-mode <=> root.theme-mode;
        language-mode <=> root.language-mode;
        theme-changed(a0) => { root.theme-changed(a0); }
        language-changed(a0) => { root.language-changed(a0); }
        mic-devices: root.mic-devices;
        speaker-devices: root.speaker-devices;
        camera-devices: root.camera-devices;
        mic-device <=> root.mic-device;
        speaker-device <=> root.speaker-device;
        camera-device <=> root.camera-device;
        device-changed(a0, a1) => { root.device-changed(a0, a1); }
        update-state: root.update-state;
        update-version: root.update-version;
        update-error: root.update-error;
        app-version: root.app-version;
        releases: root.releases;
        changelog-loading: root.changelog-loading;
        changelog-loaded: root.changelog-loaded;
        changelog-more: root.changelog-more;
        changelog-error: root.changelog-error;
        changelog-has-new: root.changelog-has-new;
        changelog-verified: root.changelog-verified;
        show-whats-new() => { root.show-whats-new(); }
        changelog-load(a0) => { root.changelog-load(a0); }
        update-check() => { root.update-check(); }
        update-apply() => { root.update-apply(); }
        update-restart() => { root.update-restart(); }
        settings-open <=> root.settings-open;
        settings-section <=> root.settings-section;
        settings-query <=> root.settings-query;
        settings-categories: root.settings-categories;
        settings-matches(a0) => { return root.settings-matches(a0); }
        pin-set: root.pin-set;
        autostart: root.autostart;
        mcp-enabled: root.mcp-enabled;
        mcp-url: root.mcp-url;
        mcp-token: root.mcp-token;
        mcp-status: root.mcp-status;
        settings-status: root.settings-status;
        translation-status: root.translation-status;
        translation-detail: root.translation-detail;
        translation-busy: root.translation-busy;
        translation-running: root.translation-running;
        translation-target: root.translation-target;
        translation-source: root.translation-source;
        translation-installed: root.translation-installed;
        translation-pairs: root.translation-pairs;
        translation-installing: root.translation-installing;
        translation-progress: root.translation-progress;
        translation-progress-text: root.translation-progress-text;
        translation-pair-state: root.translation-pair-state;
        translation-pair-detail: root.translation-pair-detail;
        translation-action(a0) => { root.translation-action(a0); }
        translation-install(a0) => { root.translation-install(a0); }
        translation-remove(a0, a1) => { root.translation-remove(a0, a1); }
        translation-model-selected(a0) => { root.translation-model-selected(a0); }
        translation-model-source <=> root.translation-model-source;
        translation-language(a0, a1) => { root.translation-language(a0, a1); }
        autostart-changed(a0) => { root.autostart-changed(a0); }
        mcp-changed(a0) => { root.mcp-changed(a0); }
        mcp-copy-config() => { root.mcp-copy-config(); }
        mcp-regenerate-token() => { root.mcp-regenerate-token(); }
        save-pin(a0, a1) => { root.save-pin(a0, a1); }
        remove-pin(a0) => { root.remove-pin(a0); }
        logout() => { root.logout(); }
        accounts: root.accounts;
        can-add-account: root.can-add-account;
        switch-account(a0) => { root.switch-account(a0); }
        add-account() => { root.add-account(); }
        remove-account(a0) => { root.remove-account(a0); }
        send-receipts: root.send-receipts;
        apply-deletions: root.apply-deletions;
        send-receipts-changed(a0) => { root.send-receipts-changed(a0); }
        apply-deletions-changed(a0) => { root.apply-deletions-changed(a0); }
        auto-download-photos: root.auto-download-photos;
        auto-download-photos-changed(a0) => { root.auto-download-photos-changed(a0); }
        auto-download-audio: root.auto-download-audio;
        auto-download-audio-changed(a0) => { root.auto-download-audio-changed(a0); }
        auto-download-video: root.auto-download-video;
        auto-download-video-changed(a0) => { root.auto-download-video-changed(a0); }
        auto-download-documents: root.auto-download-documents;
        auto-download-documents-changed(a0) => { root.auto-download-documents-changed(a0); }
        auto-download-stickers: root.auto-download-stickers;
        auto-download-stickers-changed(a0) => { root.auto-download-stickers-changed(a0); }
        win-width: root.width;
    }

    // ---------- PDF viewer ----------
    // Kept in the tree (hidden) so the Flickable's geometry is always
    // readable by the host; the pages are laid out by the host.
    Rectangle {
        visible: root.pdf-open;
        background: Theme.viewer;
        TouchArea { }
        VerticalLayout {
            padding: 0;
            spacing: 0;
            Rectangle {
                height: 56px;
                background: Theme.header;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;
                    IconButton {
                        label: @tr("common.action.close");
                        icon: @image-url("../icons/x.svg");
                        clicked => { root.pdf-close(); }
                    }
                    Text {
                        text: root.pdf-title;
                        color: Theme.text;
                        font-size: 15px;
                        font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    if root.pdf-count > 0: HorizontalLayout {
                        spacing: 2px;
                        IconButton {
                            label: @tr("accessibility.previous_page");
                            icon: @image-url("../icons/chevron-up.svg");
                            icon-size: 18px;
                            clicked => { root.pdf-goto(-1); }
                        }
                        Text {
                            text: root.pdf-page + " / " + root.pdf-count;
                            color: Theme.text;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        IconButton {
                            label: @tr("accessibility.next_page");
                            icon: @image-url("../icons/chevron-down.svg");
                            icon-size: 18px;
                            clicked => { root.pdf-goto(1); }
                        }
                    }
                    Rectangle { width: 12px; }
                    if root.pdf-count > 0: HorizontalLayout {
                        spacing: 2px;
                        IconButton {
                            label: @tr("accessibility.zoom_out");
                            icon: @image-url("../icons/circle-minus.svg");
                            icon-size: 18px;
                            clicked => { root.pdf-zoom(-1); }
                        }
                        zoom-touch := TouchArea {
                            accessible-role: button;
                            accessible-label: @tr("accessibility.reset_zoom", root.pdf-zoom-label);
                            accessible-action-default => { root.pdf-zoom(0); }
                            width: zoom-text.preferred-width + 16px;
                            mouse-cursor: pointer;
                            clicked => { root.pdf-zoom(0); }
                            zoom-text := Text {
                                text: root.pdf-zoom-label;
                                color: Theme.text;
                                font-size: 13px;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                                width: parent.width;
                                height: parent.height;
                            }
                            zoom-key := KeyFocus {
                                activate => { root.pdf-zoom(0); }
                            }
                            FocusRing {
                                shown: zoom-key.has-focus;
                                width: parent.width;
                                height: parent.height;
                                border-radius: 6px;
                            }
                        }
                        IconButton {
                            label: @tr("accessibility.zoom_in");
                            icon: @image-url("../icons/plus.svg");
                            icon-size: 18px;
                            clicked => { root.pdf-zoom(1); }
                        }
                    }
                    Rectangle { width: 12px; }
                    IconButton {
                        label: @tr("file.action.save_as");
                        icon: @image-url("../icons/download.svg");
                        clicked => { root.pdf-save-as(); }
                    }
                    IconButton {
                        label: @tr("pdf.engine.open_external");
                        icon: @image-url("../icons/corner-up-right.svg");
                        clicked => { root.pdf-open-external(); }
                    }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                pdf-flick := Flickable {
                    width: parent.width;
                    height: parent.height;
                    content-height: max(self.height, root.pdf-total-h * 1px);
                    content-width: max(self.width, root.pdf-total-w * 1px);
                    changed viewport-y => { root.pdf-scrolled(-self.viewport-y / 1px); }
                    changed width => { if (root.pdf-open) { root.pdf-view-resized(); } }
                    for p in root.pdf-pages: Rectangle {
                        x: (pdf-flick.viewport-width - p.w * 1px) / 2;
                        y: p.y * 1px;
                        width: p.w * 1px;
                        height: p.h * 1px;
                        background: white;
                        drop-shadow-blur: 6px;
                        drop-shadow-color: Theme.glass-shadow;
                        if p.ready: Image {
                            source: p.pic;
                            width: parent.width;
                            height: parent.height;
                            image-fit: fill;
                        }
                    }
                }
                if root.pdf-status != "": Rectangle {
                    width: min(parent.width - 48px, 420px);
                    height: status-col.preferred-height + 40px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    background: Theme.panel;
                    border-width: Theme.glass ? 1px : 0px;
                    border-color: Theme.glass-rim;
                    if Theme.glass: Rectangle {
                        border-radius: parent.border-radius;
                        background: Theme.glass-sheen;
                    }
                    border-radius: 20px;
                    drop-shadow-blur: 10px;
                    drop-shadow-color: Theme.glass-shadow;
                    status-col := VerticalLayout {
                        padding: 20px;
                        spacing: 14px;
                        width: parent.width;
                        Text {
                            text: root.pdf-status;
                            color: Theme.text;
                            font-size: 14px;
                            wrap: word-wrap;
                            width: parent.width - 40px;
                            horizontal-alignment: center;
                        }
                        if root.pdf-engine-missing: HorizontalLayout {
                            alignment: center;
                            spacing: 8px;
                            DialogButton {
                                label: @tr("pdf.engine.open_external");
                                clicked => { root.pdf-open-external(); }
                            }
                            DialogButton {
                                label: root.pdf-installing ? @tr("pdf.engine.installing") : @tr("pdf.engine.install");
                                primary: true;
                                enabled: !root.pdf-installing;
                                clicked => { root.pdf-install-engine(); }
                            }
                        }
                    }
                }
            }
        }
    }

    // ---------- Video player ----------
    video-layer := VideoLayer {
        open: root.video-open;
        scrim: Theme.glass ? #000000c8 : #000000ee;
        dismissible: false;

        video-frame: root.video-frame;
        video-w: root.video-w;
        video-h: root.video-h;
        close-video() => { root.close-video(); }
        video-is-clip: root.video-is-clip;
        video-loading: root.video-loading;
        video-playing: root.video-playing;
        video-ended: root.video-ended;
        video-progress: root.video-progress;
        video-pos-label: root.video-pos-label;
        video-duration-label: root.video-duration-label;
        video-volume: root.video-volume;
        video-muted: root.video-muted;
        video-toggle() => { root.video-toggle(); }
        video-seek(a0) => { root.video-seek(a0); }
        video-seek-by(a0) => { root.video-seek-by(a0); }
        video-set-volume(a0) => { root.video-set-volume(a0); }
        video-mute-toggle() => { root.video-mute-toggle(); }
        video-save() => { root.video-save(); }
    }

    // ---------- Lightbox ----------
    lightbox-layer := LightboxLayer {
        open: root.lightbox-open;
        scrim: Theme.glass ? #000000c8 : #000000ee;
        dismiss => { root.lightbox-open = false; }

        lightbox-open <=> root.lightbox-open;
        lightbox-image: root.lightbox-image;
    }
    }
    whats-new-layer := WhatsNewLayer {
        open: root.whats-new-open;
        scrim: Theme.scrim;
        dismiss => { root.whats-new-open = false; }

        update-state: root.update-state;
        update-version: root.update-version;
        app-version: root.app-version;
        releases: root.releases;
        changelog-loading: root.changelog-loading;
        changelog-more: root.changelog-more;
        changelog-error: root.changelog-error;
        changelog-has-new: root.changelog-has-new;
        changelog-verified: root.changelog-verified;
        whats-new-open <=> root.whats-new-open;
        changelog-load(a0) => { root.changelog-load(a0); }
        update-apply() => { root.update-apply(); }
        update-restart() => { root.update-restart(); }
    }

    splash := Splash {
        width: 100%;
        height: 100%;
        loading: root.app-loading;
    }
}
