    public function clear-sidebar-search() {
        search-box.text = "";
    }

    public function focus-composer() {
        if (root.screen == "main" && root.chat-open && root.current-can-send && !root.select-mode
            && !root.message-menu-open && !root.message-dialog-open && !root.details-open && !root.confirm-open
            && !root.settings-open && !root.forward-open && !root.share-open && !root.preview-open
            && !root.lightbox-open && !root.video-open && !root.pdf-open && !root.sv-open
            && !root.alert-open && !root.member-pick-open && !root.reactions-open
            && !root.picker-open && !root.attach-open && !root.chat-menu-open && !root.account-menu-open
            && !root.chat-search-open && !root.sync-open && !root.new-list-open && !root.info-open) {
            message-input.focus();
        }
    }
    public function append-composer(t: string) {
        message-input.text = message-input.text + t;
    }
    // The host rewrote the composer (a mention was picked).
    public function set-composer(t: string, cursor: int) {
        message-input.text = t;
        message-input.set-selection-offsets(cursor, cursor);
        message-input.focus();
    }
    public function scroll-conversation-end() {
        msg-list.viewport-y = min(0px, msg-list.height - msg-list.viewport-height);
    }
    public function scroll-conversation-top() {
        msg-list.viewport-y = 0;
    }
    public function set-conversation-scroll(y: length) {
        msg-list.viewport-y = y;
    }

    // Settings
    in-out property <bool> settings-open: false;
    in-out property <string> settings-section: "general";
    property <string> settings-query: "";
    property <[{ key: string, title: string, detail: string, icon: image }]> settings-categories: [
        { key: "account", title: @tr("settings.category.account.title"), detail: @tr("settings.category.account.description"), icon: @image-url("../icons/users.svg") },
        { key: "general", title: @tr("settings.category.general.title"), detail: @tr("settings.category.general.description"), icon: @image-url("../icons/settings.svg") },
        { key: "appearance", title: @tr("settings.category.appearance.title"), detail: @tr("settings.category.appearance.description"), icon: @image-url("../icons/eye.svg") },
        { key: "notifications", title: @tr("settings.category.notifications.title"), detail: @tr("settings.category.notifications.description"), icon: @image-url("../icons/bell.svg") },
        { key: "privacy", title: @tr("settings.category.privacy.title"), detail: @tr("settings.category.privacy.description"), icon: @image-url("../icons/lock.svg") },
        { key: "calls", title: @tr("settings.category.calls.title"), detail: @tr("settings.category.calls.description"), icon: @image-url("../icons/phone.svg") },
        { key: "downloads", title: @tr("settings.category.downloads.title"), detail: @tr("settings.category.downloads.description"), icon: @image-url("../icons/download.svg") },
        { key: "security", title: @tr("settings.category.security.title"), detail: @tr("settings.category.security.description"), icon: @image-url("../icons/lock.svg") },
        { key: "updates", title: @tr("settings.category.updates.title"), detail: @tr("settings.category.updates.description"), icon: @image-url("../icons/refresh.svg") },
        { key: "translation", title: @tr("translation.settings.title"), detail: @tr("translation.settings.category_description"), icon: @image-url("../icons/translate.svg") },
        { key: "mcp", title: @tr("settings.category.mcp.title"), detail: @tr("settings.category.mcp.description"), icon: @image-url("../icons/message-circle.svg") }
    ];
    pure callback settings-search(string, string) -> bool;
    pure function settings-matches(text: string) -> bool {
        return root.settings-search(text, root.settings-query);
    }
    in-out property <bool> pin-set: false;
    in-out property <bool> autostart: false;
    in-out property <bool> mcp-enabled: false;
    in-out property <string> mcp-url;
    in-out property <string> mcp-token;
    in-out property <string> mcp-status;
    in-out property <string> settings-status: "";
    in property <string> translation-status: "Stopped";
    in property <string> translation-detail: "";
    in property <bool> translation-busy: false;
    in property <bool> translation-running: false;
    in property <string> translation-target: "pt";
    in property <string> translation-source: "auto";
    in property <[TranslationModelItem]> translation-installed;
    in property <string> translation-pairs;
    in property <bool> translation-installing: false;
    in property <float> translation-progress: -1;
    in property <string> translation-progress-text;
    in property <int> translation-pair-state: 0;
    in property <string> translation-pair-detail;
    callback translation-action(string);
    callback translation-install(string);
    callback translation-remove(string, string);
    callback translation-model-selected(string);
    in-out property <string> translation-model-source: "en";
    callback translation-language(string, string);
    pure function can-translate(message: MessageItem) -> bool {
        return !message.deleted && message.cardKind == "" && !message.sticker
            && message.text != "" && (message.kind == "text" || message.kind == "image" || message.kind == "video");
    }
    callback autostart-changed(bool);
    callback mcp-changed(bool);
    callback mcp-copy-config();
    callback mcp-regenerate-token();
    callback save-pin(string, string);
    callback remove-pin(string);
    callback logout();
    // Accounts (up to five, one loaded at a time).
    in property <[AccountItem]> accounts;
    // The loaded one, for the rail.
    in property <AccountItem> my-account;
    in property <int> account-count: 1;
    in property <bool> can-add-account: true;
    in-out property <bool> account-menu-open: false;
    in property <bool> account-switching: false;
    // The login screen: conversations a past session left on disk, and
    // the number they belong to.
    in property <bool> kept-conversations: false;
    in property <string> kept-number;
    callback switch-account(string);
    callback add-account();
    callback remove-account(string);
    callback forget-conversations();
    // Privacy: both off by default (see Bridge::send_view_receipts and
    // the deletion routing in Bridge::on_messages).
    in-out property <bool> send-receipts: false;
    in-out property <bool> apply-deletions: false;
    callback send-receipts-changed(bool);
    callback apply-deletions-changed(bool);
    callback download-media(string);
    in-out property <bool> auto-download-photos: true;
    callback auto-download-photos-changed(bool);
    in-out property <bool> auto-download-audio: true;
    callback auto-download-audio-changed(bool);
    in-out property <bool> auto-download-video: true;
    callback auto-download-video-changed(bool);
    in-out property <bool> auto-download-documents: true;
    callback auto-download-documents-changed(bool);
    in-out property <bool> auto-download-stickers: true;
    callback auto-download-stickers-changed(bool);

    // Lightbox
    in-out property <bool> lightbox-open: false;
    in-out property <image> lightbox-image;
    in-out property <string> lightbox-id: "";
    callback open-lightbox(string);
    callback notice-clicked(string);

    // Share the group's recent history with someone who joined by link.
    in-out property <bool> share-open: false;
    in-out property <string> share-name: "";
    in-out property <image> share-avatar;
    in-out property <bool> share-has-avatar: false;
    in-out property <string> share-initial: "";
    in-out property <int> share-color-idx: 0;
    in-out property <bool> share-sending: false;
    callback share-accept();
    callback share-cancel();
    // In-app video player
    in-out property <bool> video-open: false;
    in-out property <image> video-frame;
    in-out property <int> video-w: 0;
    in-out property <int> video-h: 0;
    callback open-video(string);
    callback close-video();
    // The hand cursor over links (see LinkHover): a press on a link's box
    // is played again by the host with the boxes stepped aside.
    in-out property <bool> link-press-through: false;
    in-out property <bool> link-release-seen: false;
    callback link-pressed(length, length);
    // A clip gets the transport; the GIF zoom is just the picture.
    in property <bool> video-is-clip: false;
    in property <bool> video-loading: false;
    in property <bool> video-playing: false;
    in property <bool> video-ended: false;
    in property <float> video-progress: 0;
    in property <string> video-pos-label: "0:00";
    in property <string> video-duration-label: "0:00";
    in property <float> video-volume: 1;
    in property <bool> video-muted: false;
    callback video-toggle();
    // A fraction of the clip's length.
    callback video-seek(float);
    // Seconds, either way.
    callback video-seek-by(float);
    callback video-set-volume(float);
    callback video-mute-toggle();
    callback video-save();

    // Send-image preview (paste / attach confirmation)
    in-out property <bool> preview-open: false;
    in-out property <image> preview-image;
    callback confirm-send-image(string);
    callback cancel-send-image();
    callback crop-preview(float, float, float, float);
    callback text-preview(string, float, float);
    callback draw-preview(string, color, float);
    in-out property <bool> preview-busy: false;
    callback reset-preview();
    public function focus-preview-caption() { image-editor.focus-caption(); }
    changed preview-open => {
        if (!root.preview-open) { image-editor.clear(); }
    }

    // Colourful stand-in for the OS backdrop; only the demo screenshots set it.
    in property <image> demo-backdrop;
    in-out property <bool> demo-hover: false;
    in-out property <length> demo-hover-x: 0px;
    in-out property <length> demo-hover-y: 0px;
    if root.demo-backdrop.width > 0: Image {
        source: root.demo-backdrop;
        image-fit: fill;
        width: 100%;
        height: 100%;
    }

    // ---------- Lock screen ----------
    if root.screen == "locked": VerticalBox {
        alignment: center;
        spacing: 14px;
        HorizontalBox {
            alignment: center;
            UpdateBanner {
                width: 360px;
                inset: 0;
                state: root.update-state;
                version: root.update-version;
                error: root.update-error;
                apply-update => { root.update-apply(); }
                restart => { root.update-restart(); }
                view-news => { root.show-whats-new(); }
            }
        }
        HorizontalBox {
            alignment: center;
            spacing: 10px;
            Image {
                source: @image-url("../icons/lock.svg");
                colorize: Theme.text;
                width: 26px;
                height: 26px;
                y: 2px;
            }
            Text {
                text: "Zapive";
                color: Theme.text;
                font-size: 26px;
                font-weight: 700;
            }
        }
        Text {
            text: @tr("security.unlock.enter_pin_prompt");
            color: Theme.text-dim;
            font-size: 14px;
            horizontal-alignment: center;
        }
        HorizontalBox {
            alignment: center;
            pin-input := LineEdit {
                width: 220px;
                input-type: password;
                placeholder-text: @tr("security.unlock.pin_placeholder");
                accessible-label: @tr("security.unlock.enter_pin_prompt");
                accepted => { root.unlock(self.text); self.text = ""; }
            }
            Button {
                text: @tr("security.unlock.action");
                primary: true;
                clicked => { root.unlock(pin-input.text); pin-input.text = ""; }
            }
        }
        Text {
            text: root.lock-error;
            color: Theme.danger-solid;
            font-size: 13px;
            horizontal-alignment: center;
        }
    }

    // ---------- Login ----------
    if root.screen == "login": VerticalBox {
        alignment: center;
        HorizontalBox {
            alignment: center;
            UpdateBanner {
                width: 820px;
                inset: 0;
                state: root.update-state;
                version: root.update-version;
                error: root.update-error;
                apply-update => { root.update-apply(); }
                restart => { root.update-restart(); }
                view-news => { root.show-whats-new(); }
            }
        }
        HorizontalBox {
            alignment: center;
            Rectangle {
                width: 820px;
                height: 420px;
                background: Theme.glass ? Theme.glass-fill : Theme.panel;
                border-width: Theme.glass ? 1px : 0px;
                border-color: Theme.glass-rim;
                drop-shadow-blur: Theme.glass ? 40px : 0px;
                drop-shadow-color: Theme.glass-shadow;
                if Theme.glass: Rectangle {
                    border-radius: parent.border-radius;
                    background: Theme.glass-sheen;
                }
                border-radius: 20px;

                if !root.pairing-mode: HorizontalLayout {
                    padding: 48px;
                    spacing: 40px;
                    VerticalLayout {
                        alignment: start;
                        spacing: 22px;
                        horizontal-stretch: 1;
                        Text {
                            text: @tr("account.login.whatsapp.title");
                            color: Theme.text;
                            font-size: 24px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.status-text;
                            color: Theme.text-dim;
                            font-size: 13px;
                        }
                        Text { text: @tr("account.login.qr.step_open_whatsapp"); color: Theme.text; font-size: 15px; }
                        Text { text: @tr("account.login.qr.step_linked_devices"); color: Theme.text; font-size: 15px; }
                        Text { text: @tr("account.login.qr.step_link_device"); color: Theme.text; font-size: 15px; }
                        Text { text: @tr("account.login.qr.step_scan_code"); color: Theme.text; font-size: 15px; }
                        Rectangle { height: 8px; }
                        GreenLink {
                            label: @tr("account.login.phone.open");
                            clicked => { root.pairing-mode = true; }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 264px;
                            height: 264px;
                            background: white;
                            border-radius: 8px;
                            Image {
                                source: root.qr-image;
                                width: 240px;
                                height: 240px;
                                image-rendering: pixelated;
                                accessible-role: image;
                                accessible-label: @tr("accessibility.qr_code");
                            }
                        }
                    }
                }

                if root.pairing-mode: VerticalLayout {
                    padding: 48px;
                    spacing: 20px;
                    alignment: start;
                    Text {
                        text: @tr("account.login.phone.title");
                        color: Theme.text;
                        font-size: 24px;
                        font-weight: 700;
                    }
                    Text {
                        text: @tr("account.login.phone.instructions");
                        color: Theme.text-dim;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        phone-input := LineEdit {
                            width: 300px;
                            placeholder-text: @tr("account.login.phone.number_placeholder");
                            accessible-label: @tr("account.login.phone.number_placeholder");
                            accepted => { root.request-pairing-code(self.text); }
                        }
                        Button {
                            text: @tr("account.login.phone.request_code");
                            primary: true;
                            clicked => { root.request-pairing-code(phone-input.text); }
                        }
                    }
                    Text {
                        text: root.pairing-code;
                        accessible-label: root.pairing-code == "" ? "" : @tr("accessibility.pairing_code", root.pairing-code);
                        color: Theme.accent;
                        font-size: 36px;
                        font-weight: 700;
                        letter-spacing: 4px;
                    }
                    Rectangle { vertical-stretch: 1; }
                    GreenLink {
                        label: @tr("account.login.qr.back");
                        clicked => { root.pairing-mode = false; }
                    }
                }
            }
        }
        // A past session's conversations are still here: linking the
        // same number again carries on from them.
        if root.kept-conversations: HorizontalBox {
            alignment: center;
            Rectangle {
                width: 820px;
                height: kept-row.preferred-height;
                background: Theme.panel;
                border-width: Theme.glass ? 1px : 0px;
                border-color: Theme.glass-rim;
                if Theme.glass: Rectangle {
                    border-radius: parent.border-radius;
                    background: Theme.glass-sheen;
                }
                border-radius: 20px;
                kept-row := HorizontalLayout {
                    padding: 16px;
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 16px;
                    Image {
                        source: @image-url("../icons/archive.svg");
                        colorize: Theme.accent;
                        width: 22px;
                        height: 22px;
                        y: (parent.height - self.height) / 2;
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;
                        horizontal-stretch: 1;
                        Text {
                            text: root.kept-number != ""
                                ? @tr("account.backup.saved_for_number", root.kept-number)
                                : @tr("account.backup.saved");
                            color: Theme.text;
                            font-size: 14px;
                            font-weight: 600;
                            wrap: word-wrap;
                        }
                        Text {
                            text: @tr("account.backup.restore_explanation");
                            color: Theme.text-dim;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        DialogButton {
                            label: @tr("account.backup.erase_action");
                            clicked => { root.forget-conversations(); }
                        }
                    }
                }
            }
        }
        if root.account-count > 1: HorizontalBox {
            alignment: center;
            Rectangle {
                width: 820px;
                height: others-col.preferred-height;
                background: Theme.panel;
                border-width: Theme.glass ? 1px : 0px;
                border-color: Theme.glass-rim;
                if Theme.glass: Rectangle {
                    border-radius: parent.border-radius;
                    background: Theme.glass-sheen;
                }
                border-radius: 20px;
                others-col := VerticalLayout {
                    padding: 10px;
                    spacing: 2px;
                    Text {
                        text: @tr("account.menu.other_accounts");
                        color: Theme.text-dim;
                        font-size: 12px;
                        height: 24px;
                        x: 12px;
                        vertical-alignment: center;
                    }
                    for acc in root.accounts: AccountRow {
                        visible: !acc.active;
                        height: acc.active ? 0 : 52px;
                        account: acc;
                        enabled: !root.account-switching;
                        clicked => { root.switch-account(acc.id); }
                        remove => { root.remove-account(acc.id); }
                    }
                }
            }
        }
    }

    // ---------- Main ----------
    // capture-key-pressed sees Ctrl+V even while the composer LineEdit is
    // focused; rejecting keeps normal text paste working while the app
    // checks the clipboard for an image (WhatsApp-style paste-to-send).
    capture-scope := FocusScope {
        visible: root.screen == "main";
        capture-key-pressed(event) => {
            if (event.text == "/" && event.modifiers.control) {
                root.shortcuts-open = !root.shortcuts-open;
                return accept;
            }
            if (event.modifiers.control && !event.modifiers.shift && !event.modifiers.alt
                && event.text >= "1" && event.text <= "9" && root.screen == "main") {
                if (event.text == "1") { root.open-chat-at(0); }
                else if (event.text == "2") { root.open-chat-at(1); }
                else if (event.text == "3") { root.open-chat-at(2); }
                else if (event.text == "4") { root.open-chat-at(3); }
                else if (event.text == "5") { root.open-chat-at(4); }
                else if (event.text == "6") { root.open-chat-at(5); }
                else if (event.text == "7") { root.open-chat-at(6); }
                else if (event.text == "8") { root.open-chat-at(7); }
                else { root.open-chat-at(8); }
                return accept;
            }
            if (event.text == Key.Tab && event.modifiers.control) {
                root.select-adjacent-chat(event.modifiers.shift ? -1 : 1);
                return accept;
            }
            if (event.modifiers.alt && event.text == Key.DownArrow) {
                root.select-adjacent-chat(1);
                return accept;
            }
            if (event.modifiers.alt && event.text == Key.UpArrow) {
                root.select-adjacent-chat(-1);
                return accept;
            }
            if (event.text.to-lowercase() == "f" && event.modifiers.control && event.modifiers.shift
                && root.chat-open) {
                root.menu-search();
                return accept;
            }
            if (event.text == "f" && event.modifiers.control) {
                search-box.focus();
                return accept;
            }
            if (event.text.to-lowercase() == "e" && event.modifiers.control && root.chat-open) {
                root.toggle-archive-current();
                return accept;
            }
            if (event.text.to-lowercase() == "m" && event.modifiers.control && event.modifiers.shift
                && root.chat-open) {
                root.toggle-mute-current();
                return accept;
            }
            if (event.text == "v" && event.modifiers.control && root.chat-open) {
                root.paste-clipboard();
            }
            if (event.text == "c" && event.modifiers.control && root.select-mode) {
                root.select-copy();
                return accept;
            }
            if (event.text == Key.Escape) {
                if (root.shortcuts-open) { root.shortcuts-open = false; }
                else if (root.poll-composer-open) { root.poll-composer-open = false; }
                else if (root.whats-new-open) { root.whats-new-open = false; }
                else if (root.video-open) { root.close-video(); }
                else if (root.lightbox-open) { root.lightbox-open = false; }
                else if (root.pdf-open) { root.pdf-close(); }
                else if (root.message-menu-open) { root.message-menu-open = false; }
                else if (root.details-open) { root.details-open = false; }
                else if (root.message-dialog-open) { root.message-dialog-open = false; }
                else if (root.confirm-open) { root.confirm-open = false; }
                else if (root.preview-open) { root.cancel-send-image(); }
                else if (root.share-open) { root.share-cancel(); }
                else if (root.member-pick-open) { root.member-pick-open = false; }
                else if (root.new-list-open) { root.new-list-open = false; }
                else if (root.forward-open) { root.forward-open = false; }
                else if (root.settings-open) { root.settings-open = false; }
                else if (root.account-menu-open) { root.account-menu-open = false; }
                else if (root.sv-open) { root.status-close(); }
                else if (root.sync-open) { root.sync-open = false; }
                else if (root.chat-menu-open) { root.chat-menu-open = false; }
                else if (root.mention-open) { root.mention-close(); }
                else if (root.picker-open) { root.picker-open = false; }
                else if (root.attach-open) { root.attach-open = false; }
                else if (root.select-mode) { root.select-cancel(); }
                else if (root.starred-open) { root.starred-open = false; }
                else if (root.info-open) { root.close-info(); }
                else if (root.chat-search-open) { root.chat-search-close(); }
                else if (root.chat-tab == "archived") {
                    root.chat-tab = "all";
                    root.tab-changed("all");
                    search-box.text = "";
                    root.search-changed("");
                }
                else {
                    root.menu-close-chat();
                    root.settings-open = false; root.sidebar-view = "chats";
                    root.view-changed("chats");
                    search-box.text = "";
                    root.search-changed("");
                }
                capture-scope.focus();
                return accept;
            }
            reject
        }

    main-pane := HorizontalLayout {
        padding: 0;
        spacing: 0;

        // Icon rail
        Rectangle {
            width: 60px;
            background: Theme.rail;
            VerticalLayout {
                width: 100%;
                padding: 10px;
                spacing: 8px;
                alignment: start;
                IconButton {
                    label: @tr("navigation.chats");
                    icon: @image-url("../icons/message-circle.svg");
                    active-background: Theme.rail-active;
                    tint: self.active ? Theme.accent-text : Theme.icon;
                    badge-border: Theme.badge-cut;
                    badge-count: root.chats-unread-count;
                    active: root.sidebar-view == "chats";
                    clicked => {
                        root.settings-open = false; root.sidebar-view = "chats";
                        root.view-changed("chats");
                    }
                }
                IconButton {
                    label: @tr("navigation.status");
                    icon: @image-url("../icons/circle-dot.svg");
                    active-background: Theme.rail-active;
                    tint: self.active ? Theme.accent-text : Theme.icon;
                    badge-border: Theme.badge-cut;
                    badge-dot: root.statuses-unseen;
                    active: root.sidebar-view == "status";
                    clicked => { root.settings-open = false; root.sidebar-view = "status"; }
                }
                IconButton {
                    label: @tr("navigation.calls");
                    icon: @image-url("../icons/phone.svg");
                    active-background: Theme.rail-active;
                    tint: self.active ? Theme.accent-text : Theme.icon;
                    badge-border: Theme.badge-cut;
                    badge-count: root.calls-unseen-count;
                    active: root.sidebar-view == "calls";
                    clicked => { root.settings-open = false; root.sidebar-view = "calls"; root.view-changed("calls"); }
                }
                IconButton {
                    label: @tr("navigation.channels");
                    icon: @image-url("../icons/speakerphone.svg");
                    active-background: Theme.rail-active;
                    tint: self.active ? Theme.accent-text : Theme.icon;
                    badge-border: Theme.badge-cut;
                    badge-count: root.channels-unread-count;
                    active: root.sidebar-view == "channels";
                    clicked => {
                        root.settings-open = false; root.sidebar-view = "channels";
                        root.view-changed("channels");
                    }
                }
                IconButton {
                    label: @tr("navigation.communities");
                    icon: @image-url("../icons/users-group.svg");
                    active-background: Theme.rail-active;
                    tint: self.active ? Theme.accent-text : Theme.icon;
                    badge-border: Theme.badge-cut;
                    badge-count: root.communities-unread-count;
                    active: root.sidebar-view == "communities";
                    clicked => {
                        root.settings-open = false; root.sidebar-view = "communities";
                        root.view-changed("communities");
                    }
                }
            }
            VerticalLayout {
                width: 100%;
                height: self.preferred-height;
                y: parent.height - self.height;
                padding-left: 10px;
                padding-right: 10px;
                padding-bottom: 0px;
                spacing: 8px;
                Rectangle { height: 1px; background: Theme.border; }
                IconButton {
                    label: @tr("navigation.settings");
                    icon: @image-url("../icons/settings.svg");
                    active: root.settings-open;
                    clicked => {
                        root.settings-status = "";
                        root.settings-open = !root.settings-open;
                        root.settings-opened();
                    }
                }
                // Whose conversations these are; opens the switcher.
                TouchArea {
                    accessible-role: button;
                    accessible-label: @tr("accessibility.account_menu", root.my-account.name);
                    accessible-action-default => { root.account-menu-open = !root.account-menu-open; }
                    height: 40px;
                    mouse-cursor: pointer;
                    clicked => { root.account-menu-open = !root.account-menu-open; }
                    Avatar {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 32px;
                        height: 32px;
                        src: root.my-account.avatar;
                        has-image: root.my-account.hasAvatar;
                        initial: root.my-account.initial;
                        color-idx: root.my-account.colorIdx;
                    }
                    account-key := KeyFocus {
                        activate => { root.account-menu-open = !root.account-menu-open; }
                    }
                    FocusRing {
                        shown: account-key.has-focus;
                        width: parent.width;
                        height: parent.height;
                        border-radius: 8px;
                    }
                }
            }
        }

        Rectangle { width: Theme.glass ? 0px : 1px; background: Theme.border; }

        // Sidebar
        Rectangle {
            width: 380px;
            background: Theme.sidebar;
            if Theme.glass: Rectangle {
                border-radius: parent.border-radius;
                background: Theme.glass-sheen;
            }
            // Side rims only: a full border drew a grey line along the
            // window's top and bottom edges too.
            if root.glass: Rectangle {
                x: 0px;
                width: 1px;
                background: Theme.glass-rim;
            }
            if root.glass: Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Theme.glass-rim;
            }

            VerticalBox {
                visible: root.sidebar-view == "status";
                width: 100%;
                height: 100%;
                padding: 0;
                spacing: 0;
                Rectangle {
                    height: 56px;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        Text {
                            text: @tr("navigation.status");
                            color: Theme.text;
                            font-size: 21px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                }
                if root.statuses.length == 0: Text {
                    text: @tr("status.empty.recent_updates");
                    color: Theme.text-dim;
                    font-size: 13px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    height: 72px;
                    vertical-alignment: center;
                }
                ListView {
                    for st[i] in root.statuses: Rectangle {
                        height: 72px;
                        clip: true;
                        background: st-touch.has-hover ? Theme.hover : transparent;
                        st-touch := TouchArea {
                            accessible-role: list-item;
                            accessible-label: st.name + ", " + st.time;
                            accessible-item-index: i;
                            accessible-item-count: root.statuses.length;
                            accessible-action-default => { root.status-open(st.jid); }
                            clicked => { root.status-open(st.jid); }
                            st-key := KeyFocus {
                                activate => { root.status-open(st.jid); }
                            }
                        }
                        HorizontalLayout {
                            padding-left: 13px;
                            padding-right: 15px;
                            spacing: 13px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 0;
                                Rectangle {
                                    width: 53px;
                                    height: 53px;
                                    border-radius: 26.5px;
                                    border-width: 2px;
                                    border-color: Theme.accent;
                                    Avatar {
                                        width: 46px;
                                        height: 46px;
                                        x: 3.5px;
                                        y: 3.5px;
                                        src: st.avatar;
                                        has-image: st.hasAvatar;
                                        initial: st.initial;
                                        color-idx: st.colorIdx;
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text {
                                    text: st.name;
                                    color: Theme.text;
                                    font-size: 15px;
                                    overflow: elide;
                                }
                                Text {
                                    text: st.time;
                                    color: Theme.text-dim;
                                    font-size: 12px;
                                }
                            }
                        }
                    }
                }
            }

            VerticalBox {
                visible: root.sidebar-view == "calls";
                width: 100%;
                height: 100%;
                padding: 0;
                spacing: 0;
                Rectangle {
                    height: 56px;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        Text {
                            text: @tr("navigation.calls");
                            color: Theme.text;
                            font-size: 21px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                }
                if root.calls.length == 0: Text {
                    text: @tr("calls.empty.list");
                    color: Theme.text-dim;
                    font-size: 13px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    height: 72px;
                    vertical-alignment: center;
                }
                ListView {
                    for call in root.calls: Rectangle {
                        height: 68px;
                        clip: true;
                        background: call-touch.has-hover ? Theme.hover : transparent;
                        call-touch := TouchArea {
                            accessible-role: list-item;
                            accessible-label: call.name + ", " + call.detail + ", " + call.time;
                            accessible-action-default => { root.open-dm(call.from); }
                            clicked => { root.open-dm(call.from); }
                            call-key := KeyFocus {
                                activate => { root.open-dm(call.from); }
                            }
                        }
                        HorizontalLayout {
                            padding-left: 13px;
                            padding-right: 15px;
                            spacing: 13px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 0;
                                Avatar {
                                    width: 46px;
                                    height: 46px;
                                    src: call.avatar;
                                    has-image: call.hasAvatar;
                                    initial: call.initial;
                                    color-idx: call.colorIdx;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                spacing: 3px;
                                Text {
                                    text: call.name;
                                    color: Theme.text;
                                    font-size: 15px;
                                    overflow: elide;
                                }
                                Text {
                                    text: call.detail;
                                    color: Theme.text-dim;
                                    font-size: 13px;
                                    overflow: elide;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 0;
                                spacing: 4px;
                                Text {
                                    text: call.time;
                                    color: Theme.text-dim;
                                    font-size: 11px;
                                    horizontal-alignment: right;
                                }
                                // Redial, the way the phone's call log does.
                                if !call.group: IconButton {
                                    label: @tr("accessibility.call_back");
                                    icon: @image-url("../icons/phone.svg");
                                    icon-size: 18px;
                                    width: 30px;
                                    height: 30px;
                                    clicked => { root.start-call(call.from); }
                                }
                            }
                        }
                    }
                }
            }

            VerticalBox {
                visible: root.sidebar-view != "status" && root.sidebar-view != "calls";
                width: 100%;
                height: 100%;
                padding: 0;
                spacing: 0;

                Rectangle {
                    height: 56px;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        Text {
                            text: root.sidebar-view == "channels" ? @tr("navigation.channels")
                                : root.sidebar-view == "communities" ? @tr("navigation.communities")
                                : @tr("navigation.chats");
                            color: Theme.text;
                            font-size: 21px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                }

                Rectangle {
                    height: 46px;
                    Rectangle {
                        x: 14px;
                        width: parent.width - 28px;
                        height: 34px;
                        border-radius: 10px;
                        background: Theme.field;
                        border-width: 1px;
                        border-color: search-box.has-focus ? Theme.accent : Theme.field-border;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 6px;
                            spacing: 8px;
                            Rectangle {
                                width: 16px;
                                Image {
                                    source: @image-url("../icons/search.svg");
                                    colorize: Theme.icon;
                                    width: 16px;
                                    height: 16px;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                search-box := TextInput {
                                    accessible-label: @tr("chat.search.placeholder");
                                    width: parent.width;
                                    height: parent.height;
                                    color: Theme.text;
                                    font-size: 12px;
                                    single-line: true;
                                    vertical-alignment: center;
                                    selection-background-color: Theme.accent;
                                    selection-foreground-color: white;
                                    edited => { root.search-changed(self.text); }
                                }
                                if search-box.text == "": Text {
                                    text: @tr("chat.search.placeholder");
                                    color: Theme.text-dim;
                                    font-size: 12px;
                                    width: parent.width;
                                    height: parent.height;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                            Rectangle {
                                width: 52px;
                                HorizontalLayout {
                                    y: (parent.height - self.height) / 2;
                                    height: 22px;
                                    spacing: 4px;
                                    for shortcut in ["Ctrl", "F"]: Rectangle {
                                        width: shortcut == "Ctrl" ? 28px : 20px;
                                        border-radius: 5px;
                                        background: Theme.tile;
                                        Text {
                                            text: shortcut;
                                            color: Theme.text-dim;
                                            font-size: 10px;
                                            width: parent.width;
                                            height: parent.height;
                                            vertical-alignment: center;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Self-update banner under the search box.
                UpdateBanner {
                    state: root.update-state;
                    version: root.update-version;
                error: root.update-error;
                    apply-update => { root.update-apply(); }
                    restart => { root.update-restart(); }
                view-news => { root.show-whats-new(); }
                }

                // Filter chips scroll sideways once the lists add up.
                Flickable {
                    height: root.sidebar-view == "chats" ? 40px : 0;
                    visible: root.sidebar-view == "chats";
                    content-width: chips.preferred-width;
                    content-height: self.height;
                    interactive: chips.preferred-width > self.width;
                    chips := HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 5px;
                        alignment: start;
                        FilterChip {
                            label: @tr("chat.filter.all");
                            active: root.chat-tab == "all";
                            clicked => { root.chat-tab = "all"; root.tab-changed("all"); }
                        }
                        FilterChip {
                            label: @tr("chat.filter.unread");
                            count: root.chats-unread-count;
                            active: root.chat-tab == "unread";
                            clicked => { root.chat-tab = "unread"; root.tab-changed("unread"); }
                        }
                        FilterChip {
                            label: @tr("chat.filter.favorites");
                            active: root.chat-tab == "favorites";
                            clicked => { root.chat-tab = "favorites"; root.tab-changed("favorites"); }
                        }
                        FilterChip {
                            label: @tr("chat.filter.groups");
                            active: root.chat-tab == "groups";
                            clicked => { root.chat-tab = "groups"; root.tab-changed("groups"); }
                        }
                        FilterChip {
                            label: @tr("chat.filter.archived");
                            active: root.chat-tab == "archived";
                            clicked => { root.chat-tab = "archived"; root.tab-changed("archived"); }
                        }
                        for lb in root.label-chips: FilterChip {
                            label: lb.name;
                            active: root.chat-tab == "label:" + lb.id;
                            clicked => {
                                root.chat-tab = "label:" + lb.id;
                                root.tab-changed("label:" + lb.id);
                            }
                        }
                    }
                }

                if root.sidebar-view == "chats" && root.search-hits.length == 0: Rectangle {
                    height: 48px;
                    background: root.chat-tab == "archived" ? Theme.selected : archive-touch.has-hover ? Theme.hover : transparent;
                    HorizontalLayout {
                        padding-left: 24px;
                        padding-right: 20px;
                        spacing: 24px;
                        Rectangle {
                            width: 20px;
                            Image {
                                width: 20px;
                                height: 20px;
                                y: (parent.height - self.height) / 2;
                                source: @image-url("../icons/archive.svg");
                                colorize: Theme.icon;
                            }
                        }
                        Text {
                            text: @tr("chat.filter.archived");
                            color: Theme.text;
                            font-size: 14px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        if root.archived-mentioned: Text {
                            text: "@";
                            color: Theme.accent;
                            font-size: 16px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        if root.archived-unread-count > 0: Text {
                            text: root.archived-unread-count;
                            color: Theme.accent;
                            font-size: 13px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                    archive-touch := TouchArea {
                        accessible-role: button;
                        accessible-label: @tr("chat.filter.archived");
                        accessible-action-default => { root.chat-tab = root.chat-tab == "archived" ? "all" : "archived"; root.tab-changed(root.chat-tab); }
                        mouse-cursor: pointer;
                        clicked => {
                            root.chat-tab = root.chat-tab == "archived" ? "all" : "archived";
                            root.tab-changed(root.chat-tab);
                        }
                        archive-key := KeyFocus {
                            activate => { root.chat-tab = root.chat-tab == "archived" ? "all" : "archived"; root.tab-changed(root.chat-tab); }
                        }
                    }
                }

                // Searching: chats by name on top, then messages by content.
                if root.search-hits.length > 0: Rectangle {
                    height: 28px;
                    Text {
                        text: @tr("chat.search.chats_heading");
                        color: Theme.accent;
                        font-size: 13px;
                        font-weight: 700;
                        x: 16px;
                        height: parent.height;
                        vertical-alignment: center;
                    }
                }
                chat-list := ListView {
                    vertical-stretch: root.search-hits.length > 0 ? 1 : 3;
                    for chat[i] in root.chats: Rectangle {
                        height: 56px;
                        clip: true;
                        accessible-role: list-item;
                        accessible-label: @tr("accessibility.chat_row", chat.name,
                            chat.unread > 0 ? @tr("accessibility.unread.one" | "accessibility.unread.other" % chat.unread) : "",
                            chat.typing ? @tr("presence.typing") : chat.preview, chat.time);
                        accessible-item-selectable: true;
                        accessible-item-selected: chat.jid == root.selected-jid;
                        accessible-item-index: i;
                        accessible-item-count: root.chats.length;
                        accessible-action-default => { root.open-chat(chat.jid); }
                        chat-key := KeyFocus {
                            activate => { root.open-chat(chat.jid); }
                        }
                        // Files dragged from the desktop over this row.
                        if root.drop-target-jid == chat.jid: Rectangle {
                            x: 4px;
                            y: 1px;
                            width: parent.width - 8px;
                            height: parent.height - 2px;
                            border-radius: 10px;
                            background: Theme.accent.with-alpha(0.22);
                            border-width: 2px;
                            border-color: Theme.accent;
                        }
                        Rectangle {
                            x: 4px;
                            y: 1px;
                            width: parent.width - 8px;
                            height: parent.height - 2px;
                            border-radius: 10px;
                            background: chat.jid == root.selected-jid
                                ? Theme.chat-active
                                : touch.has-hover ? Theme.hover : transparent;
                            border-width: chat.jid == root.selected-jid ? 1px : 0px;
                            border-color: Theme.chat-active-border;
                            animate background { duration: 140ms; easing: ease-out; }
                            animate border-color { duration: 140ms; easing: ease-out; }
                        }
                        FocusRing {
                            x: 4px;
                            y: 1px;
                            width: parent.width - 8px;
                            height: parent.height - 2px;
                            border-radius: 10px;
                            shown: chat-key.has-focus;
                        }
                        touch := TouchArea {
                            accessible-role: none;
                            clicked => { root.open-chat(chat.jid); }
                            changed has-hover => {
                                if (self.has-hover) { root.chat-hover(chat.jid); }
                            }
                        }
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 18px;
                            spacing: 13px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 0;
                                Avatar {
                                    width: 40px;
                                    height: 40px;
                                    src: chat.avatar;
                                    has-image: chat.hasAvatar;
                                    initial: chat.initial;
                                    color-idx: chat.colorIdx;
                                    privacy-blurred: root.blur-photos;
                                    privacy-reveal: touch.has-hover;
                                    demo-reveal: root.demo-hover && root.demo-hover-x < 440px;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                spacing: 4px;
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: chat.name;
                                        color: root.blur-names && !touch.has-hover && !(root.demo-hover && root.demo-hover-x < 440px) ? transparent : Theme.text;
                                        font-size: 14px;
                                        font-weight: chat.jid == root.selected-jid || chat.unread > 0 ? 600 : 400;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                        if root.blur-names && !touch.has-hover && !(root.demo-hover && root.demo-hover-x < 440px): PrivacyVeil {
                                            width: parent.width;
                                            height: parent.height;
                                            radius: 3px;
                                            tint: Theme.sidebar;
                                        }
                                    }
                                    if chat.silenced-call: Image {
                                        source: @image-url("../icons/phone.svg");
                                        colorize: Theme.text-dim;
                                        width: 13px;
                                        height: 13px;
                                        y: (parent.height - self.height) / 2;
                                        accessible-role: none;
                                    }
                                    Text {
                                        text: chat.time;
                                        color: chat.unread > 0 ? Theme.accent : Theme.text-dim;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        horizontal-stretch: 0;
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    if chat.ticks != "": Ticks {
                                        ticks: chat.ticks;
                                        blue: chat.ticksBlue;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: chat.preview;
                                        color: root.blur-messages && !touch.has-hover && !(root.demo-hover && root.demo-hover-x < 440px) ? transparent
                                            : chat.draft ? Theme.warning : chat.typing ? Theme.accent : Theme.text-dim;
                                        font-size: 13px;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                        if root.blur-messages && !touch.has-hover && !(root.demo-hover && root.demo-hover-x < 440px): PrivacyVeil {
                                            width: parent.width;
                                            height: parent.height;
                                            radius: 3px;
                                            tint: Theme.sidebar;
                                        }
                                        Tooltip {
                                            Rectangle {
                                                width: min(420px, preview-tooltip.preferred-width + 24px);
                                                height: preview-tooltip.preferred-height + 16px;
                                                background: Theme.header;
                                                border-color: Theme.border;
                                                border-width: 1px;
                                                border-radius: 6px;
                                                preview-tooltip := Text {
                                                    x: 12px;
                                                    y: 8px;
                                                    width: parent.width - 24px;
                                                    text: chat.preview;
                                                    color: Theme.text;
                                                    font-size: 13px;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }
                                    }
                                    if chat.muted: Image {
                                        source: @image-url("../icons/bell-off.svg");
                                        colorize: Theme.text-dim;
                                        width: 14px;
                                        height: 14px;
                                        y: (parent.height - self.height) / 2;
                                        horizontal-stretch: 0;
                                    }
                                    if chat.pinned: Image {
                                        source: @image-url("../icons/pin.svg");
                                        colorize: Theme.text-dim;
                                        width: 14px;
                                        height: 14px;
                                        y: (parent.height - self.height) / 2;
                                        horizontal-stretch: 0;
                                    }
                                    if chat.mentioned: Image {
                                        source: @image-url("../icons/at.svg");
                                        colorize: Theme.accent;
                                        width: 15px;
                                        height: 15px;
                                        y: (parent.height - self.height) / 2;
                                        horizontal-stretch: 0;
                                    }
                                    if chat.unread > 0: Rectangle {
                                        width: max(20px, badge-text.preferred-width + 12px);
                                        height: 20px;
                                        border-radius: 10px;
                                        background: Theme.accent;
                                        badge-text := Text {
                                            text: chat.unread;
                                            color: #ffffff;
                                            font-size: 11px;
                                            font-weight: 700;
                                            width: parent.width;
                                            height: parent.height;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                        Rectangle {
                            x: 67px;
                            y: parent.height - 1px;
                            width: parent.width - 85px;
                            height: 1px;
                            background: chat.jid == root.selected-jid ? transparent : Theme.border;
                        }
                    }
                }

                if root.search-hits.length > 0: Rectangle {
                    height: 28px;
                    Text {
                        text: @tr("chat.search.messages_heading");
                        color: Theme.accent;
                        font-size: 13px;
                        font-weight: 700;
                        x: 16px;
                        height: parent.height;
                        vertical-alignment: center;
                    }
                }
                if root.search-hits.length > 0: ListView {
                    vertical-stretch: 2;
                    for hit in root.search-hits: HitRow {
                        hit: hit;
                        clicked => { root.open-hit(hit.jid, hit.id); }
                    }
                }
            }

            // Mini player: keeps the running voice note reachable after
            // the user moves to another conversation.
            if root.mini-audio: Rectangle {
                y: parent.height - self.height;
                width: parent.width;
                height: 56px;
                background: #008069e8;
                border-width: 1px;
                border-color: #ffffff55;
                mini-touch := TouchArea {
                    accessible-role: button;
                    accessible-label: @tr("accessibility.open_voice_message", root.mini-audio-name);
                    accessible-action-default => { root.mini-audio-open(); }
                    mouse-cursor: pointer;
                    clicked => { root.mini-audio-open(); }
                    mini-key := KeyFocus {
                        activate => { root.mini-audio-open(); }
                    }
                }
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 12px;
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 26px;
                            height: 26px;
                            play-touch := TouchArea {
                                accessible-role: button;
                                accessible-label: root.mini-audio-playing ? @tr("accessibility.pause") : @tr("accessibility.play");
                                accessible-action-default => { root.mini-audio-toggle(); }
                                mouse-cursor: pointer;
                                clicked => { root.mini-audio-toggle(); }
                                mini-play-key := KeyFocus {
                                    activate => { root.mini-audio-toggle(); }
                                }
                                FocusRing {
                                    shown: mini-play-key.has-focus;
                                    width: parent.width;
                                    height: parent.height;
                                    border-radius: 13px;
                                }
                            }
                            Image {
                                source: root.mini-audio-playing
                                    ? @image-url("../icons/player-pause.svg")
                                    : @image-url("../icons/player-play.svg");
                                colorize: white;
                                width: 18px;
                                height: 18px;
                            }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 30px;
                                    height: 30px;
                                    Avatar {
                                        width: 30px;
                                        height: 30px;
                                        src: root.mini-audio-avatar;
                                        has-image: root.mini-audio-avatar-has;
                                        initial: root.mini-audio-initial;
                                        color-idx: root.mini-audio-color-idx;
                                    }
                                    Image {
                                        source: @image-url("../icons/microphone.svg");
                                        colorize: white;
                                        width: 14px;
                                        height: 14px;
                                        x: parent.width - self.width;
                                        y: parent.height - self.height;
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: root.mini-audio-name;
                                    color: white;
                                    font-size: 14px;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 24px;
                            height: 24px;
                            close-touch := TouchArea {
                                accessible-role: button;
                                accessible-label: @tr("common.action.close");
                                accessible-action-default => { root.mini-audio-close(); }
                                mouse-cursor: pointer;
                                clicked => { root.mini-audio-close(); }
                                mini-close-key := KeyFocus {
                                    activate => { root.mini-audio-close(); }
                                }
                                FocusRing {
                                    shown: mini-close-key.has-focus;
                                    width: parent.width;
                                    height: parent.height;
                                    border-radius: 12px;
                                }
                            }
                            Image {
                                source: @image-url("../icons/x.svg");
                                colorize: white;
                                width: 16px;
                                height: 16px;
                            }
                        }
                    }
                }
                // Progress hairline along the bottom edge.
                Rectangle {
                    x: 0;
                    y: parent.height - 2px;
                    width: parent.width * root.mini-audio-progress;
                    height: 2px;
                    background: #ffffffcc;
                }
            }
        }

        Rectangle { width: Theme.glass ? 0px : 1px; background: Theme.border; }

        // Conversation pane
        conv-pane := Rectangle {
            Wallpaper {
                width: parent.width;
                height: parent.height;
            }

            HomeScreen {
                visible: !root.chat-open;
                width: 100%;
                height: 100%;
                conversations => {
                    root.settings-open = false; root.sidebar-view = "chats";
                    root.view-changed("chats");
                    root.chat-tab = "all";
                    root.tab-changed("all");
                    search-box.text = "";
                    root.search-changed("");
                    search-box.focus();
                }
                groups => {
                    root.settings-open = false; root.sidebar-view = "chats";
                    root.view-changed("chats");
                    root.chat-tab = "groups";
                    root.tab-changed("groups");
                    search-box.text = "";
                    root.search-changed("");
                    search-box.focus();
                }
                settings => {
                    root.settings-open = true;
                    root.settings-opened();
                }
            }

            Rectangle {
                visible: root.chat-open;
                width: 100%;
                height: 100%;
                opacity: root.chat-open ? 1 : 0;
                animate opacity { duration: Theme.motion-normal; easing: ease-out; }

                // The conversation and the day pill floating over it.
                Rectangle {
                    width: parent.width;
                    height: parent.height;
                    // Fades the floating day out once the wheel stops.
                    scroll-idle := Timer {
                        interval: 1400ms;
                        running: false;
                        triggered => { root.scrolling = false; self.running = false; }
                    }
                    typing-restick := Timer {
                        interval: 1ms;
                        running: false;
                        triggered => {
                            self.running = false;
                            if (root.conv-ready && root.stick-bottom) {
                                root.scroll-conversation-end();
                            }
                        }
                    }
                    if root.messages.length == 0 && msg-list.typing-space > 0px && root.conv-ready: TypingBubbles {
                        x: 48px + (root.select-mode ? 30px : 0px);
                        y: contact-header.height + 4px;
                        members: root.typing-members;
                        extra: root.typing-extra;
                        privacy-blurred: root.blur-photos;
                    }
                msg-list := ListView {
                    width: parent.width;
                    height: parent.height;
                    opacity: root.demo-hover ? 1.0 : root.conv-ready ? 1.0 : 0.0;
                    animate opacity {
                        duration: 160ms;
                        easing: ease-out;
                        enabled: root.conv-ready;
                    }
                    property <length> typing-space: root.current-is-group && root.typing-members.length > 0 ? 40px : 0px;
                    changed typing-space => {
                        typing-restick.running = root.conv-ready && root.stick-bottom;
                    }
                    changed viewport-height => {
                        root.conv-viewport-h = self.viewport-height;
                    }
                    changed viewport-y => {
                        root.conv-scroll = self.viewport-y;
                        root.stick-bottom =
                            self.viewport-y <= self.height - self.viewport-height + 60px;
                        if (self.viewport-y < -120px && root.conv-ready) {
                            root.scroll-armed = true;
                        }
                        if (self.viewport-y >= -4px && self.viewport-height > self.height
                            && root.scroll-armed) {
                            root.load-older();
                        }
                        if (root.conv-ready) {
                            root.scrolling = true;
                            scroll-idle.running = false;
                            scroll-idle.running = true;
                            root.conv-scrolled();
                        }
                    }
                    for msg[i] in root.messages: msg-row := Rectangle {
                        accessible-role: list-item;
                        accessible-label: msg.kind == "system" ? msg.text
                            : msg.deleted ? @tr("message.deleted_by_sender")
                            : @tr("accessibility.message",
                                msg.fromMe ? @tr("reactions.you") : msg.sender != "" ? msg.sender : root.current-chat-name,
                                (msg.sticker ? @tr("preview.sticker")
                                    : msg.kind == "image" ? @tr("preview.photo")
                                    : msg.kind == "video" ? @tr("preview.video")
                                    : msg.kind == "audio" ? (msg.voiceMessage ? @tr("preview.voice") : @tr("preview.audio"))
                                    : msg.kind == "doc" ? @tr("preview.document", "")
                                    : msg.cardKind != "" ? msg.cardTitle : "")
                                    + (msg.text != "" && msg.kind != "audio" ? " " + msg.text : "")
                                    + (msg.cardBody != "" ? " " + msg.cardBody : ""),
                                msg.time);
                        accessible-description: msg.reactions;
                        accessible-item-index: i;
                        accessible-item-count: root.messages.length;
                        property <int> menu-request: root.message-menu-request;
                        changed menu-request => {
                            if (self.menu-request > 0 && !msg.deleted && msg.kind != "system"
                                && root.message-menu-request-x >= self.absolute-position.x
                                && root.message-menu-request-x < self.absolute-position.x + self.width
                                && root.message-menu-request-y >= self.absolute-position.y + bubble.y
                                && root.message-menu-request-y < self.absolute-position.y + bubble.y + bubble.height) {
                                root.menu-message = msg;
                                root.message-menu-x = root.message-menu-request-x;
                                root.message-menu-y = root.message-menu-request-y;
                                root.message-menu-open = true;
                            }
                        }
                        property <length> header-offset: i == 0 ? contact-header.height + (root.pinned-items.length > 0 ? 40px : 0px) + root.silenced-calls.length * 56px : 0px;
                        // The row crossing the top edge names the day in
                        // the floating pill. Rows sit in viewport
                        // coordinates; the ListView re-anchors every
                        // visible row on each scroll step, so the check
                        // rides on y as well as on the visible offset.
                        property <length> vis-y: self.y + msg-list.viewport-y;
                        changed vis-y => {
                            if (self.vis-y <= contact-header.height + 6px && self.vis-y + self.height > contact-header.height + 6px) {
                                root.day-at-top(msg.dayFull);
                            }
                            root.row-geom(msg.id, self.vis-y / 1px, self.height / 1px);
                        }
                        changed y => {
                            if (self.vis-y <= contact-header.height + 6px && self.vis-y + self.height > contact-header.height + 6px) {
                                root.day-at-top(msg.dayFull);
                            }
                            root.row-geom(msg.id, self.vis-y / 1px, self.height / 1px);
                        }
                        changed height => {
                            root.row-geom(msg.id, self.vis-y / 1px, self.height / 1px);
                        }
                        // Pressing on the row's background and dragging
                        // sweeps whole messages into the selection, the way
                        // dragging over a page selects across bubbles.
                        row-hover := TouchArea {
                            // Hover probe for the action buttons and privacy
                            // reveal, and the background for drag-select.
                            // System rows keep it inert, as before.
                            enabled: msg.kind != "system";
                            mouse-cursor: default;
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                    root.drag-start(msg.id, msg-row.vis-y / 1px + self.pressed-y / 1px);
                                }
                                if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                                    root.drag-end();
                                }
                            }
                            moved => {
                                if (self.pressed) {
                                    root.drag-move(msg-row.vis-y / 1px + self.mouse-y / 1px);
                                }
                            }
                            double-clicked => {
                                if (!root.select-mode && !msg.deleted) {
                                    root.request-reply(msg.id);
                                    root.focus-composer();
                                }
                            }
                        }
                        if root.select-mode && msg.selected: Rectangle {
                            background: Theme.accent.with-alpha(0.14);
                        }
                        // One short flash on arrival, then a steady tint: a finite
                        // `animate`, never a per-frame redraw.
                        if root.highlight-id == msg.id: Rectangle {
                            property <bool> lit: false;
                            init => { self.lit = true; }
                            background: Theme.accent.with-alpha(self.lit ? 0.22 : 0.5);
                            animate background { duration: 700ms; easing: ease-out; }
                            border-radius: 10px;
                        }
                        // System notices: one centered pill, no bubble.
                        sys-pill := Rectangle {
                            property <bool> is-system: msg.kind == "system";
                            visible: self.is-system;
                            y: 6px + msg-row.day-offset;
                            x: (parent.width - self.width) / 2;
                            width: self.is-system
                                ? min(parent.width * 0.8, sys-text.preferred-width + 28px) : 0;
                            height: self.is-system ? sys-text.preferred-height + 12px : 0;
                            border-radius: 8px;
                            background: sys-touch.has-hover && msg.clickable ? Theme.selected : Theme.pill;
                            sys-touch := TouchArea {
                                accessible-role: button;
                                accessible-label: msg.text;
                                accessible-enabled: msg.clickable;
                                accessible-action-default => { if (msg.clickable) { root.notice-clicked(msg.id); } }
                                enabled: sys-pill.is-system;
                                mouse-cursor: msg.clickable ? pointer : default;
                                clicked => { if (msg.clickable) { root.notice-clicked(msg.id); } }
                                sys-key := KeyFocus {
                                    enabled: sys-pill.is-system && msg.clickable;
                                    activate => { if (msg.clickable) { root.notice-clicked(msg.id); } }
                                }
                                FocusRing {
                                    shown: sys-key.has-focus;
                                    width: parent.width;
                                    height: parent.height;
                                    border-radius: 8px;
                                }
                            }
                            sys-text := Text {
                                text: sys-pill.is-system ? msg.text : "";
                                animate opacity { duration: 120ms; easing: ease-out; }
                                color: msg.clickable ? Theme.accent : Theme.text-dim;
                                font-size: 12px;
                                wrap: word-wrap;
                                horizontal-alignment: center;
                                width: max(0px, parent.width - 28px);
                                x: 14px;
                                y: 6px;
                            }
                        }
                        if root.select-mode && msg.kind != "system": Rectangle {
                            x: 14px;
                            // Centred on short bubbles, pinned near the top of tall ones.
                            y: bubble.y + max(0px, min((bubble.height - self.height) / 2, 8px));
                            width: 20px;
                            height: 20px;
                            border-radius: 10px;
                            border-width: 2px;
                            border-color: msg.selected ? Theme.accent : Theme.text-dim;
                            background: msg.selected ? Theme.accent : transparent;
                            animate background, border-color { duration: 120ms; easing: ease-out; }
                            if msg.selected: Image {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                source: @image-url("../icons/check.svg");
                                colorize: white;
                                width: 13px;
                                height: 13px;
                            }
                        }
                        // A link card drives the bubble width, so the text
                        // wraps at the card instead of stretching past it on
                        // a wide window.
                        property <length> max-text-w: msg.hasLink
                            ? min(360px, max(120px, self.width * 0.65 - 44px))
                            : max(120px, self.width * 0.65 - 44px);
                        // Media drives the bubble width; the header and the
                        // caption wrap inside it instead of widening the bubble.
                        property <length> content-w:
                            msg.cardKind != "" ? min(360px, max-text-w)
                                : (msg.kind == "image" || msg.kind == "video") && msg.picW > 0
                                ? max(150px, msg.picW * 1px)
                                : max-text-w;
                        // Whether the time/ticks float on the last text line (text paths only).
                        property <bool> has-translation: root.can-translate(msg)
                            && (msg.translationText != "" || msg.translationBusy || msg.translationError != "");
                        property <bool> meta-inline:
                            msg.cardKind == "" && (msg.hasStyled || msg.kind == "text"
                                || ((msg.kind == "image" || msg.kind == "video") && msg.text != ""))
                            && (msg.text != "" || msg.deleted)
                            && !self.has-translation;
                        property <length> unread-offset: msg.unread-boundary ? 28px : 0;
                        property <length> day-offset: (msg.dayLabel != "" ? 40px : 0) + unread-offset + header-offset;
                        if msg.unread-boundary: Rectangle {
                            y: (msg.dayLabel != "" ? 40px : 0px) + msg-row.header-offset;
                            width: parent.width;
                            height: 28px;
                            HorizontalLayout {
                                padding-left: 20px;
                                padding-right: 20px;
                                spacing: 12px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    Rectangle {
                                        y: (parent.height - self.height) / 2;
                                        height: 1px;
                                        background: Theme.conversation-divider;
                                    }
                                }
                                Text {
                                    text: @tr("chat.unread.separator");
                                    color: Theme.text-dim;
                                    font-size: 11px;
                                    horizontal-stretch: 0;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    Rectangle {
                                        y: (parent.height - self.height) / 2;
                                        height: 1px;
                                        background: Theme.conversation-divider;
                                    }
                                }
                            }
                        }
                        property <length> message-height: msg.kind == "system"
                            ? sys-pill.height + 12px + self.day-offset
                            : bubble.height + translation-card.height + (msg.firstOfRun ? 16px : 6px)
                                + (msg.reactions != "" ? 14px : 0) + self.day-offset;
                        height: self.message-height + (i == root.messages.length - 1
                            ? msg-list.typing-space + root.composer-tail-space : 0px);
                        if i == root.messages.length - 1 && msg-list.typing-space > 0px: TypingBubbles {
                            x: 48px + (root.select-mode ? 30px : 0px);
                            y: msg-row.message-height + 4px;
                            members: root.typing-members;
                            extra: root.typing-extra;
                            privacy-blurred: root.blur-photos;
                        }
                        if msg.dayLabel != "": Rectangle {
                            y: 8px + msg-row.header-offset;
                            x: (parent.width - self.width) / 2;
                            width: day-text.preferred-width + 24px;
                            height: 24px;
                            border-radius: 12px;
                            background: Theme.day-bg;
                            border-width: 1px;
                            border-color: Theme.day-border;
                            day-text := Text {
                                text: msg.dayLabel;
                                color: Theme.text-dim;
                                font-size: 11px;
                                width: parent.width;
                                height: parent.height;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        if msg.showAvatar: Avatar {
                            width: 28px;
                            height: 28px;
                            privacy-blurred: root.blur-photos;
                            privacy-reveal: row-hover.has-hover;
                            demo-reveal: root.demo-hover && root.demo-hover-x > 440px;
                            x: root.select-mode ? 42px : 12px;
                            animate x { duration: 140ms; easing: ease-out; }
                            y: (msg.firstOfRun ? 12px : 3px) + msg-row.day-offset;
                            src: msg.senderAvatar;
                            has-image: msg.senderHasAvatar;
                            initial: msg.senderInitial;
                            color-idx: msg.senderColorIdx;
                        }
                        bubble := Rectangle {
                            visible: msg.kind != "system";
                            y: (msg.firstOfRun ? 12px : 3px) + msg-row.day-offset;
                            x: msg.fromMe
                                ? parent.width - self.width - 30px
                                : (msg.groupIndent ? 48px : 30px) + (root.select-mode ? 30px : 0px);
                            animate x { duration: 140ms; easing: ease-out; }
                            width: msg.kind == "system" ? 0 : max(content.preferred-width,
                                msg-row.has-translation ? min(msg-row.content-w + 24px,
                                    max(260px, translation-measure.preferred-width + 52px)) : 0px);
                            height: msg.kind == "system" ? 0 : content.preferred-height;
                            background: msg.sticker
                                ? transparent
                                : (msg.fromMe ? Theme.bubble-out : Theme.bubble-in);
                            border-radius: msg-row.has-translation ? 11px : 10px;
                            border-width: Theme.glass && !msg.sticker ? 1px : 0px;
                            border-color: Theme.bubble-rim;
                            translation-measure := Text {
                                text: msg.translationText;
                                font-size: 14px;
                                visible: false;
                                width: 0px;
                                height: 0px;
                            }
                            num-measure := Text {
                                text: msg.senderNumber;
                                font-size: 11px;
                                visible: false;
                                width: 0px;
                                height: 0px;
                            }
                            if msg.showSender && msg.senderNumber != "" && !msg-row.has-translation: Text {
                                text: msg.senderNumber;
                                font-size: 11px;
                                color: Theme.text-dim;
                                x: parent.width - self.width - 9px;
                                y: 7px;
                            }
                            TouchArea {
                                enabled: !root.select-mode && !msg.deleted;
                                double-clicked => {
                                    root.request-reply(msg.id);
                                    root.focus-composer();
                                }
                            }
                            content := VerticalLayout {
                                padding: 7px;
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 2px;

                                if msg.showSender: HorizontalLayout {
                                    spacing: 8px;
                                    sender-touch := TouchArea {
                                        accessible-role: button;
                                        accessible-label: @tr("accessibility.message_sender", msg.senderLabel);
                                        accessible-action-default => { root.open-dm(msg.senderJid); }
                                        width: sender-text.width;
                                        horizontal-stretch: msg-row.has-translation ? 0 : 1;
                                        height: sender-text.preferred-height;
                                        mouse-cursor: pointer;
                                        clicked => { root.open-dm(msg.senderJid); }
                                        sender-text := Text {
                                            text: msg.senderLabel;
                                            animate opacity { duration: 120ms; easing: ease-out; }
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: Theme.sender;
                                            width: min(self.preferred-width,
                                                msg-row.content-w - 26px
                                                    - (msg.senderNumber != ""
                                                        ? num-measure.preferred-width + 24px
                                                        : 0px));
                                            overflow: elide;
                                        }
                                        sender-key := KeyFocus {
                                            activate => { root.open-dm(msg.senderJid); }
                                        }
                                    }
                                    if msg.senderNumber != "" && msg-row.has-translation: Text {
                                        text: msg.senderNumber;
                                        font-size: 11px;
                                        color: Theme.text-dim;
                                        width: num-measure.preferred-width;
                                        horizontal-stretch: 0;
                                        vertical-alignment: center;
                                    }
                                    if msg.senderNumber != "" && !msg-row.has-translation: Rectangle {
                                        width: num-measure.preferred-width + 24px;
                                    }
                                    if msg-row.has-translation: Rectangle { horizontal-stretch: 1; }
                                }

                                if msg.hasQuote && !msg.deleted: Rectangle {
                                    height: quote-col.preferred-height;
                                    border-radius: 4px;
                                    background: msg.fromMe ? #00000014 : #00000010;
                                    clip: true;
                                    quote-touch := TouchArea {
                                        accessible-role: button;
                                        accessible-label: @tr("accessibility.go_to_quoted");
                                        accessible-action-default => { root.open-quote(msg.quoteJid, msg.quoteId); }
                                        mouse-cursor: pointer;
                                        clicked => { root.open-quote(msg.quoteJid, msg.quoteId); }
                                        quote-key := KeyFocus {
                                            activate => { root.open-quote(msg.quoteJid, msg.quoteId); }
                                        }
                                        FocusRing {
                                            shown: quote-key.has-focus;
                                            width: parent.width;
                                            height: parent.height;
                                            border-radius: 4px;
                                        }
                                    }
                                    Rectangle {
                                        x: 0;
                                        width: 4px;
                                        height: parent.height;
                                        background: Theme.accent;
                                    }
                                    quote-col := VerticalLayout {
                                        padding: 6px;
                                        padding-left: 12px;
                                        spacing: 2px;
                                        Text {
                                            text: msg.quoteName;
                                            animate opacity { duration: 120ms; easing: ease-out; }
                                            color: Theme.accent;
                                            font-size: 12px;
                                            font-weight: 700;
                                            overflow: elide;
                                            width: min(self.preferred-width,
                                                msg-row.content-w - 20px);
                                        }
                                        Text {
                                            text: msg.quoteText;
                                            animate opacity { duration: 120ms; easing: ease-out; }
                                            color: Theme.text-dim;
                                            font-size: 12.5px;
                                            overflow: elide;
                                            width: min(self.preferred-width,
                                                msg-row.content-w - 20px);
                                        }
                                    }
                                }

                                if msg.forwarded && !msg.deleted: HorizontalLayout {
                                    spacing: 4px;
                                    alignment: start;
                                    Image {
                                        source: @image-url("../icons/corner-up-right.svg");
                                        colorize: Theme.text-dim;
                                        width: 12px;
                                        height: 12px;
                                        y: 1px;
                                    }
                                    Text {
                                        text: @tr("message.forwarded.label");
                                        font-size: 11px;
                                        font-italic: true;
                                        color: Theme.text-dim;
                                    }
                                }

                                // "Apply deletions" is off: the sender took
                                // this back but the message was kept, so a
                                // small indicator is all that changes.
                                if msg.revoked && !msg.deleted: HorizontalLayout {
                                    spacing: 4px;
                                    alignment: start;
                                    Image {
                                        source: @image-url("../icons/trash.svg");
                                        colorize: Theme.text-dim;
                                        width: 12px;
                                        height: 12px;
                                        y: 1px;
                                    }
                                    Text {
                                        text: @tr("message.deleted_by_sender");
                                        font-size: 11px;
                                        font-italic: true;
                                        color: Theme.text-dim;
                                    }
                                }

                                if (msg.kind == "image" || msg.kind == "video") && !msg.mediaReady: MediaPlaceholder {
                                    width: msg.picW * 1px;
                                    height: msg.picH * 1px;
                                    preview: msg.picture;
                                    privacy-blurred: root.blur-media;
                                    sticker: msg.sticker;
                                    video: msg.kind == "video";
                                    file-size: msg.mediaSize;
                                    loading: msg.mediaLoading;
                                    progress: msg.mediaProgress;
                                    clicked => { root.download-media(msg.id); }
                                }
                                if msg.kind == "video" && msg.mediaReady && msg.picW > 0: TouchArea {
                                    accessible-role: button;
                                    accessible-label: @tr("accessibility.open_video");
                                    accessible-action-default => { root.open-video(msg.id); }
                                    property <bool> media-hover: self.has-hover;
                                    width: msg.picW * 1px;
                                    height: msg.picH * 1px;
                                    mouse-cursor: pointer;
                                    clicked => { root.open-video(msg.id); }
                                    Rectangle {
                                        border-radius: 6px;
                                        clip: true;
                                        background: black;
                                        Image {
                                            source: msg.picture;
                                            width: parent.width;
                                            height: parent.height;
                                            image-fit: cover;

                                            animate opacity { duration: 120ms; easing: ease-out; }
                                        }
                                        if root.blur-media && !media-hover && !(root.demo-hover && root.demo-hover-x > 440px && root.demo-hover-x < 1440px && root.demo-hover-y > 80px): PrivacyVeil {
                                            width: parent.width;
                                            height: parent.height;
                                            radius: 6px;
                                            blur: 20px;
                                            tint: Theme.well;
                                        }
                                    }
                                    if msg.videoLen != "": Rectangle {
                                        x: 8px;
                                        y: parent.height - self.height - 8px;
                                        width: len-row.preferred-width + 12px;
                                        height: 20px;
                                        border-radius: 10px;
                                        background: Theme.media-chip;
                                        len-row := HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            spacing: 4px;
                                            Image {
                                                source: @image-url("../icons/video.svg");
                                                colorize: white;
                                                width: 12px;
                                                height: 12px;
                                                y: (parent.height - self.height) / 2;
                                            }
                                            Text {
                                                text: msg.videoLen;
                                                color: white;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    // GIF badge, shown while the clip rests.
                                    if msg.gif && !msg.playing: Rectangle {
                                        x: 8px;
                                        y: parent.height - self.height - 8px;
                                        width: gif-label.preferred-width + 12px;
                                        height: 20px;
                                        border-radius: 4px;
                                        background: Theme.media-chip;
                                        gif-label := Text {
                                            text: "GIF";
                                            color: white;
                                            font-size: 11px;
                                            font-weight: 700;
                                            width: parent.width;
                                            height: parent.height;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    if !msg.gif: Rectangle {
                                        width: 56px;
                                        height: 56px;
                                        border-radius: 28px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        background: Theme.media-chip;
                                        Image {
                                            source: @image-url("../icons/player-play.svg");
                                            colorize: white;
                                            width: 28px;
                                            height: 28px;
                                            x: 15px;
                                            y: 14px;
                                        }
                                    }
                                    video-key := KeyFocus {
                                        activate => { root.open-video(msg.id); }
                                    }
                                    FocusRing {
                                        shown: video-key.has-focus;
                                        width: parent.width;
                                        height: parent.height;
                                        border-radius: 6px;
                                    }
                                }
                                if msg.kind == "image" && msg.mediaReady: TouchArea {
                                    accessible-role: button;
                                    accessible-label: @tr("accessibility.open_image");
                                    accessible-action-default => { root.open-lightbox(msg.id); }
                                    property <bool> media-hover: self.has-hover;
                                    width: msg.picW * 1px;
                                    height: msg.picH * 1px;
                                    mouse-cursor: pointer;
                                    clicked => { root.open-lightbox(msg.id); }
                                    Image {
                                        source: msg.picture;
                                        width: parent.width;
                                        height: parent.height;
                                        animate opacity { duration: 120ms; easing: ease-out; }
                                    }
                                    if root.blur-media && !media-hover && !(root.demo-hover && root.demo-hover-x > 440px && root.demo-hover-y > 80px): PrivacyVeil {
                                        width: parent.width;
                                        height: parent.height;
                                        radius: 6px;
                                        blur: 24px;
                                        tint: Theme.well;
                                    }
                                    image-key := KeyFocus {
                                        activate => { root.open-lightbox(msg.id); }
                                    }
                                    FocusRing {
                                        shown: image-key.has-focus;
                                        width: parent.width;
                                        height: parent.height;
                                        border-radius: 6px;
                                    }
                                }


                                    if msg.cardKind != "": SpecialMessage {
                                    width: msg-row.content-w;
                                    message: msg;
                                    privacy-hidden: (root.blur-messages || (root.blur-names && msg.cardKind == "contact") || (root.blur-media && (msg.cardKind == "location" || msg.cardKind == "live-location"))) && !row-hover.has-hover;
                                    details => { root.message-action(msg.id, "details"); }
                                    vote(i) => { root.poll-vote(msg.id, i); }
                                }

                                if msg.kind == "doc": VerticalLayout {
                                    spacing: 6px;
                                    Rectangle {
                                        height: 52px;
                                        border-radius: 6px;
                                        background: msg.fromMe ? #00000014 : #00000010;
                                        doc-touch := TouchArea {
                                            accessible-role: button;
                                            accessible-label: @tr("accessibility.open_document", msg.text);
                                            accessible-action-default => { root.doc-view(msg.id); }
                                            mouse-cursor: pointer;
                                            clicked => { root.doc-view(msg.id); }
                                        }
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 12px;
                                            spacing: 8px;
                                            VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    property <bool> sheet: msg.documentType == "XLS" || msg.documentType == "XLSX" || msg.documentType == "CSV" || msg.documentType == "ODS";
                                                    property <bool> slides: msg.documentType == "PPT" || msg.documentType == "PPTX" || msg.documentType == "ODP";
                                                    property <bool> archive: msg.documentType == "ZIP" || msg.documentType == "RAR" || msg.documentType == "7Z" || msg.documentType == "GZ" || msg.documentType == "TAR";
                                                    width: 38px;
                                                    height: 42px;
                                                    border-radius: 8px;
                                                    background: msg.documentType == "PDF" ? #fa5252
                                                        : self.sheet ? #0cba68
                                                        : self.slides ? #ef8534
                                                        : self.archive ? #9671d5
                                                        : msg.documentType == "DOC" || msg.documentType == "DOCX" || msg.documentType == "ODT" ? #4285e0 : #718894;
                                                    Image {
                                                        source: parent.archive ? @image-url("../icons/archive.svg")
                                                            : parent.sheet ? @image-url("../icons/list-details.svg")
                                                            : @image-url("../icons/file-text.svg");
                                                        colorize: white;
                                                        width: 22px;
                                                        height: 22px;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 4px;
                                                Text {
                                                    text: msg.text;
                                                    animate opacity { duration: 120ms; easing: ease-out; }
                                                    color: Theme.bubble-text;
                                                    font-size: 13px;
                                                    overflow: elide;
                                                    width: min(max(self.preferred-width, 180px), msg-row.max-text-w - 68px);
                                                }
                                                Text {
                                                    text: (msg.mediaSize != "" ? msg.mediaSize + " · " : "") + msg.documentType;
                                                    color: msg.fromMe ? Theme.time-out : Theme.text-dim;
                                                    font-size: 11px;
                                                }
                                            }
                                        }
                                    }
                                    // WhatsApp's two actions under a file.
                                    HorizontalLayout {
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            height: 30px;
                                            view-touch := TouchArea {
                                                accessible-role: button;
                                                accessible-label: msg.mediaReady ? @tr("media.action.view") : @tr("media.action.download");
                                                accessible-action-default => { root.doc-view(msg.id); }
                                                mouse-cursor: pointer;
                                                clicked => { root.doc-view(msg.id); }
                                                view-key := KeyFocus {
                                                    activate => { root.doc-view(msg.id); }
                                                }
                                            }
                                            Text {
                                                text: msg.mediaReady ? @tr("media.action.view") : @tr("media.action.download");
                                                color: msg.mediaReady ? (msg.fromMe ? Theme.bubble-action : Theme.accent-text) : (msg.fromMe ? Theme.time-out : Theme.text-dim);
                                                font-size: 13px;
                                                font-weight: 700;
                                                width: parent.width;
                                                height: parent.height;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Rectangle { width: 1px; height: 30px; background: Theme.border; }
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            height: 30px;
                                            save-touch := TouchArea {
                                                accessible-role: button;
                                                accessible-label: @tr("file.action.save_as");
                                                accessible-enabled: msg.mediaReady;
                                                accessible-action-default => { root.doc-save(msg.id); }
                                                mouse-cursor: pointer;
                                                enabled: msg.mediaReady;
                                                clicked => { root.doc-save(msg.id); }
                                                save-key := KeyFocus {
                                                    enabled: msg.mediaReady;
                                                    activate => { root.doc-save(msg.id); }
                                                }
                                            }
                                            Text {
                                                text: @tr("file.action.save_as");
                                                color: msg.mediaReady ? (msg.fromMe ? Theme.bubble-action : Theme.accent-text) : (msg.fromMe ? Theme.time-out : Theme.text-dim);
                                                font-size: 13px;
                                                font-weight: 700;
                                                width: parent.width;
                                                height: parent.height;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                // Voice-note player: waveform track, played
                                // portion clipped over it, click to seek.
                                if msg.kind == "audio" && !msg.voiceMessage: VerticalLayout {
                                    spacing: 10px;
                                    HorizontalLayout {
                                        spacing: 10px;
                                        Rectangle {
                                            width: 36px;
                                            height: 36px;
                                            border-radius: 10px;
                                            background: #00000018;
                                            Image {
                                                source: @image-url("../icons/music.svg");
                                                colorize: Theme.icon;
                                                width: 20px;
                                                height: 20px;
                                                x: 8px;
                                                y: 8px;
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 3px;
                                            Text {
                                                text: msg.audioFilename;
                                                width: 230px;
                                                overflow: elide;
                                                color: Theme.bubble-text;
                                                font-size: 13px;
                                                font-weight: 600;
                                            }
                                            Text {
                                                text: @tr("media.type.audio") + " · " + msg.text;
                                                color: msg.fromMe ? Theme.time-out : Theme.text-dim;
                                                font-size: 11px;
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        IconButton {
                                            label: msg.playing ? @tr("accessibility.pause") : @tr("accessibility.play");
                                            width: 34px;
                                            height: 34px;
                                            icon-size: 20px;
                                            icon: msg.playing ? @image-url("../icons/player-pause.svg") : @image-url("../icons/player-play.svg");
                                            clicked => { root.audio-toggle(msg.id); }
                                        }
                                        audio-track := TouchArea {
                                            accessible-role: slider;
                                            accessible-label: @tr("accessibility.playback_position");
                                            accessible-value: round(msg.progress * 100) + "%";
                                            accessible-action-increment => { root.audio-seek(msg.id, min(1, msg.progress + 0.1)); }
                                            accessible-action-decrement => { root.audio-seek(msg.id, max(0, msg.progress - 0.1)); }
                                            width: 194px;
                                            height: 34px;
                                            mouse-cursor: pointer;
                                            clicked => { root.audio-seek(msg.id, self.mouse-x / self.width); }
                                            Rectangle {
                                                width: parent.width;
                                                height: 4px;
                                                y: 15px;
                                                border-radius: 2px;
                                                background: Theme.media-track;
                                                Rectangle {
                                                    width: parent.width * msg.progress;
                                                    height: parent.height;
                                                    border-radius: 2px;
                                                    background: Theme.read;
                                                }
                                            }
                                        }
                                        Text {
                                            text: msg.posLabel != "" ? msg.posLabel : "0:00";
                                            width: 38px;
                                            height: 34px;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                            color: msg.fromMe ? Theme.time-out : Theme.text-dim;
                                            font-size: 11px;
                                        }
                                    }
                                    HorizontalLayout {
                                        alignment: end;
                                        BubbleMeta {
                                            time: msg.time;
                                            ticks: msg.ticks;
                                            blue: msg.ticksBlue;
                                            fromMe: msg.fromMe;
                                        }
                                    }
                                }
                                if msg.kind == "audio" && msg.voiceMessage: HorizontalLayout {
                                    spacing: 10px;
                                    VerticalLayout {
                                        alignment: center;
                                        IconButton {
                                            label: msg.playing ? @tr("accessibility.pause") : @tr("accessibility.play");
                                            icon: msg.playing
                                                ? @image-url("../icons/player-pause.svg")
                                                : @image-url("../icons/player-play.svg");
                                            icon-size: 20px;
                                            clicked => { root.audio-toggle(msg.id); }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 3px;
                                        wave-area := TouchArea {
                                            accessible-role: slider;
                                            accessible-label: @tr("accessibility.playback_position");
                                            accessible-value: round(msg.progress * 100) + "%";
                                            accessible-action-increment => { root.audio-seek(msg.id, min(1, msg.progress + 0.1)); }
                                            accessible-action-decrement => { root.audio-seek(msg.id, max(0, msg.progress - 0.1)); }
                                            width: 220px;
                                            height: 30px;
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.audio-seek(msg.id,
                                                    self.mouse-x / self.width);
                                            }
                                            if msg.hasWave: Image {
                                                source: msg.wave;
                                                colorize: msg.fromMe
                                                    ? #9fd3c7 : Theme.text-dim;
                                                x: 0;
                                                y: 0;
                                                width: parent.width;
                                                height: parent.height;
                                                image-fit: fill;
                                            }
                                            // Played portion: same bitmap in the
                                            // accent color, clipped from the left.
                                            if msg.hasWave: Rectangle {
                                                x: 0;
                                                y: 0;
                                                width: parent.width * msg.progress;
                                                height: parent.height;
                                                clip: true;
                                                Image {
                                                    source: msg.wave;
                                                    colorize: Theme.read;
                                                    x: 0;
                                                    y: 0;
                                                    width: wave-area.width;
                                                    height: wave-area.height;
                                                    image-fit: fill;
                                                }
                                            }
                                            if !msg.hasWave: Rectangle {
                                                width: parent.width;
                                                height: 3px;
                                                y: 14px;
                                                border-radius: 1.5px;
                                                background: Theme.text-dim;
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Text {
                                                text: msg.playing && msg.posLabel != ""
                                                    ? msg.posLabel : msg.text;
                                                color: msg.fromMe ? Theme.time-out : Theme.text-dim;
                                                font-size: 11px;
                                                horizontal-stretch: 1;
                                            }
                                            if msg.ticks != "": Ticks { ticks: msg.ticks; blue: msg.ticksBlue; }
                                            Text {
                                                text: msg.time;
                                                font-size: 10px;
                                                color: msg.fromMe ? Theme.time-out : Theme.text-dim;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 38px;
                                            height: 38px;
                                            if !msg.playing: Avatar {
                                                width: 38px;
                                                height: 38px;
                                                src: msg.voiceAvatar;
                                                has-image: msg.voiceHasAvatar;
                                                initial: msg.voiceInitial;
                                                color-idx: msg.voiceColorIdx;
                                            }
                                            if !msg.playing: Image {
                                                source: @image-url("../icons/microphone.svg");
                                                colorize: Theme.read;
                                                width: 15px;
                                                height: 15px;
                                                x: parent.width - self.width;
                                                y: parent.height - self.height;
                                            }
                                            if msg.playing: Rectangle {
                                                width: rate-label.preferred-width + 16px;
                                                height: 24px;
                                                x: parent.width - self.width;
                                                y: (parent.height - self.height) / 2;
                                                border-radius: 12px;
                                                background: rate-touch.has-hover
                                                    ? #00000030 : #00000018;
                                                rate-touch := TouchArea {
                                                    accessible-role: button;
                                                    accessible-label: @tr("accessibility.playback_rate", root.audio-rate-label);
                                                    accessible-action-default => { root.audio-cycle-rate(); }
                                                    mouse-cursor: pointer;
                                                    clicked => { root.audio-cycle-rate(); }
                                                    rate-key := KeyFocus {
                                                        activate => { root.audio-cycle-rate(); }
                                                    }
                                                    FocusRing {
                                                        shown: rate-key.has-focus;
                                                        width: parent.width;
                                                        height: parent.height;
                                                        border-radius: 12px;
                                                    }
                                                }
                                                rate-label := Text {
                                                    text: root.audio-rate-label;
                                                    color: Theme.text-dim;
                                                    font-size: 11px;
                                                    font-weight: 700;
                                                }
                                            }
                                        }
                                    }
                                }

                                if msg.hasLink: Rectangle {
                                    property <length> card-w: msg-row.max-text-w;
                                    property <bool> large-image: msg.hasLinkThumb && msg.hasLinkOg;
                                    property <bool> favicon: msg.hasLinkThumb && !msg.hasLinkOg;
                                    property <length> img-h: large-image ? card-w * 0.525 : 0px;
                                    property <length> text-x: favicon ? 76px : 10px;
                                    property <length> text-w: max(24px, card-w - text-x - 10px);
                                    property <length> title-h: msg.linkTitle != ""
                                        ? min(38px, link-title.preferred-height) + 4px : 0px;
                                    property <length> desc-h: msg.linkDesc != ""
                                        ? min(48px, link-desc.preferred-height) + 4px : 0px;
                                    property <length> host-h: msg.linkHost != "" ? 17px : 0px;
                                    property <length> body-h: max(favicon ? 56px : 0px,
                                        title-h + desc-h + host-h) + 20px;
                                    width: card-w;
                                    height: img-h + body-h;
                                    horizontal-stretch: 0;
                                    vertical-stretch: 0;
                                    border-radius: 6px;
                                    clip: true;
                                    background: msg.fromMe ? #ffffff14 : #00000014;

                                    if msg.hasLinkThumb: Rectangle {
                                        x: parent.large-image ? 0px : 10px;
                                        y: parent.large-image ? 0px : 10px;
                                        width: parent.large-image ? parent.width : 56px;
                                        height: parent.large-image ? parent.img-h : 56px;
                                        border-radius: parent.large-image ? 0px : 6px;
                                        clip: true;
                                        Image {
                                            source: msg.linkThumb;
                                            width: parent.width;
                                            height: parent.height;
                                            image-fit: msg.hasLinkOg ? cover : contain;
                                        }
                                        if root.blur-media && !row-hover.has-hover: PrivacyVeil {
                                            width: parent.width;
                                            height: parent.height;
                                            blur: 20px;
                                            tint: Theme.well;
                                        }
                                    }
                                    link-title := Text {
                                        text: msg.linkTitle;
                                        visible: msg.linkTitle != "";
                                        color: Theme.bubble-text;
                                        font-size: 13px;
                                        font-weight: 700;
                                        wrap: word-wrap;
                                        overflow: elide;
                                        x: parent.text-x;
                                        y: parent.img-h + 10px;
                                        width: parent.text-w;
                                        height: max(0px, parent.title-h - 4px);
                                    }
                                    link-desc := Text {
                                        text: msg.linkDesc;
                                        visible: msg.linkDesc != "";
                                        color: Theme.text-dim;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                        overflow: elide;
                                        x: parent.text-x;
                                        y: parent.img-h + parent.title-h + 10px;
                                        width: parent.text-w;
                                        height: max(0px, parent.desc-h - 4px);
                                    }
                                    Text {
                                        text: msg.linkHost;
                                        color: Theme.text-dim;
                                        font-size: 11px;
                                        overflow: elide;
                                        x: parent.text-x;
                                        y: parent.img-h + parent.title-h + parent.desc-h + 10px;
                                        width: parent.text-w;
                                        height: parent.host-h;
                                    }
                                    TouchArea {
                                        accessible-role: button;
                                        accessible-label: msg.linkTitle != "" ? msg.linkTitle : msg.linkHost;
                                        accessible-action-default => { root.open-dm(msg.linkUrl); }
                                        mouse-cursor: pointer;
                                        clicked => { root.open-dm(msg.linkUrl); }
                                        link-key := KeyFocus {
                                            activate => { root.open-dm(msg.linkUrl); }
                                        }
                                    }
                                }

                                // Formatted text (bold/italic/strike/mono).
                                // The bubble's own context menu (below)
                                // handles right-clicks: StyledText swallows
                                // every press, so a menu wrapped around it
                                // never saw them.
                                // StyledText cannot select text, so a
                                // transparent TextInput with the same
                                // words lies over it: it owns the mouse
                                // (drag to select, Ctrl+C), and a click
                                // that moves nothing is a link click,
                                // resolved by the host from the offset.
                                if msg.hasStyled: Rectangle {
                                    width: styled-body.width;
                                    height: styled-body.preferred-height;
                                    for span in msg.links: Rectangle {
                                        width: parent.width;
                                        height: parent.height;
                                        visible: span.mention;
                                        property <length> sx;
                                        property <length> sy;
                                        property <length> ex;
                                        property <length> ey;
                                        property <bool> at-end;
                                        property <length> line-h: mention-line.preferred-height;
                                        property <bool> one-line: abs((self.ey - self.sy) / 1px) < 2;
                                        property <string> source: msg.plain;
                                        property <int> start: span.start;
                                        property <int> end: span.end;
                                        function measure() {
                                            if (span.mention) {
                                                self.at-end = false;
                                                mention-probe.set-selection-offsets(self.start, self.start);
                                                self.at-end = true;
                                                mention-probe.set-selection-offsets(self.end, self.end);
                                            }
                                        }
                                        init => { self.measure(); }
                                        changed source => { self.measure(); }
                                        changed width => { self.measure(); }
                                        changed height => { self.measure(); }
                                        changed start => { self.measure(); }
                                        changed end => { self.measure(); }
                                        Timer {
                                            interval: 30ms;
                                            running: true;
                                            triggered => { self.running = false; parent.measure(); }
                                        }
                                        mention-line := Text {
                                            text: "Ag";
                                            font-size: 14px;
                                            font-weight: 700;
                                            visible: false;
                                        }
                                        mention-probe := TextInput {
                                            text: msg.plain;
                                            width: parent.width;
                                            height: parent.height;
                                            font-size: 14px;
                                            font-weight: 700;
                                            single-line: false;
                                            wrap: word-wrap;
                                            visible: false;
                                            enabled: false;
                                            read-only: true;
                                            cursor-position-changed(pos) => {
                                                if (parent.at-end) {
                                                    parent.ex = pos.x;
                                                    parent.ey = pos.y;
                                                } else {
                                                    parent.sx = pos.x;
                                                    parent.sy = pos.y;
                                                }
                                            }
                                        }
                                        Rectangle {
                                            x: parent.sx;
                                            y: parent.sy - 1px;
                                            width: max(0px, (parent.one-line ? parent.ex : parent.width) - parent.sx);
                                            height: parent.line-h + 2px;
                                            border-radius: 7px;
                                            background: #4cbb7b40;
                                        }
                                        Rectangle {
                                            visible: !parent.one-line && parent.ey - parent.sy > parent.line-h * 1.5;
                                            y: parent.sy + parent.line-h - 1px;
                                            width: parent.width;
                                            height: max(0px, parent.ey - parent.sy - parent.line-h + 2px);
                                            border-radius: 7px;
                                            background: #4cbb7b40;
                                        }
                                        Rectangle {
                                            visible: !parent.one-line;
                                            y: parent.ey - 1px;
                                            width: max(0px, parent.ex);
                                            height: parent.line-h + 2px;
                                            border-radius: 7px;
                                            background: #4cbb7b40;
                                        }
                                    }
                                    styled-body := StyledText {
                                        text: msg.styled;
                                        animate opacity { duration: 120ms; easing: ease-out; }
                                        default-color: Theme.bubble-text;
                                        default-font-size: 14px;
                                        link-color: Theme.accent;
                                        width: min(self.preferred-width, msg-row.content-w);
                                    }
                                    stamp-in := Rectangle {
                                        visible: msg-row.meta-inline;
                                        width: stamp-lay.preferred-width;
                                        height: stamp-lay.preferred-height;
                                        x: bubble.width - 24px - stamp-lay.preferred-width;
                                        y: parent.height - stamp-lay.preferred-height - 1px;
                                        stamp-lay := HorizontalLayout {
                                            BubbleMeta {
                                                time: msg.time;
                                                ticks: msg.ticks;
                                                blue: msg.ticksBlue;
                                                fromMe: msg.fromMe;
                                            }
                                        }
                                    }
                                    sel-overlay := TextInput {
                                        accessible-role: none;
                                        text: msg.plain;
                                        read-only: true;
                                        single-line: false;
                                        wrap: word-wrap;
                                        font-size: 14px;
                                        // Not fully transparent: the renderer
                                        // skips a TextInput whose color has no
                                        // alpha, selection highlight included.
                                        color: #00000001;
                                        selection-background-color: Theme.selection;
                                        selection-foreground-color: white;
                                        width: parent.width;
                                        height: parent.height;
                                        // Slint moves the cursor for more
                                        // than clicks: a recycled row gets
                                        // new text and the cursor is clamped
                                        // to it, and arrow keys walk it. A
                                        // link opens only for a press that
                                        // lands on the text it was seen on.
                                        property <string> seen-text;
                                        property <bool> key-down: false;
                                        init => { self.seen-text = self.text; }
                                        cursor-position-changed(pos) => {
                                            link-click.running = false;
                                            if (self.text != self.seen-text) {
                                                self.seen-text = self.text;
                                            } else if (self.has-focus && !self.key-down
                                                    && self.anchor-position-byte-offset
                                                        == self.cursor-position-byte-offset) {
                                                link-click.running = true;
                                            }
                                        }
                                        key-pressed(event) => { self.key-down = true; reject }
                                        key-released(event) => { self.key-down = false; reject }
                                    }
                                    for span in msg.links: LinkHover {
                                        width: parent.width;
                                        height: parent.height;
                                        text: msg.plain;
                                        start: span.start;
                                        end: span.end;
                                        pass-through: root.link-press-through || root.select-mode;
                                        press(x, y) => {
                                            root.link-release-seen = false;
                                            root.link-pressed(x, y);
                                        }
                                        release => { root.link-release-seen = true; }
                                    }
                                    // A press that is still a click (no drag
                                    // moved the cursor away from the anchor)
                                    // once a double-click would have shown up.
                                    link-click := Timer {
                                        interval: 220ms;
                                        running: false;
                                        triggered => {
                                            self.running = false;
                                            if (sel-overlay.has-focus
                                                && sel-overlay.anchor-position-byte-offset
                                                    == sel-overlay.cursor-position-byte-offset) {
                                                root.open-link-at(msg.id, sel-overlay.cursor-position-byte-offset);
                                            }
                                        }
                                    }
                                }

                                if msg.cardKind == "" && !msg.hasStyled && (msg.kind == "text" || ((msg.kind == "image" || msg.kind == "video") && msg.text != "")): Rectangle {
                                    width: min(plain-text.preferred-width, msg-row.content-w);
                                    height: plain-text.preferred-height;
                                    plain-text := TextInput {
                                        accessible-role: none;
                                        text: (msg.deleted ? "🚫 " + msg.text : msg.text)
                                            + (msg-row.meta-inline ? "\u{A0}\u{A0}\u{A0}\u{A0}\u{A0}\u{A0}\u{A0}\u{A0}\u{A0}\u{A0}\u{A0}\u{A0}\u{A0}\u{A0}" : "");
                                        animate opacity { duration: 120ms; easing: ease-out; }
                                        read-only: true;
                                        single-line: false;
                                        wrap: word-wrap;
                                        font-size: 14px;
                                        font-italic: msg.deleted;
                                        color: msg.deleted ? Theme.text-dim : Theme.bubble-text;
                                        selection-background-color: Theme.selection;
                                        selection-foreground-color: white;
                                        // captions wrap to the image width
                                        width: parent.width;
                                        height: self.preferred-height;
                                    }
                                    stamp-in2 := Rectangle {
                                        visible: msg-row.meta-inline;
                                        width: stamp-lay2.preferred-width;
                                        height: stamp-lay2.preferred-height;
                                        x: bubble.width - 24px - stamp-lay2.preferred-width;
                                        y: parent.height - stamp-lay2.preferred-height - 1px;
                                        stamp-lay2 := HorizontalLayout {
                                            BubbleMeta {
                                                time: msg.time;
                                                ticks: msg.ticks;
                                                blue: msg.ticksBlue;
                                                fromMe: msg.fromMe;
                                            }
                                        }
                                    }
                                }

                                // Stickers have no bubble, so the timestamp
                                // gets its own pill like WhatsApp draws it,
                                // with breathing room under the artwork.
                                if msg.sticker: Rectangle { height: 6px; }
                                if msg.kind != "audio" && msg.kind != "system" && !msg-row.meta-inline: HorizontalLayout {
                                    alignment: end;
                                    spacing: msg-row.has-translation ? 8px : 0px;
                                    Rectangle {
                                        width: stamp.preferred-width + (msg.sticker ? 14px : 0);
                                        height: msg-row.has-translation ? 26px : msg.sticker ? 20px : stamp.preferred-height;
                                        border-radius: 10px;
                                        background: msg.sticker
                                            ? (msg.fromMe ? Theme.bubble-out : Theme.bubble-in)
                                            : transparent;
                                        stamp := HorizontalLayout {
                                            spacing: 4px;
                                            padding-top: msg-row.has-translation ? 12px : 0px;
                                            padding-left: msg.sticker ? 7px : 0;
                                            padding-right: msg.sticker ? 7px : 0;
                                            if msg.ticks != "": Ticks { ticks: msg.ticks; blue: msg.ticksBlue; }
                                            Text {
                                                text: msg.time;
                                                font-size: 10px;
                                                color: msg.fromMe ? Theme.time-out : Theme.text-dim;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    if msg-row.has-translation: IconButton {
                                        label: @tr("chat.message.translate");
                                        width: 26px;
                                        height: 26px;
                                        radius: 6px;
                                        icon: @image-url("../icons/translate.svg");
                                        icon-size: 16px;
                                        background: Theme.selected;
                                        active-background: Theme.selected;
                                        active: msg.translationText != "";
                                        enabled: !msg.translationBusy && !root.select-mode;
                                        accessible-role: button;
                                        accessible-label: @tr("chat.message.translate");
                                        clicked => { root.message-action(msg.id, "translate"); }
                                    }
                                }
                            }
                        }
                        if root.blur-messages && !row-hover.has-hover && !(root.demo-hover && root.demo-hover-x > 440px && root.demo-hover-x < 1440px && root.demo-hover-y > 80px) && msg.kind != "system": PrivacyVeil {
                            x: bubble.x + 1px;
                            y: bubble.y + 1px;
                            width: bubble.width - 2px;
                            height: bubble.height - 2px;
                            visible: bubble.width > 2px && bubble.height > 2px;
                            radius: 6px;
                            cover: true;
                            tint: msg.fromMe ? Theme.bubble-out : Theme.bubble-in;
                        }
                        translation-card := Rectangle {
                            visible: msg-row.has-translation;
                            x: bubble.x;
                            y: bubble.y + bubble.height;
                            width: bubble.width;
                            height: msg-row.has-translation
                                ? max(msg.translationText != "" ? 94px : 54px, translated-content.preferred-height) : 0px;
                            border-radius: 11px;
                            background: msg.fromMe ? Theme.bubble-out : Theme.bubble-in;
                            drop-shadow-blur: 6px;
                            drop-shadow-color: Theme.glass-shadow;
                            Rectangle {
                                x: 4px;
                                y: 1px;
                                width: max(0px, parent.width - 8px);
                                height: max(0px, parent.height - 2px);
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: Theme.text-dim.with-alpha(0.18);
                                drop-shadow-blur: 2px;
                                drop-shadow-color: Theme.glass-shadow;
                            }
                            translated-content := VerticalLayout {
                                x: 18px;
                                width: max(0px, parent.width - 62px);
                                height: self.preferred-height;
                                padding-top: 8px;
                                padding-bottom: 14px;
                                spacing: 6px;
                                HorizontalLayout {
                                    spacing: 5px;
                                    Image {
                                        source: @image-url("../icons/translate.svg");
                                        colorize: Theme.text-dim;
                                        width: 10px;
                                        height: 10px;
                                        vertical-stretch: 0;
                                    }
                                    Text {
                                        text: msg.translationLabel != "" ? @tr("chat.message.translated_from", msg.translationLabel) : @tr("chat.message.translated");
                                        color: Theme.text-dim;
                                        font-size: 10px;
                                        wrap: word-wrap;
                                    }
                                }
                                if msg.translationText != "": TextInput {
                                    text: msg.translationText;
                                    read-only: true;
                                    single-line: false;
                                    wrap: word-wrap;
                                    font-size: 14px;
                                    color: Theme.bubble-text;
                                    selection-background-color: Theme.selection;
                                    selection-foreground-color: white;
                                    animate opacity { duration: 120ms; easing: ease-out; }
                                }
                                if msg.translationBusy: Text {
                                    text: @tr("chat.message.translating");
                                    color: Theme.text-dim;
                                    font-size: 12px;
                                }
                                if msg.translationError != "": Text {
                                    text: msg.translationError;
                                    color: Theme.text-dim;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                            }
                            if msg.translationText != "": IconButton {
                                label: @tr("chat.message.copy_translation");
                                x: parent.width - 39px;
                                y: 11px;
                                width: 24px;
                                height: 24px;
                                icon-size: 14px;
                                icon: @image-url("../icons/copy.svg");
                                tint: Theme.text-dim;
                                enabled: !root.select-mode;
                                accessible-role: button;
                                accessible-label: @tr("chat.message.copy_translation");
                                clicked => { root.message-action(msg.id, "translation-copy"); }
                            }
                        }
                        // Hover actions like WhatsApp Web: one small pill
                        // beside the bubble (react, forward, translate, menu).
                        // Shown while the pointer is anywhere on the row's
                        // line, so moving onto the pill never hides it.
                        // The pointer is over this row (bubble line, full width).
                        property <bool> pointer-in: root.pointer-y >= self.absolute-position.y + bubble.y - 6px
                            && root.pointer-y < self.absolute-position.y + bubble.y + max(bubble.height, 36px) + 6px
                            && root.pointer-x >= self.absolute-position.x
                            && root.pointer-x < self.absolute-position.x + self.width;
                        property <bool> show-actions: (msg-row.pointer-in || row-hover.has-hover || root.react-bar-id == msg.id)
                            && !root.select-mode && msg.kind != "system" && !msg.deleted;
                        if msg-row.show-actions: Rectangle {
                            width: actions-row.preferred-width + 8px;
                            height: 32px;
                            y: bubble.y + max(0px, (min(bubble.height, 80px) - self.height) / 2);
                            x: msg.fromMe
                                ? max(0px, bubble.x - self.width - 6px)
                                : bubble.x + bubble.width + 6px;
                            border-radius: 16px;
                            background: Theme.panel;
                            border-width: Theme.glass ? 1px : 0px;
                            border-color: Theme.glass-rim;
                            actions-row := HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                padding-top: 2px;
                                padding-bottom: 2px;
                                spacing: 2px;
                                IconButton {
                                    label: @tr("message.menu.react");
                                    icon: @image-url("../icons/mood-smile.svg");
                                    icon-size: 17px;
                                    width: 28px;
                                    height: 28px;
                                    radius: 14px;
                                    accessible-role: button;
                                    clicked => {
                                        root.react-bar-id =
                                            root.react-bar-id == msg.id ? "" : msg.id;
                                    }
                                }
                                IconButton {
                                    label: @tr("message.menu.forward");
                                    icon: @image-url("../icons/corner-up-right.svg");
                                    icon-size: 17px;
                                    width: 28px;
                                    height: 28px;
                                    radius: 14px;
                                    accessible-role: button;
                                    clicked => { root.request-forward(msg.id); }
                                }
                                if root.can-translate(msg) && !msg-row.has-translation: IconButton {
                                    label: @tr("chat.message.translate");
                                    icon: @image-url("../icons/translate.svg");
                                    icon-size: 17px;
                                    width: 28px;
                                    height: 28px;
                                    radius: 14px;
                                    accessible-role: button;
                                    accessible-label: @tr("chat.message.translate");
                                    enabled: !msg.translationBusy;
                                    active: msg.translationText != "";
                                    clicked => { root.message-action(msg.id, "translate"); }
                                }
                                menu-button := IconButton {
                                    label: @tr("accessibility.message_options");
                                    icon: @image-url("../icons/chevron-down.svg");
                                    icon-size: 17px;
                                    width: 28px;
                                    height: 28px;
                                    radius: 14px;
                                    accessible-role: button;
                                    clicked => {
                                        root.menu-message = msg;
                                        root.message-menu-x = self.absolute-position.x;
                                        root.message-menu-y = self.absolute-position.y + self.height;
                                        root.message-menu-open = true;
                                    }
                                }
                            }
                        }

                        // Quick reactions, the same set WhatsApp offers.
                        if root.react-bar-id == msg.id: Rectangle {
                            y: max(0px, bubble.y - 34px);
                            x: msg.fromMe
                                ? max(4px, bubble.x + bubble.width - self.width)
                                : bubble.x;
                            width: 214px;
                            height: 38px;
                            border-radius: 19px;
                            background: Theme.panel;
                            backdrop-blur: 0px;
                            border-width: Theme.glass ? 1px : 0px;
                            border-color: Theme.glass-rim;
                            if Theme.glass: Rectangle {
                                border-radius: parent.border-radius;
                                background: Theme.glass-sheen;
                            }
                            drop-shadow-blur: 8px;
                            drop-shadow-color: Theme.glass-shadow;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 2px;
                                for e in ["\u{1f44d}", "\u{2764}\u{fe0f}", "\u{1f602}",
                                          "\u{1f62e}", "\u{1f622}", "\u{1f64f}"]:
                                    Rectangle {
                                        width: 30px;
                                        emoji-touch := TouchArea {
                                            accessible-role: button;
                                            accessible-label: @tr("accessibility.react_with", e);
                                            accessible-action-default => { root.react-to(msg.id, e); root.react-bar-id = ""; }
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.react-to(msg.id, e);
                                                root.react-bar-id = "";
                                            }
                                            emoji-key := KeyFocus {
                                                activate => { root.react-to(msg.id, e); root.react-bar-id = ""; }
                                            }
                                            FocusRing {
                                                shown: emoji-key.has-focus;
                                                width: parent.width;
                                                height: parent.height;
                                                border-radius: 8px;
                                            }
                                        }
                                        EmojiText {
                                            text: e;
                                            font-size: emoji-touch.has-hover ? 24px : 20px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: parent.width;
                                            height: parent.height;
                                        }
                                    }
                                Rectangle {
                                    width: 26px;
                                    plus-touch := TouchArea {
                                        accessible-role: button;
                                        accessible-label: @tr("accessibility.more_reactions");
                                        accessible-action-default => { root.react-bar-id = ""; root.react-pick(msg.id); }
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.react-bar-id = "";
                                            root.react-pick(msg.id);
                                        }
                                        plus-key := KeyFocus {
                                            activate => { root.react-bar-id = ""; root.react-pick(msg.id); }
                                        }
                                        FocusRing {
                                            shown: plus-key.has-focus;
                                            width: parent.width;
                                            height: parent.height;
                                            border-radius: 8px;
                                        }
                                    }
                                    Image {
                                        source: @image-url("../icons/plus.svg");
                                        colorize: Theme.text-dim;
                                        width: 16px;
                                        height: 16px;
                                    }
                                }
                            }
                        }

                        if msg.reactions != "": Rectangle {
                            y: translation-card.y + translation-card.height - 4px;
                            x: msg.fromMe
                                ? bubble.x + bubble.width - self.width - 4px
                                : bubble.x + 4px;
                            width: chip-row.preferred-width + 14px;
                            height: 21px;
                            border-radius: 10.5px;
                            background: Theme.pill;
                            border-width: 1.5px;
                            border-color: Theme.conv-bg;
                            TouchArea {
                                accessible-role: button;
                                accessible-label: @tr("accessibility.reactions_summary", msg.reactions, msg.reactionCount);
                                accessible-action-default => { root.reactions-msg-id = msg.id; root.show-reactions(msg.id); }
                                mouse-cursor: pointer;
                                clicked => { root.reactions-msg-id = msg.id; root.show-reactions(msg.id); }
                                reactions-key := KeyFocus {
                                    activate => { root.reactions-msg-id = msg.id; root.show-reactions(msg.id); }
                                }
                                FocusRing {
                                    shown: reactions-key.has-focus;
                                    width: parent.width;
                                    height: parent.height;
                                    border-radius: 10.5px;
                                }
                            }
                            // The emoji and the count apart: the emoji font
                            // has digits of its own.
                            chip-row := HorizontalLayout {
                                alignment: center;
                                spacing: 3px;
                                EmojiText {
                                    text: msg.reactions;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                                if msg.reactionCount != "": Text {
                                    text: msg.reactionCount;
                                    font-size: 11px;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        // Selection mode: a click anywhere on the row
                        // toggles it, over whatever the bubble holds.
                        if root.select-mode && msg.kind != "system": TouchArea {
                            accessible-role: checkbox;
                            accessible-label: @tr("accessibility.select_message");
                            accessible-checkable: true;
                            accessible-checked: msg.selected;
                            accessible-action-default => { root.toggle-select(msg.id); }
                            mouse-cursor: pointer;
                            clicked => { root.toggle-select(msg.id); }
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                    root.drag-start(msg.id, msg-row.vis-y / 1px + self.pressed-y / 1px);
                                }
                                if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                                    root.drag-end();
                                }
                            }
                            moved => {
                                if (self.pressed) {
                                    root.drag-move(msg-row.vis-y / 1px + self.mouse-y / 1px);
                                }
                            }
                            select-key := KeyFocus {
                                activate => { root.toggle-select(msg.id); }
                            }
                        }
                    }
                }
                    // Floating day: the date of the row at the top edge,
                    // shown while the list moves.
                    if root.scrolling && root.floating-day != "" && root.conv-ready: Rectangle {
                        y: contact-header.height + 8px;
                        x: (parent.width - self.width) / 2;
                        width: float-day.preferred-width + 24px;
                        height: 24px;
                        border-radius: 12px;
                        background: Theme.day-bg;
                        border-width: 1px;
                        border-color: Theme.day-border;
                        float-day := Text {
                            text: root.floating-day;
                            color: Theme.text-dim;
                            font-size: 11px;
                            width: parent.width;
                            height: parent.height;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                composer-dock := Rectangle {
                    x: 0px;
                    width: parent.width;
                    height: dock-col.preferred-height;
                    y: parent.height - self.height;
                    // Transparent: the composer pill floats over the
                    // conversation like the header pill, no strip behind it.
                    background: transparent;
                    dock-touch := TouchArea {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                    }
                    dock-col := VerticalLayout {
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 6px;

                if root.reply-open: Rectangle {
                    height: 58px;
                    background: transparent;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 6px;
                        spacing: 10px;
                        Rectangle {
                            horizontal-stretch: 1;
                            background: Theme.pill;
                            border-radius: 6px;
                            Rectangle {
                                x: 0;
                                width: 4px;
                                height: parent.height;
                                background: Theme.accent;
                            }
                            VerticalLayout {
                                padding-left: 12px;
                                padding-right: 8px;
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: root.reply-name;
                                    color: Theme.accent;
                                    font-size: 13px;
                                    font-weight: 700;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.reply-text;
                                    color: Theme.text-dim;
                                    font-size: 13px;
                                    overflow: elide;
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                label: @tr("accessibility.cancel_reply");
                                icon: @image-url("../icons/x.svg");
                                clicked => { root.cancel-reply(); }
                            }
                        }
                    }
                }

                // Selection bar: what to do with the picked messages.
                if root.select-mode: Rectangle {
                    height: 56px;
                    Rectangle {
                    x: 12px;
                    width: parent.width - 24px;
                    height: parent.height;
                    background: Theme.panel;
                    backdrop-blur: 0px;
                    border-width: 1px;
                    border-color: Theme.glass ? Theme.glass-rim : Theme.border;
                    border-radius: 18px;
                    drop-shadow-blur: 10px;
                    drop-shadow-color: Theme.glass-shadow;
                    if Theme.glass: Rectangle {
                        width: parent.width;
                        height: parent.height;
                        border-radius: parent.border-radius;
                        background: Theme.glass-sheen;
                    }
                    HorizontalBox {
                        padding: 8px;
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        IconButton {
                            label: @tr("accessibility.cancel_selection");
                            icon: @image-url("../icons/x.svg");
                            clicked => { root.select-cancel(); }
                        }
                        Text {
                            text: @tr("selection.messages.count.one" | "selection.messages.count.other" % root.select-count);
                            color: Theme.text;
                            font-size: 15px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        IconButton {
                            label: @tr("message.menu.star");
                            icon: @image-url("../icons/star.svg");
                            enabled: root.select-count > 0;
                            clicked => { root.select-star(); }
                        }
                        IconButton {
                            label: @tr("accessibility.copy");
                            icon: @image-url("../icons/copy.svg");
                            enabled: root.select-count > 0;
                            clicked => { root.select-copy(); }
                        }
                        IconButton {
                            label: @tr("message.menu.forward");
                            icon: @image-url("../icons/corner-up-right.svg");
                            enabled: root.select-count > 0;
                            clicked => { root.select-forward(); }
                        }
                        IconButton {
                            label: @tr("message.menu.delete");
                            icon: @image-url("../icons/trash.svg");
                            enabled: root.select-count > 0;
                            clicked => { root.select-delete(); }
                        }
                    }
                    }
                }

                // Read-only conversation: announcement groups and groups
                // we are no longer in.
                if !root.select-mode && !root.current-can-send: Rectangle {
                    height: 52px;
                    // Floats like the composer pill: same margins, radius and glass.
                    Rectangle {
                        x: 12px;
                        width: parent.width - 24px;
                        height: parent.height;
                        background: Theme.panel;
                        backdrop-blur: 0px;
                        border-width: 1px;
                        border-color: Theme.glass ? Theme.glass-rim : Theme.border;
                        border-radius: 18px;
                        drop-shadow-blur: 10px;
                        drop-shadow-color: Theme.glass-shadow;
                        if Theme.glass: Rectangle {
                            width: parent.width;
                            height: parent.height;
                            border-radius: parent.border-radius;
                            background: Theme.glass-sheen;
                        }
                        HorizontalLayout {
                            alignment: center;
                            if root.current-left: Text {
                                text: @tr("chat.composer.not_member");
                                color: Theme.text-dim;
                                font-size: 14px;
                                vertical-alignment: center;
                            }
                            if !root.current-left: Text {
                                text: @tr("chat.composer.admins_only_prefix");
                                color: Theme.text-dim;
                                font-size: 14px;
                                vertical-alignment: center;
                            }
                            if !root.current-left: Text {
                                text: @tr("chat.composer.admins_only_highlight");
                                color: Theme.accent-text;
                                font-size: 14px;
                                vertical-alignment: center;
                            }
                            if !root.current-left: Text {
                                text: @tr("chat.composer.admins_only_suffix");
                                color: Theme.text-dim;
                                font-size: 14px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                Rectangle {
                    height: root.select-mode || !root.current-can-send ? 0
                        : max(52px, min(190px, message-input.preferred-height + 32px));
                    visible: !root.select-mode && root.current-can-send;
                    background: transparent;

                    Rectangle {
                        x: 12px;
                        width: parent.width - 24px;
                        height: parent.height;
                        background: Theme.panel;
                        backdrop-blur: 0px;
                        border-width: 1px;
                        border-color: Theme.glass ? Theme.glass-rim : Theme.border;
                        border-radius: 18px;
                        drop-shadow-blur: 10px;
                        drop-shadow-color: Theme.glass-shadow;
                        if Theme.glass: Rectangle {
                            width: parent.width;
                            height: parent.height;
                            border-radius: parent.border-radius;
                            background: Theme.glass-sheen;
                        }

                        // Recording bar (replaces the composer while capturing)
                        HorizontalBox {
                            visible: root.rec-active;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;
                            IconButton {
                                label: @tr("accessibility.discard_recording");
                                icon: @image-url("../icons/trash.svg");
                                clicked => { root.rec-cancel(); }
                            }
                            Rectangle {
                                width: 10px;
                                height: 10px;
                                border-radius: 5px;
                                background: Theme.danger-solid;
                                y: 26px;
                            }
                            Text {
                                text: root.rec-elapsed;
                                color: Theme.text;
                                font-size: 15px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            vo-touch := TouchArea {
                                accessible-role: switch;
                                accessible-label: @tr("accessibility.view_once");
                                accessible-checkable: true;
                                accessible-checked: root.rec-view-once;
                                accessible-action-default => { root.rec-view-once = !root.rec-view-once; }
                                width: 40px;
                                height: 40px;
                                mouse-cursor: pointer;
                                clicked => { root.rec-view-once = !root.rec-view-once; }
                                Rectangle {
                                    width: parent.width;
                                    height: parent.height;
                                    border-radius: 8px;
                                    background: root.rec-view-once ? Theme.chip-active-bg
                                        : vo-touch.has-hover ? Theme.hover : transparent;
                                    Image {
                                        source: @image-url("../icons/eye.svg");
                                        colorize: root.rec-view-once ? Theme.accent : Theme.icon;
                                        width: 22px;
                                        height: 22px;
                                        x: 9px;
                                        y: 9px;
                                    }
                                }
                                vo-key := KeyFocus {
                                    activate => { root.rec-view-once = !root.rec-view-once; }
                                }
                                FocusRing {
                                    shown: vo-key.has-focus;
                                    width: parent.width;
                                    height: parent.height;
                                    border-radius: 8px;
                                }
                            }
                            IconButton {
                                label: @tr("accessibility.send_recording");
                                icon: @image-url("../icons/send-2.svg");
                                clicked => { root.rec-stop(); }
                            }
                        }

                        HorizontalBox {
                            visible: !root.rec-active;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 8px;
                            IconButton {
                                label: @tr("accessibility.attach");
                                width: 32px;
                                height: 32px;
                                icon-size: 20px;
                                radius: 10px;
                                background: Theme.tile;
                                icon: @image-url("../icons/plus.svg");
                                clicked => {
                                    root.picker-open = false;
                                    root.attach-open = !root.attach-open;
                                }
                            }
                            IconButton {
                                label: @tr("accessibility.emoji");
                                width: 32px;
                                height: 32px;
                                icon-size: 20px;
                                icon: @image-url("../icons/mood-smile.svg");
                                clicked => {
                                    root.attach-open = false;
                                    root.picker-open = !root.picker-open;
                                    if (root.picker-open) { root.picker-opened(); }
                                }
                            }
                            // A TextInput rather than a LineEdit: it wraps,
                            // takes Shift+Enter for a new line and tells the
                            // host where the cursor is (for "@" mentions).
                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 22px;
                                background: Theme.field;
                                border-width: 1px;
                                border-color: Theme.field-border;
                                composer-scroll := Flickable {
                                    x: 12px;
                                    y: 8px;
                                    width: parent.width - 24px;
                                    height: parent.height - 16px;
                                    content-height: max(self.height, message-input.preferred-height);
                                    content-width: self.width;
                                    // TextInput never scrolls itself into view
                                    // (that's the enclosing widget's job, per
                                    // Slint's own docs) -- interactive lets a
                                    // mouse-wheel/drag also scroll a long
                                    // composed message, and cursor-position-changed
                                    // below keeps the caret itself always visible.
                                    interactive: true;
                                    message-input := TextInput {
                                        accessible-label: @tr("chat.composer.placeholder");
                                        width: parent.width;
                                        height: max(parent.height, self.preferred-height);
                                        color: Theme.text;
                                        font-size: 15px;
                                        single-line: false;
                                        wrap: word-wrap;
                                        vertical-alignment: center;
                                        selection-background-color: Theme.selection;
                                        selection-foreground-color: white;
                                        edited => {
                                            root.composer-changed(self.text, self.cursor-position-byte-offset);
                                        }
                                        cursor-position-changed(pos) => {
                                            root.composer-cursor(self.cursor-position-byte-offset, self.anchor-position-byte-offset);
                                            if (pos.y < -composer-scroll.viewport-y) {
                                                composer-scroll.viewport-y = -pos.y;
                                            } else if (pos.y + self.font-size * 1.3
                                                    > -composer-scroll.viewport-y + composer-scroll.height) {
                                                composer-scroll.viewport-y =
                                                    composer-scroll.height - pos.y - self.font-size * 1.3;
                                            }
                                        }
                                        key-pressed(event) => {
                                            if (root.mention-open && root.mention-rows.length > 0) {
                                                if (event.text == Key.UpArrow || event.text == Key.DownArrow) {
                                                    root.mention-index = Math.mod(root.mention-index + root.mention-rows.length
                                                        + (event.text == Key.DownArrow ? 1 : -1), root.mention-rows.length);
                                                    return accept;
                                                }
                                                if (event.text == Key.Tab || (event.text == Key.Return && !event.modifiers.shift)) {
                                                    root.mention-pick(root.mention-index);
                                                    return accept;
                                                }
                                            }
                                            if (root.composer-key(event.text, self.cursor-position-byte-offset,
                                                self.anchor-position-byte-offset, event.modifiers.shift, event.modifiers.control)) {
                                                return accept;
                                            }
                                            if (event.text == Key.Return && !event.modifiers.shift) {
                                                if (root.mention-open) {
                                                    root.mention-pick(root.mention-index);
                                                } else {
                                                    root.send-message(self.text);
                                                    composer-scroll.viewport-y = 0;
                                                }
                                                return accept;
                                            }
                                            if (event.text == Key.Escape && root.mention-open) {
                                                root.mention-close();
                                                return accept;
                                            }
                                            if (event.text == Key.UpArrow && self.text == ""
                                                && !event.modifiers.alt && !event.modifiers.control
                                                && !root.mention-open) {
                                                root.edit-last-message();
                                                return accept;
                                            }
                                            reject
                                        }
                                    }
                                    for mention in root.composer-mentions: Rectangle {
                                        property <{ x: length, y: length }> token-start;
                                        property <{ x: length, y: length }> token-end;
                                        x: self.token-start.x - 5px;
                                        y: self.token-start.y - 5px;
                                        width: max(0px, self.token-end.x - self.token-start.x) + 7px;
                                        height: 29px;
                                        border-radius: 15px;
                                        background: Theme.dark ? #075348 : #d3f4e6;
                                        border-width: 1px;
                                        border-color: Theme.accent.with-alpha(0.8);
                                        visible: message-input.text != "" && self.token-start.y == self.token-end.y;
                                        function measure() {
                                            token-probe.set-selection-offsets(mention.start, mention.start);
                                            token-probe.set-selection-offsets(mention.end, mention.end);
                                        }
                                        init => { self.measure(); }
                                        property <string> source: message-input.text;
                                        property <length> editor-width: message-input.width;
                                        property <length> editor-height: message-input.height;
                                        changed source => { self.measure(); }
                                        changed editor-width => { self.measure(); }
                                        changed editor-height => { self.measure(); }
                                        property <int> start-offset: mention.start;
                                        property <int> end-offset: mention.end;
                                        changed start-offset => { self.measure(); }
                                        changed end-offset => { self.measure(); }
                                        Timer {
                                            interval: 30ms;
                                            running: true;
                                            triggered => { self.running = false; parent.measure(); }
                                        }
                                        Text {
                                            x: 9px;
                                            width: max(0px, parent.width - 29px);
                                            height: parent.height;
                                            text: "@" + mention.label;
                                            font-size: 15px;
                                            font-weight: 600;
                                            color: Theme.text;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        TouchArea {
                                            x: parent.width - 23px;
                                            y: 3px;
                                            width: 22px;
                                            height: parent.height - 6px;
                                            mouse-cursor: pointer;
                                            accessible-role: button;
                                            accessible-label: @tr("Remove mention");
                                            clicked => { root.mention-remove(mention.start, mention.end); }
                                            Image {
                                                x: 4px;
                                                y: (parent.height - 14px) / 2;
                                                width: 14px;
                                                height: 14px;
                                                source: @image-url("../icons/x.svg");
                                                colorize: Theme.text-dim;
                                            }
                                        }
                                        token-probe := TextInput {
                                            width: message-input.width;
                                            height: message-input.height;
                                            text: message-input.text;
                                            font-size: message-input.font-size;
                                            wrap: word-wrap;
                                            single-line: false;
                                            vertical-alignment: center;
                                            opacity: 0;
                                            enabled: false;
                                            cursor-position-changed(pos) => {
                                                if (self.cursor-position-byte-offset == mention.start) {
                                                    parent.token-start = { x: pos.x, y: pos.y };
                                                } else {
                                                    parent.token-end = { x: pos.x, y: pos.y };
                                                }
                                            }
                                        }
                                    }
                                }
                                if message-input.text == "": Text {
                                    text: @tr("chat.composer.placeholder");
                                    color: Theme.text-dim;
                                    font-size: 15px;
                                    x: 12px;
                                    height: parent.height;
                                    vertical-alignment: center;
                                }
                            }
                            IconButton {
                                label: @tr("accessibility.record_voice");
                                width: 32px;
                                height: 32px;
                                icon-size: 20px;
                                icon: @image-url("../icons/microphone.svg");
                                y: parent.height - self.height - 8px;
                                clicked => { root.rec-start(); }
                            }
                            IconButton {
                                label: @tr("accessibility.send");
                                width: 40px;
                                height: 32px;
                                icon-size: 20px;
                                radius: 10px;
                                background: Theme.send;
                                tint: #ffffff;
                                icon: @image-url("../icons/send-2.svg");
                                y: parent.height - self.height - 8px;
                                clicked => {
                                    root.send-message(message-input.text);
                                    composer-scroll.viewport-y = 0;
                                }
                            }
                        }
                    }
                    }
                }
                }
            }

            contact-header := Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                visible: root.chat-open;
                height: 80px;

                // Transparent: the header pill floats over the conversation
                // like the composer, no strip behind it.
                background: transparent;
                Rectangle {
                    x: 12px;
                    y: 8px;
                    width: parent.width - 24px;
                    height: 64px;
                    border-radius: 18px;
                    background: Theme.panel;
                    backdrop-blur: 0px;
                    border-width: 1px;
                    border-color: Theme.glass ? Theme.glass-rim : Theme.border;
                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 14px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 40px;
                                height: 40px;
                                Avatar {
                                    x: 0;
                                    y: 0;
                                    width: 40px;
                                    height: 40px;
                                    src: root.current-avatar;
                                    has-image: root.current-avatar-has;
                                    initial: root.current-initial;
                                    color-idx: root.current-color-idx;
                                    privacy-blurred: root.blur-photos;
                                    privacy-reveal: header-avatar-touch.has-hover;
                                }
                                header-avatar-touch := TouchArea {
                                    accessible-role: button;
                                    accessible-label: @tr("accessibility.open_chat_info", root.current-chat-name);
                                    accessible-action-default => { root.open-info(); }
                                    width: parent.width;
                                    height: parent.height;
                                    mouse-cursor: pointer;
                                    clicked => { root.open-info(); }
                                }
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            head-touch := TouchArea {
                                accessible-role: button;
                                accessible-label: @tr("accessibility.open_chat_info", root.current-chat-name);
                                accessible-action-default => { root.open-info(); }
                                mouse-cursor: pointer;
                                clicked => { root.open-info(); }
                                head-key := KeyFocus {
                                    activate => { root.open-info(); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                width: parent.width;
                                height: parent.height;
                                spacing: 4px;
                                Text {
                                    text: root.current-chat-name;
                                    color: root.blur-names && !head-touch.has-hover ? transparent : Theme.text;
                                    font-size: 15px;
                                    font-weight: 600;
                                    overflow: elide;
                                    if root.blur-names && !head-touch.has-hover: PrivacyVeil {
                                        width: parent.width;
                                        height: parent.height;
                                        radius: 3px;
                                        tint: Theme.header;
                                    }
                                }
                                if root.current-status != "": Text {
                                    text: root.current-status;
                                    color: root.blur-names && !head-touch.has-hover ? transparent : Theme.text-dim;
                                    font-size: 11px;
                                    wrap: no-wrap;
                                    overflow: elide;
                                    if root.blur-names && !head-touch.has-hover: PrivacyVeil {
                                        width: parent.width;
                                        height: parent.height;
                                        radius: 3px;
                                        tint: Theme.header;
                                    }
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                label: @tr("info.action.search");
                                width: 32px;
                                height: 32px;
                                icon-size: 20px;
                                icon: @image-url("../icons/search.svg");
                                active: root.chat-search-open;
                                clicked => { root.menu-search(); }
                            }
                        }
                        if root.current-callable: VerticalLayout {
                            alignment: center;
                            IconButton {
                                label: @tr("accessibility.video_call");
                                width: 32px;
                                height: 32px;
                                icon-size: 20px;
                                icon: @image-url("../icons/video.svg");
                                clicked => { root.start-video-call(root.current-jid); }
                            }
                        }
                        if root.current-callable: VerticalLayout {
                            alignment: center;
                            IconButton {
                                label: @tr("accessibility.voice_call");
                                width: 32px;
                                height: 32px;
                                icon-size: 20px;
                                icon: @image-url("../icons/phone.svg");
                                clicked => { root.start-call(root.current-jid); }
                            }
                        }
                        Rectangle {
                            width: 1px;
                            height: 24px;
                            y: (parent.height - self.height) / 2;
                            background: Theme.border;
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                label: @tr("accessibility.chat_menu");
                                width: 32px;
                                height: 32px;
                                icon-size: 20px;
                                icon: @image-url("../icons/dots-vertical.svg");
                                active: root.chat-menu-open;
                                clicked => {
                                    root.chat-menu-sub = "";
                                    root.chat-menu-open = !root.chat-menu-open;
                                }
                            }
                        }
                    }
                }
            }

            // Calls held back by the anti-spam rule, stacked under the pinned strip.
            if root.chat-open && root.silenced-calls.length > 0: VerticalLayout {
                x: 0px;
                y: contact-header.height - 6px + (root.pinned-items.length > 0 ? 44px : 0px);
                width: parent.width;
                spacing: 0px;
                for call in root.silenced-calls: SilencedCallBanner {
                    call: call;
                    answer => { root.answer-silenced-call(call.id); }
                    decline => { root.decline-silenced-call(call.id); }
                }
            }

            // Pinned message strip, just under the floating header.
            if root.chat-open && root.pinned-items.length > 0: PinnedBanner {
                x: 0px;
                y: contact-header.height - 6px;
                width: parent.width;
                items: root.pinned-items;
                index <=> root.pinned-index;
                open-pinned(a0) => { root.open-pinned(a0); }
                unpin(a0) => { root.unpin-message(a0); }
            }

            if root.chat-open && root.sync-banner != "": Rectangle {
                y: contact-header.height + 4px;
                width: parent.width;
                height: 32px;
                HorizontalLayout {
                    alignment: center;
                    padding-top: 6px;
                    Rectangle {
                        width: banner-text.preferred-width + 44px;
                        height: 24px;
                        border-radius: 12px;
                        background: banner-touch.has-hover ? Theme.selected : Theme.pill;
                        banner-touch := TouchArea {
                            accessible-role: button;
                            accessible-label: root.sync-banner;
                            accessible-action-default => { root.sync-clicked(); }
                            mouse-cursor: pointer;
                            clicked => { root.sync-clicked(); }
                            banner-key := KeyFocus {
                                activate => { root.sync-clicked(); }
                            }
                            FocusRing {
                                shown: banner-key.has-focus;
                                width: parent.width;
                                height: parent.height;
                                border-radius: 12px;
                            }
                        }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            Image {
                                source: @image-url("../icons/refresh.svg");
                                colorize: Theme.text-dim;
                                width: 13px;
                                height: 13px;
                                y: (parent.height - self.height) / 2;
                            }
                            banner-text := Text {
                                text: root.sync-banner;
                                color: Theme.text-dim;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // Floating "jump to latest" button
            if root.chat-open && !root.stick-bottom: Rectangle {
                x: parent.width - self.width - 24px;
                y: parent.height - self.height - composer-dock.height - 16px;
                width: 42px;
                height: 42px;
                border-radius: 21px;
                background: Theme.panel;
                backdrop-blur: 0px;
                border-width: Theme.glass ? 1px : 0px;
                border-color: Theme.glass-rim;
                if Theme.glass: Rectangle {
                    border-radius: parent.border-radius;
                    background: Theme.glass-sheen;
                }
                drop-shadow-blur: 6px;
                drop-shadow-color: Theme.glass-shadow;
                jump-touch := TouchArea {
                    accessible-role: button;
                    accessible-label: @tr("accessibility.jump_to_latest");
                    accessible-action-default => { root.jump-latest(); }
                    mouse-cursor: pointer;
                    // Routed through the host so the jump is re-applied
                    // while late-growing rows settle.
                    clicked => { root.jump-latest(); }
                    jump-key := KeyFocus {
                        activate => { root.jump-latest(); }
                    }
                    FocusRing {
                        shown: jump-key.has-focus;
                        width: parent.width;
                        height: parent.height;
                        border-radius: 21px;
                    }
                }
                Image {
                    source: @image-url("../icons/chevron-right.svg");
                    colorize: Theme.icon;
                    width: 22px;
                    height: 22px;
                    x: 10px;
                    y: 10px;
                    transform-rotation: 90deg;
                }
            }

            // "@" mention list above the composer.
            if root.mention-open && root.chat-open && !root.select-mode: MentionPicker {
                x: 12px;
                y: parent.height - self.height - composer-dock.height - 8px;
                width: min(460px, max(0px, parent.width - 24px));
                height: min(420px, self.preferred-height, max(0px, parent.height - composer-dock.height - 16px));
                rows: root.mention-rows;
                selected-index: root.mention-index;
                member-count: root.mention-member-count;
                pick(i) => { root.mention-pick(i); }
            }

            drop-overlay := DropOverlay {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                active: root.file-drag-hover && root.chat-open && root.screen == "main";
            }

            preview-layer := ModalLayer {
                open: root.preview-open && root.chat-open;
                scrim: transparent;
                dismissible: false;
                width: parent.width;
                height: parent.height;
                image-editor := ImagePreview {
                    opacity: preview-layer.progress;
                    width: parent.width;
                    height: parent.height;
                    picture: root.preview-image;
                    busy: root.preview-busy;
                    count: root.staged-count;
                    index: root.staged-index;
                    thumbs: root.staged-thumbs;
                    select(i) => { root.staged-index = i; root.staged-select(i); }
                    cancel => { root.cancel-send-image(); }
                    send(caption) => { root.confirm-send-image(caption); }
                    crop(x, y, w, h) => { root.crop-preview(x, y, w, h); }
                    annotate(text, x, y) => { root.text-preview(text, x, y); }
                    draw(points, ink, thickness) => { root.draw-preview(points, ink, thickness); }
                    reset => { root.reset-preview(); }
                }
            }
        }
    }

    // Emoji / sticker picker above the composer
    picker-layer := PickerLayer {
        open: root.picker-open && root.chat-open;
        scrim: transparent;
        dismiss => { root.picker-open = false; }

        picker-open <=> root.picker-open;
        picker-tab <=> root.picker-tab;
        emoji-rows: root.emoji-rows;
        sticker-rows: root.sticker-rows;
        gif-rows: root.gif-rows;
        fav-rows: root.fav-rows;
        gif-send(a0) => { root.gif-send(a0); }
        emoji-pick(a0) => { root.emoji-pick(a0); }
        sticker-send(a0) => { root.sticker-send(a0); }
        gif-search(a0) => { root.gif-search(a0); }
        gif-hint: root.gif-hint;
        fav-hint: root.fav-hint;
        conv-x: conv-pane.absolute-position.x;
        conv-y: conv-pane.absolute-position.y;
        conv-h: conv-pane.height;
        dock-h: composer-dock.height;
    }

    // Chat header menu, dropping from the "⋮" button.
    chat-menu-layer := ChatMenuLayer {
        open: root.chat-menu-open && root.chat-open;
        scrim: transparent;
        dismiss => { root.chat-menu-open = false; root.chat-menu-sub = ""; }

        open-info() => { root.open-info(); }
        current-left: root.current-left;
        current-is-group: root.current-is-group;
        current-admin: root.current-admin;
        current-muted: root.current-muted;
        current-mute-label: root.current-mute-label;
        current-favorite: root.current-favorite;
        current-ephemeral: root.current-ephemeral;
        current-ephemeral-label: root.current-ephemeral-label;
        select-start(a0) => { root.select-start(a0); }
        chat-menu-open <=> root.chat-menu-open;
        chat-menu-sub <=> root.chat-menu-sub;
        labels: root.labels;
        menu-add-member() => { root.menu-add-member(); }
        menu-search() => { root.menu-search(); }
        menu-starred() => { root.starred-current-only = false; root.starred-open = true; root.open-starred(false); }
        menu-mute(a0) => { root.menu-mute(a0); }
        menu-ephemeral(a0) => { root.menu-ephemeral(a0); }
        menu-favorite() => { root.menu-favorite(); }
        menu-list(a0) => { root.menu-list(a0); }
        menu-export() => { root.menu-export(); }
        menu-close-chat() => { root.menu-close-chat(); }
        menu-clear() => { root.menu-clear(); }
        menu-delete-chat() => { root.menu-delete-chat(); }
        menu-exit-group() => { root.menu-exit-group(); }
        new-list-open <=> root.new-list-open;
        conv-x: conv-pane.absolute-position.x;
        conv-y: conv-pane.absolute-position.y;
        conv-w: conv-pane.width;
    }

    // WhatsApp-style attach menu popping above the composer
    attach-layer := AttachLayer {
        open: root.attach-open && root.chat-open;
        scrim: transparent;
        dismiss => { root.attach-open = false; }

        attach-open <=> root.attach-open;
        attach-sticker() => { root.attach-sticker(); }
        attach-image() => { root.attach-image(); }
        attach-audio() => { root.attach-audio(); }
        attach-doc() => { root.attach-doc(); }
        attach-poll() => { root.poll-composer-open = true; root.open-poll-composer(); }
        conv-x: conv-pane.absolute-position.x;
        conv-y: conv-pane.absolute-position.y;
        conv-h: conv-pane.height;
        dock-h: composer-dock.height;
    }
    // ---------- Contact / group info ----------
    info-layer := InfoLayer {
        open: root.info-open;
        scrim: Theme.scrim;
        dismiss => { root.close-info(); }
        open-starred-here() => { root.starred-current-only = true; root.starred-open = true; root.open-starred(true); }

        current-callable: root.current-callable;
        start-call(a0) => { root.start-call(a0); }
        start-video-call(a0) => { root.start-video-call(a0); }
        open-chat(a0) => { root.open-chat(a0); }
        current-jid: root.current-jid;
        info-name: root.info-name;
        info-id: root.info-id;
        info-about: root.info-about;
        info-desc: root.info-desc;
        info-is-group: root.info-is-group;
        info-members: root.info-members;
        info-archived: root.info-archived;
        info-avatar: root.info-avatar;
        info-has-avatar: root.info-has-avatar;
        info-initial: root.info-initial;
        info-color-idx: root.info-color-idx;
        info-media: root.info-media;
        close-info() => { root.close-info(); }
        toggle-archive() => { root.toggle-archive(); }
        clear-chat() => { root.clear-chat(); }
        current-left: root.current-left;
        current-muted: root.current-muted;
        menu-add-member() => { root.menu-add-member(); }
        menu-search() => { root.menu-search(); }
        menu-mute(a0) => { root.menu-mute(a0); }
        info-member-rows: root.info-member-rows;
        info-common-groups: root.info-common-groups;
        info-common-groups-state: root.info-common-groups-state;
        open-member(a0) => { root.open-member(a0); }
    }

    // ---------- In-chat search panel ----------
    chat-search-layer := ChatSearchLayer {
        open: root.chat-search-open && root.chat-open;
        scrim: transparent;
        dismiss => { root.chat-search-close(); }

        open-hit(a0, a1) => { root.open-hit(a0, a1); }
        chat-search-rows: root.chat-search-rows;
        chat-search-count: root.chat-search-count;
